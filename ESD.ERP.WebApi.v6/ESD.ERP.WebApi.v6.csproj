<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup Label="Globals">
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
    <RootNamespace>ESD.ERP.WebApi</RootNamespace>
    <UserSecretsId>cf20f11b-56b7-4140-bb91-59dab9e3352d</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="5.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ESD.Core.Service.v1\ESD.Core.Service.v1.csproj" />
    <ProjectReference Include="..\ESD.ERP.Business.v6\ESD.ERP.Business.v6.csproj" />
    <ProjectReference Include="..\ESD.ERP.DTO.v6\ESD.ERP.DTO.v6.csproj" />
    <ProjectReference Include="..\ESD.ERP.Repository.v6\ESD.ERP.Repository.v6.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Infrastructure\Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Infrastructure\Resources\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="connectionStrings.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
