<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log" >

   <targets>
      <target name="debugger" xsi:type="Debugger" layout="${longdate} ${level:uppercase=true:padding=-5} [${logger}] :: ${message}"/>
      <target name="file" xsi:type="File" fileName="${basedir}/logs/ESD.ERP.IntegrationApi.log"
              archiveEvery="Day" archiveNumbering="Date" archiveDateFormat="yyyyMMdd"
              layout="${longdate} ${uppercase:${level}} [${logger}] :: ${message}" />
      <target name="fileTmp" xsi:type="File" fileName="${basedir}/logs/ESDERP.Web.log"
              archiveEvery="Day" archiveNumbering="Date" archiveDateFormat="yyyyMMdd"
              layout="${longdate} ${uppercase:${level}} [${mdlc:item=ClassName}.${mdlc:item=MethodName}] :: ${message}" />
   </targets>

   <rules>
      <!--<logger name="*" minlevel="Trace" writeTo="debugger" />-->
      <logger name="ESDERP.*" minlevel="Trace" writeTo="file" />
      <logger name="ESD.*" minlevel="Trace" writeTo="fileTmp" />
   </rules>
</nlog>