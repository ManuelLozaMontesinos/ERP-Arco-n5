@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.CM.Models.PedidoCompraViewModel
<esd-menubar id="menuBar" Title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-textbox id="Codigo" col-position="col-lg-2" label="Código" col-label-position="col-lg-2" max-length="5"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2" max-length="35"></esd-textbox>
                  <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Razon Social" col-label-position="col-lg-2" max-length="150"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker id="FechaDesde" col-position="col-lg-2" label="Desde" col-label-position="col-lg-2"></esd-datetimepicker>
                  <esd-datetimepicker id="FechaHasta" col-position="col-lg-2" label="Hasta" col-label-position="col-lg-2"></esd-datetimepicker>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoProductoId" for="@Model.TipoProductoList" col-position="col-lg-2" label="Tipo Pedido" col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<esd-dialog id="stockMinimoListPopup" title="Punto de Pedido" onclick="stockMinimoListPopupOnClick" size="Large">
   <div id="stockMinimoListPopupContent"></div>
</esd-dialog>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         sortname: 'Fecha',
         sortorder: 'desc',
         url: "@Url.Action("ListarBandeja", "PedidoCompra")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "PedidoCompraDTO.Codigo", value: $('#Codigo').val() },
                     { name: "PedidoCompraDTO.FechaDesde", value: $('#FechaDesde').val(), type: 'date' },
                     { name: "PedidoCompraDTO.FechaHasta", value: $('#FechaHasta').val(), type: 'date' },
                     { name: "PedidoCompraDTO.TipoProductoId", value: $('#TipoProductoId').val() || 0, type: 'int' },
                     { name: "PedidoCompraDTO.ProveedorDTO.RazonSocial", value: $('#RazonSocial').val() },
                     { name: "PedidoCompraDTO.ProveedorDTO.NumeroDocumentoIdentidad", value: $('#NumeroDocumentoIdentidad').val() }
                  ]
               ));
            }
         },
         colNames: ['', 'Código', 'Tipo', 'Fecha', 'Proveedor', '#Doc', 'Tiene Modif.','', 'Estado Aprob.','','Estado',''],
         colModel: [
            { name: 'PedidoCompraId', hidden: true },
            { name: "Codigo", width: 80 },
            { name: "TipoProducto", width: 100 },
            { name: "Fecha", width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: "RazonSocial", width: 300 },
            { name: "NumeroDocumentoIdentidad", width: 100 },
            { name: "EsModificacion", width: 100, align: 'center' },
            { name: "EstadoAprobacion", hidden: true },
            { name: "EstadoAprobacionNombre", width: 150 },
            { name: "EstadoPedidoCompra", hidden: true },
            { name: "EstadoPedidoCompraNombre", width: 200 },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#menuBar").appMenu('disabledButton', { buttonId: 'desde_stock', disabled: false });
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');

            $("#menuBar").appMenu('disabledButton', { buttonId: 'desde_stock', disabled: false });
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });

      $('#stockMinimoListPopup').setDialog({
         onShow: function (p) {
            $(this).getView({
               urlAction: '@Url.Action("StockMinimoListPopup", "VolumenExisten", new { Area = "IV"})',
               container: 'stockMinimoListPopupContent',
               showLoading: false,
               hideLoading: false
            });
         },
         onShown: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         }
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $('#TipoProductoId').val('');
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#Codigo, #NumeroDocumentoIdentidad, #RazonSocial,#TipoProductoId").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
      $("#Codigo").keydown(function (e) {
         if (event.which == 13) {
            if (!$.isNullOrEmpty($("#Codigo").val())) {
               var valueFmt = padLeadingZeros($("#Codigo").val(), 5)
               $("#Codigo").val(valueFmt);
            }
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
      $("#FechaDesde").keydown(function (e) {
         if (event.which == 13) {
            $("#FechaHasta").val($("#FechaDesde").val());
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
      $("#FechaHasta").keydown(function (e) {
         if (event.which == 13) {
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
   });
   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW','desde_stock'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {
           case '@MenuItemKey.NEW':
            $(this).getView({
               editAction: '@ViewModelEditAction.New',
               buttonId: key,
               viewModel: [
                  { name: "PedidoCompraDTO.PedidoCompraId", value: 0, type: 'int' }
               ],
               urlAction: '@Url.Action("Crear", "PedidoCompra")'
            });
            break;

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "PedidoCompraDTO.PedidoCompraId", value: row.PedidoCompraId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "PedidoCompra")'
            });
            break;

         case '@MenuItemKey.DELETE':
            $('#menuBar').appMenu('disabledButton', { buttonId: key, disabled: true });
            $(this).confirm({
               title: '@SR.GetString("APPMP_anular_titulo")',
               message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
               onConfirm: function () {

                  $(this).saveView({
                     urlAction: '@Url.Action("Eliminar", "PedidoCompra")',
                     viewModel: [
                        { name: "PedidoCompraDTO.PedidoCompraId", value: row.PedidoCompraId, type: 'int' },
                        { name: "PedidoCompraDTO.Codigo", value: row.Codigo }
                     ],
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#bandejaGrid').appGrid('reloadJSON');
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
            break;

         case '@MenuItemKey.PREVIEW':
            var reportParam = "pedidoCompraId=" + row.PedidoCompraId
            $(this).getReport({
               buttonId: key,
               urlAction: '@Url.Action("ReportTo", "PedidoCompra")',
               parameters: reportParam,
               onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
            });
            break;

         case 'desde_stock':
            $('#stockMinimoListPopup').showDialog();
            break;
      }
      return true;
   };
   function stockMinimoListPopupOnClick() {

      var list = $('#bandejaPopupGrid').appGrid('getSelectedRowIdList');

      if (list.length === 0) {
         msgAlert(msgAlertTypeConstant.SUCCESS, '@SR.GetString("MG_producto_multiple_seleccion_requerida")');
         return false;
      }

      var selectedList = [];
      var proveedorId = 0;

      for (i in list) {
         var row = $('#bandejaPopupGrid').appGrid('getRow', list[i]);

         if (!$.isNullOrEmpty(row.ProveedorId) && proveedorId === 0)
            proveedorId = row.ProveedorId;

         var pedidoCompraProducto = [
            { name: "ProductoId", value: row.ProductoId, type: 'int' },
            { name: "Cantidad", value: row.MasterPack, type: 'decimal' },
            { name: "PesoNeto", value: row.PesoNeto, type: 'decimal' },
            { name: "PesoBruto", value: row.PesoBruto, type: 'decimal' }
         ];
         selectedList.push(pedidoCompraProducto);
      }

      crearPedidoCompra(selectedList, proveedorId);
   };
   function stockMinimoSelectedPopup(sourceId, row) {

      if ($.isEmpty(row)) {
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("MG_producto_multiple_seleccion_requerida")');
         return false;
      }

      var selectedList = [];
      var proveedorId = 0;

      if (!$.isNullOrEmpty(row.ProveedorId) && proveedorId === 0)
         proveedorId = row.ProveedorId;

      var pedidoCompraProducto = [
         { name: "ProductoId", value: row.ProductoId, type: 'int' },
         { name: "Cantidad", value: row.MasterPack, type: 'decimal' },
         { name: "PesoNeto", value: row.PesoNeto, type: 'decimal' },
         { name: "PesoBruto", value: row.PesoBruto, type: 'decimal' }
      ];
      selectedList.push(pedidoCompraProducto);

      crearPedidoCompra(selectedList, proveedorId);
   };
   function crearPedidoCompra(list, proveedorId) {
      $(this).saveView({
         urlAction: '@Url.Action("GrabarDesdeStockMinimo", "PedidoCompra")',
         viewModel: [
            { name: "PedidoCompraDTO.ProveedorId", value: proveedorId, type: 'int' },
            { name: "PedidoCompraProductoDTOList", value: list, type: 'list' }
         ],
         onSuccess: function (response) {
            if (response.success) {
               $('#stockMinimoListPopup').hideDialog();

               $(this).getView({
                  editAction: '@ViewModelEditAction.Edit',
                  viewModel: [
                     { name: "PedidoCompraDTO.PedidoCompraId", value: response.data.Id, type: 'int' }
                  ],
                  urlAction: '@Url.Action("Editar", "PedidoCompra")'
               });
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
</script>