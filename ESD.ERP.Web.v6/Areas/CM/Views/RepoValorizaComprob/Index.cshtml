@using ESD.Core;
@using ESD.Core.Web;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.CM.Models.ReporteGenViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="PreviewExport" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
    <div id="app-search-card" class="card">
        <div class="card-body">
            <div class="row">
                <div id="app-search-input-group" class="col-12">
                    <div class="form-group row">
                        <esd-buttontextbox id="ProveedorId" col-position="col-lg-4" label="Proveedor" col-label-position="col-lg-1" onclick="mostrarProveedor"></esd-buttontextbox>
                    </div>
                    <div class="form-group row">
                        <esd-dropdownlist id="MesId" for="@Model.SeleccionList" col-position="col-lg-4" label="Mes" col-label-position="col-lg-1"></esd-dropdownlist>
                    </div>
                </div>
            </div>
        </div>
        <esd-hidden id="ProveedorId"></esd-hidden>
    </div>
</section>
<esd-dialog id="vendedorListPopup" title="Vendedor" onclick="vendedorListPopupOnClick" size="Large">
    <div id="vendedorListPopupContent"></div>
</esd-dialog>

<esd-dialog id="proveedorListPopup" title="Cliente" onclick="proveedorListPopupOnClick" size="Large">
   <div id="proveedorListPopupContent"></div>
</esd-dialog>

<script type="text/javascript">
    $(document).ready(function () {

       $('#proveedorListPopup').setDialog({
          onShow: function (p) {
             $(this).getView({
                urlAction: '@Url.Action("ListPopup", "Proveedor", new { Area = "MG" })',
                container: 'proveedorListPopupContent',
                showLoading: false,
                hideLoading: false
             });
          },
          onShown: function () {
             $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
          }
       });
    });

    function mostrarProveedor() {
       $('#proveedorListPopup').showDialog();
    };
    function proveedorListPopupOnClick() {

       var row = $('#bandejaPopupGrid').appGrid('getSelectedRow');

       proveedorSelectedPopup('',row);
    };
    function proveedorSelectedPopup(sourceId, row) {

       if($.isEmpty(row)){
          msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("MG_proveedor_seleccion_requerida")');
          return false;
       }

       $('#ProveedorId').val(row.ProveedorId);
       $('#Proveedor').val(row.RazonSocial);

       $('#proveedorListPopup').hideDialog();
    }

    function menuBarOnClick(key) {

        if (!$('#MesId').validateNumeric('@SR.GetString("GEN_mes_seleccion_requerida")'))
            return false;

         var reportParam = "&mesId=" + $('#MesId').val()
         + "&proveedorId=" + $('#ProveedorId').val();

        var format = '';
        switch (key) {
            case '@MenuItemKey.PREVIEW':
                format = '@ReportFormatConstant.PDF'
                break;
            case '@MenuItemKey.EXPORT_XLS':
                format = '@ReportFormatConstant.EXCEL'
                break;
            case '@MenuItemKey.EXPORT_DATA_XLS':
                format = '@ReportFormatConstant.EXCELDATA'
                break;
        }

        $(this).getReport({
            urlAction: '@Url.Action("ReportTo", "RepoValorizaComprob")',
            parameters: reportParam,
            format: format,
        onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
        });

        return true;
    };

</script>