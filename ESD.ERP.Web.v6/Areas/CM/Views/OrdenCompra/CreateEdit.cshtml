   function productoSelectedPopup(sourceId, row) {

      if($.isEmpty(row)){
         msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("MG_producto_seleccion_requerida")');
         return false;
      }

      var esAdicional = $('#EstadoOrdenCompra').val() === '@EstadoOrdenCompraConstante.MODIFICACION' ? '@SiNoConstante.S' : '@SiNoConstante.N';

      $(this).postAction({
         viewModel: [
            { name: "OrdenCompraProductoDTO.OrdenCompraDTO.ProveedorId", value: $('#ProveedorId').val(), type: 'int' },
            { name: "OrdenCompraProductoDTO.OrdenCompraDTO.MonedaId", value: $('#MonedaId').val(), type: 'int' },
            { name: "OrdenCompraProductoDTO.ProductoId", value: row.ProductoId, type: 'int' },
            { name: "CalculadorVentaItemDTO.Cantidad", value: row.MasterPack, type: 'decimal' },
            { name: "CalculadorVentaItemDTO.TipoIgv", value: row.TipoIgv },
            { name: "CalculadorVentaItemDTO.ImpuestoTasa", value: $('#Tasa').val(), type: 'decimal'}
         ],
         urlAction: '@Url.Action("ObtenerPrecio", "OrdenCompra")',
         onSuccess: function (response) {
            if (response.success) {
               var editableRows = $('#productoGrid').appGrid('editableRowsCount');
               if (editableRows == 0) {
                  var initdata = {
                     OrdenCompraProductoId: 0,
                     ProductoId: row.ProductoId,
                     Codigo: row.Codigo,
                     ProductoNombre: row.Descripcion,
                     CodigoReferencial: row.CodigoReferencial,
                     UnidadMedidaNombre: row.UnidadMedidaNombre,
                     TipoIgv: row.TipoIgv,
                     Cantidad: row.MasterPack,
                     PrecioUnitario: response.data.PrecioUnitario,
                     ValorUnitario: response.data.ValorUnitario,
                     MontoBruto: response.data.MontoBruto,
                     MontoImpuesto: response.data.MontoImpuesto,
                     MontoTotal: response.data.MontoTotal,
                     Total: 0,
                     EsAdicional: esAdicional,
                     '@AppConstante.DTO_STATE' : '@(((int) DTOState.Added).ToString())',
                     Estado: '@EstadoConstante.ACTIVO'
                  };
                  $("#productoGrid").appGrid('addRow', initdata);
                  $("#productoMenuBar").appMenu('saveMenu');
               } else {
                  var rowId = $('#productoGrid').appGrid('getSelectedRowId');

                  $('#productoGrid').jqGrid('setCell', rowId, 'ProductoId', row.ProductoId);
                  $('#productoGrid').jqGrid('setCell', rowId, 'Codigo', row.Codigo);
                  $('#productoGrid').jqGrid('setCell', rowId, 'ProductoNombre', row.Descripcion);
                  $('#productoGrid').jqGrid('setCell', rowId, 'CodigoReferencial', row.CodigoReferencial);
                  $('#productoGrid').jqGrid('setCell', rowId, 'UnidadMedidaNombre', row.UnidadMedidaNombre);
                  $('#productoGrid').jqGrid('setCell', rowId, 'TipoIgv', row.TipoIgv);
                  $('#' + rowId + '_Cantidad').val(parseFloatEx(row.MasterPack));
                  $('#' + rowId + '_PrecioUnitario').val(response.data.PrecioUnitario);
                  $('#' + rowId + '_ValorUnitario').val(response.data.ValorUnitario);
                  $('#productoGrid').jqGrid('setCell', rowId, 'MontoBruto', response.data.MontoBruto);
                  $('#productoGrid').jqGrid('setCell', rowId, 'MontoImpuesto', response.data.MontoImpuesto);
                  $('#productoGrid').jqGrid('setCell', rowId, 'MontoTotal', response.data.MontoTotal);
               }

            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });

      $('#productoListPopup').hideDialog();
   }
   function calcularTotal(esVU, grabar) {

      var row = $('#productoGrid').appGrid('getSelectedRow');
      var rowId = $('#productoGrid').appGrid('getSelectedRowId');

      var valorPrecio = '';
      if (esVU)
         valorPrecio = 'ValorUnitario';
      else
         valorPrecio = 'PrecioUnitario';

      $(this).postAction({
         viewModel: [
            { name: "CalculadorVentaItemDTO." + valorPrecio, value: $('#' + rowId + '_' + valorPrecio).val(), type: 'decimal' },
            { name: "CalculadorVentaItemDTO.Cantidad", value: $('#' + rowId + '_Cantidad').val(), type: 'decimal' },
            { name: "CalculadorVentaItemDTO.TipoIgv", value: row.TipoIgv },
            { name: "CalculadorVentaItemDTO.ImpuestoTasa", value: $('#Tasa').val(), type: 'decimal'}
         ],
         urlAction: '@Url.Action("CalcularMontos", "OrdenCompra")',
         onSuccess: function (response) {
            if (response.success) {
               if (esVU)
                  $('#' + rowId + '_PrecioUnitario').val(response.data.PrecioUnitario);
               else
                  $('#' + rowId + '_ValorUnitario').val(response.data.ValorUnitario);

               $('#productoGrid').jqGrid('setCell', rowId, 'MontoBruto', response.data.MontoBruto);
               $('#productoGrid').jqGrid('setCell', rowId, 'MontoImpuesto', response.data.MontoImpuesto);
               $('#productoGrid').jqGrid('setCell', rowId, 'MontoTotal', response.data.MontoTotal);

               if (grabar)
                  grabarProducto(rowId);
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
