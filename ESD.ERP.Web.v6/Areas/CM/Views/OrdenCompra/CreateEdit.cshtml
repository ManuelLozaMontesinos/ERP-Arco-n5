            if (!$('#' + rowId + '_Cantidad').validateNumeric('@SR.GetString("GEN_cantidad_requerida")'))
               return false;

            $("#entregaGrid").jqGrid('saveRow', rowId, {url: 'clientArray', aftersavefunc: function (id, response, options) {
               row = $("#entregaGrid").appGrid('getSelectedRow');

               setModifiedDTO(row);
               $(this).saveView({
                  urlAction: '@Url.Action("GrabarOrdenCompraEntrega", "OrdenCompra")',
                  viewModel: [
                     { name: "OrdenCompraEntregaDTO.OrdenCompraEntregaId", value: row.OrdenCompraEntregaId, type: 'int' },
                     { name: "OrdenCompraEntregaDTO.OrdenCompraProductoId", value: $('#OrdenCompraProductoId').val(), type: 'int' },
                     { name: "OrdenCompraEntregaDTO.Cantidad", value: row.Cantidad, type: 'decimal' },
                     { name: "OrdenCompraEntregaDTO.Fecha", value: row.Fecha, type: 'date' },
                     { name: "OrdenCompraEntregaDTO.DTOState", value: row.DTOState, type: 'int' }
                  ],
                  onSuccess: function (response) {
                     if (response.success) {
                        $("#entregaGrid").appGrid('reloadJSON');
                        msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                     } else {
                        msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        $("#entregaMenuBar").appMenu('saveMenu');
                     }
                  }
               });
            }});
            break;

         case '@MenuItemKey.DELETE':

            $(this).confirm({
               title: '@SR.GetString("APPMP_anular_titulo")',
               message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
               onConfirm: function () {

                  $(this).saveView({
                     urlAction: '@Url.Action("EliminarOrdenCompraEntrega", "OrdenCompra")',
                     viewModel: [
                        { name: "OrdenCompraEntregaDTO.OrdenCompraEntregaId", value: row.OrdenCompraEntregaId, type: 'int' }
                     ],
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#entregaGrid').appGrid('reloadJSON');
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
            break;
      }
      return true;
   };
   function editarOrdenCompraEntregaInGrid() {
      var rowId = $("#entregaGrid").appGrid("getSelectedRowId");
      $('#entregaGrid').jqGrid('editRow', rowId);

      $("#entregaMenuBar").appMenu('saveMenu');
   };
   function asignarButtonOnClick() {

      $('#agregarEditPopup').showDialog();
   };
   function agregarEditPopupOnClick() {

      if (!mp_validarDatos())
         return;

      $(this).saveView({
         urlAction: '@Url.Action("AgregarTodosProductos", "OrdenCompra")',
         viewModel: [
            { name: "OrdenCompraEntregaDTO.OrdenCompraProductoDTO.OrdenCompraId", value: $('#OrdenCompraId').val(), type: 'int' },
            { name: "OrdenCompraEntregaDTO.Fecha", value: $('#mp-Fecha').val(), type: 'date' }
         ],
         onSuccess: function (response) {
            if (response.success) {
               $("#productoGrid").appGrid('reloadJSON');
               msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
               $("#productoGrid").appMenu('saveMenu');
            }
            $('#agregarEditPopup').hideDialog();
         }
      });
   };
   function codigoFormatter(cellvalue, options, row) {

      if (row.CantidadIngresada > 0) {
         return '<div class="jqgrid-cell-warning">' + cellvalue + '</div>'
      }
      if(cellvalue == null)
         return '';

      return cellvalue;
   };
   function editCustomGridMenuBar(key, gridName) {
      if (!$("#OrdenCompraId").validateNumeric()) {
         $('#' + key).appMenu('disabled');
      }
      else
         $('#' + key).appMenu('editMenu', { gridName: gridName, isEditableGrid: true });
   };
</script>