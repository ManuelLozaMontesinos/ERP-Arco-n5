@using ESD.Core;
@using ESD.Core.Web;
@using ESD.ERP.Common;
@using ESD.Core.Service.DTO;
@using ESD.Core.Web.JS;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.CM.Models.OrdenCompraViewModel
<esd-menubar id="menuBar" title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-10">
               <div class="form-group row">
                  <esd-textbox for="@Model.OrdenCompraDTO.Codigo" col-position="col-lg-2" label="Código" col-label-position="col-lg-2"
                               enable="false"></esd-textbox>
                  <esd-dropdownlist id="TipoProductoId" for="@Model.TipoProductoList" col-position="col-lg-2" label="Tipo Orden"
                                    col-label-position="col-lg-2" onchange="tipoProductoIdOnChange();" enable="@Model.IsNew"></esd-dropdownlist>
                  <esd-datetimepicker for="@Model.OrdenCompraDTO.Fecha" col-position="col-lg-2" label="Fecha" col-label-position="col-lg-2"
                                      enable="@Model.IsNew"></esd-datetimepicker>
               </div>
               <div class="form-group row">
                  <esd-buttontextbox id="Pedido" button-style="List" value="@Model.OrdenCompraDTO?.PedidoCompraDTO?.Codigo" col-position="col-lg-2" label="Pedido"
                                     col-label-position="col-lg-2" onclick="pedidoOnClick" enable="@Model.IsNew"></esd-buttontextbox>
               </div>
               <div class="form-group row">
                  <esd-buttontextbox id="Proveedor" button-style="ListNew" value="@Model.OrdenCompraDTO.ProveedorDTO.RazonSocial" col-position="col-lg-7" label="Proveedor"
                                     col-label-position="col-lg-2" onclick="proveedorOnClick"></esd-buttontextbox>
                  <esd-textbox for="@Model.OrdenCompraDTO.ProveedorDTO.NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Doc." col-label-position="col-lg-1"
                               enable="false"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="MonedaId" for="@Model.MonedaList" selected-value="@Model.OrdenCompraDTO.MonedaId" col-position="col-lg-2" label="Moneda"
                                    col-label-position="col-lg-2" onchange="monedaIdOnChange();" enable="@Model.IsNew"></esd-dropdownlist>
                  <esd-numerictextbox for="@Model.OrdenCompraDTO.TipoCambio" col-position="col-lg-1" label="T/C" col-label-position="col-lg-1" enable="false"></esd-numerictextbox>
                  <esd-dropdownlist id="ImpuestoTasaId" for="@Model.ImpuestoTasaList" selected-value="@Model.OrdenCompraDTO.ImpuestoTasaId" col-position="col-lg-2" label="T.Afectacion"
                                    col-label-position="col-lg-1" enable="@Model.IsNew" onchange="impuestoTasaIdOnChange();"></esd-dropdownlist>
                  <esd-dropdownlist id="CondicionPagoId" for="@Model.CondicionPagoList" col-position="col-lg-2" label="Cond. de Pago"
                                    col-label-position="col-lg-1"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <label class="col-lg-2 col-form-label">Fecha/Plazo Entrega</label>
                  <esd-radiobutton id="fechaRadio" group-name="entregaRadio" label="Fecha" col-position="col-lg-1" checked="true" onchange="entregaRadioOnChange()"></esd-radiobutton>
                  <esd-datetimepicker for="@Model.OrdenCompraDTO.FechaEntrega" col-position="col-lg-2"></esd-datetimepicker>
                  <esd-radiobutton id="plazoRadio" group-name="entregaRadio" label="Plazo" col-position="col-lg-1" onchange="entregaRadioOnChange()"></esd-radiobutton>
                  <esd-textbox for="@Model.OrdenCompraDTO.PlazoEntrega" col-position="col-lg-6" max-length="100" enable="false"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.OrdenCompraDTO.LugarEntrega" col-position="col-lg-8" label="Entrega en" col-label-position="col-lg-2"
                               max-length="200"></esd-textbox>
                  <esd-button id="direccionButton" content="Direcciones" button-style="Primary" size="Small" onclick="direccionButtonOnClick()"></esd-button>
               </div>
               <div class="form-group row">

               </div>
               <div class="form-group row">
                  <esd-textarea for="@Model.OrdenCompraDTO.Observacion" col-position="col-lg-10" label="Observacion" col-label-position="col-lg-2"
                                max-length="400" rows="1"></esd-textarea>
               </div>
               <div class="form-group row">
                  <label class="col-lg-10 offset-2" style="text-align: left">
                     <span class="badge badge-warning">Item con ingreso a Almacen.</span>
                  </label>
               </div>
            </div>
            <div class="col-2">
               <div class="form-group row">
                  <esd-textbox id="EstadoOrdenCompraNombre" value="@Model.OrdenCompraDTO.EstadoOrdenCompraDTO.Nombre" col-position="col-lg-6" label="Estado" col-label-position="col-lg-6"
                               enable="false"></esd-textbox>
               </div>
               <div class="form-group row">
                  <br />
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoBruto" value="@Model.OrdenCompraDTO.MontoBruto" col-position="col-lg-6" label="Mto. Neto" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoImpuesto" value="@Model.OrdenCompraDTO.MontoImpuesto" col-position="col-lg-6" label="Impuesto" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoTotal" value="@Model.OrdenCompraDTO.MontoTotal" col-position="col-lg-6" label="Total" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
            </div>
         </div>
      </div>
      <esd-viewmodelstate for="@Model.ViewModelState.Value"></esd-viewmodelstate>
      <esd-hidden for="@Model.OrdenCompraDTO.OrdenCompraId"></esd-hidden>
      <esd-hidden for="@Model.OrdenCompraDTO.PedidoCompraId"></esd-hidden>
      <esd-hidden for="@Model.OrdenCompraDTO.ProveedorId"></esd-hidden>
      <esd-hidden id="TipoProducto" value="@Model.OrdenCompraDTO.TipoProductoDTO.Codigo"></esd-hidden>
      <esd-hidden for="@Model.OrdenCompraDTO.MonedaDTO.EsLocal"></esd-hidden>
      <esd-hidden for="@Model.OrdenCompraDTO.ImpuestoTasaDTO.Tasa"></esd-hidden>
      <esd-hidden for="@Model.OrdenCompraDTO.EsModificacion"></esd-hidden>
      <esd-hidden id="EstadoAprobacion" value="@Model.OrdenCompraDTO?.EstadoAprobacionDTO?.Codigo"></esd-hidden>
      <esd-hidden id="EstadoOrdenCompra" value="@Model.OrdenCompraDTO.EstadoOrdenCompraDTO.Codigo"></esd-hidden>
   </div>
   <div>
      <ul class="nav nav-tabs" role="tablist" id="detailTab">
         <li class="nav-item">
            <a class="nav-link active" href="#productoTab" role="tab" data-toggle="tab">Productos/Servicios</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#entregaTab" role="tab" data-toggle="tab">Entregas</a>
         </li>
      </ul>
      <div class="tab-content">
         <div class="tab-pane active" id="productoTab" role="tabpanel">
            <div class="form-inline">
               <div class="col-6">
                  <esd-menubar id="productoMenuBar" size="Small" menu-style="CRUDAndSaveCancel" onclick="productoMenuBarOnClick"></esd-menubar>
               </div>
               <div class="col-6">
                  <esd-checkbox id="productoVerAnulado" col-position="offset-lg-9 col-lg-3" label="Mostrar Anulados" onchange="productoVerAnuladoOnChange()"
                                checkbox-style="Default"></esd-checkbox>
               </div>
            </div>
            <div id="productoContainer">
               <table id="productoGrid"></table>
               <div id="productoPager"></div>
            </div>
         </div>
         <div class="tab-pane" id="entregaTab" role="tabpanel">
            <nav class="navbar bg-white">
               <div class="col-12">
                  <div class="form-group row">
                     <esd-dropdownlist id="OrdenCompraProductoId" for="@Model.OrdenCompraProductoList" col-position="col-lg-6" label="Producto" col-label-position="col-lg-2"
                                       onchange="ordenCompraProductoIdOnChange()"></esd-dropdownlist>
                     <esd-button id="asignarButton" content="Asignar Todos" button-style="Info" size="Small" onclick="asignarButtonOnClick()"></esd-button>
                  </div>
               </div>
            </nav>
            <div>
               <esd-menubar id="entregaMenuBar" size="Small" menu-style="CRUDAndSaveCancel" onclick="entregaMenuBarOnClick"></esd-menubar>
            </div>
            <div id="entregaContainer">
               <table id="entregaGrid"></table>
               <div id="entregaPager"></div>
            </div>
         </div>
      </div>
   </div>
</section>
<esd-dialog id="pedidoListPopup" title="Pedidos" onclick="pedidoListPopupOnClick" size="Large">
   <div id="pedidoListPopupContent"></div>
</esd-dialog>
<esd-dialog id="proveedorListPopup" title="Proveedor" onclick="proveedorListPopupOnClick" size="Large">
   <div id="proveedorListPopupContent"></div>
</esd-dialog>
<esd-dialog id="productoListPopup" title="Producto" onclick="productoListPopupOnClick" size="Large">
   <div id="productoListPopupContent"></div>
</esd-dialog>
<esd-dialog id="proveedorCreatePopup" title="Nuevo Cliente" onclick="proveedorCreatePopupOnClick" size="Large">
   <div id="proveedorCreatePopupContent"></div>
</esd-dialog>
<esd-dialog id="almacenListPopup" title="Direcciones" onclick="almacenListPopupOnClick" size="Large">
   <div id="almacenListPopupContent"></div>
</esd-dialog>
<esd-dialog id="agregarEditPopup" title="Guardar" onclick="agregarEditPopupOnClick">
   <div id="agregarEditPopupContent"></div>
</esd-dialog>
<style type="text/css">
   .jqgrid-cell-warning {
      background: #ffc107;
      color: #212529;
      text-align: center;
      -moz-border-radius: 20px;
      -webkit-border-radius: 20px;
      border-radius: .25rem;
      border: 1px solid #4EA049;
      font-weight: bold;
   }
</style>
<script type="text/javascript">
   $(document).ready(function () {

      if ($('#EstadoAprobacion').val() === '@EstadoAprobacionConstante.PENDIENTE_APROBACION' ||
         $('#EstadoAprobacion').val() === '@EstadoAprobacionConstante.APROBADO') {
         $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.SAVE', disabled: true });
         $("#menuBar").appMenu('disabledButton', { buttonId: 'solicitar', disabled: true });
      }

      if ($('#EstadoAprobacion').val() !== '@EstadoAprobacionConstante.APROBADO') {
         $("#menuBar").appMenu('hideButton', { buttonId: 'modificar' });
      }

      if ($('#EstadoAprobacion').val() === '@EstadoAprobacionConstante.APROBADO') {
         if ($('#EstadoOrdenCompra').val() === '@EstadoOrdenCompraConstante.ORDEN_COMPRA' ||
            $('#EstadoOrdenCompra').val() === '@EstadoOrdenCompraConstante.INGRESO_PARCIAL') {
            $("#menuBar").appMenu('showButton', { buttonId: 'modificar' });
            $("#menuBar").appMenu('disabledButton', { buttonId: 'modificar', disabled: false });
         }
      }

      if (!$("#OrdenCompraId").validateNumeric()) {
         $("#menuBar").appMenu('disabledButton', { buttonId: 'solicitar', disabled: true });
         $("#menuBar").appMenu('hideButton', { buttonId: 'modificar' });
      }

      if ($.isNullOrEmpty($('#PlazoEntrega').val()))
         $("#fechaRadio").prop('checked', true);
      else
         $("#plazoRadio").prop('checked', true);
      entregaRadioOnChange();

      $("#productoGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarOrdenCompraProducto", "OrdenCompra")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "OrdenCompraProductoDTO.OrdenCompraId", value: $('#OrdenCompraId').val() || '0', type: 'int' },
                     { name: "OrdenCompraProductoDTO.Estado", value: $('#productoVerAnulado').prop('checked') ? '' : '@EstadoConstante.ACTIVO' }
                  ]
               ));
            }
         },
         colNames: ['', '', '', 'Código','Codigo Ref.', 'Producto', '', 'Detalle', 'U.M.','', 'Cantidad', '','V.U.', 'P.U.','Monto Neto','Impuesto','Total','','',''],
         colModel: [
            { name: 'OrdenCompraProductoId', hidden: true },
            { name: 'OrdenCompraId', hidden: true },
            { name: 'ProductoId', hidden: true },
            { name: 'Codigo', width: 95, formatter: codigoFormatter },
            { name: 'CodigoReferencial', width: 80 },
            { name: 'ProductoNombre', width: 300, editable: false },
            {
               name: '_selP', width: 35, align: 'center', formatter: function (cellvalue, options, rowObject) {
                  var disabled = '';
                  if (!$.isNullOrEmpty(rowObject.OrdenCompraProductoId) && rowObject.OrdenCompraProductoId !== 0)
                     disabled = ' disabled';

                  return '<button class="btn btn-xs btn-outline-secondary" title="Producto" name="productoButton"' + disabled + ' onclick="mostrarProducto(' + options.rowId + ');"><span class=\'fas fa-list\'/></button>';
               }
            },
            { name: 'Descripcion', width: 200, editable: true, edittype: 'text', editoptions: { class: 'form-control-sm', maxlength: 150 } },
            { name: 'UnidadMedidaNombre', width: 60, editable: false },
            { name: 'TipoIgv', hidden: true },
            {
               name: "Cantidad", width: 70, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 4, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularTotal(true, false);
                        }
                     });
                  }
               }
            },
            { name: 'CantidadIngresada', hidden: true },
            {
               name: "ValorUnitario", width: 80, align: 'right', formatter: 'number', editable: true, sortable: false,
               formatoptions: { decimalPlaces: 4 },
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 4, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularTotal(true,false);
                        }
                     });
                  }
               }
            },
            {
               name: "PrecioUnitario", width: 80, align: 'right', formatter: 'number', editable: true, sortable: false,
               formatoptions: { decimalPlaces: 4 },
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 4, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularTotal(false, false);
                        }
                     });
                  }
               }
            },
            { name: "MontoBruto", width: 80, align: 'right', formatter: 'number' },
            { name: "MontoImpuesto", width: 70, align: 'right', formatter: 'number' },
            { name: "MontoTotal", width: 90, align: 'right', formatter: 'number' },
            { name: 'EsAdicional', hidden: true },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#productoPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            if ($('#EstadoAprobacion').val() === '@EstadoAprobacionConstante.PENDIENTE_APROBACION' ||
               $('#EstadoAprobacion').val() === '@EstadoAprobacionConstante.APROBADO') {
               $("#productoMenuBar").appMenu('disabled');
               return;
            }

            var editableRows = $('#productoGrid').appGrid('editableRowsCount');
            if (editableRows == 0) {
               var row = $('#productoGrid').appGrid('getSelectedRow');
               if (parseFloatEx(row.CantidadIngresada) !== 0) {
                  $("#productoMenuBar").appMenu('disabled');
               } else
                  editCustomGridMenuBar('productoMenuBar', 'productoGrid');
            }
            else
               $("#productoMenuBar").appMenu('saveMenu');
         },
         gridComplete: function () {
            editCustomGridMenuBar('productoMenuBar', 'productoGrid');
            $("#productoGrid").appGrid('resizeGrid', 'productoContainer');

            calcularTotalesGenerales();

            $('#OrdenCompraProductoId').find('option').remove().end();
            $('#OrdenCompraProductoId').append(new Option('@SelectListFirstOptionNameConstant.SELECT', ''));
            var data = $("#productoGrid").appGrid('getData');
            $.each(data, function (index, item) {
               if (item.Estado === '@EstadoConstante.ACTIVO') {
                  var option = new Option(item.ProductoNombre + ' - Cantidad: ' + item.Cantidad, item.OrdenCompraProductoId);
                  $('#OrdenCompraProductoId').append(option);
               }
            });

            if ($('#EstadoAprobacion').val() === '@EstadoAprobacionConstante.PENDIENTE_APROBACION' ||
               $('#EstadoAprobacion').val() === '@EstadoAprobacionConstante.APROBADO') {
               $("#productoMenuBar").appMenu('disabled');
               return;
            }
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('productoContainer')
      });
      $("#entregaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarOrdenCompraEntrega", "OrdenCompra")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "OrdenCompraEntregaDTO.OrdenCompraProductoId", value: $('#OrdenCompraProductoId').val()||'0', type:'int' }
                  ]
               ));
            }
         },
         colNames: ['', '', 'Cantidad', 'Fecha Entrega','',''],
         colModel: [
            { name: 'OrdenCompraEntregaId', hidden: true },
            { name: 'OrdenCompraProductoId', hidden: true },
            {
               name: "Cantidad", width: 80, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 4, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularTotal(true, false);
                        }
                     });
                  }
               }
            },
            {
               name: "Fecha", width: 120, align: 'right', editable: true, sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT',
               editoptions:
               {
                  class: 'form-control-sm',
                  dataInit: function(elem) {
                     $(elem).inputmask({
                        alias: 'datetime',
                        inputFormat: '@JavaScriptConstant.DATE_FORMAT.ToLower()',
                        clearIncomplete: true
                     });
                  }
               }
            },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#entregaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            if ($('#EstadoOrdenCompra').val() === '@EstadoOrdenCompraConstante.ATENDIDA' ||
               $('#EstadoOrdenCompra').val() === '@EstadoOrdenCompraConstante.ANULADA') {
               $("#entregaMenuBar").appMenu('disabled');
               return;
            }

            var editableRows = $('#entregaGrid').appGrid('editableRowsCount');
            if (editableRows == 0) {
               editCustomGridMenuBar('entregaMenuBar', 'entregaGrid');
            }
            else
               $("#entregaMenuBar").appMenu('saveMenu');
         },
         gridComplete: function () {
            editCustomGridMenuBar('entregaMenuBar', 'entregaGrid');
            $("#entregaGrid").appGrid('resizeGrid', 'entregaContainer');

            if ($('#EstadoOrdenCompra').val() === '@EstadoOrdenCompraConstante.ATENDIDA' ||
               $('#EstadoOrdenCompra').val() === '@EstadoOrdenCompraConstante.ANULADA') {
               $("#entregaMenuBar").appMenu('disabled');
               $("#asignarButton").prop('disabled', true);
            }
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('entregaContainer')
      });

      $('#pedidoListPopup').setDialog({
         onShow: function (p) {
            var list = ['@EstadoPedidoCompraConstante.PEDIDO'];
            $(this).getView({
               urlAction: '@Url.Action("ListPopup", "PedidoCompra")',
               container: 'pedidoListPopupContent',
               viewModel: [
                  { name: 'PedidoCompraDTO.EstadoPedidoCompraList', value: list, type: 'listString' }
               ],
               showLoading: false,
               hideLoading: false
            });
         },
         onShown: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         }
      });
      $('#productoListPopup').setDialog({
         onShow: function (p) {
            $(this).getView({
               urlAction: '@Url.Action("ListPopup", "Producto", new { Area = "MG" })',
               viewModel: [
                  { name: "ProductoDTO.FamiliaProductoDTO.ClaseProductoDTO.GrupoProductoDTO.TipoProductoDTO.Codigo", value: $("#TipoProducto").val() },
               ],
               container: 'productoListPopupContent',
               showLoading: false,
               hideLoading: false
            });
         },
         onShown: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         }
      });
      $('#proveedorListPopup').setDialog({
         onShow: function (p) {
            $(this).getView({
               urlAction: '@Url.Action("ListPopup", "Proveedor", new { Area = "MG" })',
               container: 'proveedorListPopupContent',
               showLoading: false,
               hideLoading: false
            });
         },
         onShown: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         }
      });
      $('#proveedorCreatePopup').setDialog({
         onShow: function (p) {
            $(this).getView({
               urlAction: '@Url.Action("CreatePopup", "Proveedor", new { Area = "MG" })',
               viewModel: [
                  { name: "ProveedorDTO.ProveedorId", value: 0, type: 'int' }
               ],
               container: 'proveedorCreatePopupContent',
               showLoading: false,
               hideLoading: false
            });
         }
      });
      $('#almacenListPopup').setDialog({
         onShow: function (p) {

            $(this).getView({
               urlAction: '@Url.Action("ListPopup", "Almacen", new { Area = "IV" })',
               container: 'almacenListPopupContent',
               showLoading: false,
               hideLoading: false
            });
         },
         onShown: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         }
      });
      $('#agregarEditPopup').setDialog({
         onShow: function (p) {
            $(this).getView({
               urlAction: '@Url.Action("AgregarEditPopup", "OrdenCompra")',
               container: 'agregarEditPopupContent',
               showLoading: false,
               hideLoading: false
            });
         },
         onShown: function () {
            $("#mp-Fecha").val($("#FechaEntrega").val());
         }
      });

      $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
         var targetId = e.target.hash;
         switch (targetId) {
            case '#productoTab':
               $('#productoGrid').appGrid('resizeGrid', 'productoContainer');
               $('#productoGrid').jqGrid('setGridHeight', calculateGridHeight('productoContainer'));
               break;

            case '#entregaTab':
