   function validarDatos() {
      if (!$('#TipoProductoId').validateNumeric('@SR.GetString("CM_tipo_orden_seleccion_requerida")'))
         return false;
      if (!$('#Fecha').validateString('@SR.GetString("GEN_fecha_requerida")'))
         return false;
      if (!$('#MonedaId').validateNumeric('@SR.GetString("GEN_moneda_seleccion_requerida")'))
         return false;

      if ($('#EsLocal').val() !== '@SiNoConstante.S') {
         if (!$('#TipoCambio').validateNumeric('@SR.GetString("GEN_tipo_cambio_monto_requerido")'))
            return false;
      }
      if (!$('#ProveedorId').validateNumeric('@SR.GetString("MG_proveedor_seleccion_requerida")'))
         return false;
      if ($("#fechaRadio").prop('checked')) {
         if (!$('#FechaEntrega').validateString('@SR.GetString("CM_fecha_entrega_requerida")'))
            return false;
      }
      else {
         if (!$('#PlazoEntrega').validateString('@SR.GetString("CM_plazo_entrega_requerido")'))
            return false;
      }
      if (!$('#CondicionPagoId').validateNumeric('@SR.GetString("MG_condicion_pago_seleccion_requerida")'))
         return false;
      return true;
   }
