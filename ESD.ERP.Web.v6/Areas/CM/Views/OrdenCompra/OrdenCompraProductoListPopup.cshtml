@using ESD.Core.Web.JS;
<div id="bandejaPopupContainer">
   <table id="bandejaPopupGrid"></table>
   <div id="bandejaPopupPager"></div>
</div>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaPopupGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarOrdenCompraProductoPopup", "OrdenCompra")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "OrdenCompraProductoDTO.OrdenCompraId", value: $('#OrdenCompraId').val() || '0', type: 'int' }
                  ]
               ));
            }
         },
         colNames: ['', '', '', 'Código', 'Codigo Ref.','Producto', '','U.M.', 'Cantidad', 'V.U.', ''],
         colModel: [
            { name: 'OrdenCompraProductoId', hidden: true },
            { name: 'OrdenCompraId', hidden: true },
            { name: 'ProductoId', hidden: true },
            { name: 'Codigo', width: 90 },
            { name: 'CodigoReferencial', width: 80 },
            { name: 'ProductoNombre', width: 330, editable: false },
            { name: 'UnidadMedidaId', hidden: true },
            { name: 'UnidadMedidaNombre', width: 60, editable: false },
            { name: 'CantidadPendiente', width: 80, align: 'right', formatter: 'number' },
            { name: 'ValorUnitario', width: 80, align: 'right', formatter: 'number' },
            { name: 'Estado', hidden: true }
         ],
         pager: "#bandejaPopupPager",
         ondblClickRow: function (rowid) {

            var popupParams = getPopupParam('mp-edit-panel')

            var row = $(this).getRowData(rowid);
            ordenCompraProductoSelectedPopup(popupParams.dialogId, row);
         },
         gridComplete: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         },
         multiselect: true,
         height: 250
      });
   });
</script>