@using ESD.ERP.Web.Infrastructure;
<div id="mp-edit-panel">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-datetimepicker id="Fecha" col-position="col-lg-4" label="Fecha" col-label-position="col-lg-2" in-modal="true"></esd-datetimepicker>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>
<script type="text/javascript">

   function mp_validarDatos() {

      if (!$('#mp-Fecha').validateString('@SR.GetString("CM_fecha_entrega_requerida")'))
         return false;

      return true;
   }
</script>