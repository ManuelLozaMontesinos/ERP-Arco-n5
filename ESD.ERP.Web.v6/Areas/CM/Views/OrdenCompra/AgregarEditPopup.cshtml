@model ESD.ERP.Web.Areas.CM.Models.OrdenCompraViewModel
@using ESD.ERP.Web.Infrastructure;
<div id="mp-edit-panel">
   <div class="card shadow-none border-0 mb-0">
      <div class="card-body p-2">
         <div class="row align-items-center mb-2">
            <div class="col-lg-7 col-12">
               <div class="form-group row mb-0">
                  <esd-datetimepicker id="Fecha" col-position="col-lg-7" label="Fecha" col-label-position="col-lg-3" in-modal="true"></esd-datetimepicker>
               </div>
            </div>
            <div class="col-lg-5 col-12 mt-2 mt-lg-0 text-lg-right">
               <div class="input-group input-group-sm ml-auto" style="max-width: 250px;">
                  <div class="input-group-prepend">
                     <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                  </div>
                  <input type="text" id="txtFiltrarEntrega" class="form-control" placeholder="Buscar producto..." onkeyup="mp_filtrarEntregas(this.value)" />
               </div>
            </div>
         </div>
         <div class="row mt-2">
            <div class="col-12">
               <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="font-weight-bold" style="font-size: 0.88rem; color: #495057;">
                     <i class="fas fa-truck mr-1 text-primary"></i> Entregas de la Orden de Compra
                     @if (Model?.OrdenCompraEntregaDTOList != null && Model.OrdenCompraEntregaDTOList.Count > 0)
                     {
                        <span class="badge badge-info ml-2 px-2 py-1 font-weight-bold" id="spnBadgeContador" style="font-size: 0.82rem;">@(Model?.OrdenCompraEntregaDTOList?.Count ?? 0) registros</span>
                     }
                  </span>
                  <div>
                     <button type="button" class="btn btn-sm btn-outline-primary" id="btnSeleccionarTodos" onclick="mp_toggleSeleccionarTodos()">
                        <i class="fas fa-check-square mr-1"></i> Seleccionar Todos
                     </button>
                  </div>
               </div>
               <div class="table-responsive border rounded" style="max-height: 330px; overflow-y: auto;">
                  <table class="table table-sm table-striped table-hover mb-0" id="tblEntregasPopup">
                     <thead class="thead-light" style="position: sticky; top: 0; z-index: 2;">
                        <tr>
                           <th style="width: 40px; text-align: center;">
                              <input type="checkbox" id="chkTodosEntregas" onchange="mp_chkTodosOnChange(this)" title="Marcar / Desmarcar todos" />
                           </th>
                           <th style="text-align: left;">Producto</th>
                           <th style="text-align: right; width: 115px;">Cantidad</th>
                           <th style="text-align: center; width: 165px;">Fecha Entrega Actual</th>
                        </tr>
                     </thead>
                     <tbody id="tblEntregasPopupBody">
                        @if (Model?.OrdenCompraEntregaDTOList != null && Model.OrdenCompraEntregaDTOList.Count > 0)
                        {
                           foreach (var item in Model.OrdenCompraEntregaDTOList)
                           {
                              var prodDesc = item.OrdenCompraProductoDTO?.ProductoDTO?.Descripcion;
                              if (string.IsNullOrEmpty(prodDesc))
                              {
                                 prodDesc = item.OrdenCompraProductoDTO?.Descripcion ?? "-";
                              }
                              var prodCod = item.OrdenCompraProductoDTO?.ProductoDTO?.Codigo;
                              var detalle = item.OrdenCompraProductoDTO?.Descripcion;
                              var textoBusqueda = ((prodDesc ?? "") + " " + (prodCod ?? "") + " " + (detalle ?? "")).ToLower();

                              <tr class="tr-entrega-row" style="cursor: pointer;" data-busqueda="@textoBusqueda">
                                 <td class="text-center align-middle">
                                    <input type="checkbox" class="chk-entrega-item" value="@item.OrdenCompraEntregaId" onchange="mp_actualizarEstadoBotonTodos()" />
                                 </td>
                                 <td class="text-left align-middle">
                                    <div class="font-weight-bold text-dark" style="font-size: 0.86rem; line-height: 1.25;">
                                       @prodDesc
                                    </div>
                                    @if (!string.IsNullOrEmpty(prodCod))
                                    {
                                       <span class="text-muted" style="font-size: 0.78rem;">
                                          <i class="fas fa-barcode mr-1"></i>@prodCod
                                       </span>
                                    }
                                    @if (!string.IsNullOrEmpty(detalle) && detalle != prodDesc)
                                    {
                                       <span class="text-secondary d-block font-italic" style="font-size: 0.78rem;">
                                          @detalle
                                       </span>
                                    }
                                 </td>
                                 <td class="text-right align-middle font-weight-bold text-primary" style="font-size: 0.88rem;">
                                    @item.Cantidad.ToString("N2")
                                 </td>
                                 <td class="text-center align-middle">
                                    @if (item.Fecha.HasValue)
                                    {
                                       <span class="badge badge-light border px-2 py-1" style="font-size: 0.82rem;">
                                          <i class="far fa-calendar-alt mr-1 text-primary"></i>@item.Fecha.Value.ToString("dd/MM/yyyy")
                                       </span>
                                    }
                                    else
                                    {
                                       <span class="text-muted font-italic" style="font-size: 0.82rem;">- Sin fecha -</span>
                                    }
                                 </td>
                              </tr>
                           }
                        }
                        else
                        {
                           <tr id="trSinEntregas">
                              <td colspan="4" class="text-center text-muted py-4">
                                 <i class="fas fa-info-circle mr-1"></i> No se encontraron registros de entregas para esta orden de compra.
                              </td>
                           </tr>
                        }
                     </tbody>
                  </table>
               </div>
               <div class="d-flex justify-content-between align-items-center mt-2 px-1 text-muted small">
                  <span id="lblContadorFooter">
                     <i class="fas fa-list-ul mr-1 text-primary"></i> Mostrando <strong id="spnVisibles" class="text-dark">@(Model?.OrdenCompraEntregaDTOList?.Count ?? 0)</strong> de <strong id="spnTotal" class="text-dark">@(Model?.OrdenCompraEntregaDTOList?.Count ?? 0)</strong> registros
                  </span>
                  <span id="lblSeleccionadosFooter" class="badge badge-light border text-primary font-weight-bold px-2 py-1" style="font-size: 0.8rem;">
                     <i class="fas fa-check-circle mr-1"></i> <span id="spnSeleccionadosCount">0</span> seleccionados
                  </span>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>
<script type="text/javascript">
   function mp_validarDatos() {
      if (!$('#mp-Fecha').validateString('@SR.GetString("CM_fecha_entrega_requerida")'))
         return false;

      var marcados = $('.chk-entrega-item:checked');
      if (marcados.length === 0) {
         msgAlert(msgAlertTypeConstant.INFORMATION, 'Debe seleccionar al menos un registro de entrega.');
         return false;
      }

      return true;
   }

   function mp_actualizarContadores() {
      var total = $('#tblEntregasPopupBody tr.tr-entrega-row').length;
      var visibles = $('#tblEntregasPopupBody tr.tr-entrega-row:visible').length;
      var seleccionados = $('.chk-entrega-item:checked').length;

      $('#spnVisibles').text(visibles);
      $('#spnTotal').text(total);
      $('#spnSeleccionadosCount').text(seleccionados);

      var badgeTexto = (visibles === total)
         ? (total + ' registros')
         : (visibles + ' de ' + total + ' registros');
      $('#spnBadgeContador').text(badgeTexto);

      if (visibles === 0 && total > 0) {
         if ($('#trSinResultadosFiltro').length === 0) {
            $('#tblEntregasPopupBody').append('<tr id="trSinResultadosFiltro"><td colspan="4" class="text-center text-muted py-3"><i class="fas fa-search mr-1"></i> No se encontraron productos que coincidan con la búsqueda.</td></tr>');
         }
      } else {
         $('#trSinResultadosFiltro').remove();
      }
   }

   function mp_toggleSeleccionarTodos() {
      var chks = $('.chk-entrega-item:visible');
      if (chks.length === 0) return;
      var todos = (chks.filter(':checked').length === chks.length);
      chks.prop('checked', !todos);
      $('#chkTodosEntregas').prop('checked', !todos);
      mp_actualizarTextoBotonTodos(!todos);
      mp_actualizarContadores();
   }

   function mp_chkTodosOnChange(headerChk) {
      var checked = $(headerChk).prop('checked');
      $('.chk-entrega-item:visible').prop('checked', checked);
      mp_actualizarTextoBotonTodos(checked);
      mp_actualizarContadores();
   }

   function mp_actualizarEstadoBotonTodos() {
      var chks = $('.chk-entrega-item:visible');
      if (chks.length === 0) {
         $('#chkTodosEntregas').prop('checked', false);
         mp_actualizarTextoBotonTodos(false);
         mp_actualizarContadores();
         return;
      }
      var marcados = chks.filter(':checked').length;
      var todos = (marcados === chks.length);
      $('#chkTodosEntregas').prop('checked', todos);
      mp_actualizarTextoBotonTodos(todos);
      mp_actualizarContadores();
   }

   function mp_actualizarTextoBotonTodos(todosMarcados) {
      var btn = $('#btnSeleccionarTodos');
      if (todosMarcados) {
         btn.html('<i class="fas fa-times-circle mr-1"></i> Deseleccionar Todos');
         btn.removeClass('btn-outline-primary').addClass('btn-outline-secondary');
      } else {
         btn.html('<i class="fas fa-check-square mr-1"></i> Seleccionar Todos');
         btn.removeClass('btn-outline-secondary').addClass('btn-outline-primary');
      }
   }

   function mp_filtrarEntregas(texto) {
      var term = (texto || '').toLowerCase().trim();
      $('#tblEntregasPopupBody tr.tr-entrega-row').each(function () {
         var searchStr = $(this).attr('data-busqueda') || '';
         var hayMatch = (!term || searchStr.indexOf(term) !== -1);
         $(this).toggle(hayMatch);
      });
      mp_actualizarEstadoBotonTodos();
   }

   $(document).off('click', '#tblEntregasPopupBody tr.tr-entrega-row').on('click', '#tblEntregasPopupBody tr.tr-entrega-row', function (e) {
      if ($(e.target).is('input[type="checkbox"]')) {
         return;
      }
      var chk = $(this).find('.chk-entrega-item');
      if (chk.length > 0) {
         chk.prop('checked', !chk.prop('checked'));
         mp_actualizarEstadoBotonTodos();
      }
   });

   $(document).ready(function () {
      mp_actualizarContadores();
   });
</script>
