                     if (response.success) {
                        $("#listaPrecioGrid").appGrid('reloadJSON');
                        msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                     } else {
                        msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        $("#listaPrecioGrid").appMenu('saveMenu');
                     }
                  }
               });
            }});
            break;

         case '@MenuItemKey.DELETE':

            $(this).confirm({
               title: '@SR.GetString("APPMP_anular_titulo")',
               message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
               onConfirm: function () {

                  $(this).saveView({
                     urlAction: '@Url.Action("EliminarProveedorListaPrecio", "ProveCompra")',
                     viewModel: [
                        { name: "ProveedorListaPrecioDTO.ProveedorListaPrecioId", value: row.ProveedorListaPrecioId, type: 'int' }
                     ],
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#listaPrecioGrid').appGrid('reloadJSON');
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
            break;

      }
      return true;
   };
   function editarProveedorListaPrecioInGrid() {
      var rowId = $("#listaPrecioGrid").appGrid("getSelectedRowId");
      $('#listaPrecioGrid').jqGrid('editRow', rowId);
      $("#listaPrecioMenuBar").appMenu('saveMenu');
   };
   function proveedorListaPrecioIdOnChange() {

      var proveedorListaPrecioId = $("#ProveedorListaPrecioId").val();
      if ($.isNullOrEmpty(proveedorListaPrecioId)) {
         $('#Tasa').val('@decimal.Zero');
         $('#listaProductoGrid').appGrid('reloadJSON');
         return;
      }

      $(this).getAction({
         urlAction: '@Url.Action("ObtenerImpuestoTasa", "ProveCompra")',
         id: proveedorListaPrecioId,
         onSuccess: function (response) {
            if (response.success) {
               $('#Tasa').val(response.data.Tasa);
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });

      $('#listaProductoGrid').appGrid('reloadJSON');
   };
   function calcularPrecio(element, esPU) {

      var row = $('#listaProductoGrid').appGrid('getSelectedRow');

      $(this).postAction({
         viewModel: [
            { name: "CalculadorVentaItemDTO.PrecioUnitario", value: (esPU === true ? element.val() : 0), type: 'decimal' },
            { name: "CalculadorVentaItemDTO.ValorUnitario", value: (esPU === false ? element.val() : 0), type: 'decimal' },
            { name: "CalculadorVentaItemDTO.TipoIGV", value: row.TipoIgv },
            { name: "CalculadorVentaItemDTO.ImpuestoTasa", value: $('#Tasa').val(), type: 'decimal'}
         ],
         buttonId: '@MenuItemKey.SAVE',
         urlAction: '@Url.Action("CalcularPrecio", "ProveCompra")',
         onSuccess: function (response) {

            if (response.success) {
               var rowId = $('#listaProductoGrid').appGrid('getSelectedRowId');

               if (esPU)
                  $("#" + rowId + "_ValorUnitario").val(response.data.ValorUnitario);
               else
                  $("#" + rowId + "_PrecioUnitario").val(response.data.PrecioUnitario);

            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function habilitarImportarExportar() {
      if ($("#ProveedorListaPrecioId").validateNumeric()) {
         $("#listaProductoMenuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.IMPORT_XLS', disabled: false });
         $("#listaProductoMenuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.EXPORT_XLS', disabled: false });
      }
   };
   function listaProductoMenuBarOnClick(key) {

      if (!$('#ProveedorListaPrecioId').validateNumeric('@SR.GetString("CM_lista_precio_seleccion_requerida")'))
         return false;

      var row = $('#listaProductoGrid').appGrid('getSelectedRow');
      var excludeKeys = ['@MenuItemKey.NEW','@MenuItemKey.IMPORT_XLS','@MenuItemKey.EXPORT_XLS'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {
         case '@MenuItemKey.NEW':
            mostrarProveedorProducto();
            break;

         case '@MenuItemKey.EDIT':
            editarListaPrecioProductoInGrid();
            break;

         case '@MenuItemKey.CANCEL':
            $("#listaProductoGrid").appGrid('reloadJSON');
            break;

         case '@MenuItemKey.SAVE':

            var rowId = $("#listaProductoGrid").appGrid("getSelectedRowId");

            if ($.isNullOrEmpty(row.Codigo)) {
               msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("CM_producto_servicio_seleccion_requerida")');
               return false;
            }
            if (!$('#' + rowId + '_ValorUnitario').validateNumeric('@SR.GetString("VT_valor_unitario_requerido")'))
               return false;
            if (!$('#' + rowId + '_PrecioUnitario').validateNumeric('@SR.GetString("VT_precio_unitario_requerido")'))
               return false;
            if (!$('#' + rowId + '_FechaVigente').validateString('@SR.GetString("CM_lista_precio_producto_fecha_vigente_requerida")'))
               return false;

            $("#listaProductoGrid").jqGrid('saveRow', rowId, {url: 'clientArray', aftersavefunc: function (id, response, options) {
               row = $("#listaProductoGrid").appGrid('getSelectedRow');

               setModifiedDTO(row);
               $(this).saveView({
                  urlAction: '@Url.Action("GrabarProveedorListaPrecioProducto", "ProveCompra")',
                  viewModel: [
                     { name: "ProveedorListaPrecioProductoDTO.ProveedorListaPrecioProductoId", value: row.ProveedorListaPrecioProductoId, type: 'int' },
                     { name: "ProveedorListaPrecioProductoDTO.ProveedorListaPrecioId", value: row.ProveedorListaPrecioId, type: 'int' },
                     { name: "ProveedorListaPrecioProductoDTO.ProductoId", value: row.ProductoId, type: 'int' },
                     { name: "ProveedorListaPrecioProductoDTO.ValorUnitario", value: row.ValorUnitario, type: 'decimal' },
                     { name: "ProveedorListaPrecioProductoDTO.PrecioUnitario", value: row.PrecioUnitario, type: 'decimal' },
                     { name: "ProveedorListaPrecioProductoDTO.FechaVigente", value: row.FechaVigente, type: 'datetime' },
                     { name: "ProveedorListaPrecioProductoDTO.Estado", value: row.Estado === '@DigitoConstante.UNO' ? '@EstadoConstante.ACTIVO' : '@EstadoConstante.INACTIVO' },
                     { name: "ProveedorListaPrecioProductoDTO.DTOState", value: row.DTOState, type: 'int' }
                  ],
                  onSuccess: function (response) {
                     if (response.success) {
                        $("#listaProductoGrid").appGrid('reloadJSON');
                        msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                     } else {
                        msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        $("#listaProductoMenuBar").appMenu('saveMenu');
                     }
                  }
               });
            }});
            break;

         case '@MenuItemKey.DELETE':

            $(this).confirm({
               title: '@SR.GetString("APPMP_anular_titulo")',
               message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
               onConfirm: function () {

                  $(this).saveView({
                     urlAction: '@Url.Action("EliminarProveedorListaPrecioProducto", "ProveCompra")',
                     viewModel: [
                        { name: "ProveedorListaPrecioProductoDTO.ProveedorListaPrecioProductoId", value: row.ProveedorListaPrecioProductoId, type: 'int' }
                     ],
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#listaProductoGrid').appGrid('reloadJSON');
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
            break;

         case '@MenuItemKey.IMPORT_XLS':
            $('#importarEditPopup').showDialog();
            break;

         case '@MenuItemKey.EXPORT_XLS':

            var reportParam = "proveedorListaPrecioId=" + $("#ProveedorListaPrecioId").val();

            $(this).getReport({
               buttonId: key,
               urlAction: '@Url.Action("ReportToExcel", "ProveCompra")',
               parameters: reportParam,
               onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
            });
            $('#listaProductoMenuBar').appMenu('disabledButton', { buttonId: key, disabled: false });
            break;
      }
      return true;
   };
   function mostrarProveedorProducto() {
      $('#proveedorProductoListPopup').showDialog();
   };
   function proveedorProductoListPopupOnClick() {

      var row = $('#bandejaPopupGrid').appGrid('getSelectedRow');

      proveedorProductoSelectedPopup('',row);
   };
   function proveedorProductoSelectedPopup(sourceId, row) {

      if($.isEmpty(row)){
         msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("MG_producto_seleccion_requerida")');
         return false;
      }

      var editableRows = $('#listaProductoGrid').appGrid('editableRowsCount');
      if (editableRows == 0) {
         var initdata = {
            ProveedorListaPrecioProductoId: 0,
            ProveedorListaPrecioId: $('#ProveedorListaPrecioId').val(),
            ProductoId: row.ProductoId,
            Codigo: row.Codigo,
            Descripcion: row.ProductoNombre,
            TipoIgvId: row.TipoIgvId,
            TipoIgv: row.TipoIgv,
            ValorUnitarioAnterior: 0,
            PrecioUnitarioAnterior: 0,
            ValorUnitario: 0,
            PrecioUnitario: 0,
            '@AppConstante.DTO_STATE' : '@(((int) DTOState.Added).ToString())',
            Estado: '@EstadoConstante.ACTIVO'
         };
         $("#listaProductoGrid").appGrid('addRow', initdata);
         $("#listaProductoMenuBar").appMenu('saveMenu');
      } else {
         var rowId = $('#listaProductoGrid').appGrid('getSelectedRowId');

         $('#listaProductoGrid').jqGrid('setCell', rowId, 'ProductoId', row.ProductoId);
         $('#listaProductoGrid').jqGrid('setCell', rowId, 'Codigo', row.Codigo);
         $('#listaProductoGrid').jqGrid('setCell', rowId, 'Descripcion', row.ProductoNombre);
         $('#listaProductoGrid').jqGrid('setCell', rowId, 'TipoIgvId', row.TipoIgvId);
         $('#listaProductoGrid').jqGrid('setCell', rowId, 'TipoIgv', row.TipoIgv);
      }

      $('#proveedorProductoListPopup').hideDialog();
   }
   function editarListaPrecioProductoInGrid() {
      var rowId = $("#listaProductoGrid").appGrid("getSelectedRowId");
      $('#listaProductoGrid').jqGrid('editRow', rowId);
      $("#listaProductoMenuBar").appMenu('saveMenu');
   };
   function logPopupInconsistencias(data) {
      if (!$.isNullOrEmpty(data)) {
         $('#logTextArea').val('');
         $('#logTextArea').val(data);
         $('#logPopup').showDialog();
      } else
         msgAlert(msgAlertTypeConstant.SUCCESS, '@SR.GetString("GEN_proceso_concluido")');

      $("#listaProductoGrid").appGrid('reloadJSON');
   };
   function editCustomGridMenuBar(key, gridName) {
      if (!$("#ProveedorId").validateNumeric())
         $('#' + key).appMenu('disabled');
      else
         $('#' + key).appMenu('editMenu', { gridName: gridName, isEditableGrid: true });
   }
</script>