@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.Core.Service.DTO;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.CM.Models.ProveCompraViewModel
<esd-menubar id="menuBar" title="@Model.Title" menu-style="SaveExit" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-textbox for="@Model.ProveedorDTO.Codigo" col-position="col-lg-1" label="Codigo" col-label-position="col-lg-2"
                               enable="false"></esd-textbox>
                  <esd-checkbox for="@Model.ProveedorDTO.EsLocal" col-position="col-lg-1" label="Es Local" onchange="esLocalOnChange()"></esd-checkbox>
                  <esd-dropdownlist id="TipoNaturalezaJuridicaId" for="@Model.TipoNaturalezaJuridicaList" selected-value="@Model.ProveedorDTO.TipoNaturalezaJuridicaId"
                                    col-position="col-lg-2" label="Tipo de Persona" col-label-position="col-lg-2" enable="@Model.IsNew" onchange="tipoNaturalezaJuridicaIdOnChange();"></esd-dropdownlist>
                  <esd-masktextbox for="@Model.ProveedorDTO.NumeroRuc" col-position="col-lg-2" label="RUC" col-label-position="col-lg-2"
                                   mask="99999999999" onchange="numeroRucOnChange()"></esd-masktextbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.ProveedorDTO.RazonSocial" col-position="col-lg-6" label="Razon Social" col-label-position="col-lg-2"
                               max-length="150"></esd-textbox>
                  <esd-textbox for="@Model.ProveedorDTO.Abreviatura" col-position="col-lg-2" label="Nombre. Comer." col-label-position="col-lg-2"
                               max-length="50"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.ProveedorDTO.ApellidoPaterno" col-position="col-lg-2" label="Apellido Paterno" col-label-position="col-lg-2"
                               max-length="50"></esd-textbox>
                  <esd-textbox for="@Model.ProveedorDTO.ApellidoMaterno" col-position="col-lg-2" label="Apellido Materno" col-label-position="col-lg-2"
                               max-length="50"></esd-textbox>
                  <esd-textbox for="@Model.ProveedorDTO.Nombres" col-position="col-lg-2" label="Nombres" col-label-position="col-lg-2"
                               max-length="50"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoDocumentoIdentidadId" for="@Model.TipoDocumentoIdentidadList" selected-value="@Model.ProveedorDTO.TipoDocumentoIdentidadId" col-position="col-lg-2"
                                    label="Tipo Doc. Identidad" col-label-position="col-lg-2" onchange="tipoDocumentoIdentidadIdOnChange();"></esd-dropdownlist>
                  <esd-textbox for="@Model.ProveedorDTO.NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoViaId" for="@Model.TipoViaList" selected-value="@Model.ProveedorDTO.TipoViaId" col-position="col-lg-2" label="Tipo de Via"
                                    col-label-position="col-lg-2"></esd-dropdownlist>
                  <esd-textbox for="@Model.ProveedorDTO.NombreVia" col-position="col-lg-3" label="Nombre" col-label-position="col-lg-1"
                               max-length="50"></esd-textbox>
                  <esd-textbox for="@Model.ProveedorDTO.NumeroVia" col-position="col-lg-1" label="Numero" col-label-position="col-lg-1"
                               max-length="10"></esd-textbox>
                  <esd-textbox for="@Model.ProveedorDTO.Interior" col-position="col-lg-1" label="Interior" col-label-position="col-lg-1"
                               max-length="10"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.ProveedorDTO.Departamento" col-position="col-lg-1" label="#Dpto" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
                  <esd-textbox for="@Model.ProveedorDTO.Lote" col-position="col-lg-2" label="Lote" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
                  <esd-textbox for="@Model.ProveedorDTO.Manzana" col-position="col-lg-1" label="Manzana" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
                  <esd-textbox for="@Model.ProveedorDTO.Kilometro" col-position="col-lg-1" label="KM" col-label-position="col-lg-1"
                               max-length="10"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.ProveedorDTO.Block" col-position="col-lg-1" label="Block" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
                  <esd-textbox for="@Model.ProveedorDTO.Etapa" col-position="col-lg-2" label="Etapa" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
               </div>
            </div>
         </div>
      </div>
      <esd-viewmodelstate for="@Model.ViewModelState.Value"></esd-viewmodelstate>
      <esd-hidden for="@Model.ProveedorDTO.ProveedorId"></esd-hidden>
      <esd-hidden id="TipoNaturalezaJuridica" value="@Model.ProveedorDTO.TipoNaturalezaJuridicaDTO.Codigo"></esd-hidden>
      <esd-hidden for="@Model.ProveedorDTO.TipoDocumentoIdentidadDTO.FormatoValidacion"></esd-hidden>
      <esd-hidden for="@Model.MonedaString"></esd-hidden>
      <esd-hidden for="@Model.ImpuestoTasaString"></esd-hidden>
      <esd-hidden id="Tasa" value="@decimal.Zero"></esd-hidden>
   </div>
   <div>
      <ul class="nav nav-tabs" role="tablist" id="detailTab">
         <li class="nav-item">
            <a class="nav-link active" href="#complementaTab" role="tab" data-toggle="tab">Datos Complementarios</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#productoTab" role="tab" data-toggle="tab">Productos/Servicios</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#listaPrecioTab" role="tab" data-toggle="tab">Lista de Precios</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#listaProductoTab" role="tab" data-toggle="tab">Lista de Precios - Productos</a>
         </li>
      </ul>
      <div class="tab-content">
         <div class="tab-pane active" id="complementaTab" role="tabpanel">
            <div class="card">
               <div class="card-body">
                  <div class="row">
                     <div class="col-12">
                        <div class="form-group row">
                           <esd-dropdownlist id="TipoZonaId" for="@Model.TipoZonaList" selected-value="@Model.ProveedorDTO.TipoZonaId" col-position="col-lg-2" label="Tipo de Zona"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-textbox for="@Model.ProveedorDTO.NombreZona" col-position="col-lg-3" label="Nombre" col-label-position="col-lg-1"
                                        max-length="50"></esd-textbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="DepartamentoId" for="@Model.DepartamentoList" selected-value="@Model.DepartamentoId" col-position="col-lg-2" label="Departamento"
                                             col-label-position="col-lg-2" onchange="departamentoIdOnChange();"></esd-dropdownlist>
                           <esd-dropdownlist id="ProvinciaId" for="@Model.ProvinciaList" selected-value="@Model.ProvinciaId" col-position="col-lg-3" label="Provincia"
                                             col-label-position="col-lg-1" onchange="provinciaIdOnChange();"></esd-dropdownlist>
                           <esd-dropdownlist id="DistritoId" for="@Model.DistritoList" selected-value="@Model.ProveedorDTO.DistritoId" col-position="col-lg-3" label="Distrito"
                                             col-label-position="col-lg-1"></esd-dropdownlist>
                        </div>
                        <div class="form-group row">
                           <esd-textbox for="@Model.ProveedorDTO.Contacto" col-position="col-lg-4" label="Contacto" col-label-position="col-lg-2"
                                        max-length="150"></esd-textbox>
                           <esd-textbox for="@Model.ProveedorDTO.Telefono" col-position="col-lg-2" label="#Telefono" col-label-position="col-lg-2"
                                        max-length="15"></esd-textbox>
                        </div>
                        <div class="form-group row">
                           <esd-textbox for="@Model.ProveedorDTO.Email" col-position="col-lg-4" label="Correo Electronico" col-label-position="col-lg-2"
                                        max-length="60"></esd-textbox>
                           <esd-textbox for="@Model.ProveedorDTO.Web" col-position="col-lg-4" label="Web" col-label-position="col-lg-2"
                                        max-length="60"></esd-textbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="CondicionPagoId" for="@Model.CondicionPagoList" selected-value="@Model.ProveedorDTO.CondicionPagoId" col-position="col-lg-2" label="Condición de Pago"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                        </div>
                     </div>
                  </div>
               </div>
            </div>

         </div>
         <div id="productoTab" class="tab-pane" role="tabpanel">
            <nav class="navbar bg-white">
               <div class="col-12">
                  <div class="form-group row">
                     <esd-textbox id="Descripcion" col-position="col-lg-6" label="Producto" col-label-position="col-lg-2" max-length="150"></esd-textbox>
                  </div>
               </div>
            </nav>
            <div>
               <esd-menubar id="productoMenuBar" size="Small" menu-style="CRUDAndSaveCancel" onclick="productoMenuBarOnClick"></esd-menubar>
            </div>
            <div id="productoContainer">
               <table id="productoGrid"></table>
               <div id="productoPager"></div>
            </div>
         </div>
         <div id="listaPrecioTab" class="tab-pane" role="tabpanel">
            <div>
               <esd-menubar id="listaPrecioMenuBar" size="Small" menu-style="CRUDAndSaveCancel" onclick="listaPrecioMenuBarOnClick"></esd-menubar>
            </div>
            <div id="listaPrecioContainer">
               <table id="listaPrecioGrid"></table>
               <div id="listaPrecioPager"></div>
            </div>
         </div>
         <div id="listaProductoTab" class="tab-pane" role="tabpanel">
            <nav class="navbar bg-white">
               <div class="col-12">
                  <div class="form-group row">
                     <esd-dropdownlist id="ProveedorListaPrecioId" for="@Model.ProveedorListaPrecioList" col-position="col-lg-4" label="Lista de Precio" col-label-position="col-lg-2"
                                       onchange="proveedorListaPrecioIdOnChange()"></esd-dropdownlist>
                  </div>
                  <div class="form-group row">
                     <esd-textbox id="Descripcion2" col-position="col-lg-6" label="Producto" col-label-position="col-lg-2" max-length="150"></esd-textbox>
                  </div>
               </div>
            </nav>
            <div>
               <esd-menubar id="listaProductoMenuBar" size="Small" for="@Model.MenuItemList" onclick="listaProductoMenuBarOnClick"></esd-menubar>
            </div>
            <div id="listaProductoContainer">
               <table id="listaProductoGrid"></table>
               <div id="listaProductoPager"></div>
            </div>
         </div>
      </div>
   </div>
</section>
<esd-dialog id="productoListPopup" title="Producto" onclick="productoListPopupOnClick" size="Large">
   <div id="productoListPopupContent"></div>
</esd-dialog>
<esd-dialog id="saveEditPopup" title="Guardar" onclick="saveEditPopupOnClick">
   <div id="saveEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="importarEditPopup" title="Importar desde XLS" size="Default">
   <div id="importarEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="logPopup" title="Inconsistencias" size="Large">
   <div id="logPopupContent">
      <div class="card-body">
         <div class="row">
            <div class="col-lg-12">
               <div class="callout callout-warning">
                  <h6>El archivo procesado presenta las siguientes inconsistencias</h6>
               </div>
            </div>
         </div>
      </div>
      <esd-textarea id="logTextArea" enable="false" rows="15" use-textcase="false"></esd-textarea>
   </div>
</esd-dialog>
<esd-dialog id="proveedorProductoListPopup" title="Producto" onclick="proveedorProductoListPopupOnClick" size="Large">
   <div id="proveedorProductoListPopupContent"></div>
</esd-dialog>
<script type="text/javascript">

   $(document).ready(function () {
      habilitarImportarExportar();
      habilitarPorNaturaleza();

      $("#productoGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarProveedorProducto", "ProveCompra")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "ProveedorProductoDTO.ProveedorId", value: $('#ProveedorId').val() || '0', type: 'int' },
                     { name: "ProveedorProductoDTO.ProductoDTO.Descripcion", value: $('#Descripcion').val() }
                  ]
               ));
            }
         },
         colNames: ['', '', '', 'Código', 'Producto', '','U.M.', 'Cod.Refen.','Peso Bruto', 'Peso Neto', 'Master Pack','Volumen','',''],
         colModel: [
            { name: 'ProveedorProductoId', hidden: true },
            { name: 'ProveedorId', hidden: true },
            { name: 'ProductoId', hidden: true },
            { name: 'Codigo', width: 80, editable: false },
            { name: 'ProductoNombre', width: 350, editable: false },
            {
               name: '_selP', width: 35, align: 'center', formatter: function (cellvalue, options, rowObject) {
                  var disabled = '';
                  if (!$.isNullOrEmpty(rowObject.ProveedorProductoId) && rowObject.ProveedorProductoId !== 0)
                     disabled = ' disabled';

                  return '<button class="btn btn-xs btn-outline-secondary" title="Producto" name="productoButton"' + disabled + ' onclick="mostrarProducto(' + options.rowId + ');"><span class=\'fas fa-list\'/></button>';
               }
            },
            { name: 'UnidadMedidaNombre', width: 70, editable: false },
            { name: 'CodigoReferencial', width: 150, editable: true, edittype: 'text', editoptions: { class: 'form-control-sm', maxlength: 20 } },
            {
               name: "PesoBruto", width: 90, align: 'right', formatter: 'number', editable: true, sortable: false,
               formatoptions: { decimalPlaces: 4 },
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 4, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                        }
                     });
                  }
               }
            },
            {
               name: "PesoNeto", width: 90, align: 'right', formatter: 'number', editable: true, sortable: false,
               formatoptions: { decimalPlaces: 4 },
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 4, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                        }
                     });
                  }
               }
            },
            {
               name: "MasterPack", width: 80, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('integer', { allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                        }
                     });
                  }
               }
            },
            {
               name: "Volumen", width: 90, align: 'right', formatter: 'number', editable: true, sortable: false,
               formatoptions: { decimalPlaces: 4 },
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 4, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                        }
                     });
                  }
               }
            },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#productoPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            var editableRows = $('#productoGrid').appGrid('editableRowsCount');
            if (editableRows == 0) {
               editCustomGridMenuBar('productoMenuBar', 'productoGrid');
            }
            else
               $("#productoMenuBar").appMenu('saveMenu');
         },
         gridComplete: function () {
            editCustomGridMenuBar('productoMenuBar', 'productoGrid');
            $("#productoGrid").appGrid('resizeGrid', 'productoContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('productoContainer')
      });
      $("#listaPrecioGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarProveedorListaPrecio", "ProveCompra")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "ProveedorListaPrecioDTO.ProveedorId", value: $('#ProveedorId').val() || '0', type: 'int' }
                  ]
               ));
            }
         },
         colNames: ['', '', 'Moneda','', 'Tipo de Afectación', '',''],
         colModel: [
            { name: 'ProveedorListaPrecioId', hidden: true },
            { name: 'ProveedorId', hidden: true },
            {
               name: 'MonedaId', width: 200, editable: true, edittype: 'select', formatter: 'select', sortable: false,
               editoptions: {
                  class: 'form-control-sm',
                  value: $('#MonedaString').val()
               },
               editrules: { required: false }
            },
            { name: 'MonedaNombre', hidden: true },
            {
               name: 'ImpuestoTasaId', width: 200, editable: true, edittype: 'select', formatter: 'select', sortable: false,
               editoptions: {
                  class: 'form-control-sm',
                  value: $('#ImpuestoTasaString').val()
               },
               editrules: { required: false }
            },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#listaPrecioPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            var editableRows = $('#listaPrecioGrid').appGrid('editableRowsCount');
            if (editableRows == 0) {
               editCustomGridMenuBar('listaPrecioMenuBar', 'listaPrecioGrid');
            }
            else
               $("#listaPrecioMenuBar").appMenu('saveMenu');
         },
         gridComplete: function () {
            editCustomGridMenuBar('listaPrecioMenuBar', 'listaPrecioGrid');
            $("#listaPrecioGrid").appGrid('resizeGrid', 'listaPrecioContainer');

            $('#ProveedorListaPrecioId').find('option').remove().end();
            $('#ProveedorListaPrecioId').append(new Option('@SelectListFirstOptionNameConstant.SELECT', ''));
            var data = $("#listaPrecioGrid").appGrid('getData');
            $.each(data, function (index, item) {
               if (item.Estado === '@EstadoConstante.ACTIVO') {
                  var option = new Option(item.MonedaNombre, item.ProveedorListaPrecioId);
                  $('#ProveedorListaPrecioId').append(option);
               }
            });

         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('listaPrecioContainer')
      });
      $("#listaProductoGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarProveedorListaPrecioProducto", "ProveCompra")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "ProveedorListaPrecioProductoDTO.ProveedorListaPrecioId", value: $('#ProveedorListaPrecioId').val() || '0', type: 'int' },
                     { name: "ProveedorListaPrecioProductoDTO.ProductoDTO.Descripcion", value: $('#Descripcion2').val() }
                  ]
               ));
            }
         },
         colNames: ['', '', '', 'Código', 'Producto', '', '', 'P.U.', 'V.U. Ant', 'P.U. Ant', 'Fecha Ant.', 'V.U.', 'P.U.','Fecha Vig.','',''],
         colModel: [
            { name: 'ProveedorListaPrecioProductoId', hidden: true },
            { name: 'ProveedorListaPrecioId', hidden: true },
            { name: 'ProductoId', hidden: true },
            { name: 'Codigo', width: 100, editable: false },
            { name: 'Descripcion', width: 350, editable: false },
            {
               name: '_selP', width: 35, align: 'center', formatter: function (cellvalue, options, rowObject) {
                  var disabled = '';
                  if (!$.isNullOrEmpty(rowObject.ProveedorListaPrecioProductoId) && rowObject.ProveedorListaPrecioProductoId !== 0)
                     disabled = ' disabled';

                  return '<button class="btn btn-xs btn-outline-secondary" title="Producto" name="productoButton"' + disabled + ' onclick="mostrarProveedorProducto(' + options.rowId + ');"><span class=\'fas fa-list\'/></button>';
               }
            },
            { name: 'TipoIgvId', hidden: true },
            { name: 'TipoIgv', hidden: true },
            { name: "ValorUnitarioAnterior", width: 100, align: 'right', formatter: 'number', editable: false, sortable: false, formatoptions: { decimalPlaces: 4 } },
            { name: "PrecioUnitarioAnterior", width: 100, align: 'right', formatter: 'number', editable: false, sortable: false, formatoptions: { decimalPlaces: 4 } },
            { name: "FechaAnterior", width: 80, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            {
               name: "ValorUnitario", width: 100, align: 'right', formatter: 'number', editable: true, sortable: false,
               formatoptions: { decimalPlaces: 4 },
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 4, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularPrecio($(elem), false);
                        }
                     });
                  }
               }
            },
            {
               name: "PrecioUnitario", width: 100, align: 'right', formatter: 'number', editable: true, sortable: false,
               formatoptions: { decimalPlaces: 4 },
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 4, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularPrecio($(elem), true);
                        }
                     });
                  }
               }
            },
            {
               name: "FechaVigente", width: 90, align: 'right', editable: true, sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT',
               editoptions:
               {
                  class: 'form-control-sm',
                  dataInit: function(elem) {
                     $(elem).inputmask({
                        alias: 'datetime',
                        inputFormat: '@JavaScriptConstant.DATE_FORMAT.ToLower()',
                        clearIncomplete: true
                     });
                  }
               }
            },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#listaProductoPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            var editableRows = $('#listaProductoGrid').appGrid('editableRowsCount');
