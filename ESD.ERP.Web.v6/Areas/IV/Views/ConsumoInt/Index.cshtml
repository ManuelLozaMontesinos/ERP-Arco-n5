@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.IV.Models.ConsumoIntViewModel
<esd-menubar id="menuBar" Title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-dropdownlist id="AlmacenId" for="@Model.AlmacenList" col-position="col-lg-2" label="Almacen" col-label-position="col-lg-2"></esd-dropdownlist>
                  <esd-textbox id="Codigo" col-position="col-lg-2" label="#Operacion" col-label-position="col-lg-2" max-length="100"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Solicitante" col-label-position="col-lg-2" max-length="150"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="CentroCostoId" for="@Model.CentroCostoList" col-position="col-lg-2" label="Centro de Costo" col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker for="@Model.MovimientoAlmacenDTO.FechaDesde" col-position="col-lg-2" label="Desde" col-label-position="col-lg-2"></esd-datetimepicker>
                  <esd-datetimepicker for="@Model.MovimientoAlmacenDTO.FechaHasta" col-position="col-lg-2" label="Hasta" col-label-position="col-lg-2"></esd-datetimepicker>
                        <esd-checkbox id="productoVerAnulado" col-position="offset-lg-2 col-lg-2" label="Mostrar Anulados" onchange="productoVerAnuladoOnChange()"
                                      checkbox-style="Default"></esd-checkbox>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
      <esd-hidden for="@Model.FileId"></esd-hidden>
      <esd-hidden id="ServidorImpresion" value=""></esd-hidden>
      <esd-hidden id="DataUrl" value=""></esd-hidden>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<esd-dialog id="impresionPopup" title="Imprimir" onclick="impresionPopupClickOk" size="Large">
   <div id="impresionPopupContent">
      <textarea class="form-control" id="printTextArea" readonly="readonly" cols="144" rows="25"></textarea>
   </div>
</esd-dialog>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         sortname: 'Fecha',
         sortorder: 'desc',
         url: "@Url.Action("ListarBandeja", "ConsumoInt")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "MovimientoAlmacenDTO.AlmacenId", value: $('#AlmacenId').val() || 0, type: 'int' },
                     { name: "MovimientoAlmacenDTO.Codigo", value: $('#Codigo').val() },
                     { name: "MovimientoAlmacenDTO.PersonalDTO.ProveedorDTO.RazonSocial", value: $('#RazonSocial').val() },
                     { name: "MovimientoAlmacenDTO.CentroCostoId", value: $('#CentroCostoId').val() || 0, type: 'int' },
                     { name: "MovimientoAlmacenDTO.FechaDesde", value: $('#FechaDesde').val(), type: 'date' },
                     { name: "MovimientoAlmacenDTO.FechaHasta", value: $('#FechaHasta').val(), type: 'date' },
                     { name: "MovimientoAlmacenDTO.Estado", value: $('#productoVerAnulado').prop('checked') ? '' : '@EstadoConstante.ACTIVO' }
                  ]
               ));
            }
         },
         colNames: ['', '#Oper.', 'Fecha', 'Almacen', 'Solicitante', 'Centro de Costo', 'Autorizado Por', 'Fec. Auto.','','Estado Aprob.','Estado',''],
         colModel: [
            { name: 'MovimientoAlmacenId', hidden: true },
            { name: "Codigo", width: 80 },
            { name: "Fecha", width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: "AlmacenNombre", width: 150 },
            { name: "PersonalNombre", width: 250 },
            { name: "CentroCostoNombre", width: 140 },
            { name: "PersonalAutoriza", width: 250 },
            { name: "FechaAutoriza", width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: "EstadoAprobacion", hidden: true },
            { name: "EstadoAprobacionNombre", width: 150 },
            { name: "EstadoMovimientoAlmacenNombre", width: 150 },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            var row = $('#bandejaGrid').appGrid('getSelectedRow');
            if (row.Estado === '@EstadoConstante.ACTIVO') {
               $("#menuBar").appMenu('disabledButton', { buttonId: 'imprimir_fmt', disabled: false });
            }
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $('#AlmacenId').val('');
      $('#CentroCostoId').val('');
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#AlmacenId,#Codigo,#RazonSocial,#CentroCostoId").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
      $("#FechaDesde").keydown(function (e) {
         if (event.which == 13) {
            $("#FechaHasta").val($("#FechaDesde").val());
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
      $("#FechaHasta").keydown(function (e) {
         if (event.which == 13) {
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
   });
   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW','@MenuItemKey.EXIT'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {

         case '@MenuItemKey.NEW':
            $(this).getView({
               editAction: '@ViewModelEditAction.New',
               buttonId: key,
               viewModel: [
                  { name: "MovimientoAlmacenDTO.MovimientoAlmacenId", value: 0, type: 'int' }
               ],
               urlAction: '@Url.Action("Crear", "ConsumoInt")'
            });
            break;

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "MovimientoAlmacenDTO.MovimientoAlmacenId", value: row.MovimientoAlmacenId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "ConsumoInt")'
            });
            break;

         case '@MenuItemKey.DELETE':
            $('#menuBar').appMenu('disabledButton', { buttonId: key, disabled: true });
            $(this).confirm({
               title: '@SR.GetString("APPMP_anular_titulo")',
               message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
               onConfirm: function () {

                  $(this).saveView({
                     urlAction: '@Url.Action("Eliminar", "ConsumoInt")',
                     viewModel: [
                        { name: "MovimientoAlmacenDTO.MovimientoAlmacenId", value: row.MovimientoAlmacenId, type: 'int' }
                     ],
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#bandejaGrid').appGrid('reloadJSON');
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
            break;

         case 'imprimir_fmt':
            $(this).getAction({
               urlAction: '@Url.Action("ObtenerServicioImpresion", "ConsumoInt")',
               id: row.MovimientoAlmacenId,
               onSuccess: function (response) {
                  if (response.success) {
                     $('#ServidorImpresion').val(response.data.ServidorImpresion);
                     $('#DataUrl').val(response.data.DataUrl);

                     generarFormato(key, '@DataFormatoImpresionConstante.CONSUMO_INTERNO', row.MovimientoAlmacenId);
                  } else {
                     msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                  }
               }
            });
            break;
      }
      return true;
   };
   function generarFormato(buttonId, key, id){

      var basePrintUrl = $('#ServidorImpresion').val();
      var dataUrl = $('#DataUrl').val();

      if($.isNullOrEmpty(basePrintUrl)){
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("AJX_servicio_impresion_no_configurado")');
         return;
      }

      $("#menuBar").appMenu('disabledButton', { buttonId: buttonId, disabled: true });

      $("#FileId").val('');
      try{
         $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: basePrintUrl + 'PrintDocument?key=' + key + '&id=' + id + '&dataUrl=' + dataUrl,
            processData: false,
            dataType: "jsonp",
            jsonp: 'callback',
            jsonpCallback: 'jsonpCallback',
            beforeSend: function () {
               $('#impresionPopup').showDialog();
               $('#impresionPopupContent').showLoadingOverlay();
            },
            success: function (data) {
               $('#impresionPopupContent').hideLoadingOverlay();

               if(data === null)
               {
                  $('#impresionPopup').hideDialog();
                  msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_reporte_sin_datos")');
                  return;
               }

               $('#printTextArea').val(data[1]);
               $("#FileId").val(data[0]);
               $("#menuBar").appMenu('disabledButton', { buttonId: buttonId, disabled: false });
            },
            error: function (jqXHR, textStatus, errorThrown) {
               $('#impresionPopup').hideDialog();
               $('#impresionPopupContent').hideLoadingOverlay();
               $("#menuBar").appMenu('disabledButton', { buttonId: buttonId, disabled: false });

               switch(jqXHR.status){
                  case 404:
                     msgAlert(msgAlertTypeConstant.ERROR, '@SR.GetString("AJX_servicio_impresion_no_activo")');
                     break;
                  default:
                     msgAlert(msgAlertTypeConstant.ERROR, textStatus);
                     break;
               }
            }
         });
      } catch(exception){
         $('#impresionPopup').hideDialog();
         $('#impresionPopupContent').hideLoadingOverlay();
         $("#menuBar").appMenu('disabledButton', { buttonId: buttonId, disabled: false });
      }
   };
    function productoVerAnuladoOnChange() {
        $("#bandejaGrid").appGrid('reloadJSON');
    };
   function impresionPopupClickOk(){

      $('#impresionPopup').modal('hide');

      var basePrintUrl = $('#ServidorImpresion').val();
      if($.isNullOrEmpty(basePrintUrl)){
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("AJX_servicio_impresion_no_configurado")');
         return;
      }
      var id = $("#FileId").val();

      try{
         $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: basePrintUrl + 'PrintFile?id=' + id,
            processData: false,
            dataType: "jsonp",
            jsonp: 'callback',
            jsonpCallback: 'jsonpCallback',
            success: function (data) {
            },
            error: function (jqXHR, textStatus, errorThrown) {
               msgAlert(msgAlertTypeConstant.ERROR, errorThrown);
            }
         });
      } catch(exception){
         throw exception;
      }
   };
</script>