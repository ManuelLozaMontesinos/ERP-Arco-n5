@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.IV.Models.VolumenExistenViewModel
<esd-menubar id="menuBar" Title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-dropdownlist id="EmpresaSedeId" for="@Model.EmpresaSedeList" col-position="col-lg-2" label="Sede" col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div>
      <ul class="nav nav-tabs" role="tablist" id="detailTab">
         <li class="nav-item">
            <a class="nav-link active" href="#productoTab" role="tab" data-toggle="tab">Productos</a>
         </li>
      </ul>
      <div class="tab-content">
         <div class="tab-pane active" id="productoTab" role="tabpanel">
            <nav class="navbar bg-white">
               <div class="col-12">
                  <div class="form-group row">
                     <esd-textbox id="Descripcion" col-position="col-lg-6" label="Descripción" col-label-position="col-lg-2" max-length="150"></esd-textbox>
                  </div>
               </div>
            </nav>
            <div>
               <esd-menubar id="productoMenuBar" size="Small" menu-style="EditAndSaveCancel" onclick="productoMenuBarOnClick"></esd-menubar>
            </div>
            <div id="bandejaContainer">
               <table id="bandejaGrid"></table>
               <div id="bandejaPager"></div>
            </div>
         </div>
      </div>
   </div>
</section>
<esd-dialog id="importarEditPopup" title="Importar desde XLS" size="Default">
   <div id="importarEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="logPopup" title="Inconsistencias" size="Large">
   <div id="logPopupContent">
      <div class="card-body">
         <div class="row">
            <div class="col-lg-12">
               <div class="callout callout-warning">
                  <h6>El archivo procesado presenta las siguientes inconsistencias</h6>
               </div>
            </div>
         </div>
      </div>
      <esd-textarea id="logTextArea" enable="false" rows="15" use-textcase="false"></esd-textarea>
   </div>
</esd-dialog>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "VolumenExisten")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "AlmacenVolumenProductoDTO.EmpresaSedeId", value: $('#EmpresaSedeId').val() || 0, type: 'int' },
                     { name: "AlmacenVolumenProductoDTO.ProductoDTO.Descripcion", value: $('#Descripcion').val()}
                  ]
               ));
            }
         },
         colNames: ['', 'Codigo','', 'Producto', 'U.M.', 'Stock Min.', '', ''],
         colModel: [
            { name: 'AlmacenVolumenProductoId', hidden: true },
            { name: 'ProductoId', hidden: true },
            { name: "Producto", width: 100 },
            { name: "Descripcion", width: 350 },
            { name: "UnidadMedida", width: 100 },
            {
               name: "StockMinimo", width: 100, align: 'right', formatter: 'number', sorttype: 'number', editable: true,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 2, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                        }
                     });
                  }
               }
            },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            var editableRows = $('#bandejaGrid').appGrid('editableRowsCount');
            if (editableRows == 0) {
               editCustomGridMenuBar('productoMenuBar', 'bandejaGrid');
            }
            else
               $("#productoMenuBar").appMenu('saveMenu');
         },
         gridComplete: function () {
            editCustomGridMenuBar('productoMenuBar', 'bandejaGrid');
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });

      $('#importarEditPopup').setDialog({
         onShow: function (p) {
            $(this).getView({
               urlAction: '@Url.Action("ImportarEditPopup", "VolumenExisten")',
               container: 'importarEditPopupContent',
               showLoading: false,
               hideLoading: false,
               onSuccess: function () {

               }
            });
         }
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $('#EmpresaSedeId').val('');
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#EmpresaSedeId,#Descripcion").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
   });
   function menuBarOnClick(key) {

      if (!$('#EmpresaSedeId').validateNumeric('@SR.GetString("AS_empresa_sede_seleccion_requerida")'))
         return false;

      switch (key) {

         case '@MenuItemKey.IMPORT_XLS':
            $('#importarEditPopup').showDialog();
            break;

         case '@MenuItemKey.EXPORT_XLS':

            var reportParam = "empresaSedeId=" + $("#EmpresaSedeId").val();

            $(this).getReport({
               buttonId: key,
               urlAction: '@Url.Action("ReportToExcel", "VolumenExisten")',
               parameters: reportParam,
               onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
            });
            $('#menuBar').appMenu('disabledButton', { buttonId: key, disabled: false });
            break;
      }

      return true;
   };
   function productoMenuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');
      if ($.isEmpty(row)) {
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
         return;
      }

      switch (key) {
         case '@MenuItemKey.EDIT':
            editarProductoInGrid();
            break;

         case '@MenuItemKey.CANCEL':
            $("#bandejaGrid").appGrid('reloadJSON');
            break;

         case '@MenuItemKey.SAVE':

            var rowId = $("#bandejaGrid").appGrid("getSelectedRowId");

            $("#bandejaGrid").jqGrid('saveRow', rowId, {url: 'clientArray', aftersavefunc: function (id, response, options) {
               row = $("#bandejaGrid").appGrid('getSelectedRow');

               setModifiedDTO(row);
               $(this).saveView({
                  urlAction: '@Url.Action("GrabarAlmacenVolumenProducto", "VolumenExisten")',
                  viewModel: [
                     { name: "AlmacenVolumenProductoDTO.AlmacenVolumenProductoId", value: row.AlmacenVolumenProductoId, type: 'int' },
                     { name: "AlmacenVolumenProductoDTO.EmpresaSedeId", value: $('#EmpresaSedeId').val(), type: 'int' },
                     { name: "AlmacenVolumenProductoDTO.ProductoId", value: row.ProductoId, type: 'int' },
                     { name: "AlmacenVolumenProductoDTO.StockMinimo", value: row.StockMinimo, type: 'decimal' },
                     { name: "AlmacenVolumenProductoDTO.DTOState", value: row.DTOState, type: 'int' }
                  ],
                  onSuccess: function (response) {
                     if (response.success) {
                        $("#bandejaGrid").appGrid('reloadJSON');
                        msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                     } else {
                        msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        $("#productoMenuBar").appMenu('saveMenu');
                     }
                  }
               });
            }});
            break;
      }
      return true;
   };
   function editarProductoInGrid() {
      var rowId = $("#bandejaGrid").appGrid("getSelectedRowId");
      $('#bandejaGrid').jqGrid('editRow', rowId);
      $("#productoMenuBar").appMenu('saveMenu');
   };
   function editCustomGridMenuBar(key, gridName) {
      if (!$("#EmpresaSedeId").validateNumeric())
         $('#' + key).appMenu('disabled');
      else
         $('#' + key).appMenu('editMenu', { gridName: gridName, isEditableGrid: true });
   }
</script>