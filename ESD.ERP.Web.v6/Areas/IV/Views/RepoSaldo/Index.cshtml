@using ESD.Core;
@using ESD.Core.Web;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.IV.Models.ReporteGenViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="PreviewExport" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card">
      <div class="card">
         <div class="card-body">
            <div class="row">
               <div id="app-search-input-group" class="col-12">
                  <div class="form-group row">
                     <esd-radiobutton id="ReporteGeneral" group-name="tipoReporte" label="Consolidado General" col-position="offset-lg-2 col-lg-4"
                                      onchange="tipoReporteOnChange()"></esd-radiobutton>
                  </div>
                  <div class="form-group row">
                     <esd-radiobutton id="ReporteAlmacen" group-name="tipoReporte" label="Consolidado por Almacen" col-position="offset-lg-2 col-lg-3"
                                      onchange="tipoReporteOnChange()"></esd-radiobutton>
                     <esd-checkbox id="IncluirReserva" col-position="col-lg-2" label="Incluir Reserva" enable="false"></esd-checkbox>
                  </div>
                  <div class="form-group row">
                     <esd-radiobutton id="ReporteDetalle" group-name="tipoReporte" label="Detallado" col-position="offset-lg-2 col-lg-1" checked="true"
                                      onchange="tipoReporteOnChange()"></esd-radiobutton>
                     <esd-dropdownlist id="AlmacenId" for="@Model.AlmacenList" col-position="col-lg-3" label="Almacen" col-label-position="col-lg-2"></esd-dropdownlist>
                  </div>
               </div>
            </div>
         </div>
      </div>
      <div class="card">
         <div class="card-body">
            <div class="row">
               <div id="app-search-input-group" class="col-12">
                  <div class="form-group row">

                  </div>
                  <div class="form-group row">
                     <esd-radiobutton id="PorMes" group-name="tipoPeriodicidad" label="Mes" col-position="offset-lg-2 col-lg-1" checked="true"
                                      onchange="tipoPeriodicidadOnChange()"></esd-radiobutton>
                     <esd-dropdownlist id="MesId" for="@Model.MesList" col-position="col-lg-2"></esd-dropdownlist>
                  </div>
                  <div class="form-group row">
                     <esd-radiobutton id="PorDia" group-name="tipoPeriodicidad" label="Al Día" col-position="offset-lg-2 col-lg-1"
                                      onchange="tipoPeriodicidadOnChange()"></esd-radiobutton>
                     <esd-datetimepicker id="Fecha" col-position="col-lg-2" enable="false"></esd-datetimepicker>
                  </div>
                  <div class="form-group row">
                     <esd-buttontextbox id="Producto" button-style="List" col-position="col-lg-6" label="Producto" col-label-position="col-lg-2"
                                        onclick="mostrarProducto"></esd-buttontextbox>
                  </div>
               </div>
            </div>
         </div>
      </div>
      <esd-hidden id="ProductoId" value=""></esd-hidden>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<esd-dialog id="productoListPopup" title="Productos" onclick="productoListPopupOnClick" size="Large">
   <div id="productoListPopupContent"></div>
</esd-dialog>
<script type="text/javascript">
   $(document).ready(function () {
      $('#productoListPopup').setDialog({
         onShow: function (p) {
            $(this).getView({
               urlAction: '@Url.Action("ListPopup", "Producto", new { Area = "MG" })',
               viewModel: [
                  { name: "ProductoDTO.FamiliaProductoDTO.ClaseProductoDTO.GrupoProductoDTO.TipoProductoDTO.Codigo", value: '@TipoProductoConstante.PRODUCTO' },
               ],
               container: 'productoListPopupContent',
               showLoading: false,
               hideLoading: false
            });
         },
         onShown: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         }
      });
   });
   function tipoReporteOnChange() {

      if ($('#ReporteGeneral').prop('checked')) {
         $('#AlmacenId').val('');
         $('#AlmacenId').prop('disabled', true);
         $('#PorMes').prop('checked', true);
         $('#PorDia').prop('disabled', true);
         $('#IncluirReserva').prop('checked', false);
         $('#IncluirReserva').prop('disabled', true);
      };
      if ($('#ReporteAlmacen').prop('checked')) {
         $('#AlmacenId').val('');
         $('#AlmacenId').prop('disabled', true);
         $('#PorMes').prop('checked', true);
         $('#PorDia').prop('disabled', true);
         $('#IncluirReserva').prop('checked', true);
         $('#IncluirReserva').prop('disabled', false);
      };

      if ($('#ReporteDetalle').prop('checked')) {
         $('#AlmacenId').val('');
         $('#AlmacenId').prop('disabled', false);
         $('#PorMes').prop('checked', true);
         $('#PorDia').prop('disabled', false);
         $('#IncluirReserva').prop('checked', false);
         $('#IncluirReserva').prop('disabled', true);
      };
      tipoPeriodicidadOnChange();
   };
   function tipoPeriodicidadOnChange() {

      if ($('#PorMes').prop('checked')) {
         $('#MesId').prop('disabled', false);
         $('#Fecha').prop('readonly', true);
         $('#Fecha').val('');
      };

      if ($('#PorDia').prop('checked')) {
         $('#Fecha').prop('readonly', false);
         $('#MesId').prop('disabled', true);
         $('#MesId').val('');
      };
   };
   function mostrarProducto() {
      $('#productoListPopup').showDialog();
   };
   function productoListPopupOnClick() {

      var row = $('#bandejaPopupGrid').appGrid('getSelectedRow');

      productoSelectedPopup('',row);
   };
   function productoSelectedPopup(sourceId, row) {

      if($.isEmpty(row)){
         msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("MG_producto_seleccion_requerida")');
         return false;
      }

      $('#ProductoId').val(row.ProductoId);
      $('#Producto').val(row.Descripcion);

      $('#productoListPopup').hideDialog();
   }
   function obtenerTipoReporte(){
      var tipoReporte;

      tipoReporte = '@DigitoConstante.TRES';
      if ($("#ReporteGeneral").is(':checked')) {
         tipoReporte = '@DigitoConstante.UNO';
      }
      if ($("#ReporteAlmacen").is(':checked')){
         tipoReporte = '@DigitoConstante.DOS';
      }

      return tipoReporte;
   }
   function menuBarOnClick(key) {

      if ($('#ReporteDetalle').prop('checked')) {
         if (!$('#AlmacenId').validateNumeric('@SR.GetString("IV_almacen_seleccion_requerida")'))
            return false;
      };

      if ($('#PorMes').prop('checked')) {
         if (!$('#MesId').validateNumeric('@SR.GetString("GEN_mes_seleccion_requerida")'))
            return false;
      };

      if ($('#PorDia').prop('checked')) {
         if (!$('#Fecha').validateString('@SR.GetString("GEN_fecha_requerida")'))
            return false;
      }
      debugger;
      var reportParam = "tipoReporte=" + obtenerTipoReporte()
         + "&almacenId=" + $('#AlmacenId').val()
         + "&mesId=" + $('#MesId').val()
         + "&fecha=" + $('#Fecha').val()
         + "&productoId=" + $('#ProductoId').val()
         + "&incluirReserva=" + ($('#IncluirReserva').prop('checked') ? '@SiNoConstante.S' : '@SiNoConstante.N');
      
      var format = '';
      switch (key) {

         case '@MenuItemKey.PREVIEW':
            format = '@ReportFormatConstant.PDF'
            break;
         case '@MenuItemKey.EXPORT_XLS':
            format = '@ReportFormatConstant.EXCEL'
            break;
         case '@MenuItemKey.EXPORT_DATA_XLS':
            format = '@ReportFormatConstant.EXCELDATA'
            break;
      }

      $(this).getReport({
         urlAction: '@Url.Action("ReportTo", "RepoSaldo")',
         parameters: reportParam,
         format: format,
         onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
      });

      return true;
   };
</script>