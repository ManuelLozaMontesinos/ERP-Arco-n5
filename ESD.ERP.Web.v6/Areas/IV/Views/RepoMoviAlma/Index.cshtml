@using ESD.Core;
@using ESD.Core.Web;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.IV.Models.ReporteGenViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="PreviewExport" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card">
      <div class="card">
         <div class="card-body">
            <div class="row">
               <div id="app-search-input-group" class="col-12">
                  <div class="form-group row">
                     <esd-dropdownlist id="AlmacenId" for="@Model.AlmacenList" col-position="col-lg-6" label="Almacen" col-label-position="col-lg-2"></esd-dropdownlist>
                  </div>
                <div class="form-group row">
                  <esd-dropdownlist id="TransaccionAlmacenId" for="@Model.TransaccionAlmacenList" col-position="col-lg-6" label="Transaccion" col-label-position="col-lg-2"></esd-dropdownlist>
                </div>
               </div>
            </div>
         </div>
      </div>
      <div class="card">
         <div class="card-body">
            <div class="row">
               <div id="app-search-input-group" class="col-12">
                  <div class="form-group row">
                      <esd-radiobutton id="PorMes" group-name="seleccionRadio" label="Mes" col-position="offset-lg-2 col-lg-1" checked="true"
                                       onchange="seleccionRadioOnChange()" ></esd-radiobutton>
                      <esd-dropdownlist id="MesId" for="@Model.MesList" col-position="col-lg-2"></esd-dropdownlist>
                  </div>
                  <div class="form-group row">
                      <esd-radiobutton id="PorDia" group-name="seleccionRadio" label="Dia" col-position="offset-lg-2 col-lg-1"
                                       onchange="seleccionRadioOnChange()" ></esd-radiobutton>
                      <esd-datetimepicker id="Fecha" col-position="col-lg-2" enable="false"></esd-datetimepicker>
                  </div>
                  <div class="form-group row">
                      <esd-buttontextbox id="Proveedor" button-style="List" col-position="col-lg-6" label="Proveedor" col-label-position="col-lg-2"
                                         onclick="mostrarProveedor"></esd-buttontextbox>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
          <esd-hidden id="ProveedorId" value=""></esd-hidden>
   </div>
  
</section>
<esd-dialog id="proveedorListPopup" title="Productos" onclick="proveedorListPopupOnClick" size="Large">
   <div id="proveedorListPopupContent"></div>
</esd-dialog>

<script type="text/javascript">
   $(document).ready(function () {

      $('#proveedorListPopup').setDialog({
         onShow: function (p) {
            $(this).getView({
               urlAction: '@Url.Action("ListPopup", "Proveedor", new { Area = "MG" })',
               container: 'proveedorListPopupContent',
               showLoading: false,
               hideLoading: false
            });
         },
         onShown: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         }
      });
   });
   function seleccionRadioOnChange() {

      if ($('#PorMes').prop('checked')) {
         $('#MesId').prop('disabled', false);
         $('#Fecha').prop('readonly', true);
         $('#Fecha').val('');
      };

      if ($('#PorDia').prop('checked')) {
         $('#Fecha').prop('readonly', false);
         $('#MesId').prop('disabled', true);
         $('#MesId').val('');
      };
   };
   function seleccionTipoTransOnChange(){
       if ($('#GrupoTrans').prop('checked')) {
          $('#GrupoTransaccionAlmacenId').prop('disabled', false);
          $('#TransaccionAlmacenId').prop('disabled', true);
          $('#TransaccionAlmacenId').val('');
       };

        if ($('#TipoTrans').prop('checked')) {
          $('#TransaccionAlmacenId').prop('disabled', false);
          $('#GrupoTransaccionAlmacenId').prop('disabled', true);
          $('#GrupoTransaccionAlmacenId').val('');
       };
   };
   function mostrarProveedor() {
      $('#proveedorListPopup').showDialog();
   };
   function proveedorListPopupOnClick() {

      var row = $('#bandejaPopupGrid').appGrid('getSelectedRow');

      proveedorSelectedPopup('',row);
   };
   function proveedorSelectedPopup(sourceId, row) {

      if($.isEmpty(row)){
         msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("MG_proveedor_seleccion_requerida")');
         return false;
      }

      $('#ProveedorId').val(row.ProveedorId);
      $('#Proveedor').val(row.RazonSocial);

      $('#proveedorListPopup').hideDialog();
   }
   function menuBarOnClick(key) {

      if (!$('#AlmacenId').validateNumeric('@SR.GetString("IV_almacen_seleccion_requerida")'))
         return false;

      if (!$('#TransaccionAlmacenId').validateNumeric('@SR.GetString("IV_transaccion_seleccion_requerida")'))
         return false;

      if ($('#PorMes').prop('checked')) {
         if (!$('#MesId').validateNumeric('@SR.GetString("GEN_mes_seleccion_requerida")'))
            return false;
      };

      if ($('#PorDia').prop('checked')) {
         if (!$('#Fecha').validateString('@SR.GetString("GEN_fecha_requerida")'))
            return false;
      }

      var reportParam = "almacenId=" + $('#AlmacenId').val()
         + "&transaccionAlmacenId=" + $('#TransaccionAlmacenId').val()
         + "&mesId=" + $('#MesId').val()
         + "&fecha=" + $('#Fecha').val()
         + "&proveedorId=" + $('#ProveedorId').val();

      var format = '';
      switch (key) {

         case '@MenuItemKey.PREVIEW':
            format = '@ReportFormatConstant.PDF'
            break;
         case '@MenuItemKey.EXPORT_XLS':
            format = '@ReportFormatConstant.EXCEL'
            break;
         case '@MenuItemKey.EXPORT_DATA_XLS':
            format = '@ReportFormatConstant.EXCELDATA'
            break;
      }

      $(this).getReport({
         urlAction: '@Url.Action("ReportTo", "RepoMoviAlma")',
         parameters: reportParam,
         format: format,
         onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
      });

      return true;
   };
</script>