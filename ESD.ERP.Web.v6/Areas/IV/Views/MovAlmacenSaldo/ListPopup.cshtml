@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@model ESD.ERP.Web.Areas.IV.Models.MovAlmacenViewSaldoModel
<div id="mp-edit-panel">
   <div class="card-body">
      <div class="row">
         <div id="app-search-input-group" class="col-11">
            <div class="form-group row">
               <esd-textbox id="Codigo" col-position="col-lg-2" label="Código" col-label-position="col-lg-2" max-length="12" in-modal="true"></esd-textbox>
            </div>
            <div class="form-group row">
               <esd-textbox id="Descripcion" col-position="col-lg-10" label="Descripcion" col-label-position="col-lg-2" max-length="100" in-modal="true"></esd-textbox>
            </div>
            <div class="form-group row">
               <esd-textbox id="CodigoReferencial" col-position="col-lg-2" label="Cód. Referencial" col-label-position="col-lg-2" max-length="20" in-modal="true"></esd-textbox>
            </div>
         </div>
         <div class="col-1">
            <div class="form-group row">
               <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="mp_clearButtonOnClick()"></esd-button>
            </div>
         </div>
      </div>
   </div>
</div>
<div id="bandejaPopupContainer">
   <table id="bandejaPopupGrid"></table>
   <div id="bandejaPopupPager"></div>
</div>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaPopupGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "MovAlmacenSaldo")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "MovimientoAlmacenSaldoDTO.AlmacenId", value: @Model.MovimientoAlmacenSaldoDTO.AlmacenId, type: 'int' },
                     { name: "MovimientoAlmacenSaldoDTO.MesContableId", value: @Model.MovimientoAlmacenSaldoDTO.MesContableId, type: 'int' },
                     { name: "MovimientoAlmacenSaldoDTO.ProductoDTO.Codigo", value: $('#mp-Codigo').val() },
                     { name: "MovimientoAlmacenSaldoDTO.ProductoDTO.Descripcion", value: $('#mp-Descripcion').val() },
                     { name: "MovimientoAlmacenSaldoDTO.ProductoDTO.CodigoReferencial", value: $('#mp-CodigoReferencial').val() }
                  ]
               ));
            }
         },
         colNames: ['', '','Codigo', 'Descripción', 'Cod. Ref.','U.M.', 'Saldo'],
         colModel: [
            { name: 'MovimientoAlmacenId', hidden: true },
            { name: 'ProductoId', hidden: true },
            { name: "Codigo", width: 90 },
            { name: "Descripcion", width: 350 },
            { name: "CodigoReferencial", width: 100 },
            { name: "UnidadMedidaNombre", width: 120 },
            { name: "Saldo", width: 100, align:'right', formatter:'number' }
         ],
         pager: "#bandejaPopupPager",
         ondblClickRow: function (rowid) {

            var popupParams = getPopupParam('mp-edit-panel')

            var row = $(this).getRowData(rowid);
            saldoSelectedPopup(popupParams.dialogId, row);
         },
         gridComplete: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: 250
      });
   });
   function mp_clearButtonOnClick() {
      $('#mp-edit-panel').find('input:text').val('');
      $('#bandejaPopupGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#mp-Codigo,#mp-Descripcion,#mp-CodigoReferencial").change(function () {
         $('#bandejaPopupGrid').appGrid('reloadJSON');
      });
   });
</script>