@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.IV.Models.TransfeModificaViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="Edit" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-dropdownlist id="AlmacenId" for="@Model.AlmacenList" col-position="col-lg-2" label="Almacen" col-label-position="col-lg-2"></esd-dropdownlist>
                  <esd-textbox id="Codigo" col-position="col-lg-2" label="#Operacion" col-label-position="col-lg-2" max-length="100"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-masktextbox id="NumeroRuc" col-position="col-lg-2" label="R.U.C." col-label-position="col-lg-2" mask="99999999999"></esd-masktextbox>
                  <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Razon Social" col-label-position="col-lg-2" max-length="150"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox id="NumeroGuiaRemision" col-position="col-lg-2" label="#G/R" col-label-position="col-lg-2" max-length="20"></esd-textbox>
                  <esd-textbox id="NumeroDocumentoAdicional" col-position="col-lg-2" label="#Doc. Adicional" col-label-position="col-lg-2" max-length="30"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker for="@Model.MovimientoAlmacenDTO.FechaDesde" col-position="col-lg-2" label="Desde" col-label-position="col-lg-2"></esd-datetimepicker>
                  <esd-datetimepicker for="@Model.MovimientoAlmacenDTO.FechaHasta" col-position="col-lg-2" label="Hasta" col-label-position="col-lg-2"></esd-datetimepicker>
                  <esd-checkbox id="guiaRemisionEnModificacion" col-position="offset-lg-2 col-lg-2" label="G/R en Modificación" checkbox-style="Enhanced"></esd-checkbox>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "TransfeModifica")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "MovimientoAlmacenDTO.AlmacenId", value: $('#AlmacenId').val() || 0, type: 'int' },
                     { name: "MovimientoAlmacenDTO.Codigo", value: $('#Codigo').val() },
                     { name: "MovimientoAlmacenDTO.ProveedorDTO.NumeroRuc", value: $('#NumeroRuc').val() },
                     { name: "MovimientoAlmacenDTO.ProveedorDTO.RazonSocial", value: $('#RazonSocial').val() },
                     { name: "MovimientoAlmacenDTO.NumeroGuiaRemision", value: $('#NumeroGuiaRemision').val() },
                     { name: "MovimientoAlmacenDTO.FechaDesde", value: $('#FechaDesde').val(), type: 'date' },
                     { name: "MovimientoAlmacenDTO.FechaHasta", value: $('#FechaHasta').val(), type: 'date' },
                     { name: "MovimientoAlmacenDTO.GuiaRemisionEnModificacion", value: $('#guiaRemisionEnModificacion').prop('checked') ? '@SiNoConstante.S' : '@SiNoConstante.N' }
                  ]
               ));
            }
         },
         colNames: ['', '#Oper.', 'Fecha', 'Origen', 'Destino','Tipo', '#G/R', 'En Modifica.','Cliente/Proveedor','Estado',''],
         colModel: [
            { name: 'MovimientoAlmacenId', hidden: true },
            { name: "Codigo", width: 80 },
            { name: "Fecha", width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: "AlmacenNombre", width: 200 },
            { name: "AlmacenDestinoNombre", width: 200 },
            { name: "TipoMovimientoAlmacen", width: 60 },
            { name: "NumeroGuiaRemision", width: 100 },
            { name: 'GuiaRemisionEnModificacion', width: 80 },
            { name: "RazonSocial", width: 250 },
            { name: "EstadoMovimientoAlmacenNombre", width: 200 },
            { name: 'Estado', hidden: true }
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });

            var row = $('#bandejaGrid').appGrid('getSelectedRow');
            if (row.GuiaRemisionEnModificacion === '@SiNoConstante.N')
               $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.EDIT', disabled: true });

         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $('#AlmacenId').val('');
      $('#guiaRemisionEnModificacion').prop('checked', false);
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#AlmacenId,#Codigo,#NumeroRuc,#RazonSocial,#NumeroGuiaRemision,#NumeroDocumentoAdicional,#guiaRemisionEnModificacion").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
      $("#FechaDesde").keydown(function (e) {
         if (event.which == 13) {
            $("#FechaHasta").val($("#FechaDesde").val());
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
      $("#FechaHasta").keydown(function (e) {
         if (event.which == 13) {
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
   });
   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW','@MenuItemKey.EXIT'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "MovimientoAlmacenDTO.MovimientoAlmacenId", value: row.MovimientoAlmacenId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "TransfeModifica")'
            });
            break;
      }
      return true;
   };
</script>