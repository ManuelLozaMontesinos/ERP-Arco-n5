@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.IV.Models.ReclasItemAutoViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="Edit" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-dropdownlist id="AlmacenId" for="@Model.AlmacenList" col-position="col-lg-2" label="Almacen" col-label-position="col-lg-2"></esd-dropdownlist>
                  <esd-textbox id="Codigo" col-position="col-lg-2" label="#Codigo" col-label-position="col-lg-2" max-length="7"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker for="@Model.MovimientoReclasificacionDTO.FechaDesde" col-position="col-lg-2" label="Desde" col-label-position="col-lg-2"></esd-datetimepicker>
                  <esd-datetimepicker for="@Model.MovimientoReclasificacionDTO.FechaHasta" col-position="col-lg-2" label="Hasta" col-label-position="col-lg-2"></esd-datetimepicker>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         sortname: 'Fecha',
         sortorder: 'desc',
         url: "@Url.Action("ListarBandeja", "ReclasItemAuto")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [ 
                     { name: "MovimientoReclasificacionDTO.MovimientoAlmacenDTO.AlmacenId", value: $('#AlmacenId').val() || 0, type: 'int' },
                     { name: "MovimientoReclasificacionDTO.Codigo", value: $('#Codigo').val() },
                     { name: "MovimientoReclasificacionDTO.FechaDesde", value: $('#FechaDesde').val(), type: 'date' },
                     { name: "MovimientoReclasificacionDTO.FechaHasta", value: $('#FechaHasta').val(), type: 'date' },
                     { name: "MovimientoReclasificacionDTO.EstadoMovimientoReclasificacionDTO.Codigo", value: '@EstadoMovimientoReclasificacionConstante.PENDIENTE' }
                  ]
               ));
            }
         },
         colNames: ['', '#Codigo', 'Fecha', '','#Oper.','Transaccion', 'Tipo', 'Almacen', '#Doc. Referencial','Cliente','','Estado',''],
         colModel: [
            { name: 'MovimientoReclasificacionId', hidden: true },
            { name: 'Codigo', width: 60 },
            { name: 'Fecha', width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: 'MovimientoAlmacenId', hidden: true },
            { name: 'MovimientoAlmacen', width: 80 },
            { name: "TransaccionAlmacenNombre", width: 200 },
            { name: "TipoMovimientoAlmacen", width: 40 },
            { name: "AlmacenNombre", width: 200 },
            { name: "DocumentoSerieNumeroReferencial", width: 120 },
            { name: "RazonSocial", width: 350 },
            { name: 'EstadoMovimientoReclasificacion', hidden: true },
            { name: 'EstadoMovimientoReclasificacionNombre', width: 150 },
            { name: 'Estado', hidden: true }
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $('#AlmacenId').val('');
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#AlmacenId,#Codigo,#RazonSocial,#CentroCostoId").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
      $("#FechaDesde").keydown(function (e) {
         if (event.which == 13) {
            $("#FechaHasta").val($("#FechaDesde").val());
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
      $("#FechaHasta").keydown(function (e) {
         if (event.which == 13) {
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
   });
   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW','@MenuItemKey.EXIT'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "MovimientoReclasificacionDTO.MovimientoReclasificacionId", value: row.MovimientoReclasificacionId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "ReclasItemAuto")'
            });
            break;

      }
      return true;
   };
</script>