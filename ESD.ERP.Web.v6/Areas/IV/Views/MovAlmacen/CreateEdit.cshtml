         $('#productoGrid').jqGrid('setCell', rowId, 'ProductoNombre', row.Descripcion);
         $('#productoGrid').jqGrid('setCell', rowId, 'UnidadMedidaNombre', row.UnidadMedidaNombre);
      }

      $('#saldoListPopup').hideDialog();
   }
   function editarProductoInGrid() {
      var rowId = $("#productoGrid").appGrid("getSelectedRowId");
      $('#productoGrid').jqGrid('editRow', rowId);

      if ($('#TransaccionAlmacen').val() === '@TransaccionAlmacenConstante.TRANSFERENCIA_ENTRE_ALMACENES') {
         $('#' + rowId + '_Cantidad').prop('readonly', true);
         $('#' + rowId + '_ValorUnitario').prop('readonly', true);
      }

      $("#productoMenuBar").appMenu('saveMenu');
   };
   function verificarSoloLectura() {
      if ($('#TieneMantenimiento').val() === '@SiNoConstante.N') {
         $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.SAVE', disabled: true });
         $('#productoMenuBar').appMenu('disabled');
      }

      if ($('#RegRestringido').val() === '@SiNoConstante.S'){
         $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.SAVE', disabled: true });
         $('#productoMenuBar').appMenu('disabled');
      }
   };
   function ordenCompraProductoListPopupOnClick() {
      var list = $('#bandejaPopupGrid').appGrid('getSelectedRowIdList');

      if (list.length === 0) {
         msgAlert(msgAlertTypeConstant.SUCCESS, '@SR.GetString("IV_orden_compra_producto_multiple_seleccion_requerida")');
         return false;
      }

      var selectedList = [];
      for (i in list) {
         var row = $('#bandejaPopupGrid').appGrid('getRow', list[i]);
         selectedList.push(row.OrdenCompraProductoId);
      }

      grabarOrdenCompraProducto(selectedList);
   };
   function productoVerAnuladoOnChange() {
       $("#productoGrid").appGrid('reloadJSON');
   };
   function ordenCompraProductoSelectedPopup(sourceId, row) {

      if ($.isEmpty(row)) {
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("IV_orden_compra_producto_multiple_seleccion_requerida")');
         return false;
      }

      var selectedList = [];
      selectedList.push(row.OrdenCompraProductoId);

      grabarOrdenCompraProducto(selectedList);
   };
   function grabarOrdenCompraProducto(list) {

      $(this).saveView({
         urlAction: '@Url.Action("AgregarOrdenCompraProducto", "MovAlmacen")',
         viewModel: [
            { name: "MovimientoAlmacenProductoDTO.MovimientoAlmacenId", value: $('#MovimientoAlmacenId').val(), type: 'int' },
            { name: "MovimientoAlmacenProductoDTO.MovimientoAlmacenDTO.Fecha", value: $('#Fecha').val(), type: 'date' },
            { name: "MovimientoAlmacenProductoDTO.MovimientoAlmacenDTO.OrdenCompraId", value: $('#OrdenCompraId').val(), type: 'int' },
            { name: "MovimientoAlmacenProductoDTO.OrdenCompraProductoIdList", value: list, type: 'listInt' }
         ],
         onSuccess: function (response) {
            if (response.success) {
               $('#ordenCompraProductoListPopup').hideDialog();
               $("#productoGrid").appGrid('reloadJSON');
               msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
               $("#productoMenuBar").appMenu('saveMenu');
            }
         }
      });
   };
   function editCustomGridMenuBar(key, gridName) {
      if (!$("#MovimientoAlmacenId").validateNumeric())
         $('#' + key).appMenu('disabled');
      else
         $('#' + key).appMenu('editMenu', { gridName: gridName, isEditableGrid: true });
   }
</script>