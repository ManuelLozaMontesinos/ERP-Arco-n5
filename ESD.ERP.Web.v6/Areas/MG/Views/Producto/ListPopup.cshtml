@using ESD.Core;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@model ESD.ERP.Web.Areas.MG.Models.ProductoViewModel
<div id="mp-edit-panel">
    <div class="card-body">
        <div class="row">
            <div id="app-search-input-group" class="col-11">
                <div class="form-group row">
                    <esd-dropdownlist id="TipoProductoId" for="@Model.TipoProductoList" col-position="col-lg-4" label="Tipo de Producto" col-label-position="col-lg-2"
                                      in-modal="true" onchange="mp_tipoProductoIdOnChange()"></esd-dropdownlist>
                </div>
                <div class="form-group row">
                    <esd-dropdownlist id="GrupoProductoId" for="@Model.GrupoProductoList" col-position="col-lg-4" label="Grupo" col-label-position="col-lg-2"
                                      in-modal="true" onchange="mp_grupoProductoIdOnChange()"></esd-dropdownlist>
                </div>
                <div class="form-group row">
                    <esd-dropdownlist id="ClaseProductoId" for="@Model.ClaseProductoList" col-position="col-lg-4" label="Clase" col-label-position="col-lg-2"
                                      in-modal="true" enable="false" onchange="mp_claseProductoIdOnChange()"></esd-dropdownlist>
                </div>
                <div class="form-group row">
                    <esd-dropdownlist id="FamiliaProductoId" for="@Model.FamiliaProductoList" col-position="col-lg-4" label="Familia" col-label-position="col-lg-2"
                                      in-modal="true" enable="false"></esd-dropdownlist>
                </div>
                <div class="form-group row">
                    <esd-textbox id="Codigo" col-position="col-lg-2" label="Codigo" col-label-position="col-lg-2" max-length="12" in-modal="true"></esd-textbox>
                    <esd-textbox id="Codref" col-position="col-lg-4" label="Cod-Ref" max-length="12" in-modal="true"></esd-textbox>
                </div>
                <div class="form-group row">
                    <esd-textbox id="Descripcion" col-position="col-lg-10" label="Descripcion" col-label-position="col-lg-2" max-length="100" in-modal="true"></esd-textbox>
                </div>
            </div>
            <div class="col-1">
                <div class="form-group row">
                    <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="mp_clearButtonOnClick()"></esd-button>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="bandejaPopupContainer">
    <table id="bandejaPopupGrid"></table>
    <div id="bandejaPopupPager"></div>
</div>
<script type="text/javascript">
    $(document).ready(function () {

        if (!$.isNullOrEmpty($('#mp-TipoProductoId').val())) {
            $('#mp-TipoProductoId').prop('disabled', true);
            mp_tipoProductoIdOnChange();
        }

        if (!$.isNullOrEmpty($('#mp-GrupoProductoId').val())) {
            $('#mp-GrupoProductoId').prop('disabled', true);
            mp_grupoProductoIdOnChange();
        }

        $("#bandejaPopupGrid").jqGrid({
    @GridHelper.DefaultProperties()
            url: "@Url.Action("ListarBandeja", "Producto")",
            postData: {
            jsonModel: function () {
                return JSON.stringify(modelToObject(
                    [
                        { name: "ProductoDTO.FamiliaProductoDTO.ClaseProductoDTO.GrupoProductoDTO.TipoProductoDTO.TipoProductoId", value: $('#mp-TipoProductoId').val() || 0, type: 'int' },
                        { name: "ProductoDTO.FamiliaProductoDTO.ClaseProductoDTO.GrupoProductoDTO.TipoProductoId", value: $('#mp-TipoProductoId').val() || 0, type: 'int' },
                        { name: "ProductoDTO.FamiliaProductoDTO.ClaseProductoDTO.GrupoProductoDTO.EsCombo", value: '@Model.ProductoDTO.FamiliaProductoDTO.ClaseProductoDTO.GrupoProductoDTO.EsCombo' },
                        { name: "ProductoDTO.FamiliaProductoDTO.ClaseProductoDTO.GrupoProductoDTO.GrupoProductoId", value: $('#mp-GrupoProductoId').val() || 0, type: 'int' },
                        { name: "ProductoDTO.FamiliaProductoDTO.ClaseProductoDTO.GrupoProductoId", value: $('#mp-GrupoProductoId').val() || 0, type: 'int' },
                        { name: "ProductoDTO.FamiliaProductoDTO.ClaseProductoId", value: $('#mp-ClaseProductoId').val() || 0, type: 'int' },
                        { name: "ProductoDTO.FamiliaProductoId", value: $('#mp-FamiliaProductoId').val() || 0, type: 'int' },
                        { name: "ProductoDTO.Codigo", value: $('#mp-Codigo').val() },
                        { name: "ProductoDTO.CodigoReferencial", value: $('#mp-Codref').val() },
                        { name: "ProductoDTO.Descripcion", value: $('#mp-Descripcion').val() },
                        { name: "ProductoDTO.EsOperacion", value: '@SiNoConstante.N' }
                    ]
                ));
            }
        },
            colNames: ['', 'Codigo', 'Descripción', 'Cod.Ref.', '', '', 'U.M.', 'Familia', '', '', '', 'Estado', 'Estado Comercial', 'Fecha Baja', ''],
            colModel: [
            { name: 'ProductoId', hidden: true },
            { name: "Codigo", width: 90 },
            { name: "Descripcion", width: 350 },
            { name: 'CodigoReferencial', width: 90 },
            { name: 'TipoIgvId', hidden: true },
            { name: 'TipoIgv', hidden: true },
            { name: "UnidadMedidaNombre", width: 80 },
            { name: "FamiliaNombre", width: 230 },
            { name: 'EsCombo', hidden: true },
            { name: 'PesoNeto', hidden: true },
            { name: 'MasterPack', hidden: true },
            { name: "EstadoProducto", width: 100 },
            { name: "EatadoComercialProducto", width: 150 },
            { name: "FechaBaja", width: 80, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: 'Estado', hidden: true },
        ],
            pager: "#bandejaPopupPager",
            ondblClickRow: function (rowid) {

                var popupParams = getPopupParam('mp-edit-panel')

                var row = $(this).getRowData(rowid);
                productoSelectedPopup(popupParams.dialogId, row);
            },
            gridComplete: function () {
                $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
            },
    @GridHelper.RowDeletedStyle("Estado", EstadoConstante.INACTIVO)
            height: 250
          });
       });
    function mp_clearButtonOnClick() {
        $('#mp-edit-panel').find('input:text').val('');
        $("#mp-TipoProductoId").val('');
        $("#mp-GrupoProductoId").val('');
        $('#bandejaPopupGrid').appGrid('reloadJSON');
    }
    $(function () {
        $("#mp-Codigo,#mp-Codref,#mp-Descripcion,#mp-FamiliaProductoId").change(function () {
            $('#bandejaPopupGrid').appGrid('reloadJSON');
        });
    });
    function mp_tipoProductoIdOnChange() {

        var tipoProductoId = $("#mp-TipoProductoId").val();
        if ($.isNullOrEmpty(tipoProductoId)) {
            $("#mp-GrupoProductoId").prop('disabled', true);
            $("#mp-ClaseProductoId").prop('disabled', true);
            $("#mp-FamiliaProductoId").prop('disabled', true);

            $("#mp-GrupoProductoId").val('');
            $("#mp-ClaseProductoId").val('');
            $("#mp-FamiliaProductoId").val('');
            $('#bandejaPopupGrid').appGrid('reloadJSON');
            return;
        }

        $("#mp-GrupoProductoId").val('');
        $("#mp-ClaseProductoId").val('');
        $("#mp-FamiliaProductoId").val('');
        $("#mp-GrupoProductoId").prop('disabled', true);
        $("#mp-ClaseProductoId").prop('disabled', true);
        $("#mp-FamiliaProductoId").prop('disabled', true);

        $(this).getAction({
            urlAction: '@Url.Action("ListarGrupoProducto", "Producto")',
            id: tipoProductoId,
            onSuccess: function (response) {
                if (response.success) {

                    $('#mp-GrupoProductoId').find('option').remove().end();
                    $("#mp-GrupoProductoId").addItems(response.data);
                    $("#mp-GrupoProductoId").prop('disabled', false);

                    $('#bandejaPopupGrid').appGrid('reloadJSON');
                } else {
                    msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                }
            }
        });
    };
    function mp_grupoProductoIdOnChange() {
        var grupoProductoId = $("#mp-GrupoProductoId").val();
        if ($.isNullOrEmpty(grupoProductoId)) {
            $("#mp-ClaseProductoId").prop('disabled', true);
            $("#mp-FamiliaProductoId").prop('disabled', true);

            $("#mp-ClaseProductoId").val('');
            $("#mp-FamiliaProductoId").val('');
            $('#bandejaPopupGrid').appGrid('reloadJSON');
            return;
        }

        $("#mp-ClaseProductoId").val('');
        $("#mp-FamiliaProductoId").val('');
        $("#mp-ClaseProductoId").prop('disabled', true);
        $("#mp-FamiliaProductoId").prop('disabled', true);

        $(this).getAction({
            urlAction: '@Url.Action("ListarClaseProducto", "Producto")',
            id: grupoProductoId,
            onSuccess: function (response) {
                if (response.success) {

                    $('#mp-ClaseProductoId').find('option').remove().end();
                    $("#mp-ClaseProductoId").addItems(response.data);
                    $("#mp-ClaseProductoId").prop('disabled', false);

                    $('#bandejaPopupGrid').appGrid('reloadJSON');
                } else {
                    msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                }
            }
        });
    };
    function mp_claseProductoIdOnChange() {

        var claseProductoId = $("#mp-ClaseProductoId").val();
        if ($.isNullOrEmpty(claseProductoId)) {
            $("#mp-FamiliaProductoId").prop('disabled', true);

            $("#mp-FamiliaProductoId").val('');
            $('#bandejaPopupGrid').appGrid('reloadJSON');
            return;
        }

        $("#mp-FamiliaProductoId").val('');
        $("#mp-FamiliaProductoId").prop('disabled', true);

        $(this).getAction({
            urlAction: '@Url.Action("ListarFamiliaProducto", "Producto")',
            id: claseProductoId,
            onSuccess: function (response) {
                if (response.success) {

                    $('#mp-FamiliaProductoId').find('option').remove().end();
                    $("#mp-FamiliaProductoId").addItems(response.data);
                    $("#mp-FamiliaProductoId").prop('disabled', false);

                    $('#bandejaPopupGrid').appGrid('reloadJSON');
                } else {
                    msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                }
            }
        });
    };
</script>