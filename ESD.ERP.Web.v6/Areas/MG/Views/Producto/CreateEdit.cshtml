    function subProcesoListPopupOnClick() {

        var row = $('#bandejaPopupGrid').appGrid('getSelectedRow');

        subProcesoProduccionSelectedPopup('', row);
    };
    function subProcesoProduccionSelectedPopup(sourceId, row) {

        if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("PS_sub_proceso_seleccion_requerida")');
            return false;
        }

        var editableRows = $('#procesoGrid').appGrid('editableRowsCount');
        if (editableRows == 0) {
            var initdata = {
                ProductoSubProcesoProduccionId: 0,
                ProductoId: $('#ProductoId').val(),
                SubProcesoProduccionId: row.SubProcesoProduccionId,
                ProcesoNombre: row.ProcesoNombre,
                Nombre: row.Nombre,
                Orden: 0,
                '@AppConstante.DTO_STATE': '@(((int)DTOState.Added).ToString())',
                Estado: '@EstadoConstante.ACTIVO'
            };
            $("#procesoGrid").appGrid('addRow', initdata);
            $("#procesoMenuBar").appMenu('saveMenu');
        } else {
            var rowId = $('#procesoGrid').appGrid('getSelectedRowId');

            $('#procesoGrid').jqGrid('setCell', rowId, 'SubProcesoProduccionId', row.SubProcesoProduccionId);
            $('#procesoGrid').jqGrid('setCell', rowId, 'ProcesoNombre', row.ProcesoNombre);
            $('#procesoGrid').jqGrid('setCell', rowId, 'Nombre', row.Nombre);
        }

        $('#subProcesoListPopup').hideDialog();
    };
