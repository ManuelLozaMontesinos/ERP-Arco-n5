@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@model ESD.ERP.Web.Areas.MG.Models.ProveedorViewModel
<div id="@Model.ModalEditId">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-10">
               <div class="form-group row">
                  <esd-masktextbox id="NumeroRuc" col-position="col-lg-2" label="R.U.C." col-label-position="col-lg-2" mask="99999999999" in-modal="true"></esd-masktextbox>
                  <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Nombre" col-label-position="col-lg-2" max-length="150" in-modal="true"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoDocumentoIdentidadId" for="@Model.TipoDocumentoIdentidadList" col-position="col-lg-2" label="Tipo de Documento"
                                    col-label-position="col-lg-2" in-modal="true"></esd-dropdownlist>
                  <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2" max-length="20"
                               in-modal="true"></esd-textbox>
               </div>
            </div>
            <div class="col-2">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="mp_clearButtonOnClick()" in-modal="true"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaPopupContainer">
      <table id="bandejaPopupGrid"></table>
      <div id="bandejaPopupPager"></div>
   </div>
</div>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaPopupGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "Proveedor")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "ProveedorDTO.TipoNaturalezaJuridicaDTO.Codigo", value: '@Model.ProveedorDTO?.TipoNaturalezaJuridicaDTO?.Codigo' },
                     { name: "ProveedorDTO.RazonSocial", value: $('#mp-RazonSocial').val() },
                     { name: "ProveedorDTO.TipoDocumentoIdentidadId", value: $('#mp-TipoDocumentoIdentidadId').val()||0, type: 'int' },
                     { name: "ProveedorDTO.NumeroDocumentoIdentidad", value: $('#mp-NumeroDocumentoIdentidad').val() },
                     { name: "ProveedorDTO.NumeroRuc", value: $('#mp-NumeroRuc').val() }
                  ]
               ));
            }
         },
         colNames: ['','', 'Codigo', 'T/D', '#Documento', 'RUC', 'Razon Social', 'Direccion', ''],
         colModel: [
            { name: 'ProveedorId', hidden: true },
            { name: "TipoNaturalezaJuridica", hidden: true },
            { name: "Codigo", width: 60 },
            { name: "TipoDocumentoIdentidadNombre", width: 90 },
            { name: "NumeroDocumentoIdentidad", width: 100 },
            { name: "NumeroRuc", width: 80 },
            { name: "RazonSocial", width: 350 },
            { name: "Direccion", width: 350 },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPopupPager",
         ondblClickRow: function (rowid) {

            var popupParams = getPopupParam('@Model.ModalEditId');

            var row = $(this).getRowData(rowid);
            proveedorSelectedPopup(popupParams.dialogId, row);
         },
         gridComplete: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: 250
      });
   });
   function mp_clearButtonOnClick() {
      $('#@Model.ModalEditId').find('input:text').val('');
      $('#mp-TipoDocumentoIdentidadId').val('');
      $('#bandejaPopupGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#mp-NumeroRuc, #mp-RazonSocial,#mp-TipoDocumentoIdentidadId,#mp-NumeroDocumentoIdentidad").change(function () {
         $('#bandejaPopupGrid').appGrid('reloadJSON');
      });
   });
</script>