@using ESD.Core.Web;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.MG.Models.RemMinVitalViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="SaveExit" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-numerictextbox for="@Model.RemuneracionMinimaVitalDTO.Monto" col-position="col-lg-2" label="Monto"
                                      col-label-position="col-lg-2"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker for="@Model.RemuneracionMinimaVitalDTO.FechaAlta" col-position="col-lg-2" label="Fecha Inicio"
                                      col-label-position="col-lg-2"></esd-datetimepicker>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker for="@Model.RemuneracionMinimaVitalDTO.FechaBaja" col-position="col-lg-2" label="Fecha Fin"
                                      col-label-position="col-lg-2"></esd-datetimepicker>
               </div>
            </div>
         </div>
      </div>
      <esd-viewmodelstate for="@Model.ViewModelState.Value"></esd-viewmodelstate>
      <esd-hidden for="@Model.RemuneracionMinimaVitalDTO.RemuneracionMinimaVitalId"></esd-hidden>
   </div>
</section>
<script type="text/javascript">

   function menuBarOnClick(key) {

      switch (key) {
         case '@MenuItemKey.SAVE':
            grabarDatos();
            break;

         case '@MenuItemKey.EXIT':
            $(this).getView({
               urlAction: '@Url.Action("Index", "RemMinVital")'
            });
            break;

      }
   };
   function grabarDatos() {

      if (!$('#FechaAlta').validateString('@SR.GetString("GEN_fecha_inicio_requerida")'))
         return false;

      $(this).saveView({
         viewModel: [
            { name: "RemuneracionMinimaVitalDTO.RemuneracionMinimaVitalId", value: $('#RemuneracionMinimaVitalId').val(), type: 'int' },
            { name: "RemuneracionMinimaVitalDTO.Monto", value: $('#Monto').val(), type: 'decimal' },
            { name: "RemuneracionMinimaVitalDTO.FechaAlta", value: $('#FechaAlta').val(), type: 'date' },
            { name: "RemuneracionMinimaVitalDTO.FechaBaja", value: $('#FechaBaja').val(), type: 'date' }
         ],
         buttonId: '@MenuItemKey.SAVE',
         urlAction: '@Url.Action("Grabar", "RemMinVital")',
         onSuccess: function (response) {

            if (response.success) {
               msgAlert(msgAlertTypeConstant.SUCCESS, response.message);

               $("#RemuneracionMinimaVitalId").val(response.data.Id);
               ViewModelState.setValue('EditAction', @((int)ViewModelEditAction.Edit))

            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
            $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.SAVE', disabled: false });
         }
      });
   };
</script>