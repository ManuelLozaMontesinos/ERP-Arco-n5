@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@model ESD.ERP.Web.Areas.PD.Models.ProceProduccionViewModel
<div id="@Model.ModalEditId">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-10">
               <div class="form-group row">
                  <esd-textbox id="Nombre" col-position="col-lg-10" label="Nombre" col-label-position="col-lg-2" max-length="100" in-modal="true"></esd-textbox>
               </div>
            </div>
            <div class="col-2">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="mp_clearButtonOnClick()" in-modal="true"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaPopupContainer">
      <table id="bandejaPopupGrid"></table>
      <div id="bandejaPopupPager"></div>
   </div>
</div>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaPopupGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarSubProcesoProduccionPopup", "ProceProduccion")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "SubProcesoProduccionDTO.Nombre", value: $('#mp-Nombre').val() },
                     { name: "SubProcesoProduccionDTO.Estado", value: '@EstadoConstante.ACTIVO' },
                  ]
               ));
            }
         },
         colNames: ['','','Proceso','Sub-Proceso',''],
         colModel: [
            { name: 'SubProcesoProduccionId', hidden: true },
            { name: 'ProcesoProduccionId', hidden: true },
            { name: "ProcesoNombre", width: 250 },
            { name: "Nombre", width: 300 },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPopupPager",
         ondblClickRow: function (rowid) {

            var popupParams = getPopupParam('@Model.ModalEditId')

            var row = $(this).getRowData(rowid);
            subProcesoProduccionSelectedPopup(popupParams.dialogId, row);
         },
         gridComplete: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: 250
      });
   });
   function mp_clearButtonOnClick() {
      $('#@Model.ModalEditId').find('input:text').val('');
      $('#bandejaPopupGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#mp-Nombre").change(function () {
         $('#bandejaPopupGrid').appGrid('reloadJSON');
      });
   });
</script>