@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.PD.Models.DespachoViewModel
<div id="@Model.ModalEditId">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-buttontextbox id="Personal" button-style="List" col-position="col-lg-10"
                                     label="Atendido Por" col-label-position="col-lg-2" onclick="mp_personalOnClick" in-modal="true"></esd-buttontextbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.ComprobanteDTO.EntregaDespacho" col-position="col-lg-10" label="Entregado a" col-label-position="col-lg-2"
                               max-length="100" in-modal="true"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textarea for="@Model.ComprobanteDTO.ObservacionDespacho" col-position="col-lg-10" label="Observacion" col-label-position="col-lg-2"
                                max-length="400" rows="3" in-modal="true"></esd-textarea>
               </div>
            </div>
         </div>
      </div>
   </div>
   <esd-hidden for="@Model.ComprobanteDTO.PersonalId" in-modal="true"></esd-hidden>
</div>
<script type="text/javascript">
   function mp_validarDatos() {

      if (!$('#mp-PersonalId').validateNumeric('@SR.GetString("RH_personal_seleccion_requerida")'))
         return false;

      return true;
   };
   function mp_personalOnClick() {
      $('#personalListPopup').showDialog({ hideColumnList: 'TipoDocumentoIdentidad,NumeroDocumentoIdentidad,Direccion'});
   };
</script>