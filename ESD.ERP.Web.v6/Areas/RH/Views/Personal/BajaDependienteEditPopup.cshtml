@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.RH.Models.PersonalViewModel
<div id="mp-edit-panel">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-dropdownlist id="MotivoBajaDependienteId" for="@Model.MotivoBajaDependienteList" col-position="col-lg-8" label="Motivo Baja"
                                    col-label-position="col-lg-2" in-modal="true"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker for="@Model.PersonalDependienteDTO.FechaBaja" col-position="col-lg-4" label="Fecha Baja" col-label-position="col-lg-2"
                                      in-modal="true"></esd-datetimepicker>
               </div>
            </div>
         </div>
      </div>
      <esd-hidden for="@Model.PersonalDependienteDTO.PersonalDependienteId" in-modal="true"></esd-hidden>
   </div>
</div>
<script type="text/javascript">

   function mp_validarDatos() {

      if (!$('#mp-MotivoBajaDependienteId').validateNumeric('@SR.GetString("RH_motivo_baja_dependiente_seleccion")'))
         return false;

      if (!$('#mp-FechaBaja').validateString('@SR.GetString("GEN_fecha_baja_requerida")'))
         return false;

      return true;
   };
</script>