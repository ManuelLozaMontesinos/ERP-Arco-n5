@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.RH.Models.PersonalViewModel
<div id="mp-edit-panel">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-dropdownlist id="MotivoFinPeriodoId" for="@Model.MotivoFinPeriodoList" col-position="col-lg-8" label="Motivo de Cese"
                                    col-label-position="col-lg-2" in-modal="true"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker for="@Model.PersonalPeriodoLaboralDTO.FechaCese" col-position="col-lg-4" label="Fecha Cese" col-label-position="col-lg-2"
                                      in-modal="true"></esd-datetimepicker>
               </div>
            </div>
         </div>
      </div>
      <esd-hidden for="@Model.PersonalPeriodoLaboralDTO.PersonalPeriodoLaboralId" in-modal="true"></esd-hidden>
   </div>
</div>
<script type="text/javascript">

   function mp_validarDatos() {

      if (!$('#mp-MotivoFinPeriodoId').validateNumeric('@SR.GetString("RH_motivo_fin_periodo_seleccion")'))
         return false;

      if (!$('#mp-FechaCese').validateString('@SR.GetString("RH_fecha_cese_requerida")'))
         return false;

      return true;
   };
</script>