                        <div class="form-group row">
                           <esd-dropdownlist id="TipoTrabajadorId" for="@Model.TipoTrabajadorList" col-position="col-lg-2" label="Tipo de Trabajador"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-dropdownlist id="RegimenLaboralId" for="@Model.RegimenLaboralList" col-position="col-lg-2" label="Regimen Laboral"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
