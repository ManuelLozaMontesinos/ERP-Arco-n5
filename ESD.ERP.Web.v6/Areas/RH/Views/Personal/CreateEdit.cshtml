   function remuneraMenuBarOnClick(key) {

      var row = $('#remuneraGrid').appGrid('getSelectedRow');
      var excludeKeys = ['@MenuItemKey.NEW'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {
         case '@MenuItemKey.NEW':
            var initdata = {
               PersonalRemuneracionId: 0,
               PersonalId: $('#PersonalId').val(),
               Monto: 0,
               FechaAlta: $('#FechaIngreso').val(),
               '@AppConstante.DTO_STATE' : '@(((int) DTOState.Added).ToString())',
               Estado: '@EstadoConstante.ACTIVO'
            };
            $("#remuneraGrid").appGrid('addRow', initdata);
            $("#remuneraMenuBar").appMenu('saveMenu');
            break;

         case '@MenuItemKey.EDIT':
            editarRemuneracionInGrid();
            var rowId = $("#remuneraGrid").appGrid("getSelectedRowId");
            $('#' + rowId + '_MonedaId').prop('disabled', true);
            $('#' + rowId + '_TipoRemuneracionId').prop('disabled', true);
            break;

         case '@MenuItemKey.CANCEL':
            $("#remuneraGrid").appGrid('reloadJSON');
            break;

         case '@MenuItemKey.SAVE':

            var rowId = $("#remuneraGrid").appGrid("getSelectedRowId");

            if (!$('#' + rowId + '_FechaAlta').validateString('@SR.GetString("GEN_fecha_inicio_requerida")'))
               return false;

            $("#remuneraGrid").jqGrid('saveRow', rowId, {url: 'clientArray', aftersavefunc: function (id, response, options) {
               row = $("#remuneraGrid").appGrid('getSelectedRow');

               setModifiedDTO(row);
               $(this).saveView({
                  urlAction: '@Url.Action("GrabarPersonalRemuneracion", "Personal")',
                  viewModel: [
                     { name: "PersonalRemuneracionDTO.PersonalRemuneracionId", value: row.PersonalRemuneracionId, type: 'int' },
                     { name: "PersonalRemuneracionDTO.PersonalId", value: $('#PersonalId').val(), type: 'int' },
                     { name: "PersonalRemuneracionDTO.TipoRemuneracionId", value: row.TipoRemuneracionId, type: 'int' },
                     { name: "PersonalRemuneracionDTO.MonedaId", value: row.MonedaId, type: 'int' },
                     { name: "PersonalRemuneracionDTO.Monto", value: row.Monto, type: 'decimal' },
                     { name: "PersonalRemuneracionDTO.FechaAlta", value: row.FechaAlta, type: 'date' },
                     { name: "PersonalRemuneracionDTO.FechaBaja", value: row.FechaBaja, type: 'date' },
                     { name: "PersonalRemuneracionDTO.DTOState", value: row.DTOState, type: 'int' }
                  ],
                  onSuccess: function (response) {
                     if (response.success) {
                        $("#remuneraGrid").appGrid('reloadJSON');
                        msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                     } else {
                        msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        $("#remuneraMenuBar").appMenu('saveMenu');
                     }
                  }
               });
            }});
            break;
      }
      return true;
   };
   function editarRemuneracionInGrid() {
      var rowId = $("#remuneraGrid").appGrid("getSelectedRowId");
      $('#remuneraGrid').jqGrid('editRow', rowId);

      $("#remuneraMenuBar").appMenu('saveMenu');
   };
   function periodoMenuBarOnClick(key) {

      var row = $('#periodoGrid').appGrid('getSelectedRow');
      var excludeKeys = ['@MenuItemKey.NEW'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {
         case '@MenuItemKey.NEW':
            var initdata = {
               PersonalPeriodoLaboralId: 0,
               PersonalId: $('#PersonalId').val(),
               '@AppConstante.DTO_STATE' : '@(((int) DTOState.Added).ToString())',
               Estado: '@EstadoConstante.ACTIVO'
            };
            $("#periodoGrid").appGrid('addRow', initdata);
            $("#periodoMenuBar").appMenu('saveMenu');
            break;

         case '@MenuItemKey.EDIT':
            editarPeriodoInGrid();
            break;

         case '@MenuItemKey.CANCEL':
            $("#periodoGrid").appGrid('reloadJSON');
            break;

         case '@MenuItemKey.SAVE':

            var rowId = $("#periodoGrid").appGrid("getSelectedRowId");

            if (!$('#' + rowId + '_FechaIngreso').validateString('@SR.GetString("RH_fecha_ingreso_requerida")'))
               return false;
            if (!$('#EsEventual').prop('checked')) {
               if (!$('#' + rowId + '_FechaAlta').validateString('@SR.GetString("RH_fecha_ingreso_pla_requerida")'))
                  return false;
            }

            var fechaIngreso = $('#' + rowId + '_FechaIngreso').val();
            var fechaAlta = $('#' + rowId + '_FechaAlta').val();

            $("#periodoGrid").jqGrid('saveRow', rowId, {url: 'clientArray', aftersavefunc: function (id, response, options) {
               row = $("#periodoGrid").appGrid('getSelectedRow');

               setModifiedDTO(row);
               $(this).saveView({
                  urlAction: '@Url.Action("GrabarPersonalPeriodoLaboral", "Personal")',
                  viewModel: [
                     { name: "PersonalPeriodoLaboralDTO.PersonalPeriodoLaboralId", value: row.PersonalPeriodoLaboralId, type: 'int' },
                     { name: "PersonalPeriodoLaboralDTO.PersonalId", value: $('#PersonalId').val(), type: 'int' },
                     { name: "PersonalPeriodoLaboralDTO.FechaIngreso", value: row.FechaIngreso, type: 'date' },
                     { name: "PersonalPeriodoLaboralDTO.FechaAlta", value: row.FechaAlta, type: 'date' },
                     { name: "PersonalPeriodoLaboralDTO.DTOState", value: row.DTOState, type: 'int' }
                  ],
                  onSuccess: function (response) {
                     if (response.success) {
                        $("#periodoGrid").appGrid('reloadJSON');
                        msgAlert(msgAlertTypeConstant.SUCCESS, response.message);

                        $('#FechaIngreso').val(fechaIngreso);
                        $('#FechaAlta').val(fechaAlta);
                        $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.SAVE', disabled: false });
                        $('#EsSoloLectura').val('@SiNoConstante.N');
                     } else {
                        msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        $("#periodoMenuBar").appMenu('saveMenu');
                     }
                  }
               });
            }});
            break;

         case 'baja':
            $('#bajaEditPopup').showDialog({ editAction : '@ViewModelEditAction.Edit'});
            break;
      }
      return true;
   };
   function editarPeriodoInGrid() {
      var rowId = $("#periodoGrid").appGrid("getSelectedRowId");
      $('#periodoGrid').jqGrid('editRow', rowId);

      $("#periodoMenuBar").appMenu('saveMenu');
