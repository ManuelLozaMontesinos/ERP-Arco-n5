   function grabarDatos() {

      if (!$('#ApellidoPaterno').validateString('@SR.GetString("RH_apellido_paterno_requerido")'))
         return false;
      if (!$('#Nombres').validateString('@SR.GetString("GEN_nombres_requerido")'))
         return false;
      if (!$('#Pais').validateString('@SR.GetString("RH_nacionalidad_seleccion_requerida")'))
         return false;
      if (!$('#TipoDocumentoIdentidadId').validateNumeric('@SR.GetString("GEN_tipo_doc_identidad_seleccion_requerida")'))
         return false;
      if (!$('#NumeroDocumentoIdentidad').validateString('@SR.GetString("GEN_numero_doc_identidad_requerido")'))
         return false;
      if(!validarTipoDocumentoIdentidadId())
         return false;
      if (!$('#FechaNacimiento').validateString('@SR.GetString("RH_fecha_nacimiento_requerida")'))
         return false;
      if (!$('#SexoId').validateNumeric('@SR.GetString("RH_sexo_seleccion_requerida")'))
         return false;
      if (!$('#EstadoCivilId').validateNumeric('@SR.GetString("RH_estado_civil_seleccion_requerida")'))
         return false;
      if (!$('#TipoViaId').validateNumeric('@SR.GetString("MG_tipo_via_seleccion_requerida")'))
         return false;
      if (!$('#TipoZonaId').validateNumeric('@SR.GetString("MG_tipo_zona_seleccion_requerida")'))
         return false;
      if (!$('#DepartamentoId').validateNumeric('@SR.GetString("MG_departamento_seleccion_requerida")'))
         return false;
      if (!$('#ProvinciaId').validateNumeric('@SR.GetString("MG_provincia_seleccion_requerida")'))
         return false;
      if (!$('#DistritoId').validateNumeric('@SR.GetString("MG_distrito_seleccion_requerida")'))
         return false;

      if ($('#EsCentroAsistencial').prop('checked')) {
         if (!$('#TipoViaId2').validateNumeric('@SR.GetString("MG_tipo_via_seleccion_requerida")'))
            return false;
         if (!$('#TipoZonaId2').validateNumeric('@SR.GetString("MG_tipo_zona_seleccion_requerida")'))
            return false;
         if (!$('#DepartamentoId2').validateNumeric('@SR.GetString("MG_departamento_seleccion_requerida")'))
            return false;
         if (!$('#ProvinciaId2').validateNumeric('@SR.GetString("MG_provincia_seleccion_requerida")'))
            return false;
         if (!$('#DistritoId2').validateNumeric('@SR.GetString("MG_distrito_seleccion_requerida")'))
            return false;
      }

      if (!$('#FechaIngreso').validateString('@SR.GetString("RH_fecha_ingreso_requerida")'))
         return false;
      if (!$('#EsEventual').prop('checked')) {
         if (!$('#FechaAlta').validateString('@SR.GetString("RH_fecha_ingreso_pla_requerida")'))
            return false;
      }
      if (!$('#TipoTrabajadorId').validateNumeric('@SR.GetString("RH_tipo_trabajador_seleccion_requerida")'))
         return false;
      if (!$('#RegimenLaboralId').validateNumeric('@SR.GetString("RH_regimen_laboral_seleccion_requerida")'))
         return false;
      if (!$('#CargoPersonalId').validateNumeric('@SR.GetString("RH_cargo_seleccion_requerida")'))
         return false;
      if ('@Model.RestriccionCategoriaOcupacionalXTipoTrabajador'.indexOf($('#TipoDocumentoIdentidad').val()) != -1){
         if (!$('#CategoriaOcupacionalId').validateNumeric('@SR.GetString("RH_categoria_educacional_seleccion_requerida")'))
            return false;
      }
      if (!$('#TipoContratoId').validateNumeric('@SR.GetString("RH_tipo_contrato_seleccion_requerida")'))
         return false;
      if (!$('#TipoPagoRemuneracionId').validateNumeric('@SR.GetString("RH_tipo_pago_seleccion_requerida")'))
         return false;
