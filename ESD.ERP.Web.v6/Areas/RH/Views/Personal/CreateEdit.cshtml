                  <esd-dropdownlist id="TipoDocumentoIdentidadId" for="@Model.TipoDocumentoIdentidadList" col-position="col-lg-2" label="Tipo Doc. Identidad"
                                    col-label-position="col-lg-2" onchange="tipoDocumentoIdentidadIdOnChange()"></esd-dropdownlist>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2"
                               max-length="20"></esd-textbox>
                  <esd-buttontextbox id="PaisEmisor" button-style="List" value="@Model.PersonalDTO.PaisEmisorDTO?.Nombre" col-position="col-lg-2" label="Pais Emisor"
                                     col-label-position="col-lg-2" enable="false" onclick="paisEmisorOnClick"></esd-buttontextbox>
               </div>
               <div class="form-group row">
