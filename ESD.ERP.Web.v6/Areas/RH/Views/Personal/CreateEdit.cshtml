                        </div>
                        <div class="form-group row">
                           <esd-checkbox for="@Model.PersonalDTO.EsCentroAsistencial" col-position="offset-lg-2 col-lg-3" label="Referente para Centro Asistencial"
                                         onchange="esCentroAsistencialOnChange();"></esd-checkbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="TipoViaId2" for="@Model.TipoViaList2" col-position="col-lg-2" label="Tipo de Via"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-textbox id="NombreVia2" value="@Model.PersonalDTO.NombreVia" col-position="col-lg-3" label="Nombre" col-label-position="col-lg-1"
                                        max-length="50"></esd-textbox>
                           <esd-textbox id="NumeroVia2" value="@Model.PersonalDTO.NumeroVia" col-position="col-lg-1" label="Numero" col-label-position="col-lg-1"
                                        max-length="10"></esd-textbox>
                           <esd-textbox id="Departamento2" value="@Model.PersonalDTO.Departamento" col-position="col-lg-1" label="#Dpto" col-label-position="col-lg-1"
                                        max-length="10"></esd-textbox>
                        </div>
                        <div class="form-group row">
                           <esd-textbox id="Interior2" value="@Model.PersonalDTO.Interior" col-position="col-lg-1" label="Interior" col-label-position="col-lg-2"
                                        max-length="10"></esd-textbox>
                           <esd-textbox id="Manzana2" value="@Model.PersonalDTO.Manzana" col-position="col-lg-1" label="Manzana" col-label-position="col-lg-2"
                                        max-length="10"></esd-textbox>
                           <esd-textbox id="Lote2" value="@Model.PersonalDTO.Lote" col-position="col-lg-1" label="Lote" col-label-position="col-lg-1"
                                        max-length="10"></esd-textbox>
                           <esd-textbox id="Kilometro2" value="@Model.PersonalDTO.Kilometro" col-position="col-lg-1" label="KM" col-label-position="col-lg-1"
                                        max-length="10"></esd-textbox>
                           <esd-textbox id="Block2" value="@Model.PersonalDTO.Block" col-position="col-lg-1" label="Block" col-label-position="col-lg-1"
                                        max-length="10"></esd-textbox>
                        </div>
                        <div class="form-group row">
                           <esd-textbox id="Etapa2" value="@Model.PersonalDTO.Etapa" col-position="col-lg-1" label="Etapa" col-label-position="col-lg-2"
                                        max-length="10"></esd-textbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="TipoZonaId2" for="@Model.TipoZonaList2" col-position="col-lg-2" label="Tipo de Zona"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-textbox id="NombreZona2" value="@Model.PersonalDTO.NombreZona" col-position="col-lg-3" label="Nombre" col-label-position="col-lg-1"
                                        max-length="50"></esd-textbox>
                           <esd-textbox id="Referencia2" value="@Model.PersonalDTO.Referencia" col-position="col-lg-3" label="Referencia" col-label-position="col-lg-1"
                                        max-length="50"></esd-textbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="DepartamentoId2" for="@Model.DepartamentoList2" selected-value="@Model.DepartamentoId2" col-position="col-lg-2" label="Departamento"
                                             col-label-position="col-lg-2" onchange="departamentoId2OnChange();"></esd-dropdownlist>
                           <esd-dropdownlist id="ProvinciaId2" for="@Model.ProvinciaList2" selected-value="@Model.ProvinciaId2" col-position="col-lg-3" label="Provincia"
                                             col-label-position="col-lg-1" onchange="provinciaId2OnChange();"></esd-dropdownlist>
                           <esd-dropdownlist id="DistritoId2" for="@Model.DistritoList2" selected-value="@Model.PersonalDTO.DistritoId" col-position="col-lg-3" label="Distrito"
                                             col-label-position="col-lg-1"></esd-dropdownlist>
                        </div>
                     </div>
                  </div>
               </div>
            </div>
         </div>
         <div class="tab-pane" id="laboralTab" role="tabpanel">
            <div class="card">
               <div class="card-body">
                  <div class="row">
                     <div class="col-12">
                        <div class="form-group row">
                           <esd-datetimepicker for="@Model.PersonalDTO.FechaIngreso" col-position="col-lg-2" label="Fecha Ingreso"
