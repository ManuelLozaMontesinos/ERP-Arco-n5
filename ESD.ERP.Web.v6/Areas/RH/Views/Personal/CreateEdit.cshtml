                           <esd-dropdownlist id="CategoriaOcupacionalId" for="@Model.CategoriaOcupacionalList" col-position="col-lg-2" label="Cat. Ocupacional"
                                             col-label-position="col-lg-2" onchange="categoriaOcupacionalIdOnChange();"></esd-dropdownlist>
                           <esd-buttontextbox id="Ocupacion" button-style="List" value="@Model.PersonalDTO.OcupacionDTO.Nombre" col-position="col-lg-2" label="Ocupacion"
                                              col-label-position="col-lg-2" onclick="ocupacionOnClick"></esd-buttontextbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="TipoContratoId" for="@Model.TipoContratoList" col-position="col-lg-2" label="Tipo de Contrato"
