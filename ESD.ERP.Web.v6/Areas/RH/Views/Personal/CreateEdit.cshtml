                        <div class="form-group row">
                           <esd-checkbox for="@Model.PersonalDTO.EsJornadaTrabajoMaxima" col-position="offset-lg-2 col-lg-3"
                                         label="Jornada de Trabajo Máxima"></esd-checkbox>
                           <esd-checkbox for="@Model.PersonalDTO.EsRegimenAtipico" col-position="col-lg-3"
                                         label="Jornada Atípica o Acumulativa"></esd-checkbox>
                           <esd-checkbox for="@Model.PersonalDTO.EsJornadaTrabajoNocturna" col-position="offset-lg-1 col-lg-3"
                                         label="Trabajo en Horario Nocturno"></esd-checkbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="SituacionEspecialTrabajadorId" for="@Model.SituacionEspecialTrabajadorList" col-position="col-lg-2" label="Situacion Especial"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-checkbox for="@Model.PersonalDTO.EsDiscapacitado" col-position="offset-lg-1 col-lg-2"
                                         label="Es Discapacitado"></esd-checkbox>
                           <esd-checkbox for="@Model.PersonalDTO.EsMiembroSindicalizado" col-position="offset-lg-1 col-lg-1"
                                         label="Sindicalizado"></esd-checkbox>
                           <esd-checkbox for="@Model.PersonalDTO.AsignacionFamiliar" col-position="offset-lg-1 col-lg-2"
                                         label="Asignacion Familiar"></esd-checkbox>
                        </div>
                     </div>
                  </div>
               </div>
            </div>
         </div>
         <div class="tab-pane" id="aseguramientoTab" role="tabpanel">
            <div class="card">
               <div class="card-body">
                  <div class="row">
                     <div class="col-12">
                        <div class="form-group row">
                           <esd-dropdownlist id="RegimenSaludId" for="@Model.RegimenSaludList" col-position="col-lg-2" label="Regimen Salud"
