                                             col-label-position="col-lg-2"></esd-dropdownlist>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="RegimenPensionarioId" for="@Model.RegimenPensionarioList" col-position="col-lg-2" label="Regimen Pensionario"
