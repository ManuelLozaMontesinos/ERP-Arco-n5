                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Block" col-position="col-lg-1" label="Block" col-label-position="col-lg-1"
                               max-length="10"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Etapa" col-position="col-lg-1" label="Etapa" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoZonaId" for="@Model.TipoZonaList" col-position="col-lg-2" label="Tipo de Zona"
                                    col-label-position="col-lg-2"></esd-dropdownlist>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.NombreZona" col-position="col-lg-3" label="Nombre" col-label-position="col-lg-1"
                               max-length="50"></esd-textbox>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Referencia" col-position="col-lg-3" label="Referencia" col-label-position="col-lg-1"
                               max-length="50"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="DepartamentoId" for="@Model.DepartamentoList" selected-value="@Model.DepartamentoId" col-position="col-lg-2" label="Departamento"
                                    col-label-position="col-lg-2" onchange="departamentoIdOnChange();"></esd-dropdownlist>
                  <esd-dropdownlist id="ProvinciaId" for="@Model.ProvinciaList" selected-value="@Model.ProvinciaId" col-position="col-lg-3" label="Provincia"
                                    col-label-position="col-lg-1" onchange="provinciaIdOnChange();"></esd-dropdownlist>
                  <esd-dropdownlist id="DistritoId" for="@Model.DistritoList" selected-value="@Model.PersonalDTO.ProveedorDTO.DistritoId" col-position="col-lg-3" label="Distrito"
                                    col-label-position="col-lg-1"></esd-dropdownlist>
               </div>
            </div>
         </div>
      </div>
      <esd-viewmodelstate for="@Model.ViewModelState.Value"></esd-viewmodelstate>
      <esd-hidden for="@Model.PersonalDTO.PersonalId"></esd-hidden>
      <esd-hidden for="@Model.PersonalDTO.ProveedorId"></esd-hidden>
      <esd-hidden for="@Model.PersonalDTO.PaisId"></esd-hidden>
      <esd-hidden for="@Model.PersonalDTO.PaisEmisorId"></esd-hidden>
      <esd-hidden for="@Model.TipoDocumentoIdentidad"></esd-hidden>
      <esd-hidden for="@Model.CategoriaOcupacional"></esd-hidden>
      <esd-hidden for="@Model.PersonalDTO.CargoPersonalId"></esd-hidden>
      <esd-hidden for="@Model.PersonalDTO.OcupacionId"></esd-hidden>
      <esd-hidden for="@Model.RegimenSalud"></esd-hidden>
      <esd-hidden for="@Model.RegimenPensionario"></esd-hidden>
      <esd-hidden for="@Model.TipoPagoRemuneracion"></esd-hidden>
      <esd-hidden for="@Model.EsSoloLectura"></esd-hidden>
      <esd-hidden id="MonedaList" value="@Model.MonedaString"></esd-hidden>
      <esd-hidden id="TipoRemuneracionList" value="@Model.TipoRemuneracionString"></esd-hidden>
      <esd-hidden id="PlanillaList" value="@Model.PlanillaString"></esd-hidden>
   </div>
   <div>
      <ul class="nav nav-tabs" role="tablist" id="detailTab">
         <li class="nav-item">
            <a class="nav-link active" href="#generalTab" role="tab" data-toggle="tab">Datos de Identificación</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#laboralTab" role="tab" data-toggle="tab">Datos Laborales</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#aseguramientoTab" role="tab" data-toggle="tab">Datos de Aseguramiento Social</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#complementaTab" role="tab" data-toggle="tab">Datos Complementarios</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#periodoTab" role="tab" data-toggle="tab">Periodo Laboral</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#remuneraTab" role="tab" data-toggle="tab">Remuneraciones</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#dependienteTab" role="tab" data-toggle="tab">Derecho Habientes</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#planillaTab" role="tab" data-toggle="tab">Planilla</a>
         </li>
      </ul>
      <div class="tab-content">
         <div class="tab-pane active" id="generalTab" role="tabpanel">
            <div class="card">
               <div class="card-body">
                  <div class="row">
                     <div class="col-12">
                        <div class="form-group row">
                           <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Telefono" col-position="col-lg-2" label="Telefono" col-label-position="col-lg-2"></esd-textbox>
