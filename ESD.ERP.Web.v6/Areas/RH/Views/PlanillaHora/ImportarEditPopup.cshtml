@model ESD.ERP.Web.Areas.RH.Models.PlanillaHoraViewModel
<div id="mp-edit-panel">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-radiobutton id="mp-DesdeMarcacion" group-name="mp-importarGrupo" label="Desde Marcacion" col-position="offset-lg-1 col-lg-4" checked="true"
                                   in-modal="true" onchange="mp_importarGrupoOnChange()"></esd-radiobutton>
               </div>
               <div class="form-group row">
                  <esd-radiobutton id="mp-DesdeArchivo" group-name="mp-importarGrupo" label="Desde Archivo" col-position="offset-lg-1 col-lg-4"
                                   in-modal="true" onchange="mp_importarGrupoOnChange()"></esd-radiobutton>
               </div>
               <div class="row">
                  <div class="col-1"></div>
                  <div class="col-7">
                     <div id="container" class="form-group row">
                        <esd-textbox id="mp-ArchivoExcel" col-position="col-lg-10" label="Archivo"
                                     col-label-position="col-lg-2" enable="false"></esd-textbox>
                     </div>
                     <div class="form-group row">
                        <div class="col-sm-2"></div>
                        <div class="col-sm-10">
                           <div class="form-group row progress">
                              <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                 <span class="sr-only">60% completado</span>
                              </div>
                           </div>
                        </div>
                     </div>
                  </div>
                  <div class="col-4">
                     <div class="form-group">
                        <esd-button id="mp-ArchivoExcelButton" content="Seleccionar" button-style="Primary" size="Small"></esd-button>
                        <esd-button id="mp-DescargarFormatoButton" content="Descargar Formato" button-style="Success" size="Small" onclick="mp_descargarFormatoOnClick"></esd-button>
                     </div>
                  </div>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>
<script type="text/javascript">
   $(document).ready(function () {
      $('#mp-ArchivoExcel').val('');
      $('.progress-bar').css('width', '0%')
      $('#mp-ArchivoExcelButton').prop('disabled', true);
      $('#mp-DescargarFormatoButton').prop('disabled', true);
   });
   function mp_importarGrupoOnChange() {

      if ($('#mp-DesdeMarcacion').prop('checked')) {
         $('#mp-ArchivoExcelButton').prop('disabled', true);
         $('#mp-DescargarFormatoButton').prop('disabled', true);
      };

      if ($('#mp-DesdeArchivo').prop('checked')) {
         $('#mp-ArchivoExcelButton').prop('disabled', false);
         $('#mp-DescargarFormatoButton').prop('disabled', false);
      };

   };
</script>