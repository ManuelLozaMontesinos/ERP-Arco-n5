@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.RH.Models.PlanillaRegulaViewModel
<esd-menubar id="menuBar" Title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-dropdownlist id="PlanillaId" for="@Model.PlanillaList" col-position="col-lg-4" label="Planilla"
                                    col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="MesId" for="@Model.MesList" col-position="col-lg-4" label="Mes"
                                    col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "PlanillaRegula")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "PlanillaProcesoDTO.PlanillaId", value: $('#PlanillaId').val() || 0, type: 'int' },
                     { name: "PlanillaProcesoDTO.MesId", value: $('#MesId').val() || 0, type: 'int' }
                  ]
               ));
            }
         },
         colNames: ['', 'Nombre','Mes','# Proceso','Moneda','Fec. Ini','Fec. Fin','Fec. Proceso','Estado',''],
         colModel: [
            { name: 'PlanillaProcesoId', hidden: true },
            { name: "PlanillaNombre", width: 250 },
            { name: "MesNombre", width: 150 },
            { name: "ProcesoAnual", width: 80, align: 'right', formatter: 'integer' },
            { name: "MonedaNombre", width: 120 },
            { name: "FechaDesde", width: 90, align:'right', sorttype:'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT'},
            { name: "FechaHasta", width: 90, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: "FechaProceso", width: 90, align:'right', sorttype:'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT'},
            { name: "EstadoNombre", width: 180 },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });

            var row = $('#bandejaGrid').appGrid('getSelectedRow');
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $("#PlanillaId").val('');
      $("#MesId").val('');
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#PlanillaId, #MesId").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
   });
   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW','@MenuItemKey.EXIT'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "PlanillaProcesoDTO.PlanillaProcesoId", value: row.PlanillaProcesoId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "PlanillaRegula")'
            });
            break;
      }
      return true;
   };
</script>