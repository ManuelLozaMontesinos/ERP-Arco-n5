@using ESD.Core.Web;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.RH.Models.TipoRemuneraViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="SaveExit" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-textbox for="@Model.TipoRemuneracionDTO.Nombre" col-position="col-lg-4" label="Nombre" col-label-position="col-lg-2"
                               max-length="100"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox id="VariableCalculo" col-position="col-lg-2" label="Variable" col-label-position="col-lg-2" max-length="20"
                               value="@Model.TipoRemuneracionDTO.VariableCalculoDTO.Codigo" enable="@Model.IsNew" use-textcase="false"></esd-textbox>
               </div>
            </div>
         </div>
      </div>
      <esd-viewmodelstate for="@Model.ViewModelState.Value"></esd-viewmodelstate>
      <esd-hidden for="@Model.TipoRemuneracionDTO.TipoRemuneracionId"></esd-hidden>
   </div>
</section>
<script type="text/javascript">

   $(document).ready(function () {

   });
   function menuBarOnClick(key) {

      switch (key) {
         case '@MenuItemKey.SAVE':
            grabarDatos();
            break;

         case '@MenuItemKey.EXIT':
            $(this).getView({
               urlAction: '@Url.Action("Index", "TipoRemunera")'
            });
            break;

      }
   };
   function grabarDatos() {

      if (!$('#Nombre').validateString('@SR.GetString("GEN_nombre_requerido")'))
         return false;
      if (!$('#VariableCalculo').validateString('@SR.GetString("RH_nombre_variable_requerido")'))
         return false;

      $(this).saveView({
         viewModel: [
            { name: "TipoRemuneracionDTO.TipoRemuneracionId", value: $('#TipoRemuneracionId').val(), type: 'int' },
            { name: "TipoRemuneracionDTO.Codigo", value: $('#Codigo').val() },
            { name: "TipoRemuneracionDTO.Nombre", value: $('#Nombre').val() },
            { name: "TipoRemuneracionDTO.Abreviatura", value: $('#Abreviatura').val() },
            { name: "TipoRemuneracionDTO.VariableCalculoDTO.Codigo", value: $('#VariableCalculo').val(), textCase: 'none' },
            { name: "TipoRemuneracionDTO.VariableCalculoDTO.Nombre", value: $('#Nombre').val() },
            { name: "TipoRemuneracionDTO.VariableCalculoDTO.ValorCadenaVerdad", value: $('#VariableCalculo').val(), textCase: 'none' }
         ],
         buttonId: '@MenuItemKey.SAVE',
         urlAction: '@Url.Action("Grabar", "TipoRemunera")',
         onSuccess: function (response) {

            if (response.success) {
               msgAlert(msgAlertTypeConstant.SUCCESS, response.message);

               $("#TipoRemuneracionId").val(response.data.Id);
               $("#Codigo").val(response.data.Codigo);
               ViewModelState.setValue('EditAction', @((int)ViewModelEditAction.Edit))

            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
            $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.SAVE', disabled: false });
         }
      });
   };
</script>