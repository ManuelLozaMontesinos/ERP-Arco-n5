   function tipoDocumentoIdentidadIdOnChange()
   {
      var tipoDocumentoIdentidadId = $('#TipoDocumentoIdentidadId').val();

      if ($.isNullOrEmpty(tipoDocumentoIdentidadId))
         return;

      $(this).getAction({
         urlAction: '@Url.Action("ObtenerTipoDocumentoIdentidad", "Proveedor", new { area = "MG" })',
         id: tipoDocumentoIdentidadId,
         onSuccess: function (response) {
            if (response.success) {
               $('#NumeroDocumentoIdentidad').inputmask('remove');
               $('#PaisEmisor').appButtonTextBox({ disabled:true });
               $('#PaisEmisor').val('');
               $('#PaisEmisorId').val('');

               $('#TipoDocumentoIdentidad').val(response.data.Codigo);

               if (!$.isNullOrEmpty(response.data.FormatoValidacion))
                  $('#NumeroDocumentoIdentidad').inputmask(response.data.FormatoValidacion);
               else
                  $('#NumeroDocumentoIdentidad').inputmask('remove');

               if ('@Model.RestriccionPaisEmisorXTipoDocumento'.indexOf(response.data.Codigo) != -1) {
                  $('#PaisEmisor').appButtonTextBox('disabled', { disabled: false });
               } else {
                  $('#PaisEmisor').appButtonTextBox('disabled', { disabled: true });
               }

            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function validarTipoDocumentoIdentidadId(){

      if (!$('#NumeroDocumentoIdentidad').inputmask("isComplete")){
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_numero_doc_identidad_incorrecto")');
         return false;
      }

      if ('@Model.RestriccionPaisEmisorXTipoDocumento'.indexOf($('#TipoDocumentoIdentidad').val()) != -1){
         if (!$('#PaisEmisor').validateString('@SR.GetString("RH_pais_emisor_seleccion_requerida")'))
            return false;
      }

      return true;
   };
