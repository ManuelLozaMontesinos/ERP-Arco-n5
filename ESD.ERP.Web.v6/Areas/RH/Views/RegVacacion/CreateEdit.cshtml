   function remuneraMenuBarOnClick(key) {

      var row = $('#remuneraGrid').appGrid('getSelectedRow');
      var excludeKeys = ['@MenuItemKey.NEW'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {
         case '@MenuItemKey.NEW':
            var initdata = {
               PersonalRemuneracionId: 0,
               PersonalId: $('#PersonalId').val(),
               Monto: 0,
               '@AppConstante.DTO_STATE' : '@(((int) DTOState.Added).ToString())',
               Estado: '@EstadoConstante.ACTIVO'
            };
            $("#remuneraGrid").appGrid('addRow', initdata);
            $("#remuneraMenuBar").appMenu('saveMenu');
            break;

         case '@MenuItemKey.EDIT':
            editarRemuneracionInGrid();
            var rowId = $("#remuneraGrid").appGrid("getSelectedRowId");
            $('#' + rowId + '_MonedaId').prop('disabled', true);
            $('#' + rowId + '_TipoRemuneracionId').prop('disabled', true);
            break;

         case '@MenuItemKey.CANCEL':
            $("#remuneraGrid").appGrid('reloadJSON');
            break;

         case '@MenuItemKey.SAVE':

            var rowId = $("#remuneraGrid").appGrid("getSelectedRowId");

            if (!$('#' + rowId + '_FechaAlta').validateString('@SR.GetString("GEN_fecha_inicio_requerida")'))
               return false;

            $("#remuneraGrid").jqGrid('saveRow', rowId, {url: 'clientArray', aftersavefunc: function (id, response, options) {
               row = $("#remuneraGrid").appGrid('getSelectedRow');

               setModifiedDTO(row);
               $(this).saveView({
                  urlAction: '@Url.Action("GrabarPersonalRemuneracion", "Personal")',
                  viewModel: [
                     { name: "PersonalRemuneracionDTO.PersonalRemuneracionId", value: row.PersonalRemuneracionId, type: 'int' },
                     { name: "PersonalRemuneracionDTO.PersonalId", value: $('#PersonalId').val(), type: 'int' },
                     { name: "PersonalRemuneracionDTO.TipoRemuneracionId", value: row.TipoRemuneracionId, type: 'int' },
                     { name: "PersonalRemuneracionDTO.MonedaId", value: row.MonedaId, type: 'int' },
                     { name: "PersonalRemuneracionDTO.Monto", value: row.Monto, type: 'decimal' },
                     { name: "PersonalRemuneracionDTO.FechaAlta", value: row.FechaAlta, type: 'date' },
                     { name: "PersonalRemuneracionDTO.FechaBaja", value: row.FechaBaja, type: 'date' },
                     { name: "PersonalRemuneracionDTO.DTOState", value: row.DTOState, type: 'int' }
                  ],
                  onSuccess: function (response) {
                     if (response.success) {
                        $("#remuneraGrid").appGrid('reloadJSON');
                        msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                     } else {
                        msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        $("#remuneraMenuBar").appMenu('saveMenu');
                     }
                  }
               });
            }});
            break;
      }
      return true;
   };
   function editarRemuneracionInGrid() {
      var rowId = $("#remuneraGrid").appGrid("getSelectedRowId");
      $('#remuneraGrid').jqGrid('editRow', rowId);

      $("#remuneraMenuBar").appMenu('saveMenu');
   };
   function dependienteMenuBarOnClick(key) {

      var row = $('#dependienteGrid').appGrid('getSelectedRow');
      var excludeKeys = ['@MenuItemKey.NEW'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {
         case '@MenuItemKey.NEW':
            var initdata = {
               PersonalDependienteId: 0,
               PersonalId: $('#PersonalId').val(),
               '@AppConstante.DTO_STATE' : '@(((int) DTOState.Added).ToString())',
               Estado: '@EstadoConstante.ACTIVO'
            };
            $("#dependienteGrid").appGrid('addRow', initdata);
            $("#dependienteMenuBar").appMenu('saveMenu');
            $('#dependienteEditPopup').showDialog({ editAction : '@ViewModelEditAction.New'});
            break;

         case '@MenuItemKey.EDIT':
            $('#dependienteEditPopup').showDialog({ editAction : '@ViewModelEditAction.Edit'});
            break;

         case 'baja':
            $('#bajaEditPopup').showDialog({ editAction : '@ViewModelEditAction.Edit'});
            break;
      }
      return true;
   };
   function dependienteEditPopupOnClick(key) {

      switch (key) {
         case 'ok':
            if (!mp_validarDatos())
               return false;

            var row = $("#dependienteGrid").appGrid("getSelectedRow");
            setModifiedDTO(row);

            $('#dependienteEditPopup').saveView({
               viewModel: [
                  { name: "PersonalDependienteDTO.PersonalDependienteId", value: $('#mp-PersonalDependienteId').val(), type: 'int' },
                  { name: "PersonalDependienteDTO.PersonalId", value: $('#PersonalId').val(), type:'int' },
                  { name: "PersonalDependienteDTO.TipoDocumentoIdentidadId", value: $('#mp-TipoDocumentoIdentidadId').val(), type: 'int' },
                  { name: "PersonalDependienteDTO.NumeroDocumentoIdentidad", value: $('#mp-NumeroDocumentoIdentidad').val() },
                  { name: "PersonalDependienteDTO.PaisEmisorId", value: $('#mp-PaisEmisorId').val(), type: 'int' },
                  { name: "PersonalDependienteDTO.ApellidoPaterno", value: $('#mp-ApellidoPaterno').val() },
                  { name: "PersonalDependienteDTO.ApellidoMaterno", value: $('#mp-ApellidoMaterno').val() },
                  { name: "PersonalDependienteDTO.Nombres", value: $('#mp-Nombres').val() },
                  { name: "PersonalDependienteDTO.FechaNacimiento", value: $('#mp-FechaNacimiento').val(), type: 'date' },
                  { name: "PersonalDependienteDTO.SexoId", value: $('#mp-SexoId').val(), type: 'int' },
                  { name: "PersonalDependienteDTO.VinculoFamiliarId", value: $('#mp-VinculoFamiliarId').val(), type: 'int' },
                  { name: "PersonalDependienteDTO.TipoDocumentoVinculoFamiliarId", value: $('#mp-TipoDocumentoVinculoFamiliarId').val(), type: 'int' },
                  { name: "PersonalDependienteDTO.NumeroDocumentoVinculoFamiliar", value: $('#mp-NumeroDocumentoVinculoFamiliar').val() },
                  { name: "PersonalDependienteDTO.FechaConcepcion", value: $('#mp-FechaConcepcion').val(), type: 'date' },
                  { name: "PersonalDependienteDTO.TipoViaId", value: $('#mp-TipoViaId').val(), type: 'int' },
                  { name: "PersonalDependienteDTO.NombreVia", value: $('#mp-NombreVia').val() },
                  { name: "PersonalDependienteDTO.NumeroVia", value: $('#mp-NumeroVia').val() },
                  { name: "PersonalDependienteDTO.Interior", value: $('#mp-Interior').val() },
                  { name: "PersonalDependienteDTO.Departamento", value: $('#mp-Departamento').val() },
                  { name: "PersonalDependienteDTO.Lote", value: $('#mp-Lote').val() },
                  { name: "PersonalDependienteDTO.Manzana", value: $('#mp-Manzana').val() },
                  { name: "PersonalDependienteDTO.Kilometro", value: $('#mp-Kilometro').val() },
                  { name: "PersonalDependienteDTO.Etapa", value: $('#mp-Etapa').val() },
                  { name: "PersonalDependienteDTO.TipoZonaId", value: $('#mp-TipoZonaId').val(), type: 'int' },
                  { name: "PersonalDependienteDTO.NombreZona", value: $('#mp-NombreZona').val() },
                  { name: "PersonalDependienteDTO.Referencia", value: $('#mp-Referencia').val() },
                  { name: "PersonalDependienteDTO.DistritoId", value: $('#mp-DistritoId').val(), type: 'int' },
                  { name: "PersonalDependienteDTO.Telefono", value: $('#mp-Telefono').val() },
                  { name: "PersonalDependienteDTO.Email", value: $('#mp-Email').val() },
                  { name: "PersonalDependienteDTO.FechaAlta", value: $('#mp-FechaAlta').val(), type: 'date' },
                  { name: "PersonalDependienteDTO.DTOState", value: row.DTOState, type: 'int' }
               ],
               urlAction: '@Url.Action("GrabarPersonalDependiente", "Personal")',
               onSuccess: function (response) {
                  if (response.success) {
                     msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                     $('#dependienteEditPopup').hideDialog();
                     $('#dependienteGrid').appGrid('reloadJSON');
                  } else {
                     msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                  }
               }
            });
            break;

         default:
            $('#dependienteGrid').appGrid('reloadJSON');
            break;
      }
   };
   function editCustomGridMenuBar(key, gridName) {
      if (!$("#PersonalId").validateNumeric())
         $('#' + key).appMenu('disabled');
      else
         $('#' + key).appMenu('editMenu', { gridName: gridName, isEditableGrid: true });
   }
   function bajaEditPopupOnClick() {
      if (!mp_validarDatos())
         return false;

      $('#bajaEditPopup').saveView({
         viewModel: [
            { name: "PersonalDependienteDTO.PersonalDependienteId", value: $('#mp-PersonalDependienteId').val(), type: 'int' },
            { name: "PersonalDependienteDTO.MotivoBajaDependienteId", value: $('#mp-MotivoBajaDependienteId').val(), type:'int' },
            { name: "PersonalDependienteDTO.FechaBaja", value: $('#mp-FechaBaja').val(), type: 'date' }
         ],
         urlAction: '@Url.Action("BajaPersonalDependiente", "Personal")',
         onSuccess: function (response) {
            if (response.success) {
               msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
               $('#bajaEditPopup').hideDialog();
               $('#dependienteGrid').appGrid('reloadJSON');
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });

   };
</script>