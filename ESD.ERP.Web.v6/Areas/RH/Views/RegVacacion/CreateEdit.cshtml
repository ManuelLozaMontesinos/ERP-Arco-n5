@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.Core.Service.DTO;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.RH.Models.PersonalViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="SaveExit" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-textbox for="@Model.PersonalDTO.Codigo" col-position="col-lg-2" label="Codigo" col-label-position="col-lg-2"
                               enable="false"></esd-textbox>
                  <esd-buttontextbox id="Pais" button-style="List" value="@Model.PersonalDTO.PaisDTO.Nombre" col-position="col-lg-2" label="Nacionalidad"
                                     col-label-position="col-lg-2" onclick="paisOnClick"></esd-buttontextbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.ApellidoPaterno" col-position="col-lg-2" label="Apellido Paterno" col-label-position="col-lg-2"
                               max-length="50"></esd-textbox>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.ApellidoMaterno" col-position="col-lg-2" label="Apellido Materno" col-label-position="col-lg-2"
                               max-length="50"></esd-textbox>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Nombres" col-position="col-lg-2" label="Nombres" col-label-position="col-lg-2"
                               max-length="50"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoDocumentoIdentidadId" for="@Model.TipoDocumentoIdentidadList" col-position="col-lg-2" label="Tipo Doc. Identidad"
                                    col-label-position="col-lg-2" onchange="tipoDocumentoIdentidadIdOnChange()"></esd-dropdownlist>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2"
                               max-length="20"></esd-textbox>
                  <esd-buttontextbox id="PaisEmisor" button-style="List" value="@Model.PersonalDTO.PaisEmisorDTO?.Nombre" col-position="col-lg-2" label="Pais Emisor"
                                     col-label-position="col-lg-2" enable="false" onclick="paisEmisorOnClick"></esd-buttontextbox>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker for="@Model.PersonalDTO.FechaNacimiento" col-position="col-lg-2" label="Fecha Nacimiento" col-label-position="col-lg-2"></esd-datetimepicker>
                  <esd-dropdownlist id="SexoId" for="@Model.SexoList" col-position="col-lg-2" label="Sexo" col-label-position="col-lg-2"></esd-dropdownlist>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Telefono" col-position="col-lg-2" label="Telefono" col-label-position="col-lg-2"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoViaId" for="@Model.TipoViaList" col-position="col-lg-2" label="Tipo de Via"
                                    col-label-position="col-lg-2"></esd-dropdownlist>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.NombreVia" col-position="col-lg-3" label="Nombre" col-label-position="col-lg-1"
                               max-length="50"></esd-textbox>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.NumeroVia" col-position="col-lg-1" label="Numero" col-label-position="col-lg-1"
                               max-length="10"></esd-textbox>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Interior" col-position="col-lg-1" label="Interior" col-label-position="col-lg-1"
                               max-length="10"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Departamento" col-position="col-lg-1" label="#Dpto" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Lote" col-position="col-lg-2" label="Lote" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Manzana" col-position="col-lg-1" label="Manzana" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Kilometro" col-position="col-lg-1" label="KM" col-label-position="col-lg-1"
                               max-length="10"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Block" col-position="col-lg-1" label="Block" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.Etapa" col-position="col-lg-2" label="Etapa" col-label-position="col-lg-2"
                               max-length="10"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoZonaId" for="@Model.TipoZonaList" col-position="col-lg-2" label="Tipo de Zona"
                                    col-label-position="col-lg-2"></esd-dropdownlist>
                  <esd-textbox for="@Model.PersonalDTO.ProveedorDTO.NombreZona" col-position="col-lg-3" label="Nombre" col-label-position="col-lg-1"
                               max-length="50"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="DepartamentoId" for="@Model.DepartamentoList" selected-value="@Model.DepartamentoId" col-position="col-lg-2" label="Departamento"
                                    col-label-position="col-lg-2" onchange="departamentoIdOnChange();"></esd-dropdownlist>
                  <esd-dropdownlist id="ProvinciaId" for="@Model.ProvinciaList" selected-value="@Model.ProvinciaId" col-position="col-lg-3" label="Provincia"
                                    col-label-position="col-lg-1" onchange="provinciaIdOnChange();"></esd-dropdownlist>
                  <esd-dropdownlist id="DistritoId" for="@Model.DistritoList" selected-value="@Model.PersonalDTO.ProveedorDTO.DistritoId" col-position="col-lg-3" label="Distrito"
                                    col-label-position="col-lg-1"></esd-dropdownlist>
               </div>
            </div>
         </div>
      </div>
      <esd-viewmodelstate for="@Model.ViewModelState.Value"></esd-viewmodelstate>
      <esd-hidden for="@Model.PersonalDTO.PersonalId"></esd-hidden>
      <esd-hidden for="@Model.PersonalDTO.ProveedorId"></esd-hidden>
      <esd-hidden for="@Model.PersonalDTO.PaisId"></esd-hidden>
      <esd-hidden for="@Model.PersonalDTO.PaisEmisorId"></esd-hidden>
      <esd-hidden for="@Model.TipoDocumentoIdentidad"></esd-hidden>
      <esd-hidden for="@Model.PersonalDTO.CargoPersonalId"></esd-hidden>
      <esd-hidden id="MonedaList" value="@Model.MonedaString"></esd-hidden>
      <esd-hidden id="TipoRemuneracionList" value="@Model.TipoRemuneracionString"></esd-hidden>
   </div>
   <div>
      <ul class="nav nav-tabs" role="tablist" id="detailTab">
         <li class="nav-item">
            <a class="nav-link active" href="#principalTab" role="tab" data-toggle="tab">Datos Principales</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#complementaTab" role="tab" data-toggle="tab">Datos Complementarios</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#periodoTab" role="tab" data-toggle="tab">Periodo Laboral</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#remuneraTab" role="tab" data-toggle="tab">Remuneraciones</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#dependienteTab" role="tab" data-toggle="tab">Derecho Habientes</a>
         </li>
      </ul>
      <div class="tab-content">
         <div class="tab-pane active" id="principalTab" role="tabpanel">
            <div class="card">
               <div class="card-body">
                  <div class="row">
                     <div class="col-12">
                        <div class="form-group row">
                           <esd-datetimepicker for="@Model.PersonalDTO.FechaIngreso" col-position="col-lg-2" label="Fecha Ingreso"
                                               col-label-position="col-lg-2"></esd-datetimepicker>
                           <esd-dropdownlist id="CentroCostoId" for="@Model.CentroCostoList" col-position="col-lg-2" label="C. Costo"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="TipoTrabajadorId" for="@Model.TipoTrabajadorList" col-position="col-lg-2" label="Tipo de Trabajador"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-dropdownlist id="CategoriaOcupacionalId" for="@Model.CategoriaOcupacionalList" col-position="col-lg-2" label="Cat. Ocupacional"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-dropdownlist id="RegimenLaboralId" for="@Model.RegimenLaboralList" col-position="col-lg-2" label="Regimen Laboral"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="SituacionEducativaId" for="@Model.SituacionEducativaList" col-position="col-lg-2" label="Situacion Educativa"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-buttontextbox id="CargoPersonal" button-style="List" value="@Model.PersonalDTO.CargoPersonalDTO?.Nombre" col-position="col-lg-2" label="Cargo"
                                              col-label-position="col-lg-2" enable="false" onclick="cargoPersonalOnClick"></esd-buttontextbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="RegimenPensionarioId" for="@Model.RegimenPensionarioList" col-position="col-lg-2" label="Regimen Pensionario"
                                             onchange="regimenPensionarioIdOnChange();" col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-datetimepicker for="@Model.PersonalDTO.FechaInscripcionRegimenPensionario" col-position="col-lg-2" label="Fecha Inscripcion" col-label-position="col-lg-2"></esd-datetimepicker>
                           <esd-textbox for="@Model.PersonalDTO.NumeroCuspp" col-position="col-lg-2" label="CUSPP" col-label-position="col-lg-2"
                                        max-length="15"></esd-textbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="RegimenPensionarioEsquemaId" for="@Model.RegimenPensionarioEsquemaList" col-position="col-lg-2" label="Tipo de Comisión"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="SctrSaludId" for="@Model.SctrSaludList" col-position="col-lg-2" label="SCTR Salud"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-dropdownlist id="TipoModalidadFormativaId" for="@Model.TipoModalidadFormativaList" col-position="col-lg-2" label="Modalidad Formativa"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="EstadoCivilId" for="@Model.EstadoCivilList" col-position="col-lg-2" label="Estado Civil"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-checkbox for="@Model.PersonalDTO.EsDiscapacitado" col-position="offset-lg-2 col-lg-2"
                                         label="Es Discapacitado"></esd-checkbox>
                        </div>
                        <div class="form-group row">
                           <br />
                        </div>
                     </div>
                  </div>
               </div>
            </div>
         </div>
         <div class="tab-pane" id="complementaTab" role="tabpanel">
            <div class="card">
               <div class="card-body">
                  <div class="row">
                     <div class="col-12">
                        <div class="form-group row">
                           <esd-dropdownlist id="TipoContratoId" for="@Model.TipoContratoList" col-position="col-lg-2" label="Tipo de Contrato"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-dropdownlist id="SituacionEspecialTrabajadorId" for="@Model.SituacionEspecialTrabajadorList" col-position="col-lg-2" label="Situacion Especial"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="TipoPagoRemuneracionId" for="@Model.TipoPagoRemuneracionList" col-position="col-lg-2" label="Tipo de Pago"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-dropdownlist id="PeriodicidadRemunerativaId" for="@Model.PeriodicidadRemunerativaList" col-position="col-lg-2" label="Periodicidad Remunerativa"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="BancoId" for="@Model.BancoList" col-position="col-lg-2" label="Banco Abono"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-textbox for="@Model.PersonalDTO.NumeroCuentaAbono" col-position="col-lg-2" label="#Cuenta Abono" col-label-position="col-lg-2"
                                        max-length="15"></esd-textbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="BancoCTSId" for="@Model.BancoCTSList" col-position="col-lg-2" label="Banco CTS"
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                           <esd-textbox for="@Model.PersonalDTO.NumeroCuentaCTS" col-position="col-lg-2" label="#Cuenta CTS" col-label-position="col-lg-2"
                                        max-length="15"></esd-textbox>
                        </div>
                        <div class="form-group row">
                           <esd-dropdownlist id="ConvenioDobleTributacionId" for="@Model.ConvenioDobleTributacionList" col-position="col-lg-2" label="Convenio Doble Trib."
                                             col-label-position="col-lg-2"></esd-dropdownlist>
                        </div>
                        <div class="form-group row">
                           <esd-checkbox for="@Model.PersonalDTO.EsRegimenAtipico" col-position="offset-lg-2 col-lg-2"
                                         label="Regimen Atípico"></esd-checkbox>
                           <esd-checkbox for="@Model.PersonalDTO.EsJornadaTrabajoMaxima" col-position="offset-lg-2 col-lg-2"
                                         label="Jornada Máxima"></esd-checkbox>
                           <esd-checkbox for="@Model.PersonalDTO.EsJornadaTrabajoNocturna" col-position="offset-lg-2 col-lg-2"
                                         label="Jornada Nocturna"></esd-checkbox>
                        </div>
                        <div class="form-group row">
                           <esd-checkbox for="@Model.PersonalDTO.EsMiembroSindicalizado" col-position="offset-lg-2 col-lg-2"
                                         label="Sindicalizado"></esd-checkbox>
                           <esd-checkbox for="@Model.PersonalDTO.EsExonerado5ta" col-position="offset-lg-2 col-lg-2"
                                         label="Exonerado 5ta Cat."></esd-checkbox>
                           <esd-checkbox for="@Model.PersonalDTO.AsignacionFamiliar" col-position="offset-lg-2 col-lg-2"
                                         label="Asignacion Familiar"></esd-checkbox>
                        </div>
                     </div>
                  </div>
               </div>
            </div>
         </div>
         <div class="tab-pane container" id="periodoTab">
            <div id="periodoContainer">
               <table id="periodoGrid"></table>
               <div id="periodoPager"></div>
            </div>
         </div>
         <div class="tab-pane container" id="remuneraTab">
            <div>
               <esd-menubar id="remuneraMenuBar" size="Small" menu-style="NewEditAndSaveCancel" onclick="remuneraMenuBarOnClick"></esd-menubar>
            </div>
            <div id="remuneraContainer">
               <table id="remuneraGrid"></table>
               <div id="remuneraPager"></div>
            </div>
         </div>
         <div class="tab-pane container" id="dependienteTab">
            <div>
               <esd-menubar id="dependienteMenuBar" size="Small" for="@Model.MenuItemList" onclick="dependienteMenuBarOnClick"></esd-menubar>
            </div>
            <div id="dependienteContainer">
               <table id="dependienteGrid"></table>
               <div id="dependientePager"></div>
            </div>
         </div>
      </div>
   </div>
</section>
<esd-dialog id="paisListPopup" title="Pais" onclick="paisListPopupOnClick">
   <div id="paisListPopupContent"></div>
</esd-dialog>
<esd-dialog id="paisEmisorListPopup" title="Pais Emisor" onclick="paisEmisorListPopupOnClick">
   <div id="paisEmisorListPopupContent"></div>
</esd-dialog>
<esd-dialog id="cargoPersonalListPopup" title="Pais" onclick="cargoPersonalListPopupOnClick">
   <div id="cargoPersonalListPopupContent"></div>
</esd-dialog>
<esd-dialog id="dependienteEditPopup" title="Derecho Habiente" onclick="dependienteEditPopupOnClick" size="Large" enable-dismissclick="true">
   <div id="dependienteEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="emisorDepListPopup" title="Pais Emisor" onclick="emisorDepListPopupOnClick">
   <div id="emisorDepListPopupContent"></div>
</esd-dialog>
<esd-dialog id="bajaEditPopup" title="Derecho Habiente - Baja" onclick="bajaEditPopupOnClick">
   <div id="bajaEditPopupContent"></div>
</esd-dialog>
<script type="text/javascript">

   $(document).ready(function () {

      $('#NumeroDocumentoIdentidad').inputmask('@Model.FormatoValidacion');

      $("#periodoGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarPeriodoLaboral", "Personal")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "PersonalPeriodoLaboralDTO.PersonalId", value: $('#PersonalId').val()||'0', type:'int' }
                  ]
               ));
            }
         },
         colNames: ['', '', 'Fecha Ingreso', 'Fecha Cese','Motivo Cese','',''],
         colModel: [
            { name: 'PersonalRemuneracionId', hidden: true },
            { name: 'PersonalId', hidden: true },
            { name: "FechaIngreso", width: 110, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: "FechaCese", width: 110, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: 'MotivoFinPeriodo', width: 300 },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#periodoPager",
         gridComplete: function () {
            $("#periodoGrid").appGrid('resizeGrid', 'periodoContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('periodoContainer')
      });
      $("#remuneraGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarPersonalRemuneracion", "Personal")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "PersonalRemuneracionDTO.PersonalId", value: $('#PersonalId').val()||'0', type:'int' }
                  ]
               ));
            }
         },
         colNames: ['', '','Tipo', 'Moneda', 'Monto', 'Fecha Inicio', 'Fecha Fin','',''],
         colModel: [
            { name: 'PersonalRemuneracionId', hidden: true },
            { name: 'PersonalId', hidden: true },
            {
               name: 'TipoRemuneracionId', width: 120, editable: true, edittype: 'select', formatter: 'select', sortable: false,
               editoptions: {
                  class: 'form-control-sm',
                  value: $('#TipoRemuneracionList').val()
               },
               editrules: { required: true }
            },
            {
               name: 'MonedaId', width: 120, editable: true, edittype: 'select', formatter: 'select', sortable: false,
               editoptions: {
                  class: 'form-control-sm',
                  value: $('#MonedaList').val()
               },
               editrules: { required: true }
            },
            {
               name: "Monto", width: 100, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 2, allowMinus: false });
                  }
               }
            },
            {
               name: "FechaAlta", width: 110, align: 'right', editable: true, sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT',
               editoptions:
               {
                  class: 'form-control-sm',
                  dataInit: function(elem) {
                     $(elem).inputmask({
                        alias: 'datetime',
                        inputFormat: '@JavaScriptConstant.DATE_FORMAT.ToLower()',
                        clearIncomplete: true
                     });
                  }
               }
            },
            {
               name: "FechaBaja", width: 110, align: 'right', editable: true, sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT',
               editoptions:
               {
                  class: 'form-control-sm',
                  dataInit: function(elem) {
                     $(elem).inputmask({
                        alias: 'datetime',
                        inputFormat: '@JavaScriptConstant.DATE_FORMAT.ToLower()',
                        clearIncomplete: true
                     });
                  }
               }
            },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#remuneraPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            var editableRows = $('#remuneraGrid').appGrid('editableRowsCount');
            if (editableRows == 0) {
               editCustomGridMenuBar('remuneraMenuBar', 'remuneraGrid');

               var row = $('#remuneraGrid').appGrid('getSelectedRow');
               if (!$.isNullOrEmpty(row.FechaBaja))
                  $("#remuneraMenuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.EDIT', disabled: true });
            }
            else
               $("#remuneraMenuBar").appMenu('saveMenu');
         },
         gridComplete: function () {
            editCustomGridMenuBar('remuneraMenuBar', 'remuneraGrid');
            $("#remuneraGrid").appGrid('resizeGrid', 'remuneraContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('remuneraContainer')
      });
      $("#dependienteGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarPersonalDependiente", "Personal")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "PersonalDependienteDTO.PersonalId", value: $('#PersonalId').val()||'0', type:'int' }
                  ]
               ));
            }
         },
         colNames: ['', '', 'T/D', '#Doc.','Nombres','A. Paterno','A. Materno','Fecha Alta', 'Fecha Baja','Motivo Baja','',''],
         colModel: [
            { name: 'PersonalDependienteId', hidden: true },
            { name: 'PersonalId', hidden: true },
            { name: 'TipoDocumentoIdentidad', width: 80 },
            { name: 'NumeroDocumentoIdentidad', width: 80 },
            { name: 'Nombres', width: 150 },
            { name: 'ApellidoPaterno', width: 150 },
            { name: 'ApellidoMaterno', width: 150 },
            { name: "FechaAlta", width: 110, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: "FechaBaja", width: 110, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: 'MotivoBajaDependiente', width: 200 },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#dependientePager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            var editableRows = $('#dependienteGrid').appGrid('editableRowsCount');
            if (editableRows == 0) {
