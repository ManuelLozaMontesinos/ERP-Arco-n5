@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.RH.Models.PrestamoViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="CRUD" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-textbox id="RazonSocial" col-position="col-lg-10" label="Apellidos y Nombres" col-label-position="col-lg-2" max-length="150"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-4" label="#Documento" col-label-position="col-lg-2" max-length="35"></esd-textbox>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "Prestamo")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "PrestamoPersonalDTO.PersonalDTO.ProveedorDTO.RazonSocial", value: $('#RazonSocial').val() },
                     { name: "PrestamoPersonalDTO.PersonalDTO.ProveedorDTO.NumeroDocumentoIdentidad", value: $('#NumeroDocumentoIdentidad').val() }
                  ]
               ));
            }
         },
         colNames: ['', 'Codigo','Fecha','T / D','#Documento','Apellidos y Nombres','Mon.','Monto','Tipo','Estado',''],
         colModel: [
            { name: 'PrestamoPersonalId', hidden: true },
            { name: "Codigo", width: 70 },
            { name: "Fecha", width: 90, align:'right', sorttype:'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT'},
            { name: "TipoDocumentoIdentidad", width: 80 },
            { name: "NumeroDocumentoIdentidad", width: 80 },
            { name: "RazonSocial", width: 250 },
            { name: "MonedaNombre", width: 120 },
            { name: "Monto", width: 120, align: 'right', formatter: 'number' },
            { name: "TipoPrestamo", width: 120 },
            { name: "EstadoNombre", width: 150 },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });

            var row = $('#bandejaGrid').appGrid('getSelectedRow');
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $("#PlanillaId").val('');
      $("#MesId").val('');
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#PlanillaId, #MesId").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
   });
   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW','@MenuItemKey.EXIT'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {

         case '@MenuItemKey.NEW':
            $(this).getView({
               editAction: '@ViewModelEditAction.New',
               buttonId: key,
               viewModel: [
                  { name: "PrestamoPersonalDTO.PrestamoPersonalId", value: 0, type: 'int' }
               ],
               urlAction: '@Url.Action("Crear", "Prestamo")'
            });
            break;

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "PrestamoPersonalDTO.PrestamoPersonalId", value: row.PrestamoPersonalId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "Prestamo")'
            });
            break;

         case '@MenuItemKey.DELETE':
            $('#menuBar').appMenu('disabledButton', { buttonId: key, disabled: true });
            $(this).confirm({
               title: '@SR.GetString("APPMP_anular_titulo")',
               message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
               onConfirm: function () {
                  $(this).getAction({
                     urlAction: '@Url.Action("Eliminar", "Prestamo")',
                     id: row.PrestamoPersonalId,
                     showLoading: true,
                     hideLoading: true,
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#bandejaGrid').appGrid('reloadJSON');
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
            break;
      }
      return true;
   };
</script>