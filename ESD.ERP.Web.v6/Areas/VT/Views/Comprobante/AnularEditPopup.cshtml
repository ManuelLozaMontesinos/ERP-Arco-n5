@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.VT.Models.ComprobanteViewModel
<div id="mp-edit-panel">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <div class="offset-1">@SR.GetString("GEN_registro_seleccionado_anular_pregunta")</div>
               </div>
               <div>
                  <br/>
               </div>
               <div class="form-group row">
                  <esd-textarea for="@Model.ComprobanteDTO.Observacion" col-position="col-lg-10" label="Justificación" col-label-position="col-lg-2"
                                max-length="400" rows="3" in-modal="true"></esd-textarea>
               </div>
            </div>
         </div>
      </div>
   </div>
   <esd-hidden for="@Model.ComprobanteDTO.CotizacionId" in-modal="true"></esd-hidden>
</div>
<script type="text/javascript">
   function mp_validarDatos() {

      if (!$('#mp-Observacion').validateString('@SR.GetString("GEN_justificacion_anulacion_requerida")'))
         return false;

      return true;
   };
</script>