@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.VT.Models.ComprobanteViewModel
<esd-menubar id="menuBar" Title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-textbox id="Numero" col-position="col-lg-2" label="Numero" col-label-position="col-lg-2" max-length="8"></esd-textbox>
                  <esd-textbox id="Cotizacion" col-position="col-lg-2" label="#Pedido" col-label-position="col-lg-2" max-length="7"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Doc. Iden" col-label-position="col-lg-2" max-length="35"></esd-textbox>
                  <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Razon Social" col-label-position="col-lg-2" max-length="150"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.Vendedor" col-position="col-lg-6" label="Vendedor" col-label-position="col-lg-2" max-length="150"></esd-textbox>
                  <esd-dropdownlist id="EstadoComprobanteId" for="@Model.EstadoComprobanteList" col-position="col-lg-2" label="Estado" col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker id="FechaDesde" col-position="col-lg-2" label="Desde" col-label-position="col-lg-2"></esd-datetimepicker>
                  <esd-datetimepicker id="FechaHasta" col-position="col-lg-2" label="Hasta" col-label-position="col-lg-2"></esd-datetimepicker>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<esd-dialog id="anularEditPopup" title="@SR.GetString("APPMP_anular_titulo")" onclick="anularEditPopupOnClick">
   <div id="anularEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="saldoListPopup" title="Lista de Precios" onclick="catalogoListPopupOnClick" size="Large">
   <div id="saldoListPopupContent"></div>
</esd-dialog>
<esd-dialog id="comprobanteTrazaListPopup" title="Trazabilidad" size="Large" button-style="Close">
   <div id="comprobanteTrazaListPopupContent"></div>
</esd-dialog>
<script type="text/javascript">
   $(document).ready(function () {

      var dashboardComprobanteFiltro = {
         cotizacionId: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DashboardCotizacionId ?? 0)),
         pedidoCodigo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DashboardPedidoCodigo ?? string.Empty)),
         clienteDocumento: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DashboardClienteDocumento ?? string.Empty)),
         clienteNombre: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.DashboardClienteNombre ?? string.Empty))
      };
      window.dashboardComprobanteCotizacionId = Number(dashboardComprobanteFiltro.cotizacionId) || null;
      if (dashboardComprobanteFiltro.pedidoCodigo) {
         $('#Cotizacion').val(dashboardComprobanteFiltro.pedidoCodigo);
      }
      if (dashboardComprobanteFiltro.clienteDocumento) {
         $('#NumeroDocumentoIdentidad').val(dashboardComprobanteFiltro.clienteDocumento);
      }
      if (dashboardComprobanteFiltro.clienteNombre) {
          $('#Numero, #Cotizacion, #NumeroDocumentoIdentidad, #Vendedor, #EstadoComprobanteId, #FechaDesde, #FechaHasta').val('');
         $('#RazonSocial').val(dashboardComprobanteFiltro.clienteNombre);
      }

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         sortname: 'Fecha',
         sortorder: 'desc',
         url: "@Url.Action("ListarBandeja", "Comprobante")",
         postData: {
            jsonModel: function () {
               var filtros = [
                     { name: "ComprobanteDTO.Numero", value: $('#Numero').val() },
                     { name: "ComprobanteDTO.CotizacionDTO.Codigo", value: $('#Cotizacion').val() },
                     { name: "ComprobanteDTO.ProveedorDTO.NumeroDocumentoIdentidad", value: $('#NumeroDocumentoIdentidad').val() },
                     { name: "ComprobanteDTO.ProveedorDTO.RazonSocial", value: $('#RazonSocial').val() },
                     { name: "ComprobanteDTO.VendedorDTO.ProveedorDTO.RazonSocial", value: $('#Vendedor').val() },
                     { name: "ComprobanteDTO.EstadoComprobanteId", value: $('#EstadoComprobanteId').val() ||0, type:'int' },
                     { name: "ComprobanteDTO.FechaDesde", value: $('#FechaDesde').val(), type: 'date' },
                     { name: "ComprobanteDTO.FechaHasta", value: $('#FechaHasta').val(), type: 'date' }
               ];
               if (window.dashboardComprobanteCotizacionId) {
                  filtros.push({
                     name: "ComprobanteDTO.CotizacionId",
                     value: window.dashboardComprobanteCotizacionId,
                     type: 'int'
                  });
               }
               return JSON.stringify(modelToObject(filtros));
            }
         },
         colNames: ['', '', 'T/D', 'Serie-Numero', 'Fecha', 'Cliente', '#Doc', '', '#Pedido', 'Vendedor', 'Mon.', 'Total', '','', 'Estado',
            '', 'Estado SUNAT','', '', ''],
         colModel: [
            { name: 'ComprobanteId', hidden: true },
             {name: 'ListaPrecioId', hidden: true},
            { name: "TipoDocumentoComercialNombre", width: 50 },
            { name: "SerieNumero", width: 90 },
            { name: "Fecha", width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: "RazonSocial", width: 300 },
            { name: "NumeroDocumentoIdentidad", width: 100 },
            { name: 'CotizacionId', hidden: true },
            { name: "CotizacionPedido", width: 60 },
            { name: "VendedorNombre", width: 240 },
            { name: "Moneda", width: 40 },
            { name: "MontoTotal", width: 100, align: 'right', formatter: 'number', sorttype: 'number'},
            { name: 'TipoComprobante', hidden: true },
            { name: 'EstadoComprobante', hidden: true },
            { name: "EstadoComprobanteNombre", width: 100 },
            { name: 'EstadoSunat', hidden: true },
            { name: "EstadoSunatNombre", width: 120 },
            { name: 'PermitirEliminar', hidden: true },
            { name: 'TipoDocumentoComprob', hidden: true },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#menuBar").appMenu('disabledButton', { buttonList: 'consulta,traza', disabled: false });

            var row = $('#bandejaGrid').appGrid('getSelectedRow');

            if (!$.isNullOrEmpty(row.EstadoSunat)) {
               $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.DELETE', disabled: true });

               switch (row.EstadoSunat) {
                  case '@EstadoSunatConstante.PENDIENTE_GENERAR':
                  case '@EstadoSunatConstante.PENDIENTE_ENVIO':
                  case '@EstadoSunatConstante.RECHAZADO':
                  case '@EstadoSunatConstante.ARCHIVO_CON_ERROR':
                     $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.DELETE', disabled: false });
                     break;
               }

               if (row.TipoComprobante === '@TipoComprobanteConstante.TEMPORAL')
                  $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.DELETE', disabled: true });
            }

            if (row.PermitirEliminar === '@SiNoConstante.N' && row.Estado === '@EstadoConstante.ACTIVO')
               $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.DELETE', disabled: true });

            if (row.TipoDocumentoComprob === '@TipoDocumentoComercialConstante.INTERNO' && row.Estado === '@EstadoConstante.ACTIVO')
               $("#menuBar").appMenu('disabledButton', { buttonId: 'anularInt', disabled: false });
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
            $("#menuBar").appMenu('disabledButton', { buttonId: 'consulta', disabled: false });
            $("#menuBar").appMenu('disabledButton', { buttonId: 'anularInt', disabled: true });
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });

      $('#anularEditPopup').setDialog({
         onShow: function (p) {
            var row = $('#bandejaGrid').appGrid('getSelectedRow');

            $(this).getView({
               urlAction: '@Url.Action("AnularEditPopup", "Comprobante")',
               container: 'anularEditPopupContent',
               showLoading: false,
               hideLoading: false
            });
         },
      });
      $('#saldoListPopup').setDialog({
         onShow: function (p) {
            $(this).getView({
               urlAction: '@Url.Action("SaldoListPopup", "ListaPrecio")',
               container: 'saldoListPopupContent',
               selModel: [
                  { name: "Moneda", value: '@MonedaConstante.SOLES' },
                  { name: "ListaPrecioId", type: 'firstElement' },
               ],
               showLoading: false,
               hideLoading: false
            });
         },
         onShown: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         }
      });
      $('#comprobanteTrazaListPopup').setDialog({
         onShow: function (p) {
            var row = $('#bandejaGrid').appGrid('getSelectedRow');

            $(this).getView({
               urlAction: '@Url.Action("ComprobanteTrazaListPopup", "Comprobante")',
               container: 'comprobanteTrazaListPopupContent',
               viewModel: [
                  { name: "ComprobanteDTO.ComprobanteId", value: row.ComprobanteId, type: 'int' }
               ],
               showLoading: false,
               hideLoading: false
            });
         },
         onShown: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         }
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      if (!dashboardComprobanteFiltro.clienteNombre) {
         $('#Vendedor').val('@Model.Vendedor');
      } else {
         $('#Vendedor').val('');
      }
      window.dashboardComprobanteCotizacionId = null;
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $('#Cotizacion').on('input', function () {
         window.dashboardComprobanteCotizacionId = null;
      });
      $("#Numero,#Cotizacion, #NumeroDocumentoIdentidad, #RazonSocial,#Vendedor,#EstadoComprobanteId").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
      $("#Numero").keydown(function (e) {
         if (event.which == 13) {
            if (!$.isNullOrEmpty($("#Numero").val())) {
               var valueFmt = padLeadingZeros($("#Numero").val(), 8)
               $("#Numero").val(valueFmt);
            }
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
      $("#Cotizacion").keydown(function (e) {
         if (event.which == 13) {
            if (!$.isNullOrEmpty($("#Cotizacion").val())) {
               var valueFmt = padLeadingZeros($("#Cotizacion").val(), 7)
               $("#Cotizacion").val(valueFmt);
            }
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
       $("#FechaDesde-ddiv, #FechaHasta-ddiv").on('change.datetimepicker', function () {
          $('#bandejaGrid').appGrid('reloadJSON');
       });
       $("#FechaDesde, #FechaHasta").keydown(function (e) {
          if (e.which == 13) {
             e.preventDefault();
             $('#bandejaGrid').appGrid('reloadJSON');
          }
       });
   });
   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW','consulta'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {

         case '@MenuItemKey.NEW':
            $(this).getView({
               editAction: '@ViewModelEditAction.New',
               buttonId: key,
               viewModel: [
                  { name: "ComprobanteDTO.ComprobanteId", value: 0, type: 'int' }
               ],
               urlAction: '@Url.Action("Crear", "Comprobante")'
            });
            break;

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "ComprobanteDTO.ComprobanteId", value: row.ComprobanteId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "Comprobante")'
            });
            break;

         case '@MenuItemKey.DELETE':
            $('#menuBar').appMenu('disabledButton', { buttonId: key, disabled: true });
            $('#anularEditPopup').showDialog();
            break;

         case '@MenuItemKey.PREVIEW':
            var reportParam = "comprobanteId=" + row.ComprobanteId + "&listaPrecioId=" + row.ListaPrecioId;

            $(this).getReport({
               buttonId: key,
               urlAction: '@Url.Action("ReportTo", "Comprobante")',
               parameters: reportParam,
               onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
            });
            break;

         case 'consulta':
            $('#saldoListPopup').showDialog();
            break;

         case 'traza':
            $('#comprobanteTrazaListPopup').showDialog();
            break;
         
         case 'anularInt':
            $('#menuBar').appMenu('disabledButton', { buttonId: key, disabled: true });
            $('#anularEditPopup').showDialog();
            break;
      }
      return true;
   };
   function anularEditPopupOnClick() {

      if (!mp_validarDatos())
         return true;

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      $('#anularEditPopup').saveView({
         urlAction: '@Url.Action("Eliminar", "Comprobante")',
         viewModel: [
            { name: "ComprobanteDTO.ComprobanteId", value: row.ComprobanteId, type: 'int' },
            { name: "ComprobanteDTO.Codigo", value: row.Codigo },
            { name: "ComprobanteDTO.Observacion", value: $('#mp-Observacion').val() }
         ],
         onSuccess: function (response) {
            if (response.success) {
               $('#anularEditPopup').hideDialog();
               $('#bandejaGrid').appGrid('reloadJSON');
               msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   }
</script>
