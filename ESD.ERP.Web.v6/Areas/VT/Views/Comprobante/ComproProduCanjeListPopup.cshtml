@using ESD.Core.Web.JS;
<div id="mp-edit-panel">
   <div class="card-body">
      <div class="row">
         <div class="col-11">
            <div class="form-group row">
               <esd-textbox id="Producto" col-position="col-lg-10" label="Producto" col-label-position="col-lg-2" max-length="100" in-modal="true"></esd-textbox>
            </div>
         </div>
         <div class="col-1">
            <div class="form-group row">
               <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="mp_clearButtonOnClick()"></esd-button>
            </div>
         </div>
      </div>
   </div>
</div>
<div id="bandejaPopupContainer">
   <table id="bandejaPopupGrid"></table>
   <div id="bandejaPopupPager"></div>
</div>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaPopupGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarComproProduCanjePopup", "Comprobante")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "ComprobanteProductoDTO.ProductoDTO.Descripcion", value: $('#mp-Producto').val()}
                  ]
               ));
            }
         },
         colNames: ['', '', '', 'Código', 'Producto', 'U.M.', 'Cantidad', 'P.U.', 'Total', ''],
         colModel: [
            { name: 'ComprobanteProductoId', hidden: true },
            { name: 'ComprobanteId', hidden: true },
            { name: 'ProductoId', hidden: true },
            { name: 'Codigo', width: 90},
            { name: 'ProductoNombre', width: 330, editable: false },
            { name: 'UnidadMedidaNombre', width: 60, editable: false },
            { name: 'Cantidad', width: 80, align: 'right', formatter: 'number' },
            { name: 'PrecioUnitario', width: 80, align: 'right', formatter: 'number' },
            { name: 'MontoTotal', width: 90, align: 'right', formatter: 'number' },
            { name: 'Estado', hidden: true }
         ],
         pager: "#bandejaPopupPager",
         ondblClickRow: function (rowid) {

            var popupParams = getPopupParam('mp-edit-panel')

            var row = $(this).getRowData(rowid);
            comprobanteProductoSelectedPopup(popupParams.dialogId, row);
         },
         gridComplete: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         },
         multiselect: true,
         height: 250
      });
   });
   function mp_clearButtonOnClick() {
      $('#mp-edit-panel').find('input:text').val('');
      $('#bandejaPopupGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#mp-Producto").change(function () {
         $('#bandejaPopupGrid').appGrid('reloadJSON');
      });
   });
</script>