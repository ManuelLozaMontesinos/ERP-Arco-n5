@using ESD.Core;
@using ESD.Core.Web.JS;
@model ESD.ERP.Web.Areas.VT.Models.ComprobanteViewModel
<div id="mp-edit-panel">
   <div class="card-body">
      <div class="row">
         <div class="col-11">
            <div class="form-group row">
               <esd-textbox id="Numero" col-position="col-lg-2" label="Numero" col-label-position="col-lg-2" max-length="8" in-modal="true"></esd-textbox>
               <esd-textbox id="Cotizacion" col-position="col-lg-2" label="#Pedido" col-label-position="col-lg-2" max-length="7" in-modal="true"></esd-textbox>
            </div>
            <div class="form-group row">
               <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2" max-length="35"
                            in-modal="true"></esd-textbox>
               <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Razon Social" col-label-position="col-lg-2" max-length="150"
                            in-modal="true"></esd-textbox>
            </div>
            <div class="form-group row">
               <esd-datetimepicker id="FechaDesde" col-position="col-lg-2" label="Desde" col-label-position="col-lg-2"
                                   in-modal="true"></esd-datetimepicker>
               <esd-datetimepicker id="FechaHasta" col-position="col-lg-2" label="Hasta" col-label-position="col-lg-2"
                                   in-modal="true"></esd-datetimepicker>
            </div>
         </div>
         <div class="col-1">
            <div class="form-group row">
               <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="mp_clearButtonOnClick()"></esd-button>
            </div>
         </div>
      </div>
   </div>
</div>
<div id="bandejaPopupContainer">
   <table id="bandejaPopupGrid"></table>
   <div id="bandejaPopupPager"></div>
</div>
<script type="text/javascript">
   $("#bandejaPopupGrid").jqGrid({
      @GridHelper.DefaultProperties()
      url: "@Url.Action("ListarBandejaDocumentoEmitido", "Comprobante")",
      postData: {
         jsonModel: function () {
            return JSON.stringify(modelToObject(
               [
                  { name: "ComprobanteDTO.Numero", value: $('#mp-Numero').val() },
                  { name: "ComprobanteDTO.ProveedorDTO.NumeroDocumentoIdentidad", value: $('#mp-NumeroDocumentoIdentidad').val() },
                  { name: "ComprobanteDTO.ProveedorDTO.RazonSocial", value: $('#mp-RazonSocial').val() },
                  { name: "ComprobanteDTO.VendedorDTO.ProveedorDTO.RazonSocial", value: $('#mp-Vendedor').val() },
                  { name: "ComprobanteDTO.FechaDesde", value: $('#mp-FechaDesde').val(), type: 'date' },
                  { name: "ComprobanteDTO.FechaHasta", value: $('#mp-FechaHasta').val(), type: 'date' },
                  { name: "ComprobanteDTO.TipoDocumentoComercialDTO.Codigo", value: '@Model.ComprobanteDTO?.TipoDocumentoComercialDTO?.Codigo' },
                  { name: "ComprobanteDTO.TipoDocumentoComercialList", value: JSON.parse('@Html.Raw(Model.ToJson(Model.ComprobanteDTO?.TipoDocumentoComercialList))'), type: 'listString' },
               ]
            ));
         }
      },
      colNames: ['', 'T/D', 'Serie','Numero', 'Fecha', 'Cliente', '#Doc', '', '#Pedido','', 'Vendedor','', 'Mon.', 'Total', '', 'Estado',''],
      colModel: [
         { name: 'ComprobanteId', hidden: true },
         { name: "TipoDocumentoComercialNombre", width: 50 },
         { name: "Serie", width: 60 },
         { name: "Numero", width: 80 },
         { name: "Fecha", width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
         { name: "RazonSocial", width: 300 },
         { name: "NumeroDocumentoIdentidad", width: 100 },
         { name: 'CotizacionId', hidden: true },
         { name: "CotizacionPedido", width: 70 },
         { name: 'VendedorId', hidden: true },
         { name: "VendedorNombre", width: 250 },
         { name: 'ImpuestoTasaId', hidden: true },
         { name: "Moneda", width: 40 },
         { name: "MontoTotal", width: 100, align: 'right', formatter: 'number', sorttype: 'number'},
         { name: 'EstadoComprobante', hidden: true },
         { name: "EstadoComprobanteNombre", width: 120 },
         { name: 'Estado', hidden: true },
      ],
      pager: "#bandejaPopupPager",
      ondblClickRow: function (rowid) {

         var popupParams = getPopupParam('mp-edit-panel')

         var row = $(this).getRowData(rowid);
         comprobanteSelectedPopup(popupParams.dialogId, row);
      },
      gridComplete: function () {
         $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
      },
      height: 250
   });
   function mp_clearButtonOnClick() {
      $('#mp-edit-panel').find('input:text').val('');
      $('#bandejaPopupGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#mp-Numero,#mp-Cotizacion, #mp-NumeroDocumentoIdentidad, #mp-RazonSocial,#mp-Vendedor").change(function () {
         $('#bandejaPopupGrid').appGrid('reloadJSON');
      });
      $("#mp-Numero").keydown(function (e) {
         if (event.which == 13) {
            if (!$.isNullOrEmpty($("#mp-Numero").val())) {
               var valueFmt = padLeadingZeros($("#mp-Numero").val(), 8)
               $("#mp-Numero").val(valueFmt);
            }
            event.preventDefault();
            $('#bandejaPopupGrid').appGrid('reloadJSON');
         }
      });
      $("#mp-Cotizacion").keydown(function (e) {
         if (event.which == 13) {
            if (!$.isNullOrEmpty($("#mp-Cotizacion").val())) {
               var valueFmt = padLeadingZeros($("#mp-Cotizacion").val(), 7)
               $("#mp-Cotizacion").val(valueFmt);
            }
            event.preventDefault();
            $('#bandejaPopupGrid').appGrid('reloadJSON');
         }
      });
      $("#mp-FechaDesde").keydown(function (e) {
         if (event.which == 13) {
            $("#mp-FechaHasta").val($("#mp-FechaDesde").val());
            event.preventDefault();
            $('#bandejaPopupGrid').appGrid('reloadJSON');
         }
      });
      $("#mp-FechaHasta").keydown(function (e) {
         if (event.which == 13) {
            event.preventDefault();
            $('#bandejaPopupGrid').appGrid('reloadJSON');
         }
      });
   });
</script>