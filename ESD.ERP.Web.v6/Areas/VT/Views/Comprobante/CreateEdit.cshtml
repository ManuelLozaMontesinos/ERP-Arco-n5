   function calcularTotalesGenerales()
   {

      $(this).getAction({
         urlAction: '@Url.Action("ObtenerTotales", "Comprobante")',
         id: $('#ComprobanteId').val() || 0,
         onSuccess: function (response) {
            if (response.success) {
               $('#MontoBruto').val(numeral(response.data.MontoBruto).format('0,0.00'));
               $('#MontoNeto').val(numeral(response.data.MontoNeto).format('0,0.00'));
               $('#MontoIgv').val(numeral(response.data.MontoIgv).format('0,0.00'));
               $('#MontoTotal').val(numeral(response.data.MontoTotal).format('0,0.00'));

               var montoAnticipoDescuento = response.data.MontoAnticipoDescuento;
               var montoSaldo = response.data.MontoTotal;

               montoSaldo = montoSaldo - montoAnticipoDescuento;

               $('#MontoAnticipoDescuento').val(numeral(montoAnticipoDescuento).format('0,0.00'));
               $('#MontoSaldo').val(numeral(montoSaldo).format('0,0.00'));
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function autorizacionEditPopupOnClick() {
      var data = $('#bandejaPopupGrid').appGrid('getData');

      var selectList = _.where(data, { '@AppConstante.DTO_STATE': '@(((int) DTOState.Modified).ToString())' });
      if (selectList.length === 0) {
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("VT_comprobante_autorizacion_seleccion_requerida")');
         return;
      }

      var isValid = true;
      $.each(selectList, function (i, row) {
         if (row.TipoAutorizacion === '@TipoAutorizacionConstante.DSCTO_EN_PRECIO_UNITARIO') {
            data = $('#productoPopupGrid').appGrid('getData');
            var selectProd = _.where(data, { '@AppConstante.DTO_STATE': '@(((int) DTOState.Modified).ToString())' });
            if (selectProd.length === 0) {
               msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("VT_producto_autorizacion_descuento_seleccion_requerida")');
               isValid = false;
               return;
            }
         };
      });

      if (!isValid)
         return;

      $.each(selectList, function (i, row) {
         if (row.TipoAutorizacion === '@TipoAutorizacionConstante.DSCTO_EN_PRECIO_UNITARIO') {
            data = $('#productoPopupGrid').appGrid('getData');
            var selectProd = _.where(data, { '@AppConstante.DTO_STATE': '@(((int) DTOState.Modified).ToString())' });
            if (selectProd.length === 0) {
               msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("VT_producto_autorizacion_descuento_seleccion_requerida")');
               isValid = false;
               return;
            }
         };
      });

      var comprobanteAutorizacionList = [];
      selectList.forEach(function (item) {
         var comprobanteAutorizacion = [
            { name: "ComprobanteAutorizacionId", value: item.ComprobanteAutorizacionId, type: 'int' },
            { name: "TipoAutorizacionId", value: item.TipoAutorizacionId, type: 'int' },
            { name: "ComprobanteId", value: $('#ComprobanteId').val(), type: 'int' }
         ];

         comprobanteAutorizacionList.push(comprobanteAutorizacion);
      });

      var comprobanteProductoList = [];
      $.each(selectList, function (i, row) {
         if (row.TipoAutorizacion === '@TipoAutorizacionConstante.DSCTO_EN_PRECIO_UNITARIO') {
            data = $('#productoPopupGrid').appGrid('getData');
            var selectProd = _.where(data, { '@AppConstante.DTO_STATE': '@(((int) DTOState.Modified).ToString())' });
            selectProd.forEach(function (item) {
               var comprobanteProducto = [
                  { name: "ComprobanteProductoId", value: item.ComprobanteProductoId, type: 'int' },
                  { name: "SolicitaAutorizacionDescuento", value: item.SolicitaAutorizacionDescuento }
               ];

               comprobanteProductoList.push(comprobanteProducto);
            });
         };
      });

      $('#autorizacionEditPopup').saveView({
         viewModel: [
            { name: "ComprobanteAutorizacionDTOList", value: comprobanteAutorizacionList, type: 'list' },
            { name: "ComprobanteProductoDTOList", value: comprobanteProductoList, type: 'list' }
         ],
         urlAction: '@Url.Action("GrabarComprobanteAutorizacion", "Comprobante")',
         onSuccess: function (response) {

            if (response.success) {
               $('#AutorizacionPendiente').val('@SiNoConstante.S');
               $("#menuBar").appMenu('hideButton', { buttonId: 'soli_auto' });
               $("#menuBar").appMenu('showButton', { buttonId: 'estado_auto' });
               msgAlert(msgAlertTypeConstant.SUCCESS, response.message);

            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
            $('#autorizacionEditPopup').hideDialog();
         }
      });

   };
