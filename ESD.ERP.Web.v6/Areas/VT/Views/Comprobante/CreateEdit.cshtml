   function cotizacionSelectedPopup(sourceId, row) {

      if($.isEmpty(row)){
         msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("VT_pedido_seleccion_requerida")');
         return false;
      }

      $('#CotizacionId').val(row.CotizacionId);
      $('#Cotizacion').val(row.Codigo);
      $('#MonedaId').val(row.MonedaId);
      $('#MonedaId').prop('disabled', true);
      $(this).postAction({
         urlAction: '@Url.Action("ListarListaPrecio", "Comprobante")',
         viewModel: [
            { name: "ComprobanteDTO.Fecha", value: $('#Fecha').val(), type: 'date' },
            { name: "ComprobanteDTO.MonedaId", value: row.MonedaId, type: 'int' },
         ],
         onSuccess: function (response) {
            if (response.success) {
               $('#EsLocal').val(response.data.esLocal);
               $("#MontoTipoCambio").val(response.data.montoTipoCambio);
               $('#ListaPrecioId').find('option').remove().end();
               $("#ListaPrecioId").addItems(response.data.list);
               $('#ListaPrecioId').val(row.ListaPrecioId);
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
      sleep(150);
      $('#ProveedorId').val(row.ProveedorId);
      $('#ProveedorCodigo').val(row.Codigo);
      $('#Proveedor').val(row.RazonSocial);
      $('#TipoNaturalezaJuridica').val(row.TipoNaturalezaJuridica);
      $('#NumeroDocumentoIdentidad').val(row.NumeroDocumentoIdentidad);
      $('#VendedorId').val(row.VendedorId);
      $('#VendedorNombre').val(row.VendedorNombre);
      $('#TipoCondicionPagoId').val(row.TipoCondicionPagoId);

      $(this).postAction({
         urlAction: '@Url.Action("ObtenerListaPrecioProveedorId", "Comprobante")',
         viewModel: [
            { name: "ListaPrecioProveedorDTO.ListaPrecioId", value: $('#ListaPrecioId').val(), type: 'int' },
            { name: "ListaPrecioProveedorDTO.ProveedorId", value: $('#ProveedorId').val(), type: 'int' }
         ],
         onSuccess: function (response) {
            if (response.success) {
               $('#ListaPrecioProveedorId').val(response.data.listaPrecioProveedorId);
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
      $('#cotizacionListPopup').hideDialog();
   };
