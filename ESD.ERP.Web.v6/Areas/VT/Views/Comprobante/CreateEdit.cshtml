@using ESD.Core;
@using ESD.Core.Web;
@using ESD.ERP.Common;
@using ESD.Core.Service.DTO;
@using ESD.Core.Web.JS;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.VT.Models.ComprobanteViewModel
<esd-menubar id="menuBar" title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-10">
               <div class="form-group row">
                  <esd-dropdownlist id="TipoDocumentoComercialId" for="@Model.TipoDocumentoComercialList" col-position="col-lg-1" label="Doc. Com."
                                    col-label-position="col-lg-2" onchange="tipoDocumentoComercialIdOnChange();" enable="@Model.IsNew"></esd-dropdownlist>
                  @{
                     if (Model.IsNew)
                     {
                        <esd-dropdownlist id="Serie" for="@Model.SerieList" col-position="col-lg-1" onchange="serieOnChange();"
                                          enable="@Model.IsNew"></esd-dropdownlist>
                     }
                     else
                     {
                        <esd-textbox for="@Model.ComprobanteDTO.Serie" col-position="col-lg-1" enable="false"></esd-textbox>
                     }
                  }
                  <esd-textbox for="@Model.ComprobanteDTO.Numero" col-position="col-lg-2" enable="false"></esd-textbox>
                  <esd-datetimepicker for="@Model.ComprobanteDTO.Fecha" col-position="col-lg-2" label="Fecha" col-label-position="col-lg-1"
                                      enable="@Model.IsNew"></esd-datetimepicker>
               </div>
               <div class="form-group row">
                  <esd-buttontextbox id="Cotizacion" button-style="List" value="@Model.ComprobanteDTO?.CotizacionDTO?.Codigo" col-position="col-lg-2" label="Pedido"
                                     col-label-position="col-lg-2" onclick="cotizacionOnClick"></esd-buttontextbox>
                  <esd-dropdownlist id="MonedaId" for="@Model.MonedaList" col-position="col-lg-2" label="Moneda"
                                    col-label-position="col-lg-1" onchange="monedaIdOnChange();" enable="@Model.IsNew"></esd-dropdownlist>
                  <esd-numerictextbox for="@Model.ComprobanteDTO.MontoTipoCambio" col-position="col-lg-1" label="T/C" col-label-position="col-lg-1" enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-buttontextbox id="Proveedor" button-style="ListNew" value="@Model.ComprobanteDTO.ProveedorDTO.RazonSocial" col-position="col-lg-7" label="Cliente"
                                     col-label-position="col-lg-2" onclick="proveedorOnClick"></esd-buttontextbox>
                  <esd-textbox for="@Model.ComprobanteDTO.ProveedorDTO.NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Doc." col-label-position="col-lg-1"
                               enable="false"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox id="VendedorNombre" value="@Model.ComprobanteDTO.VendedorDTO.ProveedorDTO.RazonSocial" col-position="col-lg-4" label="Vendedor"
                               col-label-position="col-lg-2" enable="false"></esd-textbox>
                  <esd-dropdownlist id="ListaPrecioId" for="@Model.ListaPrecioList" col-position="col-lg-4" label="Lista Precio"
                                    col-label-position="col-lg-2" onchange="listaPrecioIdOnChange();" enable="@Model.IsNew"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoCondicionPagoId" for="@Model.TipoCondicionPagoList" col-position="col-lg-4" label="Cond. Pago"
                                    col-label-position="col-lg-2" onchange="tipoCondicionPagoIdOnChange();"></esd-dropdownlist>
                  <esd-dropdownlist id="MedioPagoId" for="@Model.MedioPagoList" col-position="col-lg-4" label="Medio de Pago"
                                    col-label-position="col-lg-2" onchange="medioPagoIdOnChange();"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-textarea for="@Model.ComprobanteDTO.Observacion" col-position="col-lg-6" label="Observacion" col-label-position="col-lg-2"
                                max-length="400" rows="2"></esd-textarea>
               </div>
               <div class="form-group row">
                  <label class="col-lg-10 offset-2" style="text-align: left">
                     <span class="badge badge-warning">Item ya tiene dcto desde la Lista de Precios.</span>
                     <span class="badge badge-success">Item ya tiene el incremento del 5% en el P.U.</span>
                  </label>
               </div>
            </div>
            <div class="col-2">
               <div class="form-group row">
                  <esd-textbox id="EstadoComprobanteNombre" value="@Model.ComprobanteDTO.EstadoComprobanteDTO.Nombre" col-position="col-lg-6" label="Estado" col-label-position="col-lg-6"
                               enable="false"></esd-textbox>
               </div>
               <div class="form-group row">
                  <br />
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoNeto" value="@Model.ComprobanteDTO.MontoNeto" col-position="col-lg-6" label="Mto. Neto" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoIgv" value="@Model.ComprobanteDTO.MontoIgv" col-position="col-lg-6" label="IGV" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoTotal" value="@Model.ComprobanteDTO.MontoTotal" col-position="col-lg-6" label="Total" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoAnticipoDescuento" value="@Model.ComprobanteDTO.MontoAnticipoDescuento" col-position="col-lg-6" label="Mto. Anticipo"
                                      col-label-position="col-lg-6" enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoSaldo" value="@decimal.Zero" col-position="col-lg-6" label="Saldo" col-label-position="col-lg-6"
                                      enable="false" allow-minus="true"></esd-numerictextbox>
               </div>
            </div>
         </div>
      </div>
      <esd-viewmodelstate for="@Model.ViewModelState.Value"></esd-viewmodelstate>
      <esd-hidden for="@Model.ComprobanteDTO.ComprobanteId"></esd-hidden>
      <esd-hidden for="@Model.ComprobanteDTO.ProveedorId"></esd-hidden>
      <esd-hidden id="TipoDocumentoComercial" value="@Model.ComprobanteDTO.TipoDocumentoComercialDTO.Codigo"></esd-hidden>
      <esd-hidden for="@Model.ComprobanteDTO.TipoDocumentoComercialDTO.ValidarProveedor"></esd-hidden>
      <esd-hidden for="@Model.ComprobanteDTO.TipoDocumentoComercialDTO.MontoMaximoSinProveedor"></esd-hidden>
      <esd-hidden id="TipoNaturalezaJuridica" value="@Model.ComprobanteDTO.ProveedorDTO.TipoNaturalezaJuridicaDTO.Codigo"></esd-hidden>
      <esd-hidden id="ProveedorCodigo" value="@Model.ComprobanteDTO.ProveedorDTO.Codigo"></esd-hidden>
      <esd-hidden for="@Model.ComprobanteDTO.VendedorId"></esd-hidden>
      <esd-hidden for="@Model.ComprobanteDTO.CotizacionId"></esd-hidden>
      <esd-hidden for="@Model.ComprobanteDTO.MonedaDTO.EsLocal"></esd-hidden>
      <esd-hidden for="@Model.ComprobanteDTO.ImpuestoTasaDTO.Tasa"></esd-hidden>
      <esd-hidden for="@Model.ComprobanteDTO.AlmacenId"></esd-hidden>
      <esd-hidden for="@Model.ComprobanteDTO.EsContingencia"></esd-hidden>
      <esd-hidden id="EstadoComprobante" value="@Model.ComprobanteDTO.EstadoComprobanteDTO.Codigo"></esd-hidden>
      <esd-hidden for="@Model.PorcentajeFraccionPU"></esd-hidden>
      <esd-hidden for="@Model.AutorizacionPendiente"></esd-hidden>
      <esd-hidden for="@Model.ListaPrecioProveedorId"></esd-hidden>
      <esd-hidden for="@Model.IgnorarIncrementoFraccion"></esd-hidden>
      <esd-hidden for="@Model.TieneGuia"></esd-hidden>
      <esd-hidden for="@Model.EsObsequio"></esd-hidden>
      <esd-hidden for="@Model.FileId"></esd-hidden>
      <esd-hidden id="TipoDescuentoList" value="@Model.TipoDescuentoString"></esd-hidden>
      <datalist id="productoDetalleList"></datalist>
   </div>
   <div>
      <ul class="nav nav-tabs" role="tablist" id="detailTab">
         <li class="nav-item">
            <a class="nav-link active" href="#productoTab" role="tab" data-toggle="tab">Productos/Servicios</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#anticipoTab" role="tab" data-toggle="tab">Anticipos Aplicados</a>
         </li>
      </ul>
      <div class="tab-content">
         <div class="tab-pane active" id="productoTab" role="tabpanel">
            <div class="form-inline">
               <div class="col-6">
                  <esd-menubar id="productoMenuBar" size="Small" menu-style="CRUDAndSaveCancel" onclick="productoMenuBarOnClick"></esd-menubar>
               </div>
               <div class="col-6">
                  <esd-checkbox id="productoVerAnulado" col-position="offset-lg-9 col-lg-3" label="Mostrar Anulados" onchange="productoVerAnuladoOnChange()"
                                checkbox-style="Default"></esd-checkbox>
               </div>
            </div>
            <div id="productoContainer">
               <table id="productoGrid"></table>
               <div id="productoPager"></div>
            </div>
         </div>
         <div class="tab-pane" id="anticipoTab" role="tabpanel">
            <div>
               <esd-menubar id="anticipoMenuBar" size="Small" menu-style="NewDelete" onclick="anticipoMenuBarOnClick"></esd-menubar>
            </div>
            <div id="anticipoContainer">
               <table id="anticipoGrid"></table>
               <div id="anticipoPager"></div>
            </div>
         </div>
      </div>
   </div>
</section>
<esd-dialog id="cotizacionListPopup" title="Pedidos" onclick="cotizacionListPopupOnClick" size="Large">
   <div id="cotizacionListPopupContent"></div>
</esd-dialog>
<esd-dialog id="proveedorListPopup" title="Clientes" onclick="proveedorListPopupOnClick" size="Large">
   <div id="proveedorListPopupContent"></div>
</esd-dialog>
<esd-dialog id="proveedorCreatePopup" title="Nuevo Cliente" onclick="proveedorCreatePopupOnClick" size="Large">
   <div id="proveedorCreatePopupContent"></div>
</esd-dialog>
<esd-dialog id="saldoListPopup" title="Lista de Precios" onclick="saldoListPopupOnClick" size="Large">
   <div id="saldoListPopupContent"></div>
</esd-dialog>
<esd-dialog id="autorizacionEditPopup" title="Solicitar Autorizaciones" onclick="autorizacionEditPopupOnClick" size="Large">
   <div id="autorizacionEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="estadoAutoEditPopup" title="Ver Autorizaciones" size="Large" button-style="Close">
   <div id="estadoAutoEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="guiaCreatePopup" title="Generar Guía de Remisión" onclick="guiaCreatePopupOnClick" size="Large">
   <div id="guiaCreatePopupContent"></div>
</esd-dialog>
<esd-dialog id="agregarItemPopup" title="Agregar Producto/Servicio" onclick="agregarItemPopupOnClick">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-radiobutton id="DesdePedido" group-name="mp-agregarRadio" label="Agregar desde Pedido" col-position="offset-lg-1 col-lg-4" checked="true"
                                   in-modal="true"></esd-radiobutton>
               </div>
               <div class="form-group row">
                  <esd-radiobutton id="DesdeListaPrecio" group-name="mp-agregarRadio" label="Desde Lista de Precios" col-position="offset-lg-1 col-lg-4"
                                   in-modal="true"></esd-radiobutton>
               </div>
            </div>
         </div>
      </div>
   </div>
</esd-dialog>
<esd-dialog id="cotizacionProductoListPopup" title="Productos/Servicios en Pedido" onclick="cotizacionProductoListPopupOnClick" size="Large">
   <div id="cotizacionProductoListPopupContent"></div>
</esd-dialog>
<esd-dialog id="impresionPopup" title="Imprimir" onclick="impresionPopupClickOk" size="Large">
   <div id="impresionPopupContent">
      <textarea class="form-control" id="printTextArea" readonly="readonly" cols="144" rows="25"></textarea>
   </div>
</esd-dialog>
<esd-dialog id="anticipoListPopup" title="Anticipos" onclick="anticipoListPopupOnClick" size="Large">
   <div id="anticipoListPopupContent"></div>
</esd-dialog>
<style type="text/css">
   .jqgrid-cell-warning {
      background: #ffc107;
      color: #212529;
      text-align: center;
      -moz-border-radius: 20px;
      -webkit-border-radius: 20px;
      border-radius: .25rem;
      border: 1px solid #4EA049;
      font-weight: bold;
   }

   .jqgrid-cell-success {
      background: #28a745;
      color: #fff;
      text-align: center;
      -moz-border-radius: 20px;
      -webkit-border-radius: 20px;
      border-radius: .25rem;
      border: 1px solid #FFFFFF;
      font-weight: bold;
   }

   .jqgrid-cell-item-changed {
      background: #17a2b8;
      color: #FFF;
      text-align: center;
      -moz-border-radius: 20px;
      -webkit-border-radius: 20px;
      border-radius: .25rem;
      border: 1px solid #FFFFFF;
      font-weight: bold;
   }

   .jqgrid-cell-item-read-only {
      background: #545b62;
      color: #fff;
      -moz-border-radius: 20px;
      -webkit-border-radius: 20px;
      border-radius: .25rem;
      border: 1px solid #FFFFFF;
      font-weight: bold;
   }
</style>
<script type="text/javascript">
   $(document).ready(function () {

      habilitarCerrado();
      habilitarSiEsObsequio();

      $("#productoGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarComprobanteProducto", "Comprobante")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "ComprobanteProductoDTO.ComprobanteId", value: $('#ComprobanteId').val() || '0', type: 'int' },
                     { name: "ComprobanteProductoDTO.Estado", value: $('#productoVerAnulado').prop('checked') ? '' : '@EstadoConstante.ACTIVO' }
                  ]
               ));
            }
         },
         colNames: ['', '', '', 'Código', 'Producto', '','', '', '', '', 'U.M.', '','', 'Detalle', '', '', '', 'Cantidad', '', '', '', 'P.U.',
            '', '', '', '', '', '', 'T/D', '', 'Valor T/D', '','','Mto.Dcto','', '','Total','', '', '','', '', ''],
         colModel: [
            { name: 'ComprobanteProductoId', hidden: true },
            { name: 'ComprobanteId', hidden: true },
            { name: 'ProductoId', hidden: true },
            { name: 'Codigo', width: 90, formatter: codigoFormatter },
            { name: 'ProductoNombre', width: 350, formatter: descripcionFormatter, editable: false },
            {
               name: '_selP', width: 35, align: 'center', formatter: function (cellvalue, options, rowObject) {
                  var disabled = '';
                  if (!$.isNullOrEmpty(rowObject.ComprobanteProductoId) && rowObject.ComprobanteProductoId !== 0)
                     disabled = ' disabled';

                  return '<button class="btn btn-xs btn-outline-secondary" title="Producto" name="productoButton"' + disabled + ' onclick="mostrarProducto(' + options.rowId + ');"><span class=\'fas fa-list\'/></button>';
               }
            },
            { name: 'UsarIncrementoFraccion', hidden: true },
            { name: 'EsCombo', hidden: true },
            { name: 'TipoProducto', hidden: true },
            { name: 'UnidadMedidaId', hidden: true },
            { name: 'UnidadMedidaNombre', width: 60, editable: false },
            { name: 'TipoIgv', hidden: true },
            { name: 'DetalleRequerido', hidden: true },
            {
               name: 'Descripcion', width: 150, editable: true, edittype: 'text',
               editoptions: {
                  class: 'form-control-sm',
                  maxlength: 150,
                  autocomplete: "off",
                  list: "productoDetalleList"
               }
            },
            { name: 'Cantidad', hidden: true },
            { name: 'CantidadPresentacion', hidden: true },
            { name: 'CantidadEquivalente', hidden: true },
            {
               name: "CantidadVenta", width: 100, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 2, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularTotal(false);
                        }
                     });
                  }
               }
            },
            { name: 'ValorUnitarioLista', hidden: true },
            { name: 'PrecioUnitarioLista', hidden: true },
            { name: 'ValorUnitario', hidden: true },
            {
               name: "PrecioUnitario", width: 100, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 2, allowMinus: false });
                     $(elem).prop('readonly', true);
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularTotal(false);
                        }
                     });
                  }
               }
            },
            { name: 'CantidadBloqueada', hidden: true },
            { name: 'IncluyeDescuentoListaPrecio', hidden: true },
            { name: 'PermiteDescuento', hidden: true },
            { name: 'SolicitaAutorizacionDescuento', hidden: true },
            { name: 'RegistroReferencialId', hidden: true },
            { name: 'MontoBruto', hidden: true },
            {
               name: 'TipoDescuentoId', width: 50, editable: true, edittype: 'select', formatter: 'select', sortable: false,
               editoptions: {
                  class: 'form-control-sm',
                  value: $('#TipoDescuentoList').val(),
                  dataEvents: [
                  {
                     type: 'change',
                     fn: function (e) {
                        var $select = $(e.target);

                        $(this).getAction({
                           urlAction: '@Url.Action("ObtenerTipoDescuento", "Comprobante")',
                           id: $select.val(),
                           onSuccess: function (response) {
                              if (response.success) {
                                 var rowId = $('#productoGrid').appGrid('getSelectedRowId');
                                 var row = $("#productoGrid").appGrid("getSelectedRow");

                                 var tipoDescuento = response.data.Codigo;
                                 $('#productoGrid').jqGrid('setCell', rowId, 'TipoDescuento', tipoDescuento);

                                 habilitarDescuentoValor(rowId, tipoDescuento);
                              } else {
                                 msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                              }
                           }
                        });
                     }
                  }]
               },
               editrules: { required: true }
            },
            { name: 'TipoDescuento', hidden: true },
            {
               name: "DescuentoValor", width: 70, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 2, allowMinus: false });
                     $(elem).prop('readonly', true);
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularTotal(false);
                        }
                     });
                  }
               }
            },
            { name: 'PorcentajeDescuento', hidden: true },
            { name: 'MontoDescuento1', hidden: true },
            { name: 'MontoTotalDescuento', width: 90, align: 'right', formatter: 'number' },
            { name: 'MontoNeto', hidden: true },
            { name: 'MontoIgv', hidden: true },
            {
               name: "MontoTotal", width: 100, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 2, allowMinus: false });
                     $(elem).prop('readonly', true);
                  }
               }
            },
            { name: 'TipoDetraccionId', hidden: true },
            { name: 'PorcentajeDetraccion', hidden: true },
            { name: 'MontoDetraccion', hidden: true },
            { name: 'TipoAfectacionIgvId', hidden: true },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#productoPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            if ($('#EstadoComprobante').val() === '@EstadoComprobanteConstante.EMITIDO') {
               $('#productoMenuBar').appMenu('disabled');
               return;
            }

            var editableRows = $('#productoGrid').appGrid('editableRowsCount');
            if (editableRows === 0) {
               editCustomGridMenuBar('productoMenuBar', 'productoGrid');
            }
            else
               $("#productoMenuBar").appMenu('saveMenu');
         },
         gridComplete: function () {
            editCustomGridMenuBar('productoMenuBar', 'productoGrid');
            $("#productoGrid").appGrid('resizeGrid', 'productoContainer');
            calcularTotalesGenerales();

            if ($('#EstadoComprobante').val() === '@EstadoComprobanteConstante.CERRADO') {
               $('#productoMenuBar').appMenu('disabled');
            }

            if ($('#EstadoComprobante').val() === '@EstadoComprobanteConstante.EMITIDO') {
               $('#productoMenuBar').appMenu('disabled');
               if ($('#TieneGuia').val() === '@SiNoConstante.N')
                  $("#menuBar").appMenu('disabledButton', { buttonId: 'genera_gr', disabled: false });
            }

            if ($('#EstadoComprobante').val() === '@EstadoComprobanteConstante.PENDIENTE') {
               if($("#ComprobanteId").validateNumeric())
                  $("#menuBar").appMenu('disabledButton', { buttonId: 'cerrar', disabled: false });
            }
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('productoContainer')
      });
      $("#anticipoGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarAnticipoCliente", "Comprobante")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "AnticipoClienteDTO.ComprobanteId", value: $('#ComprobanteId').val() || '0', type: 'int' },
                     { name: "AnticipoClienteDTO.TipoOperacionAnticipoList", value: ['@TipoOperacionAnticipoConstante.APLICACION', '@TipoOperacionAnticipoConstante.ANULACION'], type: 'listString' }
                  ]
               ));
            }
         },
         colNames: ['', 'Recibo', 'Fecha', 'Mon.', 'Monto', 'T/D','Serie-Numero','Descripcion', '','T. Ope.','','','Estado','',''],
         colModel: [
            { name: 'AnticipoClienteId', hidden: true },
            { name: 'NumeroOperacion', width: 60, sortable: false },
            { name: "Fecha", width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: 'Moneda', width: 50, sortable: false },
            { name: "Monto", width: 100, align: 'right', formatter: 'number' },
            { name: 'TipoDocumentoComercial', width: 50, sortable: false },
            { name: 'SerieNumero', width: 100, sortable: false },
            { name: 'Observacion', width: 250, sortable: false },
            { name: 'TipoOperacionAnticipo', hidden: true },
            { name: 'TipoOperacionAnticipoNombre', width: 60 },
            { name: 'Extornado', hidden: true },
            { name: 'EstadoComprobante', hidden: true },
            { name: 'EstadoComprobanteNombre', width: 150 },
