   function codigoFormatter(cellvalue, options, rowObject) {

      if (rowObject.IncluyeDescuentoListaPrecio === '@SiNoConstante.S') {
         return '<div class="jqgrid-cell-warning">' + cellvalue + '</div>'
      }

      if (rowObject.UsarIncrementoFraccion === '@SiNoConstante.S') {
         var fracPart = (rowObject.Cantidad % 1);

         if(fracPart != 0)
            return '<div class="jqgrid-cell-success">' + cellvalue + '</div>'
      }

      if(cellvalue == null)
         return '';

      return cellvalue;
   };
   function descripcionFormatter(cellvalue, options, rowObject) {

      if (rowObject.CantidadBloqueada === '@SiNoConstante.S') {
         return '<div class="jqgrid-cell-item-read-only">' + cellvalue + '</div>'
      }
      if(cellvalue == null)
         return '';

      return cellvalue;
   };
   function editCustomGridMenuBar(key, gridName) {
      if (!$("#ComprobanteId").validateNumeric()) {
         $("#menuBar").appMenu('disabledButton', { buttonList: 'soli_auto,cerrar', disabled: true });
         $('#' + key).appMenu('disabled');
      }
      else
         $('#' + key).appMenu('editMenu', { gridName: gridName, isEditableGrid: true });
   };
   function generarFormato(buttonId, key, id){

      var basePrintUrl = '@Model.ServidorImpresion';
      var dataUrl = '@Model.DataUrl';

      if($.isNullOrEmpty(basePrintUrl)){
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("AJX_servicio_impresion_no_configurado")');
         return;
      }

      $("#menuBar").appMenu('disabledButton', { buttonId: buttonId, disabled: true });

      $("#FileId").val('');
      try{
         $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: basePrintUrl + 'PrintDocument?key=' + key + '&id=' + id + '&dataUrl=' + dataUrl,
            processData: false,
            dataType: "jsonp",
            jsonp: 'callback',
            jsonpCallback: 'jsonpCallback',
            beforeSend: function () {
               $('#impresionPopup').showDialog();
               $('#impresionPopupContent').showLoadingOverlay();
            },
            success: function (data) {
               $('#impresionPopupContent').hideLoadingOverlay();

               if(data === null)
               {
                  $('#impresionPopup').hideDialog();
                  msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_reporte_sin_datos")');
                  return;
               }

               $('#printTextArea').val(data[1]);
               $("#FileId").val(data[0]);
               $("#menuBar").appMenu('disabledButton', { buttonId: buttonId, disabled: false });
            },
            error: function (jqXHR, textStatus, errorThrown) {
               $('#impresionPopup').hideDialog();
               $('#impresionPopupContent').hideLoadingOverlay();
               $("#menuBar").appMenu('disabledButton', { buttonId: buttonId, disabled: false });

               switch(jqXHR.status){
                  case 404:
                     msgAlert(msgAlertTypeConstant.ERROR, '@SR.GetString("AJX_servicio_impresion_no_activo")');
                     break;
                  default:
                     msgAlert(msgAlertTypeConstant.ERROR, textStatus);
                     break;
               }
            }
         });
      } catch(exception){
         $('#impresionPopup').hideDialog();
         $('#impresionPopupContent').hideLoadingOverlay();
         $("#menuBar").appMenu('disabledButton', { buttonId: buttonId, disabled: false });
      }
   };
   function impresionPopupClickOk(){

      $('#impresionPopup').modal('hide');

      var basePrintUrl = '@Model.ServidorImpresion';
      if($.isNullOrEmpty(basePrintUrl)){
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("AJX_servicio_impresion_no_configurado")');
         return;
      }
      var id = $("#FileId").val();

      try{
         $.ajax({
            type: "GET",
            contentType: "application/json; charset=utf-8",
            url: basePrintUrl + 'PrintFile?id=' + id,
            processData: false,
            dataType: "jsonp",
            jsonp: 'callback',
            jsonpCallback: 'jsonpCallback',
            success: function (data) {
            },
            error: function (jqXHR, textStatus, errorThrown) {
               msgAlert(msgAlertTypeConstant.ERROR, errorThrown);
            }
         });
      } catch(exception){
         throw exception;
      }
   };
</script>