   function anticipoMenuBarOnClick(key) {

      var row = $('#anticipoGrid').appGrid('getSelectedRow');
      var excludeKeys = ['@MenuItemKey.NEW'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {
         case '@MenuItemKey.NEW':
            $('#anticipoListPopup').showDialog({ multiselect: true });
            break;

         case '@MenuItemKey.DELETE':

            $(this).confirm({
               title: '@SR.GetString("APPMP_anular_titulo")',
               message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
               onConfirm: function () {

                  $(this).saveView({
                     urlAction: '@Url.Action("AnularAnticipoCliente", "Comprobante")',
                     viewModel: [
                        { name: "AnticipoClienteDTO.AnticipoClienteId", value: row.AnticipoClienteId, type: 'int' }
                     ],
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#anticipoGrid').appGrid('reloadJSON');
                           calcularTotalesGenerales();
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
            break;
      }
      return true;
   };
   function anticipoListPopupOnClick() {
      var list = $('#bandejaPopupGrid').appGrid('getSelectedRowIdList');

      if (list.length === 0) {
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("VT_anticipo_multiple_seleccion_requerida")');
         return false;
      }

      var selectedList = [];

      for (i in list) {
         var row = $('#bandejaPopupGrid').appGrid('getRow', list[i]);

         if (!$.isNullOrEmpty(row.SerieNumero)){
            var data = $("#anticipoGrid").appGrid('getData');
            var selectedData = _.filter(data, function (r) {
               return r.Estado === '@EstadoConstante.ACTIVO' && !$.isNullOrEmpty(r.SerieNumero);
            });
            if (selectedData.length > 0) {
               msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("VT_anticipo_solo_un_documento_permitido")');
               return false;
            }
         }

         selectedList.push(row.AnticipoClienteId);
      }

      grabarAnticipoCliente(selectedList);
   };
