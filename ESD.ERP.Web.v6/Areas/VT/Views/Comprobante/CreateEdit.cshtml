   function obtenerProductoDetalleList(id) {
      $(this).getAction({
         urlAction: '@Url.Action("ListarProductoDetalle", "Comprobante")',
         id: id || 0,
         onSuccess: function (response) {
            $("#productoDetalleList").empty();
            if (response.success) {

