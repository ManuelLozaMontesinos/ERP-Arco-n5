@using ESD.Core;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@model ESD.ERP.Web.Areas.VT.Models.PedidoViewModel
<div id="mp-edit-panel">
   <div class="card-body">
      <div class="row">
         <div class="col-11">
            <div class="form-group row">
               <esd-textbox id="Codigo" col-position="col-lg-2" label="Pedido" col-label-position="col-lg-2" max-length="7"
                            in-modal="true"></esd-textbox>
            </div>
            <div class="form-group row">
               <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2" max-length="35"
                            in-modal="true"></esd-textbox>
               <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Razon Social" col-label-position="col-lg-2" max-length="150"
                            in-modal="true"></esd-textbox>
            </div>
            <div class="form-group row">
               <esd-textbox id="Vendedor" col-position="col-lg-6" label="Vendedor" col-label-position="col-lg-2" max-length="150"
                            in-modal="true"></esd-textbox>
            </div>
            <div class="form-group row">
               <esd-datetimepicker id="FechaDesde" col-position="col-lg-2" label="Desde" col-label-position="col-lg-2"
                                   in-modal="true"></esd-datetimepicker>
               <esd-datetimepicker id="FechaHasta" col-position="col-lg-2" label="Hasta" col-label-position="col-lg-2"
                                   in-modal="true"></esd-datetimepicker>
            </div>
         </div>
         <div class="col-1">
            <div class="form-group row">
               <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="mp_clearButtonOnClick()"></esd-button>
            </div>
         </div>
      </div>
   </div>
</div>
<div id="bandejaPopupContainer">
   <table id="bandejaPopupGrid"></table>
   <div id="bandejaPopupPager"></div>
</div>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaPopupGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandejaPopup", "Pedido")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "CotizacionDTO.Codigo", value: $('#mp-Codigo').val() },
                     { name: "CotizacionDTO.ProveedorDTO.NumeroDocumentoIdentidad", value: $('#mp-NumeroDocumentoIdentidad').val() },
                     { name: "CotizacionDTO.ProveedorDTO.RazonSocial", value: $('#mp-RazonSocial').val() },
                     { name: "CotizacionDTO.VendedorDTO.ProveedorDTO.RazonSocial", value: $('#mp-Vendedor').val() },
                     { name: "CotizacionDTO.FechaDesde", value: $('#mp-FechaDesde').val(), type: 'date' },
                     { name: "CotizacionDTO.FechaHasta", value: $('#mp-FechaHasta').val(), type: 'date' },
                     { name: "CotizacionDTO.Estado", value: '@EstadoConstante.ACTIVO' }
                  ]
               ));
            }
         },
         colNames: ['','Pedido', 'Fecha','','','Cliente','','#Doc','','','','Mon.','','Total','','','Estado',''],
         colModel: [
            { name: 'CotizacionId', hidden: true },
            { name: "Codigo", width: 60 },
            { name: "Fecha", width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: 'ProveedorId', hidden: true },
            { name: 'Proveedor', hidden: true },
            { name: "RazonSocial", width: 320 },
            { name: 'TipoNaturalezaJuridica', hidden: true },
            { name: "NumeroDocumentoIdentidad", width: 80 },
            { name: 'VendedorId', hidden: true },
            { name: 'VendedorNombre', hidden: true },
            { name: 'MonedaId', hidden: true },
            { name: "Moneda", width: 50 },
            { name: 'ListaPrecioId', hidden: true },
            { name: "MontoTotal", width: 80, align: 'right', formatter: 'number' },
            { name: 'TipoCondicionPagoId', hidden: true },
            { name: 'EstadoCotizacion', hidden: true },
            { name: "EstadoCotizacionNombre", width: 200 },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPopupPager",
         ondblClickRow: function (rowid) {

            var popupParams = getPopupParam('mp-edit-panel')

            var row = $(this).getRowData(rowid);
            cotizacionSelectedPopup(popupParams.dialogId, row);
         },
         gridComplete: function () {
            $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
         },
         height: 250
      });
   });
   function mp_clearButtonOnClick() {
      $('#mp-edit-panel').find('input:text').val('');
      $('#bandejaPopupGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#mp-Codigo, #mp-NumeroDocumentoIdentidad, #mp-RazonSocial,#mp-Vendedor").change(function () {
         $('#bandejaPopupGrid').appGrid('reloadJSON');
      });
      $("#mp-Codigo").keydown(function (e) {
         if (event.which == 13) {
            if (!$.isNullOrEmpty($("#mp-Codigo").val())) {
               var valueFmt = padLeadingZeros($("#mp-Codigo").val(), 7)
               $("#mp-Codigo").val(valueFmt);
            }
            event.preventDefault();
            $('#bandejaPopupGrid').appGrid('reloadJSON');
         }
      });
      $("#mp-FechaDesde").keydown(function (e) {
         if (event.which == 13) {
            $("#mp-FechaHasta").val($("#mp-FechaDesde").val());
            event.preventDefault();
            $('#bandejaPopupGrid').appGrid('reloadJSON');
         }
      });
      $("#mp-FechaHasta").keydown(function (e) {
         if (event.which == 13) {
            event.preventDefault();
            $('#bandejaPopupGrid').appGrid('reloadJSON');
         }
      });
   });
</script>