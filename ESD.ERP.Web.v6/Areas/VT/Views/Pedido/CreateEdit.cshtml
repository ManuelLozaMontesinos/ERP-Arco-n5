   function menuBarOnClick(key) {

      switch (key) {
         case '@MenuItemKey.SAVE':

            if ($('#AutorizacionPendiente').val() === '@SiNoConstante.S') {
               msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("VT_cotizacion_autorizacion_pendiente_aprobacion")');
               return;
            }

            grabarDatos();
            break;

         case '@MenuItemKey.EXIT':
            $(this).getView({
               urlAction: '@Url.Action("Index", "Pedido")'
            });
            break;

         case 'soli_auto':
            if (existeProductosEnEdicion())
               return;

            $('#autorizacionEditPopup').showDialog();
            break;

         case 'estado_auto':
            $('#estadoAutoEditPopup').showDialog();
            break;

         case 'reporte_canto':
            generarFormato(key, '@DataFormatoImpresionConstante.PEDIDO_TAPACANTO',$('#CotizacionId').val());
            break;

         case 'enviar_prod':
              mostrarProductosOP();
            break;
      }
   };
   function existeProductosEnEdicion(){
      var editableRows = $('#productoGrid').appGrid('editableRowsCount');
      if (editableRows !== 0) {
         msgAlert(msgAlertTypeConstant.SUCCESS, '@SR.GetString("VT_cotizacion_productos_en_edicion")');
         return true;
      }

      return false;
   };
   function validarDatos() {
      if (!$('#Fecha').validateString('@SR.GetString("GEN_fecha_requerida")'))
         return false;
      if (!$('#MonedaId').validateNumeric('@SR.GetString("GEN_moneda_seleccion_requerida")'))
         return false;
      if ($('#EsLocal').val() === '@SiNoConstante.N')
         if (!$('#MontoTipoCambio').validateNumeric('@SR.GetString("GEN_tipo_cambio_monto_requerido")'))
            return false;
      if (!$('#VendedorId').validateNumeric('@SR.GetString("VT_vendedor_seleccion_requerida")'))
         return false;
      if (!$('#ListaPrecioId').validateNumeric('@SR.GetString("VT_lista_precio_seleccion_requerida")'))
         return false;
      if (!$('#ProveedorId').validateNumeric('@SR.GetString("MG_proveedor_seleccion_requerida")'))
         return false;

      return true;
   }
   function grabarDatos() {

      if (!validarDatos())
         return;

      $(this).saveView({
         viewModel: [
            { name: "CotizacionDTO.CotizacionId", value: $('#CotizacionId').val(), type: 'int' },
            { name: "CotizacionDTO.Fecha", value: $('#Fecha').val(), type: 'date' },
            { name: "CotizacionDTO.ProveedorId", value: $('#ProveedorId').val(), type: 'int' },
            { name: "CotizacionDTO.VendedorId", value: $('#VendedorId').val(), type: 'int' },
            { name: "CotizacionDTO.MonedaId", value: $('#MonedaId').val(), type: 'int' },
            { name: "CotizacionDTO.MontoTipoCambio", value: $('#MontoTipoCambio').val(), type: 'decimal' },
            { name: "CotizacionDTO.ListaPrecioId", value: $('#ListaPrecioId').val(), type: 'int' },
            { name: "CotizacionDTO.TipoCondicionPagoId", value: $('#TipoCondicionPagoId').val(), type: 'int' },
            { name: "CotizacionDTO.Observacion", value: $('#Observacion').val() },
            { name: "CotizacionDTO.AlmacenId", value: $('#AlmacenId').val(), type: 'int' },
            { name: "CotizacionDTO.MesContableId", value: $('#MesContableId').val(), type: 'int' }
         ],
         buttonId: '@MenuItemKey.SAVE',
         urlAction: '@Url.Action("Grabar", "Pedido")',
         onSuccess: function (response) {

            if (response.success) {
               msgAlert(msgAlertTypeConstant.SUCCESS, response.message);

               $("#CotizacionId").val(response.data.Id);
               $("#Codigo").val(response.data.Codigo);
               $("#Fecha").prop('disabled', true);
               $("#MonedaId").prop('disabled', true);
               $("#ListaPrecioId").prop('disabled', true);
               $("#productoGrid").appGrid('reloadJSON');
               $("#anticipoGrid").appGrid('reloadJSON');
               if ($("#ListaPrecioProveedorId").validateNumeric())
                  $('#Proveedor').appButtonTextBox('disabled', { disabled: true });

               ViewModelState.setValue('EditAction', @((int)ViewModelEditAction.Edit))

            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
            $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.SAVE', disabled: false });
         }
      });
   };
   function productoMenuBarOnClick(key) {

      var row = $('#productoGrid').appGrid('getSelectedRow');
      var excludeKeys = ['@MenuItemKey.NEW'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      if ($('#AutorizacionPendiente').val() === '@SiNoConstante.S') {
         msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("VT_cotizacion_autorizacion_pendiente_aprobacion")');
         return;
      }

      switch (key) {
         case '@MenuItemKey.NEW':
            mostrarProducto();
            break;

         case '@MenuItemKey.EDIT':
            editarProductoInGrid();
            break;

         case '@MenuItemKey.CANCEL':
            $("#productoGrid").appGrid('reloadJSON');
            break;

         case '@MenuItemKey.SAVE':

            var rowId = $("#productoGrid").appGrid("getSelectedRowId");

            if (row.DetalleRequerido === '@SiNoConstante.S') {
               if (!$('#' + rowId + '_Descripcion').validateString('@SR.GetString("VT_producto_detalle_requerido")'))
                  return false;
            }

            if (!$('#' + rowId + '_CantidadVenta').validateNumeric('@SR.GetString("GEN_cantidad_requerida")'))
               return false;
            if (!$('#' + rowId + '_PrecioUnitario').validateNumeric('@SR.GetString("VT_precio_unitario_requerido")'))
               return false;

            calcularTotal(true);
            break;

         case '@MenuItemKey.DELETE':

            $(this).confirm({
               title: '@SR.GetString("APPMP_anular_titulo")',
               message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
               onConfirm: function () {

                  $(this).saveView({
                     urlAction: '@Url.Action("EliminarCotizacionProducto", "Pedido")',
                     viewModel: [
                        { name: "CotizacionProductoDTO.CotizacionProductoId", value: row.CotizacionProductoId, type: 'int' }
                     ],
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#productoGrid').appGrid('reloadJSON');
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
            break;

      }
      return true;
   };

    function mostrarProductosOP() {
        const estado = $('#EnviadoProduccion').val();

