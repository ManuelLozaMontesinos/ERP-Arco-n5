         urlAction: '@Url.Action("ObtenerTotales", "Pedido")',
         id: $('#CotizacionId').val() || 0,
         onSuccess: function (response) {
            if (response.success) {
               $('#MontoBruto').val(numeral(response.data.MontoBruto).format('0,0.00'));
               $('#MontoNeto').val(numeral(response.data.MontoNeto).format('0,0.00'));
               $('#MontoIgv').val(numeral(response.data.MontoIgv).format('0,0.00'));
               $('#MontoTotal').val(numeral(response.data.MontoTotal).format('0,0.00'));
               $('#MontoAnticipo').val(numeral(response.data.MontoAnticipo).format('0,0.00'));
               $('#MontoSaldo').val(numeral(response.data.MontoSaldo).format('0,0.00'));
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function anticipoMenuBarOnClick(key) {

      var row = $('#anticipoGrid').appGrid('getSelectedRow');
      var excludeKeys = ['@MenuItemKey.NEW'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {
         case '@MenuItemKey.NEW':
            $('#agregarAnticipoPopup').showDialog();
            break;

         case '@MenuItemKey.EDIT':
            $('#anticipoEditPopup').showDialog({ editAction: '@ViewModelEditAction.Edit' });
            break;

         case 'cerrar':

            $(this).saveView({
               urlAction: '@Url.Action("CerrarAnticipoCliente", "Pedido")',
               viewModel: [
                  { name: "AnticipoClienteDTO.AnticipoClienteId", value: row.AnticipoClienteId, type: 'int' }
               ],
               onSuccess: function (response) {
                  if (response.success) {
                     $("#anticipoGrid").appGrid('reloadJSON');
                     msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                  } else {
                     msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                  }
               }
            });
            break;

         case '@MenuItemKey.PREVIEW':
            generarFormato(key, '@DataFormatoImpresionConstante.PEDIDO_ADELANTO', $('#CotizacionId').val());
            break;

         case 'extornar':

            $(this).confirm({
               title: '@SR.GetString("APPMP_extornar_titulo")',
               message: '@SR.GetString("VT_anticipo_seleccionado_extornar_pregunta")',
               onConfirm: function () {

                  $(this).saveView({
                     urlAction: '@Url.Action("ExtornarAnticipoCliente", "Pedido")',
                     viewModel: [
                        { name: "AnticipoClienteDTO.AnticipoClienteId", value: row.AnticipoClienteId, type: 'int' }
                     ],
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#anticipoGrid').appGrid('reloadJSON');
                           calcularTotalesGenerales();
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
            break;
      }
      return true;
   };
