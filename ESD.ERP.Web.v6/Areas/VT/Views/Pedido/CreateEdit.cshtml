   function codigoFormatter(cellvalue, options, rowObject) {

      if (rowObject.IncluyeDescuentoListaPrecio === '@SiNoConstante.S') {
         return '<div class="jqgrid-cell-warning">' + cellvalue + '</div>'
      }
      if (rowObject.UsarIncrementoFraccion === '@SiNoConstante.S') {
         var fracPart = (rowObject.Cantidad % 1);

         if(fracPart != 0)
            return '<div class="jqgrid-cell-success">' + cellvalue + '</div>'
      }

      if(cellvalue == null)
         return '';

      return cellvalue;
   };
   function descripcionFormatter(cellvalue, options, rowObject) {

      if (rowObject.CantidadBloqueada === '@SiNoConstante.S') {
         return '<div class="jqgrid-cell-item-read-only">' + cellvalue + '</div>'
      }
      if(cellvalue == null)
         return '';

      return cellvalue;
   };
   function habilitarMedioPagoGrid(medioPago, rowId) {
      switch (medioPago) {
         case '@MedioPagoConstante.EFECTIVO':
            $('#' + rowId + '_BancoId').val('');
            $('#' + rowId + '_BancoId').prop('disabled', true);
            $('#' + rowId + '_FechaReferencia').val('');
            $('#' + rowId + '_FechaReferencia').prop('readonly', true);
            $('#' + rowId + '_NumeroReferencia').val('');
            $('#' + rowId + '_NumeroReferencia').prop('readonly', true);
            break;

         default:
            $('#' + rowId + '_BancoId').prop('disabled', false);
            $('#' + rowId + '_FechaReferencia').prop('readonly', false);
            $('#' + rowId + '_NumeroReferencia').prop('readonly', false);
            break;
      }
   };
   function editCustomGridMenuBar(key, gridName) {
      if (!$("#CotizacionId").validateNumeric()) {
         $('#' + key).appMenu('disabled');
