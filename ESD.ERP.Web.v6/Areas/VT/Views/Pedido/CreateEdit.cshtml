         var data = $("#anticipoGrid").appGrid('getData');
         var selectedData = _.filter(data, function (r) {
            return !$.isNullOrEmpty(r.TipoDocumentoComercialId) && r.Extornado === '@SiNoConstante.N' && r.AnticipoClienteId !== parseFloatEx($('#mp-AnticipoClienteId').val());
         });
