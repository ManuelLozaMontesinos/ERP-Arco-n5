   function permiteCantidadFraccion(cantidad, row, rowId) {

      var integerPart = parseInt(cantidad);
      var fracPart = (cantidad % 1);

      if (row.UsarIncrementoFraccion === '@SiNoConstante.S') {

         if(integerPart > 0 && fracPart !=0){
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("VT_cantidad_ingreso_no_decimal")');
            $('#' + rowId + '_PrecioUnitario').val(row.PrecioUnitarioLista);
            return false;
         }
      }

      return true;
   };
   function validarDescuento(cantidad, row, rowId) {

      var descuentoValor = parseFloatEx($('#' + rowId + '_DescuentoValor').val()) || 0;

      if (row.TipoDescuento === '@TipoDescuentoConstante.CANTIDAD') {

         if (descuentoValor >= cantidad){
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("VT_descuento_valor_mayor_cantidad_venta")');
            return false;
         }
      }

      return true;
   };
   function calcularPrecioUnitario(cantidad,row,rowId){

      if (row.UsarIncrementoFraccion == '@SiNoConstante.S'){

         if ($('#IgnorarIncrementoFraccion').val() === '@SiNoConstante.S')
            return;

         var fracPart = (cantidad % 1);
         if(fracPart != 0){

            var puLista = parseFloatEx(row.PrecioUnitarioLista);

            var porcentajeFraccionPU = parseFloatEx($('#PorcentajeFraccionPU').val());
            var puFinal = puLista + roundEx(puLista * roundEx(porcentajeFraccionPU / 100, 4), 1);

            $('#' + rowId + '_PrecioUnitario').val(puFinal);
         }
      }
   };
   function calcularTotal(grabar) {

      var row = $('#productoGrid').appGrid('getSelectedRow');
      var rowId = $('#productoGrid').appGrid('getSelectedRowId');

      var cantidad = parseFloatEx($('#' + rowId + '_CantidadVenta').val()) || 0;
      var cantidadEquivalente = parseFloatEx(row.CantidadEquivalente);
      if (cantidadEquivalente > 0)
         cantidad = cantidad * cantidadEquivalente;

      if (!permiteCantidadFraccion(cantidad, row, rowId))
         return;

      if (!validarDescuento(cantidad, row, rowId))
         return;

      calcularPrecioUnitario(cantidad, row, rowId);

      $(this).postAction({
         viewModel: [
            { name: "CotizacionProductoDTO.CotizacionProductoId", value: row.CotizacionProductoId, type: 'int' },
            { name: "CotizacionProductoDTO.CotizacionId", value: row.CotizacionId, type: 'int' },
            { name: "CotizacionProductoDTO.ProductoId", value: row.ProductoId, type: 'int' },
            { name: "CotizacionProductoDTO.ProductoDTO.FamiliaProductoDTO.ClaseProductoDTO.GrupoProductoDTO.EsCombo", value: row.EsCombo },
            { name: "CotizacionProductoDTO.ProductoDTO.FamiliaProductoDTO.ClaseProductoDTO.GrupoProductoDTO.TipoProductoDTO.Codigo", value: row.TipoProducto },
            { name: "CotizacionProductoDTO.Cantidad", value: cantidad, type: 'decimal' },
            { name: "CalculadorVentaItemDTO.PrecioUnitario", value: $('#' + rowId + '_PrecioUnitario').val(), type: 'decimal' },
            { name: "CalculadorVentaItemDTO.Cantidad", value: cantidad, type: 'decimal' },
            { name: "CalculadorVentaItemDTO.TipoIgv", value: row.TipoIgv },
            { name: "CalculadorVentaItemDTO.ImpuestoTasa", value: $('#Tasa').val(), type: 'decimal' },
            { name: "CalculadorVentaItemDTO.TipoDescuento", value: row.TipoDescuento },
            { name: "CalculadorVentaItemDTO.DescuentoValor", value: $('#' + rowId + '_DescuentoValor').val(), type: 'decimal' }
         ],
         urlAction: '@Url.Action("VerificarSaldoCalcularMontos", "Pedido")',
         onSuccess: function (response) {
            if (response.success) {

               $('#productoGrid').jqGrid('setCell', rowId, 'Cantidad', cantidad);
               if (cantidadEquivalente > 0)
                  $('#productoGrid').jqGrid('setCell', rowId, 'CantidadPresentacion', parseFloatEx($('#' + rowId + '_CantidadVenta').val()));

               var tasaImpuesto = 1 + roundEx(parseFloatEx($('#Tasa').val()) / 100, 2);

               $('#productoGrid').jqGrid('setCell', rowId, 'ValorUnitario', response.data.ValorUnitario);
               $('#productoGrid').jqGrid('setCell', rowId, 'MontoBruto', response.data.MontoBruto);
               $('#productoGrid').jqGrid('setCell', rowId, 'PorcentajeDescuento', response.data.PorcentajeDescuento);
               $('#productoGrid').jqGrid('setCell', rowId, 'MontoDescuento1', response.data.MontoDescuento1);
               $('#productoGrid').jqGrid('setCell', rowId, 'MontoTotalDescuento', roundEx(response.data.MontoDescuento1 * tasaImpuesto, 2));
               $('#productoGrid').jqGrid('setCell', rowId, 'MontoNeto', response.data.MontoNeto);
               $('#productoGrid').jqGrid('setCell', rowId, 'MontoIgv', response.data.MontoImpuesto);
               $('#' + rowId + '_MontoTotal').val(response.data.MontoTotal);

               if (grabar)
                  grabarProducto(rowId);

            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function editarProductoInGrid() {
      var rowId = $("#productoGrid").appGrid("getSelectedRowId");
      var row = $("#productoGrid").appGrid("getSelectedRow");

      obtenerProductoDetalleList(row.ProductoId);

      $('#productoGrid').jqGrid('editRow', rowId);

      if (row.CantidadBloqueada === '@SiNoConstante.S')
         $('#' + rowId + '_CantidadVenta').prop('readonly',true);
      else {
         habilitarSiEsProducto(rowId, row.TipoProducto);
      }

      habilitarTipoDescuento(rowId, row.PermiteDescuento, row.TipoDescuento);

      $("#productoMenuBar").appMenu('saveMenu');
   };
   function obtenerProductoDetalleList(id) {
      $(this).getAction({
         urlAction: '@Url.Action("ListarProductoDetalle", "Pedido")',
         id: id || 0,
         onSuccess: function (response) {
            $("#productoDetalleList").empty();
            if (response.success) {

               var list = response.data;
               if (list.length > 0)
                  $.each(list, function (i, item) {
                     $("#productoDetalleList").append($("<option>").attr('value', item));
                  });

            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function habilitarSiEsProducto(rowId, tipoProducto) {
      if (tipoProducto === '@TipoProductoConstante.PRODUCTO')
         $('#' + rowId + '_PrecioUnitario').prop('readonly', true);
      else
         $('#' + rowId + '_PrecioUnitario').prop('readonly', false);
   };
   function habilitarTipoDescuento(rowId, permiteDescuento, tipoDescuento) {

      switch (permiteDescuento) {
         case '@SiNoConstante.S':
            $('#' + rowId + '_TipoDescuentoId').prop('disabled', false);
            habilitarDescuentoValor(rowId, tipoDescuento);
            break;

         default:
            $('#' + rowId + '_TipoDescuentoId').val($('#' + rowId + '_TipoDescuentoId option:first').val());
            $('#' + rowId + '_TipoDescuentoId').prop('disabled', true);
            habilitarDescuentoValor(rowId, '@TipoDescuentoConstante.SIN_DESCUENTO');
      }
   };
   function habilitarDescuentoValor(rowId, tipoDescuento) {
      if (tipoDescuento === '@TipoDescuentoConstante.SIN_DESCUENTO') {
         $('#' + rowId + '_DescuentoValor').prop('readonly', true);
         $('#' + rowId + '_DescuentoValor').val(0);
         $('#productoGrid').jqGrid('setCell', rowId, 'PorcentajeDescuento', 0);
      } else {
         $('#' + rowId + '_DescuentoValor').prop('readonly', false);
      }
   };
