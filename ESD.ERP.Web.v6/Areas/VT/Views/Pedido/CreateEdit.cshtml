@using ESD.Core;
@using ESD.Core.Web;
@using ESD.ERP.Common;
@using ESD.Core.Service.DTO;
@using ESD.Core.Web.JS;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.VT.Models.PedidoViewModel
<esd-menubar id="menuBar" title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-10">
               <div class="form-group row">
                  <esd-textbox for="@Model.CotizacionDTO.Codigo" col-position="col-lg-2" label="Código" col-label-position="col-lg-2"
                               enable="false"></esd-textbox>
                  <esd-datetimepicker for="@Model.CotizacionDTO.Fecha" col-position="col-lg-2" label="Fecha" col-label-position="col-lg-2"
                                      enable="@Model.IsNew"></esd-datetimepicker>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="MonedaId" for="@Model.MonedaList" selected-value="@Model.CotizacionDTO.MonedaId" col-position="col-lg-2" label="Moneda"
                                    col-label-position="col-lg-2" onchange="monedaIdOnChange();" enable="@Model.IsNew"></esd-dropdownlist>
                  <esd-numerictextbox for="@Model.CotizacionDTO.MontoTipoCambio" col-position="col-lg-2" label="T/C" col-label-position="col-lg-2" enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-textbox id="VendedorNombre" value="@Model.CotizacionDTO.VendedorDTO.ProveedorDTO.RazonSocial" col-position="col-lg-4" label="Vendedor"
                               col-label-position="col-lg-2" enable="false"></esd-textbox>
                  <esd-dropdownlist id="ListaPrecioId" for="@Model.ListaPrecioList" selected-value="@Model.CotizacionDTO.ListaPrecioId" col-position="col-lg-4" label="Lista Precio"
                                    col-label-position="col-lg-2" onchange="listaPrecioIdOnChange();" enable="@Model.IsNew"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-buttontextbox id="Proveedor" button-style="ListNew" value="@Model.CotizacionDTO.ProveedorDTO.RazonSocial" col-position="col-lg-7" label="Cliente"
                                     col-label-position="col-lg-2" onclick="proveedorOnClick"></esd-buttontextbox>
                  <esd-textbox for="@Model.CotizacionDTO.ProveedorDTO.NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Doc." col-label-position="col-lg-1"
                               enable="false"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoCondicionPagoId" for="@Model.TipoCondicionPagoList" col-position="col-lg-4" label="Cond. Pago"
                                    col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-textarea for="@Model.CotizacionDTO.Observacion" col-position="col-lg-6" label="Observacion" col-label-position="col-lg-2"
                                max-length="400" rows="3"></esd-textarea>
               </div>
               <div class="form-group row">
                  <label class="col-lg-10 offset-2" style="text-align: left">
                     <span class="badge badge-warning">Item ya tiene dcto desde la Lista de Precios.</span>
                     <span class="badge badge-success">Item ya tiene el incremento del 5% en el P.U.</span>
                     <span class="badge badge-secondary">Item con Precio Autorizado</span>
                  </label>
               </div>
            </div>
            <div class="col-2">
               <div class="form-group row">
                  <esd-textbox id="EstadoCotizacionNombre" value="@Model.CotizacionDTO.EstadoCotizacionDTO.Nombre" col-position="col-lg-6" label="Estado" col-label-position="col-lg-6"
                               enable="false"></esd-textbox>
               </div>
               <div class="form-group row">
                  <br />
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoNeto" value="@Model.CotizacionDTO.MontoNeto" col-position="col-lg-6" label="Mto. Neto" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoIgv" value="@Model.CotizacionDTO.MontoIgv" col-position="col-lg-6" label="IGV" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoTotal" value="@Model.CotizacionDTO.MontoTotal" col-position="col-lg-6" label="Total" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoAnticipo" value="@Model.CotizacionDTO.MontoAnticipo" col-position="col-lg-6" label="Mto. Anticipo" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-numerictextbox id="MontoSaldo" value="@Model.CotizacionDTO.MontoSaldo" col-position="col-lg-6" label="Saldo" col-label-position="col-lg-6"
                                      enable="false"></esd-numerictextbox>
               </div>
            </div>
         </div>
      </div>
      <esd-viewmodelstate for="@Model.ViewModelState.Value"></esd-viewmodelstate>
      <esd-hidden for="@Model.CotizacionDTO.CotizacionId"></esd-hidden>
      <esd-hidden for="@Model.CotizacionDTO.CortesGratis"></esd-hidden>
      <esd-hidden for="@Model.CotizacionDTO.ProveedorId"></esd-hidden>
      <esd-hidden for="@Model.CotizacionDTO.VendedorId"></esd-hidden>
      <esd-hidden for="@Model.CotizacionDTO.AlmacenId"></esd-hidden>
      <esd-hidden for="@Model.CotizacionDTO.MesContableId"></esd-hidden>
      <esd-hidden for="@Model.CotizacionDTO.MonedaDTO.EsLocal"></esd-hidden>
      <esd-hidden for="@Model.CotizacionDTO.ImpuestoTasaDTO.Tasa"></esd-hidden>
      <esd-hidden id="EstadoCotizacion" value="@Model.CotizacionDTO.EstadoCotizacionDTO.Codigo"></esd-hidden>
      <esd-hidden for="@Model.PorcentajeFraccionPU"></esd-hidden>
      <esd-hidden for="@Model.AutorizacionPendiente"></esd-hidden>
      <esd-hidden for="@Model.ListaPrecioProveedorId"></esd-hidden>
      <esd-hidden for="@Model.IgnorarIncrementoFraccion"></esd-hidden>
      <esd-hidden for="@Model.CotizacionDTO.EnviadoProduccion"></esd-hidden>
      <esd-hidden for="@Model.OrdenProduccionId"></esd-hidden>
      <esd-hidden for="@Model.AutorizacionProduccion"></esd-hidden>
      <esd-hidden for="@Model.FileId"></esd-hidden>
      <esd-hidden id="TipoDescuentoList" value="@Model.TipoDescuentoString"></esd-hidden>
      <datalist id="productoDetalleList"></datalist>    
   </div>
   <div>
      <ul class="nav nav-tabs" role="tablist" id="detailTab">
         <li class="nav-item">
            <a class="nav-link active" href="#productoTab" role="tab" data-toggle="tab">Productos/Servicios</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#anticipoTab" role="tab" data-toggle="tab">Anticipos</a>
         </li>
         <li class="nav-item">
            <a class="nav-link" href="#procesoTab" role="tab" data-toggle="tab">Produccion</a>
         </li>
      </ul>
      <div class="tab-content">
         <div class="tab-pane active" id="productoTab" role="tabpanel">
            <div class="form-inline">
               <div class="col-6">
                  <esd-menubar id="productoMenuBar" size="Small" menu-style="CRUDAndSaveCancel" onclick="productoMenuBarOnClick"></esd-menubar>
               </div>
               <div class="col-6">
                  <esd-checkbox id="productoVerAnulado" col-position="offset-lg-9 col-lg-3" label="Mostrar Anulados" onchange="productoVerAnuladoOnChange()"
                                checkbox-style="Default"></esd-checkbox>
               </div>
            </div>
            <div id="productoContainer">
               <table id="productoGrid"></table>
               <div id="productoPager"></div>
            </div>
         </div>
         <div class="tab-pane" id="anticipoTab" role="tabpanel">
            <div>
               <esd-menubar id="anticipoMenuBar" size="Small" for="@Model.MenuAnticipoList" onclick="anticipoMenuBarOnClick"></esd-menubar>
            </div>
            <div id="anticipoContainer">
               <table id="anticipoGrid"></table>
               <div id="anticipoPager"></div>
            </div>
         </div>
         <div class="tab-pane" id="procesoTab" role="tabpanel">
            <div id="procesoContainer">
               <table id="procesoGrid"></table>
               <div id="procesoPager"></div>
            </div>
         </div>
      </div>
   </div>
</section>
<esd-dialog id="proveedorListPopup" title="Cliente" onclick="proveedorListPopupOnClick" size="Large">
   <div id="proveedorListPopupContent"></div>
</esd-dialog>
<esd-dialog id="proveedorCreatePopup" title="Nuevo Cliente" onclick="proveedorCreatePopupOnClick" size="Large">
   <div id="proveedorCreatePopupContent"></div>
</esd-dialog>
<esd-dialog id="saldoListPopup" title="Lista de Precios" onclick="saldoListPopupOnClick" size="Large">
   <div id="saldoListPopupContent"></div>
</esd-dialog>
<esd-dialog id="autorizacionEditPopup" title="Solicitar Autorizaciones" onclick="autorizacionEditPopupOnClick" size="Large">
   <div id="autorizacionEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="estadoAutoEditPopup" title="Ver Autorizaciones" size="Large" button-style="Close">
   <div id="estadoAutoEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="impresionPopup" title="Imprimir" onclick="impresionPopupClickOk" size="Large">
   <div id="impresionPopupContent">
      <textarea class="form-control" id="printTextArea" readonly="readonly" cols="144" rows="25"></textarea>
   </div>
</esd-dialog>
<esd-dialog id="agregarAnticipoPopup" title="Anticipo" onclick="agregarAnticipoPopupOnClick">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-radiobutton id="AnticipoNuevo" group-name="mp-anticipoRadio" label="Nuevo" col-position="offset-lg-1 col-lg-4" checked="true"
                                   in-modal="true"></esd-radiobutton>
               </div>
               <div class="form-group row">
                  <esd-radiobutton id="AnticipoExistente" group-name="mp-anticipoRadio" label="Agregar Anticipo registrado" col-position="offset-lg-1 col-lg-10"
                                   in-modal="true"></esd-radiobutton>
               </div>
            </div>
         </div>
      </div>
   </div>
</esd-dialog>
<esd-dialog id="anticipoEditPopup" title="Anticipo" onclick="anticipoEditPopupOnClick" size="Large">
   <div id="anticipoEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="anticipoListPopup" title="Anticipos" onclick="anticipoListPopupOnClick" size="Large">
   <div id="anticipoListPopupContent"></div>
</esd-dialog>

<esd-dialog id="enviarProduccionEditPopup" title="Enviar a Producción" onclick="enviarProduccionEditPopupOnClick" size="Large">
   <div id="enviarProduccionEditPopupContent"></div>
</esd-dialog>

<esd-dialog id="enviarProduccionParcialEditPopup" title="Envio a Producción Parcial" onclick="enviarProduccionParcialEditPopupOnClick" size="Large">
    <div id="enviarProduccionParcialEditPopupContent"></div>
</esd-dialog>

<esd-dialog id="agregarItemPopup" title="Enviar Productos y Servicios" onclick="agregarItemPopupOnClick">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-12">
                    <div class="form-group row">
                        <esd-radiobutton id="ordenProduccion" group-name="mp-agregarRadio" label="Orden de Producción" col-position="offset-lg-1 col-lg-4"
                                         checked="true" in-modal="true"></esd-radiobutton>
                    </div>
                    <div class="form-group row">
                        <esd-radiobutton id="ordenProduccionParcial" group-name="mp-agregarRadio" label="Orden de Producción Parcial" col-position="offset-lg-1 col-lg-8"
                                         in-modal="true" ></esd-radiobutton>
                    </div>
                </div>
            </div>
        </div>
    </div>
</esd-dialog>

<style type="text/css">
   .jqgrid-cell-warning {
      background: #ffc107;
      color: #212529;
      text-align: center;
      -moz-border-radius: 20px;
      -webkit-border-radius: 20px;
      border-radius: .25rem;
      border: 1px solid #4EA049;
      font-weight: bold;
   }

   .jqgrid-cell-success {
      background: #28a745;
      color: #fff;
      text-align: center;
      -moz-border-radius: 20px;
      -webkit-border-radius: 20px;
      border-radius: .25rem;
      border: 1px solid #FFFFFF;
      font-weight: bold;
   }

   .jqgrid-cell-item-read-only {
      background: #545b62;
      color: #fff;
      -moz-border-radius: 20px;
      -webkit-border-radius: 20px;
      border-radius: .25rem;
      border: 1px solid #FFFFFF;
      font-weight: bold;
   }
</style>
<script type="text/javascript">
    $(document).ready(function () {

      @if (ViewBag.EsSoloLectura == true)
      {
         <text>
         $('#app-content input, #app-content select, #app-content textarea').prop('disabled', true);
         $('#Proveedor').appButtonTextBox('disabled', { disabled: true });
         $('#Proveedor button').hide();
         $('#productoMenuBar, #anticipoMenuBar').hide();
         </text>
      }

        if ($('#EstadoCotizacion').val() === '@EstadoCotizacionConstante.FACTURADO') {
            $("#menuBar").appMenu('disabledButton', { buttonList: '@MenuItemKey.SAVE,soli_auto', disabled: true });
            $("#TipoCondicionPagoId").prop('disabled', true);
            $("#productoMenuBar").prop('disabled', true);
            if($("#EnviadoProduccion").val() === '@SiNoConstante.N'){
                $("#menuBar").appMenu('disabledButton', { buttonId: 'enviar_prod', disabled: false });
                $("#productoMenuBar").prop('disabled', true);
            }
            if($('#EnviadoProduccion').val() === '@SiNoConstante.S') {
               $("#menuBar").appMenu('disabledButton', { buttonId: 'enviar_prod', disabled: true });
               $("#productoMenuBar").prop('disabled', true);
            }
        }

        if ($('EnviadoProduccion').val() === '@SiNoConstante.S'){
            $('#productoMenuBar').appMenu('disabled', { buttonId: 'enviar_prod', disabled: true });
            $("#menuBar").appMenu('disabledButton', { buttonId: 'enviar_prod', disabled: true });
        }

        if ($("#ListaPrecioProveedorId").validateNumeric())
            $('#Proveedor').appButtonTextBox('disabled', { disabled: true });

        $("#productoGrid").jqGrid({
                 @GridHelper.DefaultProperties()
            url: "@Url.Action("ListarCotizacionProducto", "Pedido")",
            postData: {
            jsonModel: function () {
                return JSON.stringify(modelToObject(
                    [
                        { name: "CotizacionProductoDTO.CotizacionId", value: $('#CotizacionId').val() || '0', type: 'int' },
                        { name: "CotizacionProductoDTO.Estado", value: $('#productoVerAnulado').prop('checked') ? '' : '@EstadoConstante.ACTIVO' }
                    ]
                ));
            }
        },

         colNames: ['', '', '', 'Código', 'Producto', '','', '', '', '', 'U.M.', '', '','Detalle','','','','Cantidad', '', '', '', 'P.U.',
            '', '', '', '', '', '', 'T/D', '', 'Valor T/D', '','','Mto.Dcto','','', 'Total', '','', '', ''],
         colModel: [
            { name: 'CotizacionProductoId', hidden: true },
            { name: 'CotizacionId', hidden: true },
            { name: 'ProductoId', hidden: true },
            { name: 'Codigo', width: 90, formatter: codigoFormatter },
            { name: 'ProductoNombre', width: 350, formatter: descripcionFormatter, editable: false },
            {
               name: '_selP', width: 35, align: 'center', formatter: function (cellvalue, options, rowObject) {
                  var disabled = '';
                  if (!$.isNullOrEmpty(rowObject.CotizacionProductoId) && rowObject.CotizacionProductoId !== 0)
                     disabled = ' disabled';

                  return '<button class="btn btn-xs btn-outline-secondary" title="Producto" name="productoButton"' + disabled +
                     ' onclick="mostrarProducto(' + options.rowId + ');"><span class=\'fas fa-list\'/></button>';
               }
            },
            { name: 'UsarIncrementoFraccion', hidden: true },
            { name: 'EsCombo', hidden: true },
            { name: 'TipoProducto', hidden: true },
            { name: 'UnidadMedidaId', hidden: true },
            { name: 'UnidadMedidaNombre', width: 60, editable: false },
            { name: 'TipoIgv', hidden: true },
            { name: 'DetalleRequerido', hidden: true },
            {
               name: 'Descripcion', width: 150, editable: true, edittype: 'text',
               editoptions: {
                  class: 'form-control-sm',
                  maxlength: 150,
                  autocomplete: "off",
                  list: "productoDetalleList"
               }
            },
            { name: 'Cantidad', hidden: true },
            { name: 'CantidadPresentacion', hidden: true },
            { name: 'CantidadEquivalente', hidden: true },
            {
               name: "CantidadVenta", width: 100, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 2, allowMinus: false });
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularTotal(false);
                        }
                     });
                  }
               }
            },
            { name: 'ValorUnitarioLista', hidden: true },
            { name: 'PrecioUnitarioLista', hidden: true },
            { name: 'ValorUnitario', hidden: true },
            {
               name: "PrecioUnitario", width: 100, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 2, allowMinus: false });
                     $(elem).prop('readonly', true);
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularTotal(false);
                        }
                     });
                  }
               }
            },
            { name: 'CantidadBloqueada', hidden: true },
            { name: 'IncluyeDescuentoListaPrecio', hidden: true },
            { name: 'PermiteDescuento', hidden: true },
            { name: 'SinSaldo', hidden: true },
            { name: 'SolicitaAutorizacionDescuento', hidden: true },
            { name: 'MontoBruto', hidden: true },
            {
               name: 'TipoDescuentoId', width: 50, editable: true, edittype: 'select', formatter: 'select', sortable: false,
               editoptions: {
                  class: 'form-control-sm',
                  value: $('#TipoDescuentoList').val(),
                  dataEvents: [
                  {
                     type: 'change',
                     fn: function (e) {
                        var $select = $(e.target);

                        $(this).getAction({
                           urlAction: '@Url.Action("ObtenerTipoDescuento", "Pedido")',
                           id: $select.val(),
                           onSuccess: function (response) {
                              if (response.success) {
                                 var rowId = $('#productoGrid').appGrid('getSelectedRowId');
                                 var row = $("#productoGrid").appGrid("getSelectedRow");

                                 var tipoDescuento = response.data.Codigo;
                                 $('#productoGrid').jqGrid('setCell', rowId, 'TipoDescuento', tipoDescuento);

                                 habilitarDescuentoValor(rowId, tipoDescuento);
                              } else {
                                 msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                              }
                           }
                        });
                     }
                  }]
               },
               editrules: { required: true }
            },
            { name: 'TipoDescuento', hidden: true },
            {
               name: "DescuentoValor", width: 70, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 2, allowMinus: false });
                     $(elem).prop('readonly', true);
                     $(elem).keydown(function (e) {
                        if (e.keyCode == 13) {
                           e.preventDefault();
                           calcularTotal(false);
                        }
                     });
                  }
               }
            },
            { name: 'PorcentajeDescuento', hidden: true },
            { name: 'MontoDescuento1', hidden: true },
            { name: 'MontoTotalDescuento', width: 90, align: 'right', formatter: 'number' },
            { name: 'MontoNeto', hidden: true },
            { name: 'MontoIgv', hidden: true },
            {
               name: "MontoTotal", width: 100, align: 'right', formatter: 'number', editable: true, sortable: false,
               editoptions: {
                  maxlength: 19,
                  class: 'form-control-sm',
                  dataInit: function (elem) {
                     $(elem).inputmask('decimal', { digits: 2, allowMinus: false });
                     $(elem).prop('readonly', true);
                  }
               }
            },
            { name: 'PesoNeto', hidden: true },
            { name: 'TipoAfectacionIgvId', hidden: true },
            { name: 'Estado', hidden: true },
            { name: '@AppConstante.DTO_STATE', hidden: true }
         ],
         pager: "#productoPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

         if ($('#EstadoCotizacion').val() === '@EstadoCotizacionConstante.FACTURADO') {
            $("#menuBar").appMenu('disabledButton', { buttonList: '@MenuItemKey.SAVE,soli_auto', disabled: true });
            $("#TipoCondicionPagoId").prop('disabled', true);
            if($('#EnviadoProduccion').val() === '@SiNoConstante.S') {
               $("#menuBar").appMenu('disabledButton', { buttonId: 'enviar_prod', disabled: true });
               $("#productoMenuBar").prop('disabled', true);
            }
         }

            if ($('#EnviadoProduccion').val() === '@SiNoConstante.S') {
               if ($('#EstadoCotizacion').val() === '@EstadoCotizacionConstante.FACTURADO') {
                  $("#productoMenuBar").prop('disabled', true);
               }
               if ($('#AutorizacionProduccion').val() !== '@SiNoConstante.S') {
                   $('#productoMenuBar').appMenu('disabled', { buttonId: 'enviar_prod', disabled: true });
                   $("#menuBar").appMenu('disabledButton', { buttonId: 'enviar_prod', disabled: true });
                  return;
               }
            }

            var editableRows = $('#productoGrid').appGrid('editableRowsCount');
            if (editableRows === 0) {
               editCustomGridMenuBar('productoMenuBar', 'productoGrid');
            }
            else
               $("#productoMenuBar").appMenu('saveMenu');
         },
         gridComplete: function () {
            editCustomGridMenuBar('productoMenuBar', 'productoGrid');
            $("#productoGrid").appGrid('resizeGrid', 'productoContainer');
            calcularTotalesGenerales();

            if ($('#EstadoCotizacion').val() === '@EstadoCotizacionConstante.FACTURADO') {
                    $('#productoMenuBar').appMenu('disabled');
            return;
            }
            if ($('#EnviadoProduccion').val() === '@SiNoConstante.S') { 
               if ($('#AutorizacionProduccion').val() !== '@SiNoConstante.S') {
                   $('#productoMenuBar').appMenu('disabled', { buttonId: 'enviar_prod', disabled: true });
                   $("#menuBar").appMenu('disabledButton', { buttonId: 'enviar_prod', disabled: true });
                  return;
               }
            }
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('productoContainer')
