   function proveedorSelectedPopup(sourceId, row) {

      if($.isEmpty(row)){
         msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("MG_proveedor_seleccion_requerida")');
         return false;
      }

      if (sourceId === 'proveedorListPopup') {
         $('#ProveedorId').val(row.ProveedorId);
         $('#Proveedor').val(row.RazonSocial);
         $('#NumeroDocumentoIdentidad').val(row.NumeroDocumentoIdentidad);
         $('#ListaPrecioProveedorId').val(0);
         $('#IgnorarIncrementoFraccion').val('@SiNoConstante.N');

         $(this).postAction({
            urlAction: '@Url.Action("ObtenerListaPrecioProveedorId", "Pedido")',
            viewModel: [
               { name: "ListaPrecioProveedorDTO.ListaPrecioId", value: $('#ListaPrecioId').val(), type: 'int' },
               { name: "ListaPrecioProveedorDTO.ProveedorId", value: $('#ProveedorId').val(), type: 'int' }
            ],
            onSuccess: function (response) {
               if (response.success) {
                  $('#ListaPrecioProveedorId').val(response.data.listaPrecioProveedorId);
                  $('#IgnorarIncrementoFraccion').val(response.data.ignorarIncrementoFraccion);
               } else {
                  msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
               }
            }
         });
      } else {
         $('#mp-ProveedorId').val(row.ProveedorId);
         $('#mp-Proveedor2').val(row.RazonSocial);
         $('#mp-NumeroDocumentoIdentidad2').val(row.NumeroDocumentoIdentidad);
      }

      $('#' + sourceId).hideDialog();
   };
