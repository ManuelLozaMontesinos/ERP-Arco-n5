   function anticipoSelectedPopup(sourceId, row) {

      if($.isEmpty(row)){
         msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("VT_anticipo_seleccion_requerida")');
         return false;
      }

      if (!$.isNullOrEmpty(row.SerieNumero)){
         var data = $("#anticipoGrid").appGrid('getData');
         var selectedData = _.filter(data, function (r) {
            return r.Estado === '@EstadoConstante.ACTIVO' && !$.isNullOrEmpty(r.SerieNumero);
         });
         if (selectedData.length > 0) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("VT_anticipo_solo_un_documento_permitido")');
            return false;
         }
      }

      $(this).saveView({
         urlAction: '@Url.Action("AgregarAnticipoCliente", "Pedido")',
         viewModel: [
            { name: "AnticipoClienteDTO.AnticipoClienteId", value: row.AnticipoClienteId, type: 'int' },
            { name: "AnticipoClienteDTO.CotizacionId", value: $('#CotizacionId').val(), type: 'int' },
         ],
         onSuccess: function (response) {
            if (response.success) {
               $("#anticipoGrid").appGrid('reloadJSON');
               calcularTotalesGenerales();
               $('#anticipoListPopup').hideDialog();
               msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });

   };
   function anticipoEditPopupOnClick() {
