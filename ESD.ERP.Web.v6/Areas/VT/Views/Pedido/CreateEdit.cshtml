    function enviarProduccionEditPopupOnClick() {

        if (!mp_validarDatos())
            return false;
        var cotizacionProductoList = [];

        var list = $('#productoPopupGrid').appGrid('getDataIDs');
        for (i in list) {

            var rowId = list[i];
            if (isEmptyRecord(rowId))
                continue;

            var row = $('#productoPopupGrid').appGrid('getRow', rowId);
            var cantidadVenta = parseFloat($('#' + rowId + '_CantidadVenta').val()) || 0;
            var cantidadGratis = parseFloat($('#' + rowId + '_CortesGratis').val()) || 0;

            var cotizacionProducto = [
                { name: "CotizacionProductoId", value: row.CotizacionProductoId, type: 'int' },
                { name: "Cantidad", value: cantidadVenta + cantidadGratis, type: 'decimal' },
                { name: "ProductoId", value: row.ProductoId, type: 'int'},
                { name: "Descripcion", value: row.Descripcion},
            ];

            cotizacionProductoList.push(cotizacionProducto);
        }

        $('#enviarProduccionEditPopup').saveView({
            viewModel: [
                { name: "CotizacionDTO.CotizacionId", value: $('#CotizacionId').val(), type: 'int' },
                { name: "CotizacionDTO.Fecha", value: $('#mp-DiaEntrega').val() + $('#mp-HoraEntrega').val(), type: 'datetime' },
                { name: "CotizacionProductoDTOList", value: cotizacionProductoList, type: 'list' }
            ],
            buttonId: '@MenuItemKey.SAVE',
            urlAction: '@Url.Action("GenerarOrdenProduccion", "Pedido")',                 
            onSuccess: function (response) {
                if (response.success) {
                    $("#OrdenProduccionId").val(response.data.Id);
                    $("#EnviadoProduccion").val(response.data.EnviadoProduccion);
                    $('#productoMenuBar').appMenu('disabled', { buttonId: 'enviar_prod', disabled: true });
                    $("#menuBar").appMenu('disabledButton', { buttonId: 'enviar_prod', disabled: true });   

                    $('#productoMenuBar').appGrid('reloadJSON');
                    $('#menuBar').appGrid('reloadJSON');
                    $('#procesoGrid').appGrid('reloadJSON');
                    msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                } else {
                    msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                }
                $('#enviarProduccionEditPopup').hideDialog();
                $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.SAVE', disabled: false });
            }
        });
    };

    function enviarProduccionParcialEditPopupOnClick() {

         if (!mp_validarDatos())
             return false;
         var cotizacionProductoList = [];

         var list = $('#productoPopupGrid').appGrid('getDataIDs');
         for (i in list) {

             var rowId = list[i];
             if (isEmptyRecord(rowId))
                 continue;
                 
            var row = $('#productoPopupGrid').appGrid('getRow', rowId);
            var cantidad = parseFloat($('#' + rowId + '_CantidadVenta').val()) || 0;
            var cantidadParcial = parseFloat($('#' + rowId + '_CantidadEnvio').val()) || 0;
            var cantidadGratis = parseFloat($('#' + rowId + '_CortesGratis').val()) || 0;

             var cotizacionProducto = [
                 { name: "CotizacionProductoId", value: row.CotizacionProductoId, type: 'int' },
                 { name: "Cantidad", value: cantidad, type: 'decimal'},
                 { name: "CantidadParcial", value: cantidadParcial, type: 'decimal' },
                 { name: "CortesGratis", value: cantidadGratis, type: 'decimal'},
                 { name: "ProductoId", value: row.ProductoId, type: 'int'}
             ];

             cotizacionProductoList.push(cotizacionProducto);
         }
            
         $('#enviarProduccionParcialEditPopup').saveView({
             viewModel: [
                 { name: "CotizacionDTO.CotizacionId", value: $('#CotizacionId').val(), type: 'int' },
                 { name: "CotizacionDTO.Fecha", value: $('#mp-DiaEntrega').val() + $('#mp-HoraEntrega').val(), type: 'datetime' },
                 { name: "CotizacionProductoDTOList", value: cotizacionProductoList, type: 'list' }
             ],
             buttonId: '@MenuItemKey.SAVE',
             urlAction: '@Url.Action("GenerarOrdenProduccionParcial", "Pedido")',
             onSuccess: function (response) {
                 if (response.success) {
                     $("#OrdenProduccionId").val(response.data.Id);
                     $("#EnviadoProduccion").val(response.data.EnviadoProduccion);
                     $('#productoMenuBar').appMenu('disabled', { buttonId: 'enviar_prod', disabled: true });
                     $("#menuBar").appMenu('disabledButton', { buttonId: 'enviar_prod', disabled: true });

                     $('#productoMenuBar').appGrid('reloadJSON');
                     $('#menuBar').appGrid('reloadJSON');
                     $('#procesoGrid').appGrid('reloadJSON');
                     msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                 } else {
                     msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                 }
                  $('#enviarProduccionParcialEditPopup').hideDialog();
                 $("#menuBar").appMenu('disabledButton', { buttonId: '@MenuItemKey.SAVE', disabled: false });

             }
         });
     };

</script>
