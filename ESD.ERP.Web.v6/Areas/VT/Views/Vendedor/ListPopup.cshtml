@using ESD.Core;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@model ESD.ERP.Web.Areas.VT.Models.VendedorViewModel
<div id="mp-edit-panel">
   <div class="card-body">
      <div class="row">
         <div class="col-11">
            <div class="form-group row">
               <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2" max-length="20"
                            in-modal="true"></esd-textbox>
            </div>
            <div class="form-group row">
               <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Apellidos y Nombres" col-label-position="col-lg-2" max-length="150"
                            in-modal="true"></esd-textbox>
            </div>
         </div>
         <div class="col-1">
            <div class="form-group row">
               <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="mp_clearButtonOnClick()"></esd-button>
            </div>
         </div>
      </div>
   </div>
</div>
<div id="bandejaPopupContainer">
   <table id="bandejaPopupGrid"></table>
   <div id="bandejaPopupPager"></div>
</div>
<script type="text/javascript">
   $("#bandejaPopupGrid").jqGrid({
      @GridHelper.DefaultProperties()
       url: "@Url.Action("ListarBandeja", "Vendedor")",
      postData: {
         jsonModel: function () {
            return JSON.stringify(modelToObject(
               [
                  { name: "VendedorDTO.ProveedorDTO.NumeroDocumentoIdentidad", value: $('#mp-NumeroDocumentoIdentidad').val() },
                  { name: "VendedorDTO.ProveedorDTO.RazonSocial", value: $('#mp-RazonSocial').val() }
               ]
            ));
         }
      },
      colNames: ['', 'Codigo', '#Documento', 'Apellidos y Nombres','Nombre Corto',''],
      colModel: [
         { name: 'VendedorId', hidden: true },
         { name: "Codigo", width: 60 },
         { name: "NumeroDocumentoIdentidad", width: 100 },
         { name: "RazonSocial", width: 350 },
         { name: "Abreviatura", width: 120 },
         { name: 'Estado', hidden: true },
      ],
      pager: "#bandejaPopupPager",
      ondblClickRow: function (rowid) {

         var popupParams = getPopupParam('mp-edit-panel')

         var row = $(this).getRowData(rowid);
         vendedorSelectedPopup(popupParams.dialogId, row);
      },
      gridComplete: function () {
         $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
      },
      height: 250
   });
   function mp_clearButtonOnClick() {
      $('#mp-edit-panel').find('input:text').val('');
      $('#bandejaPopupGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#mp-NumeroDocumentoIdentidad, #mp-RazonSocial").change(function () {
         $('#bandejaPopupGrid').appGrid('reloadJSON');
      });
   });
</script>