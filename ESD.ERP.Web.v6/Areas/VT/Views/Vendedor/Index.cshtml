@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.VT.Models.VendedorViewModel
<esd-menubar id="menuBar" Title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2" max-length="20"></esd-textbox>
                  <esd-checkbox id="VerAnulado" col-position="col-lg-2" label="Mostrar Anulados" onchange="VerAnuladoOnChange()"
                                checkbox-style="Default"></esd-checkbox> 
               </div>
               <div class="form-group row">
                  <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Apellidos y Nombres" col-label-position="col-lg-2" max-length="150"></esd-textbox>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<script type="text/javascript">
   $(document).ready(function () {
      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "Vendedor")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "VendedorDTO.ProveedorDTO.NumeroDocumentoIdentidad", value: $('#NumeroDocumentoIdentidad').val() },
                     { name: "VendedorDTO.ProveedorDTO.RazonSocial", value: $('#RazonSocial').val() },
                     { name: "VendedorDTO.Estado", value: $('#VerAnulado').prop('checked') ? '' : '@EstadoConstante.ACTIVO' }
                  ]
               ));
            }
         },
         colNames: ['', 'Codigo', '#Documento', 'Apellidos y Nombres','Nombre Corto',''],
         colModel: [
            { name: 'VendedorId', hidden: true },
            { name: "Codigo", width: 60 },
            { name: "NumeroDocumentoIdentidad", width: 100 },
            { name: "RazonSocial", width: 350 },
            { name: "Abreviatura", width: 120 },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;
            var row = $('#bandejaGrid').appGrid('getSelectedRow');

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });

            if (row.Estado === '@EstadoConstante.INACTIVO') 
               $("#menuBar").appMenu('disabledButton', { buttonId: 'activarVendedor', disabled: false });            
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#NumeroDocumentoIdentidad, #RazonSocial").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
   });
   
   function VerAnuladoOnChange() {
        $("#bandejaGrid").appGrid('reloadJSON');
   };

   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW','@MenuItemKey.EXIT'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {

         case '@MenuItemKey.NEW':
            $(this).getView({
               editAction: '@ViewModelEditAction.New',
               buttonId: key,
               viewModel: [
                  { name: "VendedorDTO.VendedorId", value: 0, type: 'int' }
               ],
               urlAction: '@Url.Action("Crear", "Vendedor")'
            });
            break;

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "VendedorDTO.VendedorId", value: row.VendedorId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "Vendedor")'
            });
            break;

         case '@MenuItemKey.DELETE':
            $('#menuBar').appMenu('disabledButton', { buttonId: key, disabled: true });
            $(this).confirm({
               title: '@SR.GetString("APPMP_anular_titulo")',
               message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
               onConfirm: function () {

                  $(this).saveView({
                     urlAction: '@Url.Action("Eliminar", "Vendedor")',
                     viewModel: [
                        { name: "VendedorDTO.VendedorId", value: row.VendedorId, type: 'int' },
                        { name: "VendedorDTO.ProveedorDTO.RazonSocial", value: row.RazonSocial }
                     ],
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#bandejaGrid').appGrid('reloadJSON');
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
         break;

         case 'activarVendedor':
             
         $(this).confirm({
                 title: 'Activar Registro',
                 message: '¿Está seguro que desea activar el registro seleccionado?',
                 onConfirm: function () {

                    $(this).saveView({
                       urlAction: '@Url.Action("ActivarVendedor", "Vendedor")',
                       viewModel: [
                          { name: "VendedorDTO.VendedorId", value: row.VendedorId, type: 'int' },
                          { name: "VendedorDTO.Estado", value: '@EstadoConstante.ACTIVO' }
                       ],
                       onSuccess: function (response) {
                          if (response.success) {
                             $('#bandejaGrid').appGrid('reloadJSON');
                             $("#bandejaGrid").appMenu('disabledButton', { buttonId: 'activarVendedor', disabled: true });
                             msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                          } else {
                             msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                          }
                       }
                    });
                 }
              });
         break;

      }
      return true;
   };
</script>