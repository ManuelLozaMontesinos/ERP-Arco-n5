@using ESD.Core;
@using ESD.Core.Web;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.VT.Models.ReporteGenViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="PreviewExport" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-12">
               <div class="form-group row">
                  <esd-dropdownlist id="MesId" for="@Model.SeleccionList" col-position="col-lg-4" label="Mes" col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="GrupoProductoId" for="@Model.Seleccion2List" col-position="col-lg-4" label="Grupo Producto" col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
            </div>
         </div>
      </div>
   </div>
</section>
<script type="text/javascript">

   function menuBarOnClick(key) {

      if (!$('#MesId').validateNumeric('@SR.GetString("GEN_mes_seleccion_requerida")'))
         return false;

      var reportParam = "mesId=" + $('#MesId').val()
         + "&grupoProductoId=" + $('#GrupoProductoId').val();

      var format = '';
      switch (key) {

         case '@MenuItemKey.PREVIEW':
            format = '@ReportFormatConstant.PDF'
            break;
         case '@MenuItemKey.EXPORT_XLS':
            format = '@ReportFormatConstant.EXCEL'
            break;
         case '@MenuItemKey.EXPORT_DATA_XLS':
            format = '@ReportFormatConstant.EXCELDATA'
            break;
      }

      $(this).getReport({
         urlAction: '@Url.Action("ReportTo", "RepoMargenUnitario")',
         parameters: reportParam,
         format: format,
         onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
      });

      return true;
   };
</script>