@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.VT.Models.GuiaRemVtaViewModel
<div id="mp-edit-panel">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-dropdownlist id="Serie" for="@Model.SerieList" col-position="col-lg-2" label="Serie" col-label-position="col-lg-2"
                                    in-modal="true"></esd-dropdownlist>
                  <esd-textbox for="@Model.GuiaRemisionDTO.Numero" col-position="col-lg-2" enable="false"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker for="@Model.GuiaRemisionDTO.Fecha" col-position="col-lg-2" label="Fecha" col-label-position="col-lg-2"
                                      in-modal="true"></esd-datetimepicker>
                  <esd-datetimepicker for="@Model.GuiaRemisionDTO.FechaInicioTraslado" col-position="col-lg-2" label="Fecha Partida" col-label-position="col-lg-2"
                                      in-modal="true"></esd-datetimepicker>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TransportistaId" for="@Model.TransportistaList" col-position="col-lg-4" label="Transportista" col-label-position="col-lg-2"
                                    onchange="mp_transportistaIdOnChange();" in-modal="true"></esd-dropdownlist>
                  <esd-dropdownlist id="TransportistaConductorId" for="@Model.TransportistaConductorList" col-position="col-lg-5" label="Conductor" col-label-position="col-lg-1"
                                    in-modal="true" enable="false"></esd-dropdownlist>
               </div>
               <div class="form-group row">

               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TransportistaUnidadId" for="@Model.TransportistaUnidadList" col-position="col-lg-6" label="Unidad" col-label-position="col-lg-2"
                                    in-modal="true" enable="false"></esd-dropdownlist>
                  <esd-numerictextbox for="@Model.GuiaRemisionDTO.CostoFlete" col-position="col-lg-2" label="Costo Flete" col-label-position="col-lg-2"
                                      in-modal="true"></esd-numerictextbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="DepartamentoId" for="@Model.DepartamentoList" selected-value="@Model.DepartamentoId" col-position="col-lg-2" label="Partida - Departamento"
                                    col-label-position="col-lg-2" onchange="mp_departamentoIdOnChange();" in-modal="true" enable="false"></esd-dropdownlist>
                  <esd-dropdownlist id="ProvinciaId" for="@Model.ProvinciaList" selected-value="@Model.ProvinciaId" col-position="col-lg-2" label="Provincia"
                                    col-label-position="col-lg-1" onchange="mp_provinciaIdOnChange();" in-modal="true" enable="false"></esd-dropdownlist>
                  <esd-dropdownlist id="DistritoId" for="@Model.DistritoList" selected-value="@Model.GuiaRemisionDTO.DistritoId" col-position="col-lg-3" label="Distrito"
                                    col-label-position="col-lg-1" in-modal="true" enable="false"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.GuiaRemisionDTO.PuntoPartida" col-position="col-lg-10" label="Dirección" col-label-position="col-lg-2"
                               max-length="100" in-modal="true"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="Departamento2Id" for="@Model.DepartamentoList2" selected-value="@Model.Departamento2Id" col-position="col-lg-2" label="Llegada - Departamento"
                                    col-label-position="col-lg-2" onchange="mp_departamento2IdOnChange();" in-modal="true"></esd-dropdownlist>
                  <esd-dropdownlist id="Provincia2Id" for="@Model.ProvinciaList2" selected-value="@Model.Provincia2Id" col-position="col-lg-2" label="Provincia"
                                    col-label-position="col-lg-1" onchange="mp_provincia2IdOnChange();" in-modal="true"></esd-dropdownlist>
                  <esd-dropdownlist id="DistritoLlegadaId" for="@Model.DistritoList2" selected-value="@Model.GuiaRemisionDTO.DistritoLlegadaId" col-position="col-lg-3" label="Distrito"
                                    col-label-position="col-lg-1" in-modal="true"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.GuiaRemisionDTO.PuntoLlegada" col-position="col-lg-10" label="Dirección" col-label-position="col-lg-2"
                               max-length="100" in-modal="true"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="MotivoTrasladoId" for="@Model.MotivoTrasladoList" col-position="col-lg-6" label="Motivo Traslado" col-label-position="col-lg-2"
                                    in-modal="true" enable="@(!Model.GetSelectedItemDisabled("MotivoTraslado"))"></esd-dropdownlist>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>
<script type="text/javascript">
   function mp_transportistaIdOnChange() {

      var transportistaId = $("#mp-TransportistaId").val();
      if ($.isNullOrEmpty(transportistaId)) {
         $("#mp-TransportistaConductorId").val('');
         $("#mp-TransportistaConductorId").prop('disabled',true);
         $("#mp-TransportistaUnidadId").val('');
         $("#mp-TransportistaUnidadId").prop('disabled', true);
         return;
      }

      $(this).getAction({
         urlAction: '@Url.Action("ListarUnidadConductor", "GuiaRemVta")',
         id: transportistaId,
         onSuccess: function (response) {
            if (response.success) {
               $('#mp-TransportistaConductorId').find('option').remove().end();
               $("#mp-TransportistaConductorId").addItems(response.data.conductorList);
               $("#mp-TransportistaConductorId").prop('disabled', false);

               $('#mp-TransportistaUnidadId').find('option').remove().end();
               $("#mp-TransportistaUnidadId").addItems(response.data.unidadList);
               $("#mp-TransportistaUnidadId").prop('disabled', false);
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function mp_departamentoIdOnChange() {

      var departamentoId = $("#mp-DepartamentoId").val();
      if ($.isNullOrEmpty(departamentoId)) {
         $("#mp-ProvinciaId").prop('disabled', true);
         $("#mp-DistritoId").prop('disabled', true);
         return;
      }

      $("#mp-ProvinciaId").val('');
      $("#mp-DistritoId").val('');
      $("#mp-DistritoId").prop('disabled', true);

      $(this).getAction({
         urlAction: '@Url.Action("ListarProvincia", "GuiaRemVta")',
         id: departamentoId,
         onSuccess: function (response) {
            if (response.success) {
               $('#mp-ProvinciaId').find('option').remove().end();
               $("#mp-ProvinciaId").addItems(response.data);

               if (!$.isNullOrEmpty($("#mp-DepartamentoId").val())) {
                  $("#mp-ProvinciaId").removeAttr("disabled");
               }
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function mp_provinciaIdOnChange() {

      var provinciaId = $("#mp-ProvinciaId").val();
      if ($.isNullOrEmpty(provinciaId)) {
         $("#mp-DistritoId").prop('disabled', true);
         return;
      }

      $("#mp-DistritoId").val('');
      $("#mp-DistritoId").prop('disabled', true);

      $(this).getAction({
         urlAction: '@Url.Action("ListarDistrito", "GuiaRemVta")',
         id: provinciaId,
         onSuccess: function (response) {
            if (response.success) {
               $('#mp-DistritoId').find('option').remove().end();
               $("#mp-DistritoId").addItems(response.data);

               if (!$.isNullOrEmpty(provinciaId)) {
                  $("#mp-DistritoId").removeAttr("disabled");
               }
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function mp_departamento2IdOnChange() {

      var departamentoId = $("#mp-Departamento2Id").val();
      if ($.isNullOrEmpty(departamentoId)) {
         $("#mp-Provincia2Id").prop('disabled', true);
         $("#mp-DistritoLlegadaId").prop('disabled', true);
         return;
      }

      $("#mp-Provincia2Id").val('');
      $("#mp-DistritoLlegadaId").val('');
      $("#mp-DistritoLlegadaId").prop('disabled', true);

      $(this).getAction({
         urlAction: '@Url.Action("ListarProvincia", "GuiaRemVta")',
         id: departamentoId,
         onSuccess: function (response) {
            if (response.success) {
               $('#mp-Provincia2Id').find('option').remove().end();
               $("#mp-Provincia2Id").addItems(response.data);

               if (!$.isNullOrEmpty($("#mp-Departamento2Id").val())) {
                  $("#mp-Provincia2Id").removeAttr("disabled");
               }
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function mp_provincia2IdOnChange() {

      var provinciaId = $("#mp-Provincia2Id").val();
      if ($.isNullOrEmpty(provinciaId)) {
         $("#mp-DistritoLlegadaId").prop('disabled', true);
         return;
      }

      $("#mp-DistritoLlegadaId").val('');
      $("#mp-DistritoLlegadaId").prop('disabled', true);

      $(this).getAction({
         urlAction: '@Url.Action("ListarDistrito", "GuiaRemVta")',
         id: provinciaId,
         onSuccess: function (response) {
            if (response.success) {
               $('#mp-DistritoLlegadaId').find('option').remove().end();
               $("#mp-DistritoLlegadaId").addItems(response.data);

               if (!$.isNullOrEmpty(provinciaId)) {
                  $("#mp-DistritoLlegadaId").removeAttr("disabled");
               }
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   };
   function mp_validarDatos() {

      if (!$('#mp-Serie').validateString('@SR.GetString("GEN_serie_requerida")'))
         return false;
      if (!$('#mp-Fecha').validateString('@SR.GetString("GEN_fecha_requerida")'))
         return false;
      if (!$('#mp-FechaInicioTraslado').validateString('@SR.GetString("IV_guia_remision_fecha_traslado_requerida")'))
         return false;
      if (!$('#mp-DepartamentoId').validateNumeric('@SR.GetString("IV_departamento_partida_seleccion_requerida")'))
         return false;
      if (!$('#mp-ProvinciaId').validateNumeric('@SR.GetString("IV_provincia_partida_seleccion_requerida")'))
         return false;
      if (!$('#mp-DistritoId').validateNumeric('@SR.GetString("IV_distrito_partida_seleccion_requerida")'))
         return false;
      if (!$('#mp-PuntoPartida').validateString('@SR.GetString("IV_punto_partida_requerida")'))
         return false;
      if (!$('#mp-Departamento2Id').validateNumeric('@SR.GetString("IV_departamento_llegada_seleccion_requerida")'))
         return false;
      if (!$('#mp-Provincia2Id').validateNumeric('@SR.GetString("IV_provincia_llegada_seleccion_requerida")'))
         return false;
      if (!$('#mp-DistritoLlegadaId').validateNumeric('@SR.GetString("IV_distrito_llegada_seleccion_requerida")'))
         return false;
      if (!$('#mp-PuntoLlegada').validateString('@SR.GetString("IV_punto_llegada_requerida")'))
         return false;
      if (!$('#mp-MotivoTrasladoId').validateString('@SR.GetString("VT_motivo_traslado_seleccion_requerida")'))
         return false;

      return true;
   };
</script>