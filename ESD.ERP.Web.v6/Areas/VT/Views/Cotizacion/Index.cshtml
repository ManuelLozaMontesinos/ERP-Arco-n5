@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.VT.Models.CotizacionViewModel
<esd-menubar id="menuBar" Title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
    <div id="app-search-card" class="card">
        <div class="card-body">
            <div class="row">
                <div id="app-search-input-group" class="col-11">
                    <div class="form-group row">
                        <esd-textbox id="Codigo" col-position="col-lg-2" label="Código" col-label-position="col-lg-2" max-length="7"></esd-textbox>
                    </div>
                    <div class="form-group row">
                        <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2" max-length="35"></esd-textbox>
                        <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Razon Social" col-label-position="col-lg-2" max-length="150"></esd-textbox>
                    </div>
                    <div class="form-group row">
                        <esd-textbox for="@Model.Vendedor" col-position="col-lg-6" label="Vendedor" col-label-position="col-lg-2" max-length="150"></esd-textbox>
                        <esd-dropdownlist id="EstadoCotizacionId" for="@Model.EstadoCotizacionList" col-position="col-lg-2" label="Estado" col-label-position="col-lg-2"></esd-dropdownlist>
                    </div>
                    <div class="form-group row">
                        <esd-datetimepicker id="FechaDesde" col-position="col-lg-2" label="Desde" col-label-position="col-lg-2"></esd-datetimepicker>
                        <esd-datetimepicker id="FechaHasta" col-position="col-lg-2" label="Hasta" col-label-position="col-lg-2"></esd-datetimepicker>
                    </div>
                </div>
                <div class="col-1">
                    <div class="form-group row">
                        <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="bandejaContainer">
        <table id="bandejaGrid"></table>
        <div id="bandejaPager"></div>
    </div>
</section>
<esd-dialog id="vistaPreviaEditPopup" title="Vista Previa" onclick="vistaPreviaEditPopupOnClick">
    <div id="vistaPreviaEditPopupContent"></div>
</esd-dialog>
<esd-dialog id="saldoListPopup" title="Lista de Precios" onclick="catalogoListPopupOnClick" size="Large">
    <div id="saldoListPopupContent"></div>
</esd-dialog>
<script type="text/javascript">
    $(document).ready(function () {
       $("#bandejaGrid").jqGrid({
          @GridHelper.DefaultProperties()
          url: "@Url.Action("ListarBandeja", "Cotizacion")",
          postData: {
             jsonModel: function () {
                return JSON.stringify(modelToObject(
                   [
                      { name: "CotizacionDTO.Codigo", value: $('#Codigo').val() },
                      { name: "CotizacionDTO.ProveedorDTO.NumeroDocumentoIdentidad", value: $('#NumeroDocumentoIdentidad').val() },
                      { name: "CotizacionDTO.ProveedorDTO.RazonSocial", value: $('#RazonSocial').val() },
                      { name: "CotizacionDTO.VendedorDTO.ProveedorDTO.RazonSocial", value: $('#Vendedor').val() },
                      { name: "CotizacionDTO.EstadoCotizacionId", value: $('#EstadoCotizacionId').val() ||0, type:'int' },
                      { name: "CotizacionDTO.FechaDesde", value: $('#FechaDesde').val(), type: 'date' },
                      { name: "CotizacionDTO.FechaHasta", value: $('#FechaHasta').val(), type: 'date' }
                   ]
                ));
             }
          },
          colNames: ['','Código', 'Fecha', 'Cliente','#Doc','Vendedor', '', 'Mon.','Total','','Estado',''],
          colModel: [
             { name: 'CotizacionId', hidden: true },
             { name: "Codigo", width: 80 },
             { name: "Fecha", width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
             { name: "RazonSocial", width: 300 },
             { name: "NumeroDocumentoIdentidad", width: 100 },
             { name: "VendedorNombre", width: 250 },
             { name: "ListaPrecioId", hidden: true},
             { name: "Moneda", width: 50 },
             { name: "MontoTotal", width: 100, align: 'right', formatter: 'number', sorttype: 'number' },
             { name: 'EstadoCotizacion', hidden: true },
             { name: "EstadoCotizacionNombre", width: 200 },
             { name: 'Estado', hidden: true },
          ],
          pager: "#bandejaPager",
          onSelectRow: function (rowid) {
             if (rowid == null || rowid == 0)
                return;

             $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
             $("#menuBar").appMenu('disabledButton', { buttonId: 'consulta', disabled: false });
          },
          gridComplete: function () {
             $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
             $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
             $("#menuBar").appMenu('disabledButton', { buttonId: 'consulta', disabled: false });
          },
          @GridHelper.RowDeletedStyle("Estado", EstadoConstante.INACTIVO)
          height: calculateGridHeight('bandejaContainer')
       });

       $('#saldoListPopup').setDialog({
          onShow: function (p) {
             $(this).getView({
                urlAction: '@Url.Action("SaldoListPopup", "ListaPrecio")',
                container: 'saldoListPopupContent',
                selModel: [
                   { name: "Moneda", value: '@MonedaConstante.SOLES' },
                   { name: "ListaPrecioId", type: 'firstElement' },
                ],
                showLoading: false,
                hideLoading: false
             });
          },
          onShown: function () {
             $("#bandejaPopupGrid").appGrid('resizeGrid', 'bandejaPopupContainer');
          }
       });
       $('#vistaPreviaEditPopup').setDialog({
          onShow: function (p) {
             var row = $('#bandejaGrid').appGrid('getSelectedRow');

             $(this).getView({
                urlAction: '@Url.Action("VistaPreviaEditPopup", "Cotizacion")',
                container: 'vistaPreviaEditPopupContent',
                showLoading: false,
                hideLoading: false
             });
          }
       });
    });
    function clearButtonOnClick() {
       $('#app-search-input-group').find('input:text').val('');
       $('#Vendedor').val('@Model.Vendedor');
       $('#bandejaGrid').appGrid('reloadJSON');
    }
    $(function () {
       $("#Codigo, #NumeroDocumentoIdentidad, #RazonSocial,#Vendedor,#EstadoCotizacionId").change(function () {
          $('#bandejaGrid').appGrid('reloadJSON');
       });
       $("#Codigo").keydown(function (e) {
          if (event.which == 13) {
             if (!$.isNullOrEmpty($("#Codigo").val())) {
                var valueFmt = padLeadingZeros($("#Codigo").val(), 7)
                $("#Codigo").val(valueFmt);
             }
             event.preventDefault();
             $('#bandejaGrid').appGrid('reloadJSON');
          }
       });
        $("#FechaDesde-ddiv, #FechaHasta-ddiv").on('change.datetimepicker', function () {
           $('#bandejaGrid').appGrid('reloadJSON');
        });
        $("#FechaDesde, #FechaHasta").keydown(function (e) {
           if (e.which == 13) {
              e.preventDefault();
              $('#bandejaGrid').appGrid('reloadJSON');
           }
        });
    });
    function menuBarOnClick(key) {

       var row = $('#bandejaGrid').appGrid('getSelectedRow');

       var excludeKeys = ['@MenuItemKey.NEW','consulta'];
       if(excludeKeys.indexOf(key) == -1){
          if ($.isEmpty(row)) {
             msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
             return;
          }
       }

       switch (key) {

          case '@MenuItemKey.NEW':
             $(this).getView({
                editAction: '@ViewModelEditAction.New',
                buttonId: key,
                viewModel: [
                   { name: "CotizacionDTO.CotizacionId", value: 0, type: 'int' }
                ],
                urlAction: '@Url.Action("Crear", "Cotizacion")'
             });
             break;

          case '@MenuItemKey.EDIT':
             $(this).getView({
                editAction: '@ViewModelEditAction.Edit',
                buttonId: key,
                viewModel: [
                   { name: "CotizacionDTO.CotizacionId", value: row.CotizacionId, type: 'int' }
                ],
                urlAction: '@Url.Action("Editar", "Cotizacion")'
             });
             break;

          case '@MenuItemKey.DELETE':
             $('#menuBar').appMenu('disabledButton', { buttonId: key, disabled: true });
             $(this).confirm({
                title: '@SR.GetString("APPMP_anular_titulo")',
                message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
                onConfirm: function () {

                   $(this).saveView({
                      urlAction: '@Url.Action("Eliminar", "Cotizacion")',
                      viewModel: [
                         { name: "CotizacionDTO.CotizacionId", value: row.CotizacionId, type: 'int' },
                         { name: "CotizacionDTO.Codigo", value: row.Codigo }
                      ],
                      onSuccess: function (response) {
                         if (response.success) {
                            $('#bandejaGrid').appGrid('reloadJSON');
                            msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                         } else {
                            msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                         }
                      }
                   });
                }
             });
             break;

          case '@MenuItemKey.PREVIEW':
             $('#vistaPreviaEditPopup').showDialog();
             break;

          case 'consulta':
             $('#saldoListPopup').showDialog();
             break;
       }
       return true;
    };
    function vistaPreviaEditPopupOnClick() {

       var row = $('#bandejaGrid').appGrid('getSelectedRow');

       var reportParam = "cotizacionId=" + row.CotizacionId + "&incluyePeso="
          + ($('#mp-IncluyePesoCheckBox').prop('checked') ? '@SiNoConstante.S' : '@SiNoConstante.N')
          + "&ListaPrecioId=" + row.ListaPrecioId;

       $('#vistaPreviaEditPopup').hideDialog();

       $(this).getReport({
          urlAction: '@Url.Action("ReportTo", "Cotizacion")',
          parameters: reportParam,
          onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
       });
    };
</script>
