   function calcularPrecioProveedorProducto(element) {

      var row = $('#clienteProductoGrid').appGrid('getSelectedRow');
      var rowId = $('#clienteProductoGrid').appGrid('getSelectedRowId');

      var precioUnitario = parseFloatEx(row.PrecioUnitario);
      var porcentajePrecioBase = parseFloatEx($("#" + rowId + "_PorcentajePrecioBase").val());

      var nuevoPU = ((precioUnitario * porcentajePrecioBase) / 100).toFixed(1);

      $("#" + rowId + "_PrecioUnitarioFinal").val(nuevoPU);
   };
   function editCustomGridMenuBar(key, gridName, excludeDeletedRow) {
