@using ESD.Core;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.VT.Models.CuadroCostoViewModel
<esd-menubar id="menuBar" Title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-dropdownlist id="ListaPrecioId" for="@Model.ListaPrecioList" col-position="col-lg-4" label="Lista de Precios" col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-textbox id="Codigo" col-position="col-lg-2" label="Codigo" col-label-position="col-lg-2" max-length="12"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox id="Descripcion" col-position="col-lg-6" label="Descripcion" col-label-position="col-lg-2" max-length="100"></esd-textbox>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "CuadroCosto")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "CuadroCostoDTO.ListaPrecioId", value: $('#ListaPrecioId').val() || 0, type: 'int' },
                     { name: "CuadroCostoDTO.ProductoDTO.Codigo", value: $('#Codigo').val() },
                     { name: "CuadroCostoDTO.ProductoDTO.Descripcion", value: $('#Descripcion').val() }
                  ]
               ));
            }
         },
         colNames: ['', 'Codigo', 'Producto', 'V.Prom','F. Ult.Compra', 'Ultima Compra', 'P.Venta'],
         colModel: [
            { name: 'CuadroCostoId', hidden: true },
            { name: "Producto", width: 100 },
            { name: "Descripcion", width: 350 },
            { name: "ValorPromedio", width: 100, align: 'right', formatter: 'number', sorttype: 'number' },
            { name: "FechaUltimaCompra", width: 80, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: "ValorUltimaCompra", width: 100, align: 'right', formatter: 'number', sorttype: 'number' },
            { name: "PrecioUnitario", width: 100, align: 'right', formatter: 'number', sorttype: 'number' }
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $('#ListaPrecioId').val('');
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#ListaPrecioId,#Codigo,#Descripcion").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
   });
   function menuBarOnClick(key) {

      if (!$('#ListaPrecioId').validateNumeric('@SR.GetString("VT_lista_precio_seleccion_requerida")'))
         return false;

      $('#menuBar').appMenu('disabledButton', { buttonId: key, disabled: true });

      var reportParam = "listaPrecioId=" + $('#ListaPrecioId').val();

      $(this).getReport({
         urlAction: '@Url.Action("ReportTo", "CuadroCosto")',
         parameters: reportParam,
         onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
      });

      return true;
   };
</script>