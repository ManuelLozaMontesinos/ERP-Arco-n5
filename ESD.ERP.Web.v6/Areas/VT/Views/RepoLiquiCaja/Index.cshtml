@using ESD.Core;
@using ESD.Core.Web;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.VT.Models.ReporteGenViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="PreviewExport" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-12">
               <div class="form-group row">
                  <esd-dropdownlist id="CajaId" for="@Model.SeleccionList" col-position="col-lg-4" label="Caja" col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker for="@Model.Fecha" col-position="col-lg-2" label="Fecha" col-label-position="col-lg-2"></esd-datetimepicker>
               </div> 
            </div>
         </div>
      </div>
   </div>
</section>
<script type="text/javascript">

   function menuBarOnClick(key) {

      if (!$('#CajaId').validateNumeric('@SR.GetString("VT_caja_seleccion_requerida")'))
         return false;

      if (!$('#Fecha').validateString('@SR.GetString("GEN_fecha_requerida")'))
         return false;

      var reportParam = "cajaId=" + $('#CajaId').val() + "&fecha=" + $('#Fecha').val();

      var format = '';
      switch (key) {

         case '@MenuItemKey.PREVIEW':
            format = '@ReportFormatConstant.PDF'
            break;
         case '@MenuItemKey.EXPORT_XLS':
            format = '@ReportFormatConstant.EXCEL'
            break;
         case '@MenuItemKey.EXPORT_DATA_XLS':
            format = '@ReportFormatConstant.EXCELDATA'
            break;
      }

      $(this).getReport({
         urlAction: '@Url.Action("ReportTo", "RepoLiquiCaja")',
         parameters: reportParam,
         format: format,
         onFailMessage: '@SR.GetString("GEN_archivo_descarga_invalida")'
      });

      return true;
   };
</script>