@using ESD.Core;
@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.TS.Models.BancarizaViewModel
<esd-menubar id="menuBar" Title="@Model.Title" for="@Model.MenuItemList" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-dropdownlist id="PeriodoEmpresaSedeId" for="@Model.PeriodoEmpresaSedeList" col-position="col-lg-4" label="Sede" col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-textbox id="Numero" col-position="col-lg-2" label="Numero" col-label-position="col-lg-2" max-length="8"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Doc. Iden" col-label-position="col-lg-2" max-length="35"></esd-textbox>
                  <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Razon Social" col-label-position="col-lg-2" max-length="150"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-datetimepicker id="FechaDesde" col-position="col-lg-2" label="Desde" col-label-position="col-lg-2"></esd-datetimepicker>
                  <esd-datetimepicker id="FechaHasta" col-position="col-lg-2" label="Hasta" col-label-position="col-lg-2"></esd-datetimepicker>
               </div>
               <div class="form-group row">
                  <label class="col-lg-2 col-form-label">Bancarizado</label>
                  <esd-radiobutton id="TodoRadio" group-name="estadoBancarizado" label="Todos" col-position="col-lg-1" checked="true"></esd-radiobutton>
                  <esd-radiobutton id="SiRadio" group-name="estadoBancarizado" label="Si" col-position="col-lg-1"></esd-radiobutton>
                  <esd-radiobutton id="NoRadio" group-name="estadoBancarizado" label="No" col-position="col-lg-1"></esd-radiobutton>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "Bancariza")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "ComprobanteDTO.PeriodoEmpresaSedeId", value: $('#PeriodoEmpresaSedeId').val(), type: 'int' },
                     { name: "ComprobanteDTO.Numero", value: $('#Numero').val() },
                     { name: "ComprobanteDTO.ProveedorDTO.NumeroDocumentoIdentidad", value: $('#NumeroDocumentoIdentidad').val() },
                     { name: "ComprobanteDTO.ProveedorDTO.RazonSocial", value: $('#RazonSocial').val() },
                     { name: "ComprobanteDTO.FechaDesde", value: $('#FechaDesde').val(), type: 'date' },
                     { name: "ComprobanteDTO.FechaHasta", value: $('#FechaHasta').val(), type: 'date' },
                     { name: "ComprobanteDTO.Bancarizado", value: obtenerEstado() }
                  ]
               ));
            }
         },
         colNames: ['', 'T/D', 'Serie-Numero', 'Fecha', 'Cliente', '#Doc', 'Mon.', 'Total','Bancarizado', ''],
         colModel: [
            { name: 'ComprobanteId', hidden: true },
            { name: "TipoDocumentoComercialNombre", width: 40 },
            { name: "SerieNumero", width: 90 },
            { name: "Fecha", width: 70, align: 'right', sorttype: 'date', datefmt: '@JavaScriptConstant.GRID_DATE_FORMAT' },
            { name: "RazonSocial", width: 300 },
            { name: "NumeroDocumentoIdentidad", width: 100 },
            { name: "Moneda", width: 40 },
            { name: "MontoTotal", width: 90, align: 'right', formatter: 'number', sorttype: 'number' },
            { name: "Bancarizado", width: 90, align: 'center' },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $("#TodoRadio").prop("checked", true);

      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#PeriodoEmpresaSedeId,#Numero,#NumeroDocumentoIdentidad,#RazonSocial,#TodoRadio,#SiRadio,#NoRadio").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
      $("#Numero").keydown(function (e) {
         if (event.which == 13) {
            if (!$.isNullOrEmpty($("#Numero").val())) {
               var valueFmt = padLeadingZeros($("#Numero").val(), 8)
               $("#Numero").val(valueFmt);
            }
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
      $("#FechaDesde").keydown(function (e) {
         if (event.which == 13) {
            $("#FechaHasta").val($("#FechaDesde").val());
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
      $("#FechaHasta").keydown(function (e) {
         if (event.which == 13) {
            event.preventDefault();
            $('#bandejaGrid').appGrid('reloadJSON');
         }
      });
   });
   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "ComprobanteDTO.ComprobanteId", value: row.ComprobanteId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "Bancariza")'
            });
            break;
      }
      return true;
   };
   function obtenerEstado() {
      if ($('#TodoRadio').prop('checked'))
         return "";
      if ($('#SiRadio').prop('checked'))
         return "@SiNoConstante.S";
      if ($('#NoRadio').prop('checked'))
         return "@SiNoConstante.N";
   };
</script>