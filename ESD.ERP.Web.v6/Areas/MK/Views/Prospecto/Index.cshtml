@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.MK.Models.ProspectoViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="CRUD" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-masktextbox id="NumeroRuc" col-position="col-lg-2" label="R.U.C." col-label-position="col-lg-2" mask="99999999999"></esd-masktextbox>
                  <esd-textbox id="RazonSocial" col-position="col-lg-6" label="Nombre" col-label-position="col-lg-2" max-length="150"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoDocumentoIdentidadId" for="@Model.TipoDocumentoIdentidadList" col-position="col-lg-2" label="Tipo de Documento"
                                    col-label-position="col-lg-2"></esd-dropdownlist>
                  <esd-textbox id="NumeroDocumentoIdentidad" col-position="col-lg-2" label="#Documento" col-label-position="col-lg-2" max-length="20"></esd-textbox>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "Prospecto")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "ProveedorDTO.RazonSocial", value: $('#RazonSocial').val() },
                     { name: "ProveedorDTO.TipoDocumentoIdentidadId", value: $('#TipoDocumentoIdentidadId').val()||0, type: 'int' },
                     { name: "ProveedorDTO.NumeroDocumentoIdentidad", value: $('#NumeroDocumentoIdentidad').val() },
                     { name: "ProveedorDTO.NumeroRuc", value: $('#NumeroRuc').val() }
                  ]
               ));
            }
         },
         colNames: ['','Codigo', 'T/D', '#Documento','RUC', 'Razon Social','Telf.','Correo','Tipificacion','Tipificacion Venta',''],
         colModel: [
            { name: 'ProveedorId', hidden: true },
            { name: "Codigo", width: 60 },
            { name: "TipoDocumentoIdentidadNombre", width: 90 },
            { name: "NumeroDocumentoIdentidad", width: 100 },
            { name: "NumeroRuc", width: 80 },
            { name: "RazonSocial", width: 350 },
            { name: "Telefono", width: 100 },
            { name: "Email", width: 200 },
            { name: "TipoProfesionOficio", width: 200 },
            { name: "TipoVentaCliente", width: 100 },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });

            var row = $('#bandejaGrid').appGrid('getSelectedRow');
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $('#TipoDocumentoIdentidadId').val('');
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#NumeroRuc, #RazonSocial,#TipoDocumentoIdentidadId,#NumeroDocumentoIdentidad").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
   });
   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW','@MenuItemKey.EXIT'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {

         case '@MenuItemKey.NEW':
            $(this).getView({
               editAction: '@ViewModelEditAction.New',
               buttonId: key,
               viewModel: [
                  { name: "ProveedorDTO.ProveedorId", value: 0, type: 'int' }
               ],
               urlAction: '@Url.Action("Crear", "Prospecto")'
            });
            break;

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "ProveedorDTO.ProveedorId", value: row.ProveedorId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "Prospecto")'
            });
            break;
      }
      return true;
   };
</script>