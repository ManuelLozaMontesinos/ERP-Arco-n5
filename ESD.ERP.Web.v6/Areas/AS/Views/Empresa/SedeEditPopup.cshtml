@using ESD.Core.Web;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.AS.Models.EmpresaViewModel
<div id="mp-edit-panel">
   <div class="card">
      <div class="card-body">
         <div class="row">
            <div class="col-12">
               <div class="form-group row">
                  <esd-textbox for="@Model.EmpresaSedeDTO.Codigo" col-position="col-lg-2" label="Codigo" col-label-position="col-lg-2"
                               enable="false" in-modal="true"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.EmpresaSedeDTO.Nombre" col-position="col-lg-6" label="Nombre" col-label-position="col-lg-2"
                               max-length="50" in-modal="true"></esd-textbox>
                  <esd-masktextbox for="@Model.EmpresaSedeDTO.CodigoSunat" col-position="col-lg-2" label="Codigo SUNAT" col-label-position="col-lg-2"
                                   mask="9999" in-modal="true"></esd-masktextbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoViaId" for="@Model.TipoViaList" selected-value="@Model.EmpresaSedeDTO.TipoViaId" col-position="col-lg-2" label="Tipo de Via"
                                    col-label-position="col-lg-2" in-modal="true"></esd-dropdownlist>
                  <esd-textbox for="@Model.EmpresaSedeDTO.NombreVia" col-position="col-lg-3" label="Nombre" col-label-position="col-lg-1"
                               max-length="50" in-modal="true"></esd-textbox>
                  <esd-textbox for="@Model.EmpresaSedeDTO.NumeroVia" col-position="col-lg-1" label="Numero" col-label-position="col-lg-1"
                               max-length="10" in-modal="true"></esd-textbox>
                  <esd-textbox for="@Model.EmpresaSedeDTO.Interior" col-position="col-lg-1" label="Interior" col-label-position="col-lg-1"
                               max-length="10" in-modal="true"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.EmpresaSedeDTO.Departamento" col-position="col-lg-1" label="#Dpto" col-label-position="col-lg-2"
                               max-length="10" in-modal="true"></esd-textbox>
                  <esd-textbox for="@Model.EmpresaSedeDTO.Lote" col-position="col-lg-2" label="Lote" col-label-position="col-lg-2"
                               max-length="10" in-modal="true"></esd-textbox>
                  <esd-textbox for="@Model.EmpresaSedeDTO.Manzana" col-position="col-lg-1" label="Manzana" col-label-position="col-lg-2"
                               max-length="10" in-modal="true"></esd-textbox>
                  <esd-textbox for="@Model.EmpresaSedeDTO.Kilometro" col-position="col-lg-1" label="KM" col-label-position="col-lg-1"
                               max-length="10" in-modal="true"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.EmpresaSedeDTO.Block" col-position="col-lg-1" label="Block" col-label-position="col-lg-2"
                               max-length="10" in-modal="true"></esd-textbox>
                  <esd-textbox for="@Model.EmpresaSedeDTO.Etapa" col-position="col-lg-2" label="Etapa" col-label-position="col-lg-2"
                               max-length="10" in-modal="true"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoZonaId" for="@Model.TipoZonaList" selected-value="@Model.EmpresaSedeDTO.TipoZonaId" col-position="col-lg-2"
                                    label="Tipo de Zona" col-label-position="col-lg-2" in-modal="true"></esd-dropdownlist>
                  <esd-textbox for="@Model.EmpresaSedeDTO.NombreZona" col-position="col-lg-3" label="Nombre" col-label-position="col-lg-1"
                               max-length="50" in-modal="true"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="DepartamentoId" for="@Model.DepartamentoList" selected-value="@Model.DepartamentoId" col-position="col-lg-2" label="Departamento"
                                    col-label-position="col-lg-2" onchange="mp_departamentoIdOnChange();" in-modal="true"></esd-dropdownlist>
                  <esd-dropdownlist id="ProvinciaId" for="@Model.ProvinciaList" selected-value="@Model.ProvinciaId" col-position="col-lg-3" label="Provincia"
                                    col-label-position="col-lg-1" onchange="mp_provinciaIdOnChange();" in-modal="true"></esd-dropdownlist>
                  <esd-dropdownlist id="DistritoId" for="@Model.DistritoList" selected-value="@Model.EmpresaSedeDTO.DistritoId" col-position="col-lg-3" label="Distrito"
                                    col-label-position="col-lg-1" in-modal="true"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.EmpresaSedeDTO.Telefono" col-position="col-lg-2" label="Telefono" col-label-position="col-lg-2"
                               max-length="15" in-modal="true"></esd-textbox>
                  <esd-textbox for="@Model.EmpresaSedeDTO.Telefono2" col-position="col-lg-2" label="Telefono 2" col-label-position="col-lg-2"
                               max-length="15" in-modal="true"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-textbox for="@Model.EmpresaSedeDTO.Email" col-position="col-lg-6" label="Correo Electronico" col-label-position="col-lg-2"
                               max-length="100" in-modal="true" use-textcase="false"></esd-textbox>
               </div>
               <div class="form-group row">
                  <esd-checkbox for="@Model.EmpresaSedeDTO.EsCentral" col-position="offset-lg-2 col-lg-4"
                                label="Es Central" in-modal="true"></esd-checkbox>
               </div>
            </div>
         </div>
      </div>
      <esd-hidden for="@Model.EmpresaSedeDTO.EmpresaSedeId" in-modal="true"></esd-hidden>
   </div>
</div>
<script type="text/javascript">

   function mp_departamentoIdOnChange() {

      var departamentoId = $("#mp-DepartamentoId").val();
      if ($.isNullOrEmpty(departamentoId)) {
         $("#mp-ProvinciaId").prop('disabled', true);
         $("#mp-DistritoId").prop('disabled', true);
         return;
      }

      $("#mp-ProvinciaId").val('');
      $("#mp-DistritoId").val('');
      $("#mp-DistritoId").prop('disabled', true);

      $(this).getAction({
         urlAction: '@Url.Action("ListarProvincia", "Empresa")',
         id: departamentoId,
         onSuccess: function (response) {
            if (response.success) {
               $('#mp-ProvinciaId').find('option').remove().end();
               $("#mp-ProvinciaId").addItems(response.data);

               if (!$.isNullOrEmpty($("#mp-DepartamentoId").val())) {
                  $("#mp-ProvinciaId").removeAttr("disabled");
               }
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   }
   function mp_provinciaIdOnChange() {

      var provinciaId = $("#mp-ProvinciaId").val();
      if ($.isNullOrEmpty(provinciaId)) {
         $("#mp-DistritoId").prop('disabled', true);
         return;
      }

      $("#mp-DistritoId").val('');
      $("#mp-DistritoId").prop('disabled', true);

      $(this).getAction({
         urlAction: '@Url.Action("ListarDistrito", "Empresa")',
         id: provinciaId,
         onSuccess: function (response) {
            if (response.success) {
               $('#mp-DistritoId').find('option').remove().end();
               $("#mp-DistritoId").addItems(response.data);

               if (!$.isNullOrEmpty(provinciaId)) {
                  $("#mp-DistritoId").removeAttr("disabled");
               }
            } else {
               msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
            }
         }
      });
   }
   function mp_menuBarOnClick(key) {

      switch (key) {
         case '@MenuItemKey.SAVE':
            grabarDatos();
            break;

         case '@MenuItemKey.EXIT':
            $(this).getView({
               urlAction: '@Url.Action("Index", "Empresa")'
            });
            break;
      }
   };
   function mp_validarDatos() {

      if (!$('#mp-Nombre').validateString('@SR.GetString("AS_nombre_sede_requerido")'))
         return false;
      if (!$('#mp-CodigoSunat').validateString('@SR.GetString("AS_codigo_sunat_requerido")'))
         return false;
      if (!$('#mp-TipoViaId').validateNumeric('@SR.GetString("MG_tipo_via_seleccion_requerida")'))
         return false;
      if (!$('#mp-TipoZonaId').validateNumeric('@SR.GetString("MG_tipo_zona_seleccion_requerida")'))
         return false;
      if (!$('#mp-DepartamentoId').validateNumeric('@SR.GetString("MG_departamento_seleccion_requerida")'))
         return false;
      if (!$('#mp-ProvinciaId').validateNumeric('@SR.GetString("MG_provincia_seleccion_requerida")'))
         return false;
      if (!$('#mp-DistritoId').validateNumeric('@SR.GetString("MG_distrito_seleccion_requerida")'))
         return false;

      return true;
   }
</script>