@using ESD.Core.Web;
@using ESD.Core.Web.JS;
@using ESD.ERP.Common;
@using ESD.ERP.Web.Infrastructure;
@model ESD.ERP.Web.Areas.AS.Models.DocuComSerieViewModel
<esd-menubar id="menuBar" Title="@Model.Title" menu-style="CRUD" onclick="menuBarOnClick"></esd-menubar>
<section id="app-content" class="content">
   <div id="app-search-card" class="card">
      <div class="card-body">
         <div class="row">
            <div id="app-search-input-group" class="col-11">
               <div class="form-group row">
                  <esd-dropdownlist id="EmpresaSedeId" for="@Model.EmpresaSedeList" col-position="col-lg-4" label="Sede" col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-dropdownlist id="TipoDocumentoComercialId" for="@Model.TipoDocumentoComercialList" col-position="col-lg-4" label="Tipo de Documento" 
                                    col-label-position="col-lg-2"></esd-dropdownlist>
               </div>
               <div class="form-group row">
                  <esd-textbox id="Serie" col-position="col-lg-2" label="Serie" col-label-position="col-lg-2" max-length="4"></esd-textbox>
               </div>
            </div>
            <div class="col-1">
               <div class="form-group row">
                  <esd-button id="clearButton" content="Limpiar" button-style="Primary" size="Small" block="true" onclick="clearButtonOnClick()"></esd-button>
               </div>
            </div>
         </div>
      </div>
   </div>
   <div id="bandejaContainer">
      <table id="bandejaGrid"></table>
      <div id="bandejaPager"></div>
   </div>
</section>
<script type="text/javascript">
   $(document).ready(function () {

      $("#bandejaGrid").jqGrid({
         @GridHelper.DefaultProperties()
         url: "@Url.Action("ListarBandeja", "DocuComSerie")",
         postData: {
            jsonModel: function () {
               return JSON.stringify(modelToObject(
                  [
                     { name: "DocumentoComercialSerieDTO.EmpresaSedeId", value: $('#EmpresaSedeId').val() || 0, type: 'int' },
                     { name: "DocumentoComercialSerieDTO.TipoDocumentoComercialId", value: $('#TipoDocumentoComercialId').val() || 0, type: 'int' },
                     { name: "DocumentoComercialSerieDTO.Serie", value: $('#Serie').val() }
                  ]
               ));
            }
         },
         colNames: ['', 'Sede', 'Tipo de Documento', 'Elec.', 'Serie', 'Correlativo', 'Formato','Almacen',''],
         colModel: [
            { name: 'DocumentoComercialSerieId', hidden: true },
            { name: "EmpresaSedeNombre", width: 200 },
            { name: "TipoDocumentoComercialNombre", width: 200 },
            { name: "EsElectronico", width: 80 },
            { name: "Serie", width: 100 },
            { name: "Correlativo", width: 100, align: 'right' },
            { name: "Formato", width: 100 },
            { name: "AlmacenNombre", width: 150 },
            { name: 'Estado', hidden: true },
         ],
         pager: "#bandejaPager",
         onSelectRow: function (rowid) {
            if (rowid == null || rowid == 0)
               return;

            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
         },
         gridComplete: function () {
            $('#menuBar').appMenu('editMenu', { gridName: 'bandejaGrid' });
            $("#bandejaGrid").appGrid('resizeGrid', 'bandejaContainer');
         },
         @GridHelper.RowDeletedStyle("Estado",EstadoConstante.INACTIVO)
         height: calculateGridHeight('bandejaContainer')
      });
   });
   function clearButtonOnClick() {
      $('#app-search-input-group').find('input:text').val('');
      $('#EmpresaSedeId').val('');
      $('#TipoDocumentoComercialId').val('');
      $('#bandejaGrid').appGrid('reloadJSON');
   }
   $(function () {
      $("#EmpresaSedeId,#TipoDocumentoComercialId,#Serie").change(function () {
         $('#bandejaGrid').appGrid('reloadJSON');
      });
   });
   function menuBarOnClick(key) {

      var row = $('#bandejaGrid').appGrid('getSelectedRow');

      var excludeKeys = ['@MenuItemKey.NEW'];
      if(excludeKeys.indexOf(key) == -1){
         if ($.isEmpty(row)) {
            msgAlert(msgAlertTypeConstant.INFORMATION, '@SR.GetString("GEN_registro_seleccionado_requerido")');
            return;
         }
      }

      switch (key) {

         case '@MenuItemKey.NEW':
            $(this).getView({
               editAction: '@ViewModelEditAction.New',
               buttonId: key,
               viewModel: [
                  { name: "DocumentoComercialSerieDTO.DocumentoComercialSerieId", value: 0, type: 'int' }
               ],
               urlAction: '@Url.Action("Crear", "DocuComSerie")'
            });
            break;

         case '@MenuItemKey.EDIT':
            $(this).getView({
               editAction: '@ViewModelEditAction.Edit',
               buttonId: key,
               viewModel: [
                  { name: "DocumentoComercialSerieDTO.DocumentoComercialSerieId", value: row.DocumentoComercialSerieId, type: 'int' }
               ],
               urlAction: '@Url.Action("Editar", "DocuComSerie")'
            });
            break;

         case '@MenuItemKey.DELETE':
            $('#menuBar').appMenu('disabledButton', { buttonId: key, disabled: true });
            $(this).confirm({
               title: '@SR.GetString("APPMP_anular_titulo")',
               message: '@SR.GetString("GEN_registro_seleccionado_anular_pregunta")',
               onConfirm: function () {

                  $(this).saveView({
                     urlAction: '@Url.Action("Eliminar", "DocuComSerie")',
                     viewModel: [
                        { name: "DocumentoComercialSerieDTO.DocumentoComercialSerieId", value: row.DocumentoComercialSerieId, type: 'int' }
                     ],
                     onSuccess: function (response) {
                        if (response.success) {
                           $('#bandejaGrid').appGrid('reloadJSON');
                           msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                        } else {
                           msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
                        }
                     }
                  });
               }
            });
            break;
      }
      return true;
   };
</script>