   <link rel="stylesheet" href="~/plugins/overlayScrollbars/css/OverlayScrollbars.min.css" asp-append-version="true">
   <link rel="stylesheet" href="~/plugins/icheck-bootstrap/icheck-bootstrap.min.css" asp-append-version="true">
   <link rel="stylesheet" href="~/plugins/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.min.css" asp-append-version="true" />
   <link rel="stylesheet" href="~/dist/css/adminlte.min.css" asp-append-version="true">
   <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
   <!-- App -->
   <link rel="stylesheet" href="~/lib/jqgrid/css/ui.jqgrid-bootstrap4.min.css" asp-append-version="true">
   <link rel="stylesheet" href="~/css/alertifyjs/alertify.min.css" asp-append-version="true">
   <link rel="stylesheet" href="~/css/alertifyjs/themes/bootstrap.min.css" asp-append-version="true">
   @*<link rel="stylesheet" href="~/css/bootstrap-datetimepicker.css" asp-append-version="true">*@
   <link rel="stylesheet" href="~/css/app.main.css" asp-append-version="true">
</head>
<body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed">
   <div class="wrapper">
      <!-- Navbar -->
      <nav class="main-header navbar navbar-expand navbar-white navbar-light">
         <!-- Left navbar links -->
         <ul class="navbar-nav">
            <li class="nav-item">
               <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
         </ul>
         <ul class="navbar-nav ml-auto">
            <li class="nav-item">
               <span class="navbar-text">Año : </span>
            </li>
            <li class="nav-item">
               <a class="nav-link active" href="#">@ViewBag.Periodo</a>
            </li>
            <li class="nav-item">
               <span class="navbar-text">Empresa : </span>
            </li>
            <li class="nav-item">
               <a class="nav-link active" href="#">@ViewBag.Empresa</a>
            </li>
            <li class="nav-item">
               <span class="navbar-text">Sede : </span>
            </li>
            <li class="nav-item">
               <a class="nav-link active" href="#">@ViewBag.Sede</a>
            </li>
         </ul>
         <!-- SEARCH FORM -->
         <!-- Right navbar links -->
         <ul class="navbar-nav ml-auto">
            <!-- Messages Dropdown Menu -->
            <li class="nav-item dropdown">
               <a class="nav-link" data-toggle="dropdown" href="#">
                  <i class="far fa-bell"></i>
                  <span id="app-notification-icon" class="badge badge-warning navbar-badge font-weight-bold"></span>
               </a>
               <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
                  <span id="app-notification-total" class="dropdown-item dropdown-header">Sin Notificaciones</span>
                  <div id="app-notification-dropdown">
                  </div>
               </div>
            </li>
            <!-- User Dropdown Menu -->
            <li class="nav-item dropdown">
               <a class="nav-link" data-toggle="dropdown" href="#">
                  <i class="fas fa-th-large"></i>
               </a>
               <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
                  <span class="dropdown-item dropdown-header">Opciones</span>
                  <div class="dropdown-divider"></div>
                  <a href="#" class="dropdown-item" onclick="cambiarContrasena();">
                     <i class="fas fa-lock mr-2"></i> Cambiar Contraseña
                  </a>
                  <div class="dropdown-divider"></div>
                  <a href="#" class="dropdown-item" onclick="window.location.href = '@Url.Action("Index", "pf")';">
                     <i class="fas fa-exchange-alt mr-2"></i> Cambiar Año y Empresa
                  </a>
                  <div class="dropdown-divider"></div>
                  <a class="dropdown-item" href="@Url.Action("SignOut","Login")">
                     <i class="fas fa-sign-out-alt mr-2"></i> Cerrar Sesión
                  </a>
               </div>
            </li>
         </ul>
      </nav>
      <!-- /.navbar -->
      <!-- Main Sidebar Container -->
      <aside class="main-sidebar sidebar-dark-primary elevation-4">
         <!-- Brand Logo -->
         <a href="index3.html" class="brand-link">
            <img src="~/dist/img/AdminLTELogo.png" alt="AdminLTE Logo" class="brand-image img-circle elevation-3"
                 style="opacity: .8">
            <span class="brand-text font-weight-light">AdminLTE 3</span>
         </a>

         <!-- Sidebar -->
         <div class="sidebar">
            <!-- Sidebar user panel (optional) -->
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
               <div class="image">
                  <img src="img/user.jpg" class="img-circle elevation-2" alt="Usuario">
               </div>
               <div class="info">
                  <a class="d-block text-wrap">@ViewBag.Usuario</a>
               </div>
            </div>

            <!-- Sidebar Menu -->
            <nav class="mt-2">
               <ul id="main-menu" class="nav nav-pills nav-sidebar nav-child-indent flex-column" data-widget="treeview" role="menu" data-accordion="false"></ul>
            </nav>
            <!-- /.sidebar-menu -->
         </div>
         <!-- /.sidebar -->
      </aside>

      <!-- Content Wrapper. Contains page content -->
      <div id="workspace" class="content-wrapper">
         <!-- Content Header (Page header) -->
         @RenderBody()
         <!-- /.content-header -->
         <!-- /.content -->
      </div>
      <input id="__cid" type="hidden" value="@ViewBag.cid" />
      <aside class="control-sidebar control-sidebar-dark">
         <!-- Control sidebar content goes here -->
      </aside>
      <!-- /.content-wrapper -->
      <!-- Main Footer -->
      <!--footer class="main-footer">
      <strong>Copyright &copy; 2014-2019 <a href="http://adminlte.io">AdminLTE.io</a>.</strong>
      All rights reserved.
      <div class="float-right d-none d-sm-inline-block">
         <b>Version</b> 3.0.4
      </div>
      </footer-->
   </div>
   <!-- ./wrapper -->
   <!-- REQUIRED SCRIPTS -->
   <!-- plugins -->
   <script src="~/plugins/jquery/jquery.min.js" asp-append-version="true"></script>
   <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
   <script src="~/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js" asp-append-version="true"></script>
   <script src="~/plugins/inputmask/jquery.inputmask.min.js" asp-append-version="true"></script>
   <!-- moment.js es requerido por tempusdominus -->
   <script src="~/lib/moment.js/moment.min.js" asp-append-version="true"></script>
   <script src="~/plugins/tempusdominus-bootstrap-4/js/tempusdominus-bootstrap-4.min.js" asp-append-version="true"></script>
   <script src="~/dist/js/adminlte.js" asp-append-version="true"></script>
   <!-- App -->
   <script src="~/lib/jqgrid/js/i18n/grid.locale-es.js" asp-append-version="true"></script>
   <script src="~/lib/jqgrid/js/jquery.jqGrid.min.js" asp-append-version="true"></script>
   <script src="~/lib/loading-overlay/dist/loadingoverlay.min.js" asp-append-version="true"></script>
   <script src="~/js/alertify.min.js" asp-append-version="true"></script>
   <script src="~/lib/underscore.js/underscore-min.js" asp-append-version="true"></script>
   @*<script src="~/js/bootstrap-datetimepicker.min.js" asp-append-version="true"></script>*@
   <script src="~/lib/bootbox.js/bootbox.min.js" asp-append-version="true"></script>
   <script src="~/lib/plupload/plupload.full.min.js" asp-append-version="true"></script>
   <script src="~/lib/jquery.fileDownload/jquery.fileDownload.js" asp-append-version="true"></script>
   <script src="~/lib/numeral.js/numeral.min.js" asp-append-version="true"></script>
   <script src="~/js/app.main.js" asp-append-version="true"></script>
   <script src="~/lib/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
   <script src="~/js/app.signalr.js" asp-append-version="true"></script>
   <esd-dialog id="passwordEditPopup" title="Cambiar Contraseña" onclick="passwordEditPopupOnClick">
      <div id="passwordEditPopupContent"></div>
   </esd-dialog>
   <script type="text/javascript">
      function buildMenu(parent, items) {
         $.each(items, function () {

            var hasNodes = false;
            if (this.nodes != null) {
               if (this.nodes.length > 0)
                  hasNodes = true;
            }

            var li = $("<li></li>");
            li.addClass("nav-item");

            if (hasNodes) {
               li.addClass("has-treeview");
            }

            var a = $("<a></a>");
            a.attr('href', "javascript:void(0);");
            a.addClass("nav-link");
            if (!$.isNullOrEmpty(this.url)) {
               a.attr('onclick', "$(this).getView({urlAction: '" + this.url+"'});");
            }

            var i = $("<i></i>");
            i.addClass(this.icon + "nav-icon");
            i.appendTo(a);

            var p = $("<p>" + this.text + "</p>");

            if (hasNodes) {
               var i2 = $("<i></i>");
               i2.addClass("right fas fa-angle-left");
               i2.appendTo(p);
            }
            p.appendTo(a);

            a.appendTo(li);
            li.appendTo(parent);
            if (hasNodes) {
               var ul = $("<ul></ul>");
               ul.addClass("nav nav-treeview");
               ul.appendTo(li);
               buildMenu(ul, this.nodes);
            }
         });
      };
      jQuery(document).ready(function ($) {

         $('#workspace').removeAttr('style');

         $(this).getAction({
            urlAction: '@Url.Action("ObtenerMenuAsignado", "Menu")',
            onSuccess: function (response) {
               var ul = $('#main-menu');
               buildMenu(ul, response);
            }
         });
         $('#passwordEditPopup').setDialog({
            onShow: function () {
               var row = $('#bandejaGrid').appGrid('getSelectedRow');
               $(this).getView({
                  urlAction: '@Url.Action("ContrasenaEditPopup", "Usuario", new { area = "AS" })',
                  viewModel: [
                     { name: "ContrasenaAnteriorVisible", value: true, type:'bool' }
                  ],
                  container: 'passwordEditPopupContent',
                  showLoading: false,
                  hideLoading: false
               });
            }
         });
      });
      function cambiarContrasena() {
         $('#passwordEditPopup').showDialog();
      }
      function passwordEditPopupOnClick() {

         if (!$('#mp-ContrasenaAnterior').validateString('@SR.GetString("AS_contrasena_anterior_requerida")'))
            return false;
         if (!$('#mp-Contrasena').validateString('@SR.GetString("AS_contrasena_requerida")'))
            return false;
         if (!$('#mp-ContrasenaConfirmada').validateString('@SR.GetString("AS_contrasena_confirmada_requerida")'))
            return false;

         if ($('#mp-Contrasena').val() !== $('#mp-ContrasenaConfirmada').val()) {
            msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("AS_verificar_contrasena_invalida")');
            return false;
         }

         $('#passwordEditPopup').saveView({
            viewModel: [
               { name: "UsuarioDTO.UsuarioId", value: $('#mp-UsuarioId').val(), type: 'int' },
               { name: "UsuarioDTO.ContrasenaAnterior", value: $('#mp-ContrasenaAnterior').val(), textCase:'none' },
               { name: "UsuarioDTO.Password", value: $('#mp-Contrasena').val(), textCase: 'none'}
            ],
            urlAction: '@Url.Action("CambiarContrasenaAnterior", "Usuario", new { area = "AS" })',
            onSuccess: function (response) {

               if (response.success) {
                  msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                  $('#passwordEditPopup').hideDialog();
               } else {
                  msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
               }
            }
         });
   };
   </script>
</body>
</html>
