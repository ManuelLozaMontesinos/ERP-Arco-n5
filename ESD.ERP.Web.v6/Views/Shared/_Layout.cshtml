      (function () {
         try {
            var uid = '@currentUserId';
            if (uid && uid !== '0') {
               var savedTheme = localStorage.getItem('adminlte_dark_mode_user_' + uid);
               if (savedTheme === 'dark') {
                  document.documentElement.classList.add('dark-mode');
               } else if (savedTheme === 'light') {
                  document.documentElement.classList.remove('dark-mode');
               }
            } else {
               document.documentElement.classList.remove('dark-mode');
            }
            localStorage.removeItem('adminlte_dark_mode');
         } catch (e) { }
      })();
   </script>
