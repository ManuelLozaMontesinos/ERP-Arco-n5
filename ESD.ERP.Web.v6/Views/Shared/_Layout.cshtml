   <script type="text/javascript">
      window.menuUrlMap = {};

      window.updateNavbarBreadcrumb = function(pathArray) {
         if (!pathArray || !pathArray.length) {
            pathArray = ['Dashboard'];
         }
         try {
            sessionStorage.setItem('app_current_breadcrumb', JSON.stringify(pathArray));
         } catch(e) {}

         var $ol = $('#app-breadcrumb-list');
         if (!$ol.length) return;

         $ol.empty();

         var homeUrl = '@Url.Action("Index", "Home")?cid=' + encodeURIComponent($('#__cid').val() || '@ViewBag.cid');
         var $homeLi = $('<li class="breadcrumb-item"></li>');
         var $homeLink = $('<a href="' + homeUrl + '" style="cursor: pointer; text-decoration: none;"><i class="fas fa-home mr-1"></i>Inicio</a>');
         $homeLink.on('click', function(e) {
            e.preventDefault();
            window.resetNavbarBreadcrumb();
            window.location.href = homeUrl;
         });
         $homeLi.append($homeLink);
         $ol.append($homeLi);

         if (pathArray.length === 1 && pathArray[0] === 'Dashboard') {
            $ol.append('<li class="breadcrumb-item active" id="app-breadcrumb-active">Dashboard</li>');
            return;
         }

         for (var idx = 0; idx < pathArray.length; idx++) {
            var isLast = (idx === pathArray.length - 1);
            var text = pathArray[idx];
            var safeText = $('<div>').text(text).html();
            if (isLast) {
               $ol.append('<li class="breadcrumb-item active" id="app-breadcrumb-active">' + safeText + '</li>');
            } else {
               $ol.append('<li class="breadcrumb-item text-secondary">' + safeText + '</li>');
            }
         }
      };

      window.resetNavbarBreadcrumb = function() {
         try { sessionStorage.removeItem('app_current_breadcrumb'); } catch(e) {}
         window.updateNavbarBreadcrumb(['Dashboard']);
      };

      window.appendNavbarBreadcrumb = function(subAction) {
         var cur = null;
         try {
            var raw = sessionStorage.getItem('app_current_breadcrumb');
            if (raw) cur = JSON.parse(raw);
         } catch(e) {}
         if (cur && cur.length && cur[cur.length - 1] !== subAction) {
            var next = cur.concat([subAction]);
            window.updateNavbarBreadcrumb(next);
         }
      };

      window.removeBreadcrumbSubAction = function() {
         var cur = null;
         try {
            var raw = sessionStorage.getItem('app_current_breadcrumb');
            if (raw) cur = JSON.parse(raw);
         } catch(e) {}
         if (cur && cur.length > 1) {
            var last = cur[cur.length - 1];
            if (last === 'Consultar' || last === 'Editar' || last === 'Nuevo') {
               window.updateNavbarBreadcrumb(cur.slice(0, cur.length - 1));
            }
         }
      };

      function buildMenu(parent, items, pathArray) {
         pathArray = pathArray || [];
         if (!window.menuUrlMap) {
            window.menuUrlMap = {};
         }
         $.each(items, function () {

            var hasNodes = false;
            if (this.nodes != null) {
               if (this.nodes.length > 0)
                  hasNodes = true;
            }

            var currentPath = pathArray.concat([this.text]);

            var li = $("<li></li>");
            li.addClass("nav-item");

            if (hasNodes) {
               li.addClass("has-treeview");
            }

            var a = $("<a></a>");
            a.attr('href', "javascript:void(0);");
            a.addClass("nav-link");
            if (!$.isNullOrEmpty(this.url)) {
               var cleanUrl = this.url.trim().toLowerCase().split('?')[0];
               var noSlash = cleanUrl.replace(/^\/+/, '');
               window.menuUrlMap[cleanUrl] = currentPath;
               window.menuUrlMap[noSlash] = currentPath;
               window.menuUrlMap['/' + noSlash] = currentPath;

               a.on('click', (function(p, url) {
                  return function(e) {
                     e.preventDefault();
                     if (window.updateNavbarBreadcrumb) {
                        window.updateNavbarBreadcrumb(p);
                     }
                     $(this).getView({ urlAction: url });
                  };
               })(currentPath, this.url));
            }

            var i = $("<i></i>");
            i.addClass(this.icon + "nav-icon");
            i.appendTo(a);

            var p = $("<p>" + this.text + "</p>");

            if (hasNodes) {
               var i2 = $("<i></i>");
               i2.addClass("right fas fa-angle-left");
               i2.appendTo(p);
            }
            p.appendTo(a);

            a.appendTo(li);
            li.appendTo(parent);
            if (hasNodes) {
               var ul = $("<ul></ul>");
               ul.addClass("nav nav-treeview");
               ul.appendTo(li);
               buildMenu(ul, this.nodes, currentPath);
            }
         });
      };
            function initThemeMode() {
         var uid = '@currentUserId';
         var isDark = false;
         if (uid && uid !== '0') {
            var saved = localStorage.getItem('adminlte_dark_mode_user_' + uid);
            if (saved !== null) {
               isDark = (saved === 'dark');
            } else {
               isDark = @(isUserDarkMode ? "true" : "false");
            }
         } else {
            isDark = false;
         }

         applyThemeMode(isDark, false, false);

         $('#app-dark-mode-toggle').off('click').on('click', function (e) {
            e.preventDefault();
            var isCurrentDark = $('body').hasClass('dark-mode');
            applyThemeMode(!isCurrentDark, true, true);
         });
      }

      function applyThemeMode(dark, animate, shouldPersist) {
         var $body = $('body');
         var $html = $('html');
         var $nav = $('.main-header.navbar');
         var $icon = $('#app-dark-mode-icon');
         var $btn = $('#app-dark-mode-toggle');
         var uid = '@currentUserId';
         var themeVal = dark ? 'dark' : 'light';

         // Eliminar cualquier preload style remanente
         var preload = document.getElementById('theme-preload-style');
         if (preload) { preload.remove(); }

         if (dark) {
            $body.addClass('dark-mode');
            $html.addClass('dark-mode');
            $nav.removeClass('navbar-white navbar-light').addClass('navbar-dark');
            $icon.removeClass('far fa-moon').addClass('fas fa-sun text-warning');
            $btn.attr('title', 'Cambiar a Modo Claro');
         } else {
            $body.removeClass('dark-mode');
            $html.removeClass('dark-mode');
            $nav.removeClass('navbar-dark').addClass('navbar-white navbar-light');
            $icon.removeClass('fas fa-sun text-warning').addClass('far fa-moon');
            $btn.attr('title', 'Cambiar a Modo Oscuro');
         }

         if (shouldPersist && uid && uid !== '0') {
            // 1. Guardar en localStorage exclusivo del usuario actual
            try {
               localStorage.setItem('adminlte_dark_mode_user_' + uid, themeVal);
            } catch (e) { }

            // 2. Guardar en cookie para que las siguientes cargas de página en el servidor la lean directo
            try {
               document.cookie = 'app_theme_user_' + uid + '=' + themeVal + '; path=/; max-age=31536000; SameSite=Lax';
            } catch (e) { }

            // 3. Persistir en la base de datos de forma asíncrona
            try {
               $.ajax({
                  url: '@Url.Action("GuardarTemaUsuario", "Home", new { area = "" })',
                  type: 'POST',
                  data: { tema: themeVal }
               });
            } catch (e) { }
         }

         if (animate && $icon.length) {
            $icon.css({ transform: 'rotate(360deg) scale(1.25)', transition: 'transform 0.3s ease' });
            setTimeout(function () {
               $icon.css({ transform: 'none', transition: 'none' });
            }, 300);
         }
         $(document).trigger('themeChanged', [dark]);
      }

      jQuery(document).ready(function ($) {

         initThemeMode();

         $('#workspace').removeAttr('style');

         $(this).getAction({
            urlAction: '@Url.Action("ObtenerMenuAsignado", "Menu")',
            onSuccess: function (response) {
               var ul = $('#main-menu');
               buildMenu(ul, response);
            }
         });
         $('#passwordEditPopup').setDialog({
            onShow: function () {
               var row = $('#bandejaGrid').appGrid('getSelectedRow');
               $(this).getView({
                  urlAction: '@Url.Action("ContrasenaEditPopup", "Usuario", new { area = "AS" })',
                  viewModel: [
                     { name: "ContrasenaAnteriorVisible", value: true, type:'bool' }
                  ],
                  container: 'passwordEditPopupContent',
                  showLoading: false,
                  hideLoading: false
               });
            }
         });

         // Interaccion y cambio de sesion en cabecera (ANO y SEDE)
         $('.session-chip-clickable').on('click', function (e) {
            if (e.target && e.target.tagName !== 'SELECT') {
               var $sel = $(this).find('select');
               if ($sel.length) {
                  $sel.focus();
                  if (typeof $sel[0].showPicker === 'function') {
                     try { $sel[0].showPicker(); } catch (err) { }
                  }
               }
            }
         });


         window.abrirModalPerfilSesion = function () {
            var anioActual = $('#header-select-periodo').val() || '@ViewBag.Periodo' || '2026';
            var sedeActual = $('#header-select-sede').val() || '1';
            $('#modal-perfil-periodo').val(anioActual);
            $('#modal-perfil-sede').val(sedeActual);
            $('#modal-seleccionar-perfil-sesion').modal('show');
         };

         window.guardarPerfilModal = function () {
            var anio = $('#modal-perfil-periodo').val();
            var sedeId = $('#modal-perfil-sede').val();
            $('#modal-seleccionar-perfil-sesion').modal('hide');
            ejecutarCambioSesion(anio, sedeId);
         };

         function ejecutarCambioSesion(anio, sedeId) {
            var cidActual = $('#__cid').val() || '@ViewBag.cid';

            if (typeof $.LoadingOverlay === 'function') {
               $.LoadingOverlay('show', {
                  text: 'Cambiando sesión de trabajo a ' + anio + ' · ' + (parseInt(sedeId) === 2 ? 'SEDE ILO' : 'SEDE CENTRAL') + '...',
                  background: 'rgba(0, 0, 0, 0.45)'
               });
            }
            $('#navbar-session-chips').css('opacity', '0.5').css('pointer-events', 'none');

            $.ajax({
               url: '@Url.Action("CambiarSesionCabecera", "Home", new { area = "" })',
               type: 'POST',
               data: {
                  nuevoAnio: anio,
                  nuevaSedeId: sedeId,
                  cidActual: cidActual
               },
               success: function (res) {
                  if (res && res.success && res.redirectUrl) {
                     window.location.href = res.redirectUrl;
                  } else {
                     if (typeof $.LoadingOverlay === 'function') { $.LoadingOverlay('hide'); }
                     $('#navbar-session-chips').css('opacity', '1').css('pointer-events', 'auto');
                     if (window.msgAlert) {
                        msgAlert(msgAlertTypeConstant.INFORMATION, res && res.message ? res.message : 'No se pudo cambiar la sesión.');
                     } else {
                        alert(res && res.message ? res.message : 'No se pudo cambiar la sesión.');
                     }
                  }
               },
               error: function () {
                  if (typeof $.LoadingOverlay === 'function') { $.LoadingOverlay('hide'); }
                  $('#navbar-session-chips').css('opacity', '1').css('pointer-events', 'auto');
                  if (window.msgAlert) {
                     msgAlert(msgAlertTypeConstant.ERROR, 'Error al comunicarse con el servidor para cambiar la sesión.');
                  } else {
                     alert('Error al comunicarse con el servidor para cambiar la sesión.');
                  }
               }
            });
         }

         $('#header-select-periodo, #header-select-sede').on('change', function () {
            var anio = $('#header-select-periodo').val();
            var sedeId = $('#header-select-sede').val();
            ejecutarCambioSesion(anio, sedeId);
         });
      });
      function cambiarContrasena() {
         $('#passwordEditPopup').showDialog();
      }
      function passwordEditPopupOnClick() {

         if (!$('#mp-ContrasenaAnterior').validateString('@SR.GetString("AS_contrasena_anterior_requerida")'))
            return false;
         if (!$('#mp-Contrasena').validateString('@SR.GetString("AS_contrasena_requerida")'))
            return false;
         if (!$('#mp-ContrasenaConfirmada').validateString('@SR.GetString("AS_contrasena_confirmada_requerida")'))
            return false;

         if ($('#mp-Contrasena').val() !== $('#mp-ContrasenaConfirmada').val()) {
            msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("AS_verificar_contrasena_invalida")');
            return false;
         }

         $('#passwordEditPopup').saveView({
            viewModel: [
               { name: "UsuarioDTO.UsuarioId", value: $('#mp-UsuarioId').val(), type: 'int' },
               { name: "UsuarioDTO.ContrasenaAnterior", value: $('#mp-ContrasenaAnterior').val(), textCase:'none' },
               { name: "UsuarioDTO.Password", value: $('#mp-Contrasena').val(), textCase: 'none'}
            ],
            urlAction: '@Url.Action("CambiarContrasenaAnterior", "Usuario", new { area = "AS" })',
            onSuccess: function (response) {

               if (response.success) {
                  msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                  $('#passwordEditPopup').hideDialog();
               } else {
                  msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
               }
            }
         });
   };
   </script>

   <!-- Modal Seleccionar Perfil de Acceso (Año, Empresa, Sede) similar al login -->
   <div class="modal fade" id="modal-seleccionar-perfil-sesion" tabindex="-1" role="dialog" aria-labelledby="modalPerfilSesionLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 440px;">
         <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-primary text-white py-3 px-4">
               <h5 class="modal-title font-weight-bold d-flex align-items-center" id="modalPerfilSesionLabel" style="font-size: 1.1rem;">
                  <i class="fas fa-id-badge mr-2"></i> Seleccionar Perfil de Acceso
               </h5>
               <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar" style="opacity: 0.9;">
                  <span aria-hidden="true">&times;</span>
               </button>
            </div>
            <div class="modal-body p-4 bg-white">
               <div class="text-center mb-3">
                  <img src="@Url.Content("~/img/erp-lg-logo.png")" alt="SIGANET" style="max-height: 44px; object-fit: contain;">
                  <p class="text-muted small mt-1 mb-0 font-weight-500">Sistema Integrado de Gesti&oacute;n Administrativa</p>
               </div>
               
               <div class="form-group mb-3">
                  <label for="modal-perfil-periodo" class="font-weight-bold text-dark small text-uppercase mb-1">
                     <i class="fas fa-calendar-alt text-primary mr-1"></i> A&ntilde;o de Trabajo
                  </label>
                  <select id="modal-perfil-periodo" class="form-control form-control-lg font-weight-bold shadow-sm" style="font-size: 0.95rem; border-radius: 6px;">
                     @for (int y = 2026; y >= 2021; y--)
                     {
                        if (y == anioActualInt)
                        {
                           <option value="@y" selected="selected">@y</option>
                        }
                        else
                        {
                           <option value="@y">@y</option>
                        }
                     }
                  </select>
               </div>

               <div class="form-group mb-3">
                  <label class="font-weight-bold text-dark small text-uppercase mb-1">
                     <i class="fas fa-building text-secondary mr-1"></i> Empresa
                  </label>
                  <div class="input-group">
                     <input type="text" class="form-control form-control-lg bg-light text-muted font-weight-bold" value="@(ViewBag.Empresa ?? "EMP. DE PRUEBA")" readonly style="font-size: 0.95rem; border-radius: 6px 0 0 6px;" />
                     <div class="input-group-append">
                        <span class="input-group-text bg-light text-muted" style="border-radius: 0 6px 6px 0;"><i class="fas fa-lock" title="Empresa fija"></i></span>
                     </div>
                  </div>
               </div>

               <div class="form-group mb-4">
                  <label for="modal-perfil-sede" class="font-weight-bold text-dark small text-uppercase mb-1">
                     <i class="fas fa-map-marker-alt text-danger mr-1"></i> Sede / Sucursal
                  </label>
                  <select id="modal-perfil-sede" class="form-control form-control-lg font-weight-bold shadow-sm" style="font-size: 0.95rem; border-radius: 6px;">
                     @if (esSedeIlo)
                     {
                        <option value="1">SEDE CENTRAL</option>
                        <option value="2" selected="selected">SEDE ILO</option>
                     }
                     else
                     {
                        <option value="1" selected="selected">SEDE CENTRAL</option>
                        <option value="2">SEDE ILO</option>
                     }
                  </select>
               </div>

               <div class="alert alert-info py-2 px-3 small mb-0 d-flex align-items-center" style="border-radius: 6px;">
                  <i class="fas fa-info-circle mr-2 fa-lg"></i>
                  <span>Al aceptar se cambiar&aacute; la sesi&oacute;n y contexto del ERP para el a&ntilde;o y la sede seleccionados.</span>
               </div>
            </div>
            <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
               <button type="button" class="btn btn-secondary px-3" data-dismiss="modal">
                  <i class="fas fa-times mr-1"></i> Cancelar
               </button>
               <button type="button" class="btn btn-primary px-4 font-weight-bold" id="btn-modal-perfil-aceptar" onclick="guardarPerfilModal();">
                  <i class="fas fa-check mr-1"></i> Aceptar
               </button>
            </div>
         </div>
      </div>
   </div>

</body>
</html>




