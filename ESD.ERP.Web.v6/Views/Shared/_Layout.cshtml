   <script type="text/javascript">
      function buildMenu(parent, items) {
         $.each(items, function () {

            var hasNodes = false;
            if (this.nodes != null) {
               if (this.nodes.length > 0)
                  hasNodes = true;
            }

            var li = $("<li></li>");
            li.addClass("nav-item");

            if (hasNodes) {
               li.addClass("has-treeview");
            }

            var a = $("<a></a>");
            a.attr('href', "javascript:void(0);");
            a.addClass("nav-link");
            if (!$.isNullOrEmpty(this.url)) {
               a.attr('onclick', "$(this).getView({urlAction: '" + this.url+"'});");
            }

            var i = $("<i></i>");
            i.addClass(this.icon + "nav-icon");
            i.appendTo(a);

            var p = $("<p>" + this.text + "</p>");

            if (hasNodes) {
               var i2 = $("<i></i>");
               i2.addClass("right fas fa-angle-left");
               i2.appendTo(p);
            }
            p.appendTo(a);

            a.appendTo(li);
            li.appendTo(parent);
            if (hasNodes) {
               var ul = $("<ul></ul>");
               ul.addClass("nav nav-treeview");
               ul.appendTo(li);
               buildMenu(ul, this.nodes);
            }
         });
      };
            function initThemeMode() {
         var isDark = localStorage.getItem('adminlte_dark_mode') === 'true';
         applyThemeMode(isDark, false);

         $('#app-dark-mode-toggle').off('click').on('click', function (e) {
            e.preventDefault();
            var isCurrentDark = $('body').hasClass('dark-mode');
            applyThemeMode(!isCurrentDark, true);
         });
      }

      function applyThemeMode(dark, animate) {
         var $body = $('body');
         var $html = $('html');
         var $nav = $('.main-header.navbar');
         var $icon = $('#app-dark-mode-icon');
         var $btn = $('#app-dark-mode-toggle');

         // Eliminar cualquier preload style remanente
         var preload = document.getElementById('theme-preload-style');
         if (preload) { preload.remove(); }

         if (dark) {
            $body.addClass('dark-mode');
            $html.addClass('dark-mode');
            $nav.removeClass('navbar-white navbar-light').addClass('navbar-dark');
            $icon.removeClass('far fa-moon').addClass('fas fa-sun text-warning');
            $btn.attr('title', 'Cambiar a Modo Claro');
            try { localStorage.setItem('adminlte_dark_mode', 'true'); } catch (e) { }
         } else {
            $body.removeClass('dark-mode');
            $html.removeClass('dark-mode');
            $nav.removeClass('navbar-dark').addClass('navbar-white navbar-light');
            $icon.removeClass('fas fa-sun text-warning').addClass('far fa-moon');
            $btn.attr('title', 'Cambiar a Modo Oscuro');
            try { localStorage.setItem('adminlte_dark_mode', 'false'); } catch (e) { }
         }

         if (animate && $icon.length) {
            $icon.css({ transform: 'rotate(360deg) scale(1.25)', transition: 'transform 0.3s ease' });
            setTimeout(function () {
               $icon.css({ transform: 'none', transition: 'none' });
            }, 300);
         }
         $(document).trigger('themeChanged', [dark]);
      }

      jQuery(document).ready(function ($) {

         initThemeMode();

         $('#workspace').removeAttr('style');

         $(this).getAction({
            urlAction: '@Url.Action("ObtenerMenuAsignado", "Menu")',
            onSuccess: function (response) {
               var ul = $('#main-menu');
               buildMenu(ul, response);
            }
         });
         $('#passwordEditPopup').setDialog({
            onShow: function () {
               var row = $('#bandejaGrid').appGrid('getSelectedRow');
               $(this).getView({
                  urlAction: '@Url.Action("ContrasenaEditPopup", "Usuario", new { area = "AS" })',
                  viewModel: [
                     { name: "ContrasenaAnteriorVisible", value: true, type:'bool' }
                  ],
                  container: 'passwordEditPopupContent',
                  showLoading: false,
                  hideLoading: false
               });
            }
         });
      });
      function cambiarContrasena() {
         $('#passwordEditPopup').showDialog();
      }
      function passwordEditPopupOnClick() {

         if (!$('#mp-ContrasenaAnterior').validateString('@SR.GetString("AS_contrasena_anterior_requerida")'))
            return false;
         if (!$('#mp-Contrasena').validateString('@SR.GetString("AS_contrasena_requerida")'))
            return false;
         if (!$('#mp-ContrasenaConfirmada').validateString('@SR.GetString("AS_contrasena_confirmada_requerida")'))
            return false;

         if ($('#mp-Contrasena').val() !== $('#mp-ContrasenaConfirmada').val()) {
            msgAlert(msgAlertTypeConstant.INFORMATION,'@SR.GetString("AS_verificar_contrasena_invalida")');
            return false;
         }

         $('#passwordEditPopup').saveView({
            viewModel: [
               { name: "UsuarioDTO.UsuarioId", value: $('#mp-UsuarioId').val(), type: 'int' },
               { name: "UsuarioDTO.ContrasenaAnterior", value: $('#mp-ContrasenaAnterior').val(), textCase:'none' },
               { name: "UsuarioDTO.Password", value: $('#mp-Contrasena').val(), textCase: 'none'}
            ],
            urlAction: '@Url.Action("CambiarContrasenaAnterior", "Usuario", new { area = "AS" })',
            onSuccess: function (response) {

               if (response.success) {
                  msgAlert(msgAlertTypeConstant.SUCCESS, response.message);
                  $('#passwordEditPopup').hideDialog();
               } else {
                  msgAlert(msgAlertTypeConstant.INFORMATION, response.message);
               }
            }
         });
   };
   </script>
