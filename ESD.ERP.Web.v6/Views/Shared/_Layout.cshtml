@using ESD.ERP.Web.Infrastructure;
@{
   int currentUserId = 0;
   string userIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
   if (!string.IsNullOrEmpty(userIdStr))
   {
      int.TryParse(userIdStr, out currentUserId);
   }
   if (currentUserId == 0 && ViewBag.UsuarioId != null)
   {
      int.TryParse(ViewBag.UsuarioId.ToString(), out currentUserId);
   }

   string userTheme = "light";
   if (currentUserId > 0)
   {
      userTheme = UserPreferenceHelper.ObtenerTemaUsuario(currentUserId, Context);
   }
   bool isUserDarkMode = (userTheme == "dark");
}
