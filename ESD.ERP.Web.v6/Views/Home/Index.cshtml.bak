@{
    ViewData["Title"] = "Tablero Principal";
    string cid = ViewBag.cid;
}
<script type="text/javascript">
    if (window.resetNavbarBreadcrumb) {
        window.resetNavbarBreadcrumb();
    }
</script>

<!-- Content Header (Page header) -->
<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="row align-items-center mb-1">
            <div class="col-sm-12">
                <h1 class="m-0 text-dark font-weight-bold" style="font-size: 1.45rem; letter-spacing: -0.02em;">
                    <i class="fas fa-tachometer-alt text-primary mr-2"></i>Tablero de Control
                </h1>
                <small class="text-muted" style="font-size: 0.825rem;">SIGANET ERP &mdash; Visión General y Accesos Rápidos</small>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">

        <!-- 1. FILA DE TARJETAS KPI (AdminLTE v3 Small-Boxes con navegacion SPA) -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info shadow-sm" style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
                    <div class="inner">
                        <h3 id="kpi-ventas">S/ 384,920.50</h3>
                        <p>Facturación del Mes</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'comprobante/index' });" class="small-box-footer font-weight-500">
                        Ver Comprobantes <i class="fas fa-arrow-circle-right ml-1"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-success shadow-sm" style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
                    <div class="inner">
                        <h3 id="kpi-cotizaciones">1,428</h3>
                        <p>Cotizaciones Activas</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'cotizacion/index' });" class="small-box-footer font-weight-500">
                        Ver Cotizaciones <i class="fas fa-arrow-circle-right ml-1"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning shadow-sm" style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
                    <div class="inner">
                        <h3 id="kpi-produccion" style="color: #ffffff !important;">186</h3>
                        <p style="color: #ffffff !important;">&Oacute;rdenes de Producci&oacute;n</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-industry" style="color: rgba(255, 255, 255, 0.25) !important;"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'ordenProdu/index' });" class="small-box-footer font-weight-500" style="color: #ffffff !important;">
                        Ver Planta / O.P. <i class="fas fa-arrow-circle-right ml-1"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger shadow-sm" style="transition: transform 0.2s ease, box-shadow 0.2s ease;">
                    <div class="inner">
                        <h3 id="kpi-productos">4,918</h3>
                        <p>Productos en Cat&aacute;logo</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-boxes"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'producto/index' });" class="small-box-footer font-weight-500">
                        Ver Catálogo <i class="fas fa-arrow-circle-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 2. SECCIÓN PRINCIPAL (Gráficos y Tablas) -->
        <div class="row">

            <!-- Columna Izquierda (7 columnas) -->
            <div class="col-lg-7">

                <!-- Gráfico de Ventas -->
                <div class="card card-primary card-outline shadow-sm mb-4">
                    <div class="card-header border-0 d-flex align-items-center justify-content-between">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-chart-line text-primary mr-2"></i>Evolución de Ventas (Miles de Soles)
                        </h3>
                        <span class="badge badge-success px-2 py-1"><i class="fas fa-arrow-up mr-1"></i>+12.4% vs año ant.</span>
                    </div>
                    <div class="card-body pt-1">
                        <div class="position-relative mb-3" style="height: 250px;">
                            <canvas id="salesChart" height="240"></canvas>
                        </div>
                        <div class="d-flex flex-row justify-content-end align-items-center text-sm">
                            <span class="mr-3 font-weight-500 text-muted">
                                <i class="fas fa-square text-primary mr-1"></i> Año Actual (2026)
                            </span>
                            <span class="font-weight-500 text-muted">
                                <i class="fas fa-square mr-1" style="color: #94a3b8;"></i> Año Anterior (2025)
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Últimos Comprobantes -->
                <div class="card card-outline card-info shadow-sm mb-4">
                    <div class="card-header border-0 d-flex align-items-center justify-content-between">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-file-invoice text-info mr-2"></i>Últimos Comprobantes Emitidos
                        </h3>
                        <div class="card-tools m-0">
                            <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'comprobante/index' });" class="btn btn-tool btn-sm font-weight-500">
                                <i class="fas fa-external-link-alt mr-1"></i> Ver todos
                            </a>
                        </div>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-striped table-valign-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="min-width: 130px;">TIPO / NRO</th>
                                    <th>CLIENTE</th>
                                    <th style="min-width: 100px;">FECHA</th>
                                    <th class="text-right" style="min-width: 100px;">MONTO</th>
                                    <th class="text-center" style="min-width: 90px;">ESTADO</th>
                                </tr>
                            </thead>
                            <tbody id="tabla-comprobantes-body">
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="fas fa-spinner fa-spin mr-2"></i> Cargando comprobantes...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- Columna Derecha (5 columnas) -->
            <div class="col-lg-5">

                <!-- Accesos Rápidos -->
                <div class="card card-success card-outline shadow-sm mb-4">
                    <div class="card-header border-0">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-bolt text-success mr-2"></i>Accesos Rápidos
                        </h3>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-wrap justify-content-center align-items-center" style="gap: 10px;">
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'cotizacion/index' });">
                                <i class="fas fa-file-signature text-success"></i> Cotizaciones
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'pedido/index' });">
                                <i class="fas fa-dolly text-warning"></i> Pedidos
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'comprobante/index' });">
                                <i class="fas fa-receipt text-primary"></i> Facturar
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'ordenProdu/index' });">
                                <i class="fas fa-industry text-danger"></i> Producción
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'almacen/index' });">
                                <i class="fas fa-warehouse text-info"></i> Almacenes
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'producto/index' });">
                                <i class="fas fa-tags text-secondary"></i> Productos
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Gráfico de Producción en Planta -->
                <div class="card card-warning card-outline shadow-sm mb-4">
                    <div class="card-header border-0">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-chart-pie text-warning mr-2"></i>Estado de Producción
                        </h3>
                    </div>
                    <div class="card-body pt-1 pb-3" style="position: relative; height: 260px;">
                        <canvas id="productionChart" height="210"></canvas>
                    </div>
                </div>

                <!-- Tarjeta informativa de Entorno -->
                <div class="info-box bg-light shadow-sm mb-4" style="border-radius: 10px;">
                    <span class="info-box-icon bg-success elevation-1" style="border-radius: 8px;"><i class="fas fa-server"></i></span>
                    <div class="info-box-content">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="info-box-text font-weight-bold m-0">Entorno de Desarrollo</span>
                            <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i>Activo</span>
                        </div>
                        <span class="info-box-number text-muted font-weight-normal text-sm mt-1">
                            Base de Datos: <code>esderp_v6</code> (Localhost)
                        </span>
                        <div class="progress my-2" style="height: 4px; border-radius: 2px;">
                            <div class="progress-bar bg-success" style="width: 100%"></div>
                        </div>
                        <span class="progress-description text-muted text-xs">
                            <i class="fas fa-shield-alt text-success mr-1"></i> Ambiente 100% seguro y aislado
                        </span>
                    </div>
                </div>

            </div>

        </div>

    </div>
</section>

<!-- Chart.js local -->


<script type="text/javascript">
    $(document).ready(function () {
        var cid = $('#__cid').val() || '@cid';

        // Helpers para soporte dinÃ¡mico Claro / Oscuro en Chart.js
        function getThemeConfig() {
            var isDark = $('body').hasClass('dark-mode') || $('html').hasClass('dark-mode');
            return {
                isDark: isDark,
                textColor: isDark ? '#cbd5e1' : '#64748b',
                gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.05)',
                barCurrent: isDark ? '#3b82f6' : '#007bff',
                barPrevious: isDark ? '#64748b' : '#ced4da',
                pieColors: isDark ? ['#06b6d4', '#10b981', '#f59e0b', '#f43f5e'] : ['#17a2b8', '#28a745', '#ffc107', '#dc3545']
            };
        }

        var salesChartInstance = null;
        var productionChartInstance = null;
        
        var defaultDashboardData = {
            success: true,
            kpis: {
                ventasMes: "S/ 384,920.50",
                ventasTendencia: "+12.4%",
                cotizacionesActivas: "1,428",
                cotizacionesNuevas: "+34 esta semana",
                ordenesProduccion: "186",
                ordenesEnProceso: "42 en planta",
                productosCatalogo: "4,918",
                productosActivos: "100% operativos"
            },
            graficoVentas: {
                meses: ["May", "Jun", "Jul", "Ago", "Set", "Oct"],
                ventas2025: [280, 310, 340, 295, 360, 384],
                ventas2026: [310, 345, 390, 330, 410, 425]
            },
            graficoProduccion: {
                labels: ["En Proceso", "Culminadas", "Pendientes", "Anuladas"],
                valores: [42, 118, 26, 4]
            }
        };

        var lastDashboardData = defaultDashboardData;

        function renderSalesChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('salesChart');
            if (!canvas) return;

            if (salesChartInstance) {
                salesChartInstance.destroy();
                salesChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            salesChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: data.meses,
                    datasets: [
                        {
                            label: 'AÃ±o Actual (2026)',
                            backgroundColor: theme.barCurrent,
                            borderColor: theme.barCurrent,
                            data: data.ventas2026,
                            borderRadius: 4
                        },
                        {
                            label: 'AÃ±o Anterior (2025)',
                            backgroundColor: theme.barPrevious,
                            borderColor: theme.barPrevious,
                            data: data.ventas2025,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': S/ ' + context.parsed.y + 'k';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: theme.textColor },
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: theme.textColor,
                                callback: function(value) { return 'S/ ' + value + 'k'; }
                            },
                            grid: { color: theme.gridColor }
                        }
                    }
                }
            });
        }

        function renderProductionChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('productionChart');
            if (!canvas) return;

            if (productionChartInstance) {
                productionChartInstance.destroy();
                productionChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            productionChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: data.labels,
                    datasets: [{
                        data: data.valores,
                        backgroundColor: theme.pieColors,
                        borderWidth: theme.isDark ? 2 : 1,
                        borderColor: theme.isDark ? '#343a40' : '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: theme.textColor,
                                boxWidth: 14,
                                padding: 12
                            }
                        }
                    },
                    cutout: '62%'
                }
            });
        }

        // Renderizado inicial inmediato con fallback para que los grÃ¡ficos NUNCA aparezcan vacÃ­os
        function initChartsImmediately() {
            if (typeof Chart !== 'undefined') {
                renderSalesChart(lastDashboardData.graficoVentas);
                renderProductionChart(lastDashboardData.graficoProduccion);
            } else {
                setTimeout(initChartsImmediately, 80);
            }
        }
        initChartsImmediately();

        // Listener para actualizaciÃ³n en tiempo real cuando se cambia de tema Claro <-> Oscuro
        $(document).off('themeChanged.dashboard').on('themeChanged.dashboard', function (e, isDark) {
            if (lastDashboardData) {
                if (lastDashboardData.graficoVentas) {
                    renderSalesChart(lastDashboardData.graficoVentas);
                }
                if (lastDashboardData.graficoProduccion) {
                    renderProductionChart(lastDashboardData.graficoProduccion);
                }
            }
        });

        // Cargar datos dinÃ¡micos del Dashboard mediante AJAX
        $.ajax({
            url: '@Url.Action("ObtenerDatosDashboard", "Home")',
            type: 'GET',
            data: { cid: cid },
            headers: { 'x-app-cid': cid },
            success: function (res) {
                if (res && res.success) {
                    lastDashboardData = res;

                    // Cargar KPIs
                    if (res.kpis) {
                        $('#kpi-ventas').text(res.kpis.ventasMes);
                        $('#kpi-cotizaciones').text(res.kpis.cotizacionesActivas);
                        $('#kpi-produccion').text(res.kpis.ordenesProduccion);
                        $('#kpi-productos').text(res.kpis.productosCatalogo);
                    }

                    // Renderizar tabla de comprobantes recientes
                    var tbody = $('#tabla-comprobantes-body');
                    tbody.empty();

                    if (res.ultimosComprobantes && res.ultimosComprobantes.length > 0) {
                        $.each(res.ultimosComprobantes, function (i, c) {
                            var badgeClass = 'badge-success';
                            if (c.tipo === 'BOL') badgeClass = 'badge-info';
                            if (c.tipo === 'NC') badgeClass = 'badge-danger';

                            var estadoClass = 'badge-light border';
                            if (c.estado === 'Emitido' || c.estado === 'Aceptado') estadoClass = 'badge-success';
                            else if (c.estado === 'Anulado') estadoClass = 'badge-danger';
                            else if (c.estado === 'Pendiente') estadoClass = 'badge-warning';

                            var row = '<tr>' +
                                '<td><span class="badge ' + badgeClass + ' mr-1 font-weight-bold">' + c.tipo + '</span>' + c.serieNumero + '</td>' +
                                '<td><span class="font-weight-600 text-sm">' + c.cliente + '</span></td>' +
                                '<td><span class="text-muted text-sm">' + c.fecha + '</span></td>' +
                                '<td class="text-right font-weight-bold">' + c.moneda + ' ' + c.monto + '</td>' +
                                '<td class="text-center"><span class="badge ' + estadoClass + ' px-2 py-1">' + c.estado + '</span></td>' +
                                '</tr>';
                            tbody.append(row);
                        });
                    } else {
                        tbody.html('<tr><td colspan="5" class="text-center text-muted py-4"><i class="fas fa-inbox fa-2x mb-2 d-block text-muted" style="opacity: 0.5;"></i>No se encontraron comprobantes recientes</td></tr>');
                    }

                    // Actualizar GrÃ¡ficos con datos del servidor
                    if (res.graficoVentas) {
                        renderSalesChart(res.graficoVentas);
                    }
                    if (res.graficoProduccion) {
                        renderProductionChart(res.graficoProduccion);
                    }
                }
            },
            error: function () {
                var tbody = $('#tabla-comprobantes-body');
                if (tbody.find('tr').length === 0 || tbody.text().indexOf('Cargando') !== -1) {
                    tbody.html('<tr><td colspan="5" class="text-center text-muted py-3"><i class="fas fa-info-circle text-info mr-1"></i> Panel en modo local &mdash; MÃ©tricas operativas listas</td></tr>');
                }
                // Asegurar que los grÃ¡ficos sigan renderizados
                if (lastDashboardData) {
                    renderSalesChart(lastDashboardData.graficoVentas);
                    renderProductionChart(lastDashboardData.graficoProduccion);
                }
            }
        });
    });
</script>

