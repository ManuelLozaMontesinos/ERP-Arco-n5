        function actualizarSoloKpis(sedeId) {
            $('#row-kpis-metricas').css({ 'opacity': '0.5', 'transition': 'opacity 0.2s ease' });
            $.ajax({
                url: '@Url.Action("ObtenerKpisPorSede", "Home")',
                type: 'GET',
                data: { sedeId: sedeId, anio: parseInt($('#header-select-periodo').val()) || @anioSesion, cid: cid },
                headers: { 'x-app-cid': cid },
                success: function (res) {
                    if (res && res.success && res.kpis) {
                        if (res.kpis.facturacionMes) $('#kpi-ventas').text(res.kpis.facturacionMes);
                        if (res.kpis.pedidosActivos) $('#kpi-pedidos').text(res.kpis.pedidosActivos);
                        if (res.kpis.cotizacionesActivas) $('#kpi-cotizaciones').text(res.kpis.cotizacionesActivas);
                        if (res.kpis.ordenesProduccionMes) $('#kpi-produccion').text(res.kpis.ordenesProduccionMes);
                        if (res.kpis.ordenesCompraMes) $('#kpi-compras').text(res.kpis.ordenesCompraMes);
                        if (res.kpis.pedidosMesCantidad) $('#kpi-pedidos-cantidad').text(res.kpis.pedidosMesCantidad);
                        if (res.kpis.consumoInternoMes !== undefined) $('#kpi-consumo-interno').text(res.kpis.consumoInternoMes);
                        if (res.kpis.ingresosMermaMes !== undefined) $('#kpi-merma-ingresos').text(res.kpis.ingresosMermaMes);
                        if (res.kpis.salidasMermaMes !== undefined) $('#kpi-merma-salidas').text(res.kpis.salidasMermaMes);
                        if (res.kpis.guiasRemisionMes !== undefined) $('#kpi-guias-remision').text(res.kpis.guiasRemisionMes);
                    }
                },
                complete: function () {
                    $('#row-kpis-metricas').css('opacity', '1');
                }
            });
        }

        function sincronizarDashboard() {
            var mesesAct = parseInt($('#select-meses-inactivos').val()) || 5;
            var vendChartId = parseInt($('#select-vendedor-chart').val()) || null;
            $.ajax({
                url: '@Url.Action("ObtenerDatosDashboard", "Home")',
                type: 'GET',
                data: {
                    cid: cid,
                    mesesInactivos: mesesAct,
                    vendedorClientesId: $('#select-vendedor-inactivos').val() || null,
                    vendedorId: vendChartId,
                    anio: parseInt($('#header-select-periodo').val()) || @anioSesion
                },
                headers: { 'x-app-cid': cid },
                success: function (res) {
                    if (res && res.success) {
                        lastDashboardData = res;

                        if (res.kpis) {
                            if (res.kpis.facturacionMes) $('#kpi-ventas').text(res.kpis.facturacionMes);
                            if (res.kpis.pedidosActivos) $('#kpi-pedidos').text(res.kpis.pedidosActivos);
                            if (res.kpis.cotizacionesActivas) $('#kpi-cotizaciones').text(res.kpis.cotizacionesActivas);
                            if (res.kpis.ordenesProduccionMes) $('#kpi-produccion').text(res.kpis.ordenesProduccionMes);
                            if (res.kpis.ordenesCompraMes) $('#kpi-compras').text(res.kpis.ordenesCompraMes);
                            if (res.kpis.pedidosMesCantidad) $('#kpi-pedidos-cantidad').text(res.kpis.pedidosMesCantidad);
                            if (res.kpis.consumoInternoMes !== undefined) $('#kpi-consumo-interno').text(res.kpis.consumoInternoMes);
                            if (res.kpis.ingresosMermaMes !== undefined) $('#kpi-merma-ingresos').text(res.kpis.ingresosMermaMes);
                            if (res.kpis.salidasMermaMes !== undefined) $('#kpi-merma-salidas').text(res.kpis.salidasMermaMes);
                            if (res.kpis.guiasRemisionMes !== undefined) $('#kpi-guias-remision').text(res.kpis.guiasRemisionMes);
                        }

                        if (res.graficoVentas) {
                            renderSalesChart(res.graficoVentas);
                        }
                        if (res.graficoProduccion) {
                            renderProductionChart(res.graficoProduccion);
                        }
                        if (res.graficoStackedBar) {
                            renderStackedBarChart(res.graficoStackedBar);
                        }
                        if (res.vendedorData) {
                            if (res.graficoStackedBar && res.graficoStackedBar.labels) {
                                allVendedorLabels = res.graficoStackedBar.labels;
                            }
                            allVendedorCantidades = res.vendedorData.cantidades;
                            allVendedorMontos = res.vendedorData.montos;
                            actualizarChartVendedorDias();
                        }
                        if (res.topPedidos) {
                            currentTopPedidosData = res.topPedidos;
                            renderTopPedidos(res.topPedidos, currentTopLimit);
                        }
                        if (res.topPedidosFecha) {
                            fechaTopPedidos = res.topPedidosFecha;
                        }
                        if (res.clientesInactivos) {
                            currentClientesInactivosData = res.clientesInactivos;
                            renderClientesInactivos(res.clientesInactivos, mesesAct, currentClientesInactivosLimit);
                        }
                    }
                },
                error: function () {
                    if (lastDashboardData) {
                        renderSalesChart(lastDashboardData.graficoVentas);
                        renderProductionChart(lastDashboardData.graficoProduccion);
                        renderStackedBarChart(lastDashboardData.graficoStackedBar);
                    }
                },
                complete: function () {
                    $('#row-kpis-metricas').css('opacity', '1');
                }
            });
        }

        // ========================================================
        // LOGICA DE STOCK Y CONSUMO DE INSUMOS CRITICOS
        // ========================================================
        function recargarStockInsumos(almacenId) {
            var $icon = $('#icon-recargar-stock');
            $icon.addClass('fa-spin');
            $('#btn-recargar-stock-insumos').prop('disabled', true);

            var queryAlm = (almacenId && parseInt(almacenId, 10) > 0) ? parseInt(almacenId, 10) : 0;

            $.ajax({
                url: '@Url.Action("ObtenerStockInsumos", "Home")',
                type: 'GET',
                data: { almacenId: queryAlm, cid: cid },
                success: function (res) {
                    if (res && res.success && res.data) {
                        renderTablaStockInsumos(res.data);
                        if (res.mes) {
                            $('#span-mes-stock-insumos').text(res.mes);
                        }
                    }
                },
                error: function (err) {
                    console.error('Error cargando stock de insumos:', err);
                },
                complete: function () {
                    $icon.removeClass('fa-spin');
                    $('#btn-recargar-stock-insumos').prop('disabled', false);
                }
            });
        }

        function renderTablaStockInsumos(items) {
            var $tbody = $('#tbody-stock-insumos');
            $tbody.empty();

            if (!items || items.length === 0) {
                $tbody.html('<tr><td colspan="5" class="text-center text-muted py-4"><i class="fas fa-info-circle mr-1"></i> No se encontraron registros de stock para los insumos.</td></tr>');
                return;
            }

            $('#span-cant-insumos-monitoreados').text(items ? items.length : 0);
            items.forEach(function (prod) {
                var badgeHtml = '';
                if (prod.badgeColor === 'success') {
                    badgeHtml = '<span class="badge badge-success px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-check-circle mr-1"></i>' + escapeDashboardHtml(prod.estadoStock) + '</span>';
                } else if (prod.badgeColor === 'warning') {
                    badgeHtml = '<span class="badge badge-warning text-dark px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-exclamation-triangle mr-1"></i>' + escapeDashboardHtml(prod.estadoStock) + '</span>';
                } else {
                    badgeHtml = '<span class="badge badge-danger px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-times-circle mr-1"></i>' + escapeDashboardHtml(prod.estadoStock) + '</span>';
                }

                var stockColorClass = (prod.stockActual <= 0) ? 'text-danger' : 'text-primary';

                var tr = '<tr class="fila-producto-stock" data-codigo="' + (prod.codigo || '') + '" data-desc="' + ((prod.descripcion || '').toLowerCase()) + '">' +
                    '<td class="text-center font-weight-bold text-muted py-2" style="font-size: 0.85rem;">' + prod.orden + '</td>' +
                    '<td class="text-center py-2" style="white-space: nowrap;">' +
                        '<span class="badge badge-secondary font-weight-bold px-2 py-1" style="font-family: monospace; font-size: 0.85rem; letter-spacing: 0.03em;">' +
                            escapeDashboardHtml(prod.codigo) +
                        '</span>' +
                    '</td>' +
                    '<td class="py-2" style="max-width: 380px;"><span class="font-weight-600">' + escapeDashboardHtml(prod.descripcion) + '</span></td>' +
                    '<td class="text-right py-2 font-weight-bold" style="white-space: nowrap; font-size: 0.95rem;">' +
                        escapeDashboardHtml(prod.consumoMesFormateado) + ' <small class="font-weight-normal text-muted">' + escapeDashboardHtml(prod.unidadMedida) + '</small>' +
                    '</td>' +
                    '<td class="text-right py-2" style="white-space: nowrap;">' +
                        '<div class="d-inline-flex align-items-center justify-content-end" style="gap: 8px;">' +
                            badgeHtml +
                            '<span class="font-weight-bold ' + stockColorClass + '" style="font-size: 0.95rem;">' +
                                escapeDashboardHtml(prod.stockActualFormateado) + ' <small class="font-weight-normal text-muted">' + escapeDashboardHtml(prod.unidadMedida) + '</small>' +
                            '</span>' +
                        '</div>' +
                    '</td>' +
                '</tr>';

                $tbody.append(tr);
            });

            aplicarFiltroTextoStock();
        }

        function aplicarFiltroTextoStock() {
            var q = ($('#filtro-stock-insumos').val() || '').toLowerCase().trim();
            if (!q) {
                $('.fila-producto-stock').show();
                return;
            }
            $('.fila-producto-stock').each(function () {
                var cod = ($(this).data('codigo') || '').toLowerCase();
                var desc = ($(this).data('desc') || '').toLowerCase();
                if (cod.indexOf(q) !== -1 || desc.indexOf(q) !== -1) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }

        $(document).on('input', '#filtro-stock-insumos', function () {
            aplicarFiltroTextoStock();
        });

        $(document).on('change', '#select-almacen-stock', function () {
            var almId = $(this).val();
            recargarStockInsumos(almId);
        });

        $(document).on('click', '#btn-recargar-stock-insumos', function () {
            var almId = $('#select-almacen-stock').val();
            recargarStockInsumos(almId);
        });

        // ========================================================
        // LOGICA DE TOP 10 PRODUCTOS CON MENOR STOCK (CON FILTROS)
        // ========================================================
        function cargarClasesPorGrupo(grupoId, callback) {
            var $selectClase = $('#filtro-menor-stock-clase');
            $selectClase.empty().append('<option value="">-- Todas las Clases --</option>');

            if (!grupoId || parseInt(grupoId, 10) <= 0) {
                if (callback) callback();
                return;
            }

            $.ajax({
                url: '@Url.Action("ObtenerClasesPorGrupo", "Home")',
                type: 'GET',
                data: { grupoId: grupoId },
                success: function (res) {
                    if (res && res.success && res.data) {
                        res.data.forEach(function (c) {
                            $selectClase.append('<option value="' + c.id + '">' + escapeDashboardHtml(c.nombre) + '</option>');
