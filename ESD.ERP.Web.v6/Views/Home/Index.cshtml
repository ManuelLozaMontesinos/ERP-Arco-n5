            'kpi-consumo-interno': false,
            'kpi-mermas': false,
            'kpi-guias-remision': false,
            'evolucion-ventas': false,
            'diferencia-sedes': false,
            'pedidos-vendedor': false,
            'accesos-rapidos': false,
            'estado-produccion': false,
            'agenda-calendario': false,
            'db-tiempo-real': false,
            'top-pedidos': false,
            'clientes-inactivos': false,
            'stock-insumos': false,
            'top-menor-stock': false
        };

        var defaultRolePresets = {
            'S0001': adminPreset,
            'S0002': adminPreset,
            '00020': adminPreset,
            'DEFAULT': nonAdminDefaultPreset
        };

        function esRolAdministrador(rolCod) {
            if (!rolCod) return false;
            var c = rolCod.toString().trim().toUpperCase();
            return c === 'S0001' || c === 'S0002' || c === '00020' || c === 'ADMIN';
        }

        function obtenerConfigRolesGuardada() {
            var obj = {};
            if (window._serverRolesConfig && typeof window._serverRolesConfig === 'object') {
                $.extend(true, obj, window._serverRolesConfig);
            }
            try {
                var raw = localStorage.getItem(STORAGE_ROLES_KEY);
                if (raw) {
                    var localObj = JSON.parse(raw);
                    $.extend(true, obj, localObj);
                }
            } catch (e) {
                console.warn('Error leyendo roles config local:', e);
            }
            return obj;
        }

        function guardarConfigRolesCompleta(rolesObj) {
            try {
                localStorage.setItem(STORAGE_ROLES_KEY, JSON.stringify(rolesObj));
            } catch (e) {
                console.warn('Error guardando roles config local:', e);
            }
        }

        function obtenerConfiguracionParaRol(rolCod) {
            var rolesObj = obtenerConfigRolesGuardada();
            var esAdminRol = esRolAdministrador(rolCod) || (rolCod === '@rolActualCodigo' && esUsuarioAdmin);
            var basePreset = esAdminRol ? adminPreset : nonAdminDefaultPreset;

            if (rolCod && rolesObj && rolesObj[rolCod]) {
                return $.extend({}, basePreset, rolesObj[rolCod]);
            }
            if (rolCod && defaultRolePresets[rolCod]) {
                return $.extend({}, defaultRolePresets[rolCod]);
            }
            return $.extend({}, basePreset);
        }

        function cargarConfiguracionAreas() {
            try {
                // 1. Permisos del Rol activo
                var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);

                // 2. Preferencias personales guardadas para este usuario y rol
                var personalRaw = localStorage.getItem(getStorageAreasKey());
                var personal = personalRaw ? JSON.parse(personalRaw) : null;

                // Cargar areas principales
                for (var key in areasDashboardConfig) {
                    if (areasDashboardConfig.hasOwnProperty(key)) {
                        var permitidoPorRol = (rolPermisos[key] !== undefined) ? Boolean(rolPermisos[key]) : true;
                        if (!permitidoPorRol) {
                            areasDashboardConfig[key].visible = false;
                        } else {
                            if (personal && personal.hasOwnProperty(key)) {
                                areasDashboardConfig[key].visible = Boolean(personal[key]);
                            } else {
                                areasDashboardConfig[key].visible = true;
                            }
                        }
                    }
                }

                // Cargar sub-tarjetas de KPIs
                for (var kKey in kpiCardsConfig) {
                    if (kpiCardsConfig.hasOwnProperty(kKey)) {
                        var kPermitidoPorRol = (rolPermisos[kKey] !== undefined) ? Boolean(rolPermisos[kKey]) : true;
                        if (!kPermitidoPorRol) {
                            kpiCardsConfig[kKey].visible = false;
                        } else {
                            if (personal && personal.hasOwnProperty(kKey)) {
                                kpiCardsConfig[kKey].visible = Boolean(personal[kKey]);
                            } else {
                                kpiCardsConfig[kKey].visible = true;
                            }
                        }
                    }
                }
            } catch (e) {
                console.warn('Error leyendo configuracion en localStorage:', e);
            }
        }

        function guardarConfiguracionAreas() {
            try {
                var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);
                var obj = {};
                for (var key in areasDashboardConfig) {
                    var permitidoPorRol = (rolPermisos[key] !== undefined) ? Boolean(rolPermisos[key]) : true;
                    if (permitidoPorRol) {
                        obj[key] = areasDashboardConfig[key].visible;
                    }
                }
                for (var kKey in kpiCardsConfig) {
                    var kPermitidoPorRol = (rolPermisos[kKey] !== undefined) ? Boolean(rolPermisos[kKey]) : true;
                    if (kPermitidoPorRol) {
                        obj[kKey] = kpiCardsConfig[kKey].visible;
                    }
                }
                localStorage.setItem(getStorageAreasKey(), JSON.stringify(obj));
            } catch (e) {
                console.warn('Error guardando configuracion en localStorage:', e);
            }
        }

        function aplicarVisibilidadAreas() {
            var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);
            var activasCount = 0;
            var permitidasCount = 0;

            // 1. Procesar 9 areas principales
            for (var key in areasDashboardConfig) {
                var item = areasDashboardConfig[key];
                var $el = $(item.selector);
                var $chk = $('#chk-area-' + key);
                var $card = $chk.closest('.dashboard-area-card');

                var permitidoPorRol = (rolPermisos[key] !== undefined) ? Boolean(rolPermisos[key]) : true;

                if (!permitidoPorRol) {
                    item.visible = false;
                    $el.addClass('d-none').hide();
                    if ($card.length) {
                        $card.addClass('d-none area-rol-bloqueada').css('display', 'none');
                    }
                    if ($chk.length) $chk.prop('checked', false);
                } else {
                    permitidasCount++;
                    if ($card.length) {
                        $card.removeClass('d-none area-rol-bloqueada').css('display', '');
                    }

                    if (item.visible) {
                        activasCount++;
                        $el.removeClass('d-none').show();
                        if ($chk.length) $chk.prop('checked', true);
                    } else {
                        $el.addClass('d-none').hide();
                        if ($chk.length) $chk.prop('checked', false);
                    }
                }
            }

            // 2. Despliegue y gestion de sub-controles de KPIs en modal de usuario
            var kpisAreaPermitida = (rolPermisos['kpis'] !== undefined) ? Boolean(rolPermisos['kpis']) : true;
            var kpisAreaActiva = kpisAreaPermitida && areasDashboardConfig['kpis'].visible;

            if (!kpisAreaPermitida) {
                $('#sub-kpis-container').hide();
            } else if (kpisAreaActiva) {
                $('#sub-kpis-container').show();
            } else {
                $('#sub-kpis-container').hide();
            }

            // 3. Procesar visibilidad de cada tarjeta individual de KPI
            var kpisActivosCount = 0;
            var kpisPermitidosCount = 0;

            for (var kKey in kpiCardsConfig) {
                var kCard = kpiCardsConfig[kKey];
                var $cardEl = $(kCard.selector);
                var $subChk = $('#chk-sub-' + kKey);
                var $subCard = $subChk.closest('.sub-kpi-card');

                var kPermitidoPorRol = kpisAreaPermitida && ((rolPermisos[kKey] !== undefined) ? Boolean(rolPermisos[kKey]) : true);

                if (!kPermitidoPorRol) {
                    kCard.visible = false;
                    $cardEl.addClass('d-none').hide();
                    if ($subCard.length) {
                        $subCard.addClass('d-none subkpi-rol-bloqueada').css('display', 'none');
                    }
                    if ($subChk.length) $subChk.prop('checked', false);
                } else {
                    kpisPermitidosCount++;
                    if ($subCard.length) {
                        $subCard.removeClass('d-none subkpi-rol-bloqueada').css('display', '');
                    }

                    if (kpisAreaActiva && kCard.visible) {
                        kpisActivosCount++;
                        $cardEl.removeClass('d-none').show();
                        if ($subChk.length) $subChk.prop('checked', true);
                    } else {
                        $cardEl.addClass('d-none').hide();
                        if ($subChk.length) $subChk.prop('checked', false);
                    }
                }
            }

            // Si no hay sub-KPIs permitidos para este rol, ocultar contenedor de sub-KPIs
            if (kpisPermitidosCount === 0) {
                $('#sub-kpis-container').hide();
            }

            // Si todas las tarjetas individuales de KPI estan ocultas, ocultar el row completo en dashboard
            if (kpisAreaActiva && kpisActivosCount === 0) {
                $('#row-kpis-metricas').addClass('d-none').hide();
            } else if (kpisAreaActiva && kpisActivosCount > 0) {
                $('#row-kpis-metricas').removeClass('d-none').show();
            }

            $('#badge-conteo-kpis-activos').text(kpisActivosCount + ' de ' + kpisPermitidosCount + ' activas');
            $('#modal-conteo-areas-activas').text(activasCount);
            $('#modal-conteo-areas-permitidas').text(permitidasCount);

            if (permitidasCount === 0) {
                $('#modal-areas-ninguna-permitida').removeClass('d-none').show();
                if (!esUsuarioAdmin) {
                    $('#dashboard-empty-state').removeClass('d-none').show();
                }
            } else {
                $('#modal-areas-ninguna-permitida').addClass('d-none').hide();
                $('#dashboard-empty-state').addClass('d-none').hide();
            }

            // Ajuste responsivo de columnas
            var leftVisible = areasDashboardConfig['evolucion-ventas'].visible || areasDashboardConfig['diferencia-sedes'].visible || areasDashboardConfig['pedidos-vendedor'].visible;
            var rightVisible = areasDashboardConfig['accesos-rapidos'].visible || areasDashboardConfig['estado-produccion'].visible || (areasDashboardConfig['agenda-calendario'] && areasDashboardConfig['agenda-calendario'].visible) || areasDashboardConfig['db-tiempo-real'].visible;

            var $colLeft = $('#col-main-left');
            var $colRight = $('#col-main-right');
            var $rowMain = $('#row-main-dashboard');

            if (!leftVisible && !rightVisible) {
                $rowMain.addClass('d-none');
            } else {
                $rowMain.removeClass('d-none');
                if (leftVisible && !rightVisible) {
                    $colLeft.removeClass('d-none col-lg-7').addClass('col-lg-12');
                    $colRight.addClass('d-none');
                } else if (!leftVisible && rightVisible) {
                    $colLeft.addClass('d-none');
                    $colRight.removeClass('d-none col-lg-5').addClass('col-lg-12');
                } else {
                    $colLeft.removeClass('d-none col-lg-12').addClass('col-lg-7');
                    $colRight.removeClass('d-none col-lg-12').addClass('col-lg-5');
                }
            }

            // Ajuste responsivo de tablas
            var topPedidosVis = areasDashboardConfig['top-pedidos'].visible;
            var clientesVis = areasDashboardConfig['clientes-inactivos'].visible;
            var $areaTop = $('#area-top-pedidos');
            var $areaCli = $('#area-clientes-inactivos');
            var $rowTablas = $('#row-tablas-detalle');

            if (!topPedidosVis && !clientesVis) {
                $rowTablas.addClass('d-none');
            } else {
                $rowTablas.removeClass('d-none');
                if (topPedidosVis && !clientesVis) {
                    $areaTop.removeClass('d-none col-lg-6').addClass('col-lg-12');
                    $areaCli.addClass('d-none');
                } else if (!topPedidosVis && clientesVis) {
                    $areaTop.addClass('d-none');
                    $areaCli.removeClass('d-none col-lg-6').addClass('col-lg-12');
                } else {
                    $areaTop.removeClass('d-none col-lg-12').addClass('col-lg-6');
                    $areaCli.removeClass('d-none col-lg-12').addClass('col-lg-6');
                }
            }



            // Redimensionar graficos Chart.js
            setTimeout(function () {
                if (salesChartInstance) salesChartInstance.resize();
                if (stackedBarChartInstance) stackedBarChartInstance.resize();
                if (productionChartInstance) productionChartInstance.resize();
                if (vendedorChartInstance) vendedorChartInstance.resize();
            }, 60);
        }

        // Eventos de switches principales del modal de usuario
        $(document).off('change', '.chk-dashboard-area').on('change', '.chk-dashboard-area', function () {
            var areaKey = $(this).data('area');
            var isChecked = $(this).is(':checked');
            var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);
            var permitidoPorRol = (rolPermisos[areaKey] !== undefined) ? Boolean(rolPermisos[areaKey]) : true;

            if (!permitidoPorRol) {
                $(this).prop('checked', false);
                if (areasDashboardConfig[areaKey]) {
                    areasDashboardConfig[areaKey].visible = false;
                }
            } else {
                if (areasDashboardConfig.hasOwnProperty(areaKey)) {
                    areasDashboardConfig[areaKey].visible = isChecked;
                }
                // Despliegue animado si es el switch de KPIs
                if (areaKey === 'kpis') {
                    if (isChecked) {
                        $('#sub-kpis-container').slideDown(250);
                    } else {
                        $('#sub-kpis-container').slideUp(200);
                    }
                }
            }
            guardarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        // Eventos de switches de sub-tarjetas de KPIs en modal de usuario
        $(document).off('change', '.chk-sub-kpi').on('change', '.chk-sub-kpi', function () {
            var kpiKey = $(this).data('kpi');
            var isChecked = $(this).is(':checked');
            var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);
            var permitido = (rolPermisos[kpiKey] !== undefined) ? Boolean(rolPermisos[kpiKey]) : true;

            if (!permitido) {
                $(this).prop('checked', false);
                if (kpiCardsConfig[kpiKey]) kpiCardsConfig[kpiKey].visible = false;
            } else {
                if (kpiCardsConfig.hasOwnProperty(kpiKey)) {
                    kpiCardsConfig[kpiKey].visible = isChecked;
                }
            }
            guardarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        // Botones auxiliares del modal de usuario
        $('#btn-modal-marcar-todos').on('click', function () {
            var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);
            for (var k in areasDashboardConfig) {
                var permitidoPorRol = (rolPermisos[k] !== undefined) ? Boolean(rolPermisos[k]) : true;
                if (permitidoPorRol) {
                    areasDashboardConfig[k].visible = true;
                }
            }
            for (var kKey in kpiCardsConfig) {
                var kPermitido = (rolPermisos[kKey] !== undefined) ? Boolean(rolPermisos[kKey]) : true;
                if (kPermitido) {
                    kpiCardsConfig[kKey].visible = true;
                }
            }
            $('#sub-kpis-container').slideDown(250);
            guardarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        $('#btn-modal-desmarcar-todos').on('click', function () {
            for (var k in areasDashboardConfig) {
                areasDashboardConfig[k].visible = false;
            }
            for (var kKey in kpiCardsConfig) {
                kpiCardsConfig[kKey].visible = false;
            }
            $('#sub-kpis-container').slideUp(200);
            guardarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        $('#btn-modal-restablecer').on('click', function () {
            try {
                localStorage.removeItem(getStorageAreasKey());
            } catch (e) { }
            cargarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        // ========================================================
        // LOGICA DEL MODAL: Gestionar Dashboard por Rol (Admin)
        // ========================================================
        function sincronizarModalRolUI(rolCod) {
            var configRol = obtenerConfiguracionParaRol(rolCod);
            var esAdminRol = esRolAdministrador(rolCod);
            var activasCount = 0;

            // 1. Sincronizar 12 areas principales
            $('.chk-dashboard-rol-area').each(function () {
                var areaKey = $(this).data('area');
                var isChecked = (configRol[areaKey] !== undefined) ? Boolean(configRol[areaKey]) : esAdminRol;
                $(this).prop('checked', isChecked);
                if (isChecked) activasCount++;
            });

            // 2. Despliegue de sub-panel de KPIs para el rol
            var kpisRolActivo = (configRol['kpis'] !== undefined) ? Boolean(configRol['kpis']) : esAdminRol;
            if (kpisRolActivo) {
                $('#rol-sub-kpis-container').show();
            } else {
                $('#rol-sub-kpis-container').hide();
            }

            // 3. Sincronizar cada switch de tarjeta individual
            $('.chk-rol-sub-kpi').each(function () {
                var kpiKey = $(this).data('kpi');
                var isChecked = (configRol[kpiKey] !== undefined) ? Boolean(configRol[kpiKey]) : esAdminRol;
                $(this).prop('checked', isChecked);
            });

            $('#modal-rol-conteo-areas-activas').text(activasCount);
        }

        function guardarConfiguracionRolActualEnModal() {
            var rolCod = $('#select-rol-dashboard').val();
            if (!rolCod) return;

            var rolesObj = obtenerConfigRolesGuardada();
            var rolConfig = {};

            // 1. Guardar areas principales
            $('.chk-dashboard-rol-area').each(function () {
                var areaKey = $(this).data('area');
                rolConfig[areaKey] = $(this).is(':checked');
            });

            // 2. Guardar sub-tarjetas de KPIs
            $('.chk-rol-sub-kpi').each(function () {
                var kpiKey = $(this).data('kpi');
                rolConfig[kpiKey] = $(this).is(':checked');
            });

            rolesObj[rolCod] = rolConfig;
            guardarConfigRolesCompleta(rolesObj);

            // Persistir en Base de Datos via AJAX para sincronizar con todos los clientes / PCs en produccion
            $.ajax({
                url: '@Url.Action("GuardarConfiguracionDashboardRol", "Home")',
                type: 'POST',
                data: {
                    rolCodigo: rolCod,
                    configJson: JSON.stringify(rolConfig)
                },
                success: function (res) {
                    if (res && res.success) {
                        if (window._serverRolesConfig) {
                            window._serverRolesConfig[rolCod] = rolConfig;
                        }
                    } else {
                        console.warn('No se pudo guardar la configuracion en BD:', res ? res.message : '');
                    }
                },
                error: function (err) {
                    console.error('Error al persistir configuracion de dashboard por rol en BD:', err);
                }
            });

            // Si el rol modificado es el rol activo o visualizado actualmente, refrescar live
            if (rolCod === currentRoleCode) {
                cargarConfiguracionAreas();
                aplicarVisibilidadAreas();
            }
        }

        // Cambio de rol en el select del modal
        $(document).on('change', '#select-rol-dashboard', function () {
            var rolCod = $(this).val();
            sincronizarModalRolUI(rolCod);
        });

        // Cambio de switches de areas principales en modal por rol
        $(document).on('change', '.chk-dashboard-rol-area', function () {
            var areaKey = $(this).data('area');
            var isChecked = $(this).is(':checked');

            if (areaKey === 'kpis') {
                if (isChecked) {
                    $('#rol-sub-kpis-container').slideDown(250);
                } else {
                    $('#rol-sub-kpis-container').slideUp(200);
                }
            }

            guardarConfiguracionRolActualEnModal();
            var count = $('.chk-dashboard-rol-area:checked').length;
            $('#modal-rol-conteo-areas-activas').text(count);
        });

        // Cambio de switches de sub-KPIs en modal por rol
        $(document).on('change', '.chk-rol-sub-kpi', function () {
            guardarConfiguracionRolActualEnModal();
        });

        // Botones rapidos para sub-tarjetas de KPIs en modal de rol
        $(document).on('click', '#btn-rol-kpis-todos', function () {
            $('.chk-rol-sub-kpi').prop('checked', true);
            guardarConfiguracionRolActualEnModal();
        });

        $(document).on('click', '#btn-rol-kpis-ninguno', function () {
            $('.chk-rol-sub-kpi').prop('checked', false);
            guardarConfiguracionRolActualEnModal();
        });

        // Acciones rapidas en modal por rol
        $('#btn-modal-rol-marcar-todos').on('click', function () {
            $('.chk-dashboard-rol-area').prop('checked', true);
            $('.chk-rol-sub-kpi').prop('checked', true);
            $('#rol-sub-kpis-container').slideDown(250);
            guardarConfiguracionRolActualEnModal();
            $('#modal-rol-conteo-areas-activas').text(12);
        });

        $('#btn-modal-rol-desmarcar-todos').on('click', function () {
            $('.chk-dashboard-rol-area').prop('checked', false);
            $('.chk-rol-sub-kpi').prop('checked', false);
            $('#rol-sub-kpis-container').slideUp(200);
            guardarConfiguracionRolActualEnModal();
            $('#modal-rol-conteo-areas-activas').text(0);
        });

        $('#btn-modal-rol-restablecer').on('click', function () {
            var rolCod = $('#select-rol-dashboard').val();
            var rolesObj = obtenerConfigRolesGuardada();
            if (rolesObj[rolCod]) {
                delete rolesObj[rolCod];
                guardarConfigRolesCompleta(rolesObj);
            }
            var preset = esRolAdministrador(rolCod) ? adminPreset : nonAdminDefaultPreset;
            $.ajax({
                url: '@Url.Action("GuardarConfiguracionDashboardRol", "Home")',
                type: 'POST',
                data: {
                    rolCodigo: rolCod,
                    configJson: JSON.stringify(preset)
                },
                success: function () {
                    if (window._serverRolesConfig) {
                        window._serverRolesConfig[rolCod] = preset;
                    }
                }
            });
            sincronizarModalRolUI(rolCod);
            if (rolCod === currentRoleCode) {
                cargarConfiguracionAreas();
                aplicarVisibilidadAreas();
            }
        });

        // Boton para ver el Dashboard como el rol seleccionado en el selector
        $(document).on('click', '#btn-aplicar-vista-rol', function () {
            var selectedRol = $('#select-rol-dashboard').val();
            if (selectedRol) {
                currentRoleCode = selectedRol;
                $('#badge-rol-usuario-indicador').remove();
                $('#btn-gestionar-dashboard-rol').after('<span id="badge-rol-usuario-indicador" class="badge badge-info ml-2 font-weight-600 px-2 py-1 shadow-sm" style="cursor: pointer;" title="Clic para volver a tu rol original"><i class="fas fa-eye mr-1"></i>Vista Rol: ' + selectedRol + ' &times;</span>');
                cargarConfiguracionAreas();
                aplicarVisibilidadAreas();
                $('#modal-gestionar-dashboard-rol').modal('hide');
            }
        });

        // Eventos al abrir modales
        $('#modal-gestionar-dashboard').on('show.bs.modal', function () {
            cargarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        $('#modal-gestionar-dashboard-rol').on('show.bs.modal', function () {
            var rolCod = $('#select-rol-dashboard').val();
            if (!rolCod) {
                rolCod = currentRoleCode;
                $('#select-rol-dashboard').val(rolCod);
            }
            sincronizarModalRolUI(rolCod);
        });

        // Click en badge de rol simulado para restaurar rol original del administrador
        $(document).on('click', '#badge-rol-usuario-indicador', function () {
            currentRoleCode = '@rolActualCodigo';
            $(this).remove();
            cargarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        if ($('#select-rol-dashboard').length) {
            sincronizarModalRolUI($('#select-rol-dashboard').val());
        }

        cargarConfiguracionAreas();
        aplicarVisibilidadAreas();

        // Soporte de rueda del raton sobre el grafico de Evolucion de Ventas (6 a 12 meses progresivo)
        var canvasVentas = document.getElementById('salesChart');
        if (canvasVentas && !canvasVentas.__wheelAttached) {
            canvasVentas.__wheelAttached = true;
            canvasVentas.addEventListener('wheel', function (e) {
                e.preventDefault();
                var delta = e.deltaY || e.detail || (-e.wheelDelta);
                if (delta > 0) {
                    stepVentasMeses(-1);
                } else if (delta < 0) {
                    stepVentasMeses(1);
                }
            }, { passive: false });
        }

        // Soporte de rueda del raton sobre el grafico de Diferencia (6 a 12 dias progresivo)
        var lastDiferenciaWheelTime = 0;
        function handleDiferenciaWheel(e) {
            e.preventDefault();
            var now = Date.now();
            if (now - lastDiferenciaWheelTime < 180) return;
            lastDiferenciaWheelTime = now;

            var delta = e.deltaY || e.detail || (-e.wheelDelta);
            if (delta > 0) {
                stepDiferenciaDias(-1);
            } else if (delta < 0) {
                stepDiferenciaDias(1);
            }
        }

        var canvasDiferencia = document.getElementById('stackedBarChart');
        var containerDiferencia = document.getElementById('diferencia-chart-container') || (canvasDiferencia ? canvasDiferencia.parentElement : null);
        if (canvasDiferencia && !canvasDiferencia.__wheelAttached) {
            canvasDiferencia.__wheelAttached = true;
            canvasDiferencia.addEventListener('wheel', handleDiferenciaWheel, { passive: false });
        }
        if (containerDiferencia && !containerDiferencia.__wheelAttached) {
            containerDiferencia.__wheelAttached = true;
            containerDiferencia.addEventListener('wheel', handleDiferenciaWheel, { passive: false });
        }

        // Soporte de rueda del raton sobre el grafico de Pedidos por Vendedor (6 a 12 dias progresivo)
        var lastVendedorWheelTime = 0;
        function handleVendedorWheel(e) {
            e.preventDefault();
            var now = Date.now();
            if (now - lastVendedorWheelTime < 180) return;
            lastVendedorWheelTime = now;

            var delta = e.deltaY || e.detail || (-e.wheelDelta);
            if (delta > 0) {
                stepVendedorDias(-1);
            } else if (delta < 0) {
                stepVendedorDias(1);
            }
        }

        var canvasVendedor = document.getElementById('vendedorBarChart');
        var containerVendedor = document.getElementById('vendedor-chart-container') || (canvasVendedor ? canvasVendedor.parentElement : null);
        if (canvasVendedor && !canvasVendedor.__wheelAttached) {
            canvasVendedor.__wheelAttached = true;
            canvasVendedor.addEventListener('wheel', handleVendedorWheel, { passive: false });
        }
        if (containerVendedor && !containerVendedor.__wheelAttached) {
            containerVendedor.__wheelAttached = true;
            containerVendedor.addEventListener('wheel', handleVendedorWheel, { passive: false });
        }

