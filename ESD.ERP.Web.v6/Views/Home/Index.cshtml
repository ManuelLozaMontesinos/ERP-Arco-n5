        function construirErpMenuPermitidosSet() {
            window.erpMenuPermitidosSet = {};
            if (window.erpMenuTree && Array.isArray(window.erpMenuTree)) {
                function extraer(nodes) {
                    nodes.forEach(function (n) {
                        if (n.url && n.url.trim() !== '' && n.url.trim() !== '#') {
                            var c = n.url.trim().toLowerCase().replace(/^\/+/, '').split('?')[0];
                            window.erpMenuPermitidosSet[c] = true;
                            if (c.indexOf('/') >= 0) {
                                window.erpMenuPermitidosSet[c.split('/')[0]] = true;
                            } else {
                                window.erpMenuPermitidosSet[c + '/index'] = true;
                            }
                        }
                        if (n.nodes && n.nodes.length > 0) {
                            extraer(n.nodes);
                        }
                    });
                }
                extraer(window.erpMenuTree);
            }
        }

        function isModuloPermitido(url) {
            if (!url) return false;
            if (window.esAdminTotalAccesos === true) return true;
            if (Array.isArray(window.modulosPermitidosServidor) && window.modulosPermitidosServidor.indexOf('*') >= 0) return true;

            var clean = (url || '').toLowerCase().replace(/^\/+/, '').split('?')[0].trim();
            if (!clean) return false;

            // Calendario siempre permitido
            if (clean === 'calendario' || clean === 'calendario/index' || clean.indexOf('calendario') === 0) return true;

            // Verificar contra modulosPermitidosServidor
            if (Array.isArray(window.modulosPermitidosServidor) && window.modulosPermitidosServidor.length > 0) {
                if (window.modulosPermitidosServidor.indexOf(clean) >= 0) return true;
                var ctrl = clean.indexOf('/') >= 0 ? clean.split('/')[0] : clean;
                if (window.modulosPermitidosServidor.indexOf(ctrl) >= 0) return true;
                if (window.modulosPermitidosServidor.indexOf(ctrl + '/index') >= 0) return true;
            }

            // Verificar contra erpMenuTree si existe
            if (window.erpMenuPermitidosSet) {
                if (window.erpMenuPermitidosSet[clean]) return true;
                var ctrl2 = clean.indexOf('/') >= 0 ? clean.split('/')[0] : clean;
                if (window.erpMenuPermitidosSet[ctrl2] || window.erpMenuPermitidosSet[ctrl2 + '/index']) return true;
            }

            return false;
        }

        function obtenerModulosDisponiblesCompletos() {
            construirErpMenuPermitidosSet();

            // 1. Filtrar catálogo base para incluir ÚNICAMENTE módulos permitidos para el rol
            var catalogo = [];
            var urlMap = {};

            catalogoModulosBase.forEach(function (m) {
                if (isModuloPermitido(m.url)) {
                    var clean = (m.url || '').toLowerCase().replace(/^\/+/, '').split('?')[0];
                    if (!urlMap[clean]) {
                        urlMap[clean] = true;
                        var ctrl = clean.indexOf('/') >= 0 ? clean.split('/')[0] : clean;
                        urlMap[ctrl] = true;
                        catalogo.push(m);
                    }
                }
            });

            // 2. Extraer módulos adicionales desde window.erpMenuTree que correspondan al rol
            if (window.erpMenuTree && Array.isArray(window.erpMenuTree)) {
                function extraerNodos(nodes, padreNombre) {
                    nodes.forEach(function (node) {
                        var areaActual = padreNombre || node.text;
                        if (node.nodes && node.nodes.length > 0) {
                            extraerNodos(node.nodes, areaActual);
                        } else if (node.url && node.url.trim() !== '' && node.url.trim() !== '#') {
                            var cleanUrl = node.url.trim().toLowerCase().replace(/^\/+/, '').split('?')[0];
                            var ctrl = cleanUrl.indexOf('/') >= 0 ? cleanUrl.split('/')[0] : cleanUrl;
                            if (!urlMap[cleanUrl] && !urlMap[ctrl]) {
                                urlMap[cleanUrl] = true;
                                urlMap[ctrl] = true;

                                var cat = 'Otros';
                                var lowArea = (areaActual || '').toLowerCase();
                                if (lowArea.indexOf('venta') >= 0) cat = 'Ventas';
                                else if (lowArea.indexOf('produc') >= 0) cat = 'Producción';
                                else if (lowArea.indexOf('compra') >= 0) cat = 'Compras';
                                else if (lowArea.indexOf('alma') >= 0 || lowArea.indexOf('inven') >= 0) cat = 'Almacén';
                                else if (lowArea.indexOf('maestr') >= 0) cat = 'Maestros';
                                else if (lowArea.indexOf('recurso') >= 0 || lowArea.indexOf('rrhh') >= 0 || lowArea.indexOf('humano') >= 0) cat = 'RRHH';

                                catalogo.push({
                                    url: cleanUrl,
                                    title: node.text,
                                    icon: (node.icon || 'fas fa-external-link-alt').trim(),
                                    color: 'text-secondary',
                                    area: cat,
                                    isDefault: false
                                });
                            }
                        }
                    });
                }
                extraerNodos(window.erpMenuTree, null);
            }

            return catalogo;
        }

        function obtenerAccesosRapidosGuardados() {
            var disponibles = obtenerModulosDisponiblesCompletos();
            var permitidosMap = {};
            disponibles.forEach(function (d) {
                var c = (d.url || '').toLowerCase().replace(/^\/+/, '').split('?')[0];
                permitidosMap[c] = d;
                if (c.indexOf('/') >= 0) {
                    permitidosMap[c.split('/')[0]] = d;
                }
            });

            try {
                var raw = localStorage.getItem(getStorageAccesosKey());
                if (raw) {
                    var parsed = JSON.parse(raw);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        var filtrados = [];
                        parsed.forEach(function (item) {
                            var c = (item.url || '').toLowerCase().replace(/^\/+/, '').split('?')[0];
                            var ctrl = c.indexOf('/') >= 0 ? c.split('/')[0] : c;
                            if (permitidosMap[c]) {
                                filtrados.push(permitidosMap[c]);
                            } else if (permitidosMap[ctrl]) {
                                filtrados.push(permitidosMap[ctrl]);
                            }
                        });
                        if (filtrados.length > 0) {
                            return filtrados.slice(0, 6);
                        }
                    }
                }
            } catch (e) {
                console.warn('Error leyendo accesos rápidos de localStorage:', e);
            }

            // Si no tiene guardados o se invalidaron por rol, retornar los predeterminados permitidos (máx 6)
            var defaults = disponibles.filter(function (m) { return m.isDefault; });
            if (defaults.length === 0) {
                defaults = disponibles.slice(0, 6);
            } else if (defaults.length > 6) {
                defaults = defaults.slice(0, 6);
            }
            return defaults;
        }

        function guardarAccesosRapidosEnStorage(lista) {
            try {
                if (Array.isArray(lista) && lista.length > 6) {
                    lista = lista.slice(0, 6);
                }
                localStorage.setItem(getStorageAccesosKey(), JSON.stringify(lista));
            } catch (e) {
                console.warn('Error guardando accesos rápidos:', e);
            }
        }

        function renderizarAccesosRapidos() {
            var $container = $('#contenedor-accesos-rapidos');
            if (!$container.length) return;

            var items = obtenerAccesosRapidosGuardados();
            if (items && items.length > 6) {
                items = items.slice(0, 6);
            }
            $container.empty();

            if (!items || items.length === 0) {
                $container.html('<div class="text-muted text-center py-3 w-100"><i class="fas fa-info-circle mr-1 text-info"></i>No tienes accesos rápidos seleccionados. Haz clic en el botón de ajustes <i class="fas fa-sliders-h text-success mx-1"></i> en la cabecera para agregarlos (máximo 6).</div>');
                return;
            }

            items.forEach(function (item) {
                var $btn = $('<a>')
                    .addClass('btn btn-app m-0 shadow-xs')
                    .attr('href', 'javascript:void(0);')
                    .attr('title', item.title)
                    .attr('data-url', item.url)
                    .on('click', function () {
                        $(this).getView({ urlAction: item.url });
                    });

                var $icon = $('<i>').addClass(item.icon + ' ' + (item.color || 'text-primary'));
                $btn.append($icon).append(document.createTextNode(' ' + item.title));
                $container.append($btn);
            });
        }

        function initGestionAccesosRapidos() {
            renderizarAccesosRapidos();

            $(document).on('erpMenuTreeLoaded', function () {
                renderizarAccesosRapidos();
            });

            // Al abrir el modal de personalización
            $('#modal-gestionar-accesos-rapidos').on('show.bs.modal', function () {
                var disponibles = obtenerModulosDisponiblesCompletos();
                var activos = obtenerAccesosRapidosGuardados();

                _modulosSeleccionadosTemp = {};
                activos.forEach(function (a) {
                    var cleanUrl = (a.url || '').toLowerCase().replace(/^\/+/, '');
                    _modulosSeleccionadosTemp[cleanUrl] = a;
                });

                poblarGridModulosAccesos(disponibles);
                actualizarConteoAccesosModal();
                $('#busqueda-modulo-accesos').val('');
                $('#btn-limpiar-busqueda-accesos').hide();
                $('#filtros-categoria-accesos .filter-cat-btn').removeClass('btn-success active').addClass('btn-outline-secondary');
                $('#filtros-categoria-accesos .filter-cat-btn[data-cat="TODOS"]').removeClass('btn-outline-secondary').addClass('btn-success active');
            });

            // Filtro por Búsqueda de Texto
            $('#busqueda-modulo-accesos').on('keyup input', function () {
                var term = $(this).val().toLowerCase().trim();
                $('#btn-limpiar-busqueda-accesos').toggle(term.length > 0);
                filtrarModulosEnModal();
            });

            $('#btn-limpiar-busqueda-accesos').on('click', function () {
                $('#busqueda-modulo-accesos').val('').focus();
                $(this).hide();
                filtrarModulosEnModal();
            });

            // Filtro por Categoría
            $('#filtros-categoria-accesos').on('click', '.filter-cat-btn', function () {
                $('#filtros-categoria-accesos .filter-cat-btn').removeClass('btn-success active').addClass('btn-outline-secondary');
                $(this).removeClass('btn-outline-secondary').addClass('btn-success active');
                filtrarModulosEnModal();
            });

            // Clic en la tarjeta del módulo para seleccionar/deseleccionar
            $(document).on('click', '.acceso-rapido-item-card', function (e) {
                if ($(e.target).is('input.chk-acceso-rapido') || $(e.target).is('label.custom-control-label')) return;

                var $chk = $(this).find('input.chk-acceso-rapido');
                var url = $chk.data('url');
                var willBeChecked = !$chk.is(':checked');

                // Si va a marcar y ya hay 6 seleccionados
                if (willBeChecked) {
                    var totalActual = Object.keys(_modulosSeleccionadosTemp).length;
                    if (totalActual >= 6 && !_modulosSeleccionadosTemp[url]) {
                        if (typeof msgAlert === 'function') {
                            msgAlert(msgAlertTypeConstant.WARNING, 'Solo puedes seleccionar un máximo de 6 accesos rápidos.');
                        } else if (typeof toastr !== 'undefined') {
                            toastr.warning('Solo puedes seleccionar un máximo de 6 accesos rápidos.');
                        }
                        return false;
                    }
                }

                $chk.prop('checked', willBeChecked).trigger('change');
            });

            // Cambio de estado de un checkbox de módulo
            $(document).on('change', '.chk-acceso-rapido', function () {
                var url = $(this).data('url');
                var isChecked = $(this).is(':checked');
                var $card = $(this).closest('.acceso-rapido-item-card');

                // Validar cupo máximo de 6
                if (isChecked) {
                    var totalActual = Object.keys(_modulosSeleccionadosTemp).length;
                    if (totalActual >= 6 && !_modulosSeleccionadosTemp[url]) {
                        $(this).prop('checked', false);
                        $card.removeClass('is-selected');

                        if (typeof msgAlert === 'function') {
                            msgAlert(msgAlertTypeConstant.WARNING, 'Solo puedes seleccionar un máximo de 6 accesos rápidos.');
                        } else if (typeof toastr !== 'undefined') {
                            toastr.warning('Solo puedes seleccionar un máximo de 6 accesos rápidos.');
                        }
                        return false;
                    }
                }

                $card.toggleClass('is-selected', isChecked);

                var disponibles = obtenerModulosDisponiblesCompletos();
                var mod = disponibles.find(function (m) {
                    return (m.url || '').toLowerCase().replace(/^\/+/, '') === url;
                });

                if (isChecked && mod) {
                    _modulosSeleccionadosTemp[url] = mod;
                } else {
                    delete _modulosSeleccionadosTemp[url];
                }
                actualizarConteoAccesosModal();
            });


            // Botón: Desmarcar Todos
            $('#btn-accesos-desmarcar-todos').on('click', function () {
                $('.chk-acceso-rapido').prop('checked', false);
                $('.acceso-rapido-item-card').removeClass('is-selected');
                _modulosSeleccionadosTemp = {};
                actualizarConteoAccesosModal();
            });

            // Botón: Restablecer a Predeterminados (máximo 6)
            $('#btn-accesos-restablecer').on('click', function () {
                _modulosSeleccionadosTemp = {};
                var disponibles = obtenerModulosDisponiblesCompletos();
                var defaults = disponibles.filter(function (m) { return m.isDefault; });
                if (defaults.length === 0) {
                    defaults = disponibles.slice(0, 6);
                } else if (defaults.length > 6) {
                    defaults = defaults.slice(0, 6);
                }
                defaults.forEach(function (m) {
                    var cleanUrl = (m.url || '').toLowerCase().replace(/^\/+/, '');
                    _modulosSeleccionadosTemp[cleanUrl] = m;
                });
                $('.chk-acceso-rapido').each(function () {
                    var url = $(this).data('url');
                    var check = Boolean(_modulosSeleccionadosTemp[url]);
                    $(this).prop('checked', check);
                    $(this).closest('.acceso-rapido-item-card').toggleClass('is-selected', check);
                });
                actualizarConteoAccesosModal();
            });

            // Botón: Guardar Cambios
            $('#btn-guardar-accesos-rapidos').on('click', function () {
                var listaGuardar = [];
                var disponibles = obtenerModulosDisponiblesCompletos();

                disponibles.forEach(function (m) {
                    var cleanUrl = (m.url || '').toLowerCase().replace(/^\/+/, '');
                    if (_modulosSeleccionadosTemp[cleanUrl]) {
                        listaGuardar.push(m);
                    }
                });

                if (listaGuardar.length > 6) {
                    listaGuardar = listaGuardar.slice(0, 6);
                }

                guardarAccesosRapidosEnStorage(listaGuardar);
                renderizarAccesosRapidos();
                $('#modal-gestionar-accesos-rapidos').modal('hide');

                if (typeof msgAlert === 'function') {
                    msgAlert(msgAlertTypeConstant.SUCCESS, 'Accesos rápidos actualizados correctamente (' + listaGuardar.length + ' de 6 módulos).');
                }
            });
        }

        function poblarGridModulosAccesos(disponibles) {
            var $grid = $('#grid-modulos-accesos-rapidos');
            $grid.empty();

            var catCounts = {
                'Ventas': 0,
                'Producción': 0,
                'Compras': 0,
                'Almacén': 0,
                'Maestros': 0,
                'RRHH': 0,
                'Otros': 0
            };

            disponibles.forEach(function (m) {
                if (catCounts.hasOwnProperty(m.area)) {
                    catCounts[m.area]++;
                } else {
                    catCounts['Otros'] = (catCounts['Otros'] || 0) + 1;
                }
            });

            $('#cnt-cat-todos').text(disponibles.length);

            // Mostrar u ocultar botones de categorías según tengan módulos disponibles para este rol
            $('#filtros-categoria-accesos .filter-cat-btn').each(function () {
                var cat = $(this).data('cat');
                if (cat === 'TODOS') {
                    $(this).show();
                } else {
                    var count = catCounts[cat] || 0;
                    if (count > 0) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                }
            });

            disponibles.forEach(function (mod, idx) {
                var cleanUrl = (mod.url || '').toLowerCase().replace(/^\/+/, '');
                var isSelected = Boolean(_modulosSeleccionadosTemp[cleanUrl]);
                var chkId = 'chk-mod-acc-' + idx;

                var areaColor = 'badge-light';
                if (mod.area === 'Ventas') areaColor = 'badge-success text-white';
                else if (mod.area === 'Producción') areaColor = 'badge-warning text-dark';
                else if (mod.area === 'Compras') areaColor = 'badge-danger text-white';
                else if (mod.area === 'Almacén') areaColor = 'badge-primary text-white';
                else if (mod.area === 'Maestros') areaColor = 'badge-secondary text-white';
                else if (mod.area === 'RRHH') areaColor = 'badge-info text-white';

                var colHtml = `
                    <div class="col-lg-4 col-md-6 col-sm-12 mb-2 acceso-rapido-col" data-cat="${mod.area}" data-search="${mod.title.toLowerCase()} ${cleanUrl} ${(mod.area || '').toLowerCase()}">
                        <div class="card card-body p-2 border acceso-rapido-item-card shadow-xs h-100 ${isSelected ? 'is-selected' : ''}" style="cursor: pointer;">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center text-truncate mr-2">
                                    <span class="mr-2 d-inline-flex align-items-center justify-content-center shadow-xs" style="width: 34px; height: 34px; border-radius: 8px; background-color: rgba(0,0,0,0.04); flex-shrink: 0;">
                                        <i class="${mod.icon} ${mod.color || 'text-primary'}" style="font-size: 1.05rem;"></i>
                                    </span>
                                    <div class="text-truncate">
                                        <div class="font-weight-600 text-truncate text-dark" style="font-size: 0.88rem;">${mod.title}</div>
                                        <small class="badge ${areaColor}" style="font-size: 0.68rem; padding: 2px 6px;">${mod.area}</small>
                                    </div>
                                </div>
                                <div class="custom-control custom-switch custom-switch-sm m-0" style="flex-shrink: 0;">
                                    <input type="checkbox" class="custom-control-input chk-acceso-rapido" id="${chkId}" data-url="${cleanUrl}" ${isSelected ? 'checked' : ''}>
                                    <label class="custom-control-label" for="${chkId}"></label>
                                </div>
                            </div>
                        </div>
                    </div>`;

                $grid.append(colHtml);
            });
        }

        function filtrarModulosEnModal() {
            var searchTerm = ($('#busqueda-modulo-accesos').val() || '').toLowerCase().trim();
            var selectedCat = $('#filtros-categoria-accesos .filter-cat-btn.active').data('cat') || 'TODOS';
            var visibleCount = 0;

            $('.acceso-rapido-col').each(function () {
                var searchData = $(this).data('search') || '';
                var catData = $(this).data('cat') || 'Otros';

                var matchesText = (searchTerm.length === 0) || (searchData.indexOf(searchTerm) >= 0);
                var matchesCat = (selectedCat === 'TODOS') || (catData === selectedCat);

                if (matchesText && matchesCat) {
                    $(this).show();
                    visibleCount++;
                } else {
                    $(this).hide();
                }
            });

            $('#info-modulos-visibles').text('Mostrando ' + visibleCount + ' módulos filtrados');
        }

        function actualizarConteoAccesosModal() {
            var total = Object.keys(_modulosSeleccionadosTemp).length;
            $('#conteo-accesos-seleccionados').text(total);
            var $badge = $('#badge-conteo-accesos');
            if ($badge.length) {
                if (total === 6) {
                    $badge.removeClass('badge-secondary badge-info').addClass('badge-success');
                } else if (total > 0) {
                    $badge.removeClass('badge-secondary badge-success').addClass('badge-info');
                } else {
                    $badge.removeClass('badge-info badge-success').addClass('badge-secondary');
                }
            }
        }

        // -------------------------------------------------------------
        // INICIALIZACIÓN DEL WIDGET DE AGENDA DEL CALENDARIO
        // -------------------------------------------------------------
        var calendarAgendaWidget = null;

        function initAgendaCalendarioWidget() {
            var calendarEl = document.getElementById('calendar-agenda-widget');
            if (!calendarEl) return;

            if (!window.FullCalendar) {
                var scriptFC = document.createElement('script');
                scriptFC.src = '@Url.Content("~/plugins/fullcalendar/index.global.min.js")';
                scriptFC.onload = function () {
                    var scriptEs = document.createElement('script');
                    scriptEs.src = '@Url.Content("~/plugins/fullcalendar/es.global.min.js")';
                    scriptEs.onload = function () {
    initAgendaCalendarioWidget();
                    };
                    document.head.appendChild(scriptEs);
                };
                document.head.appendChild(scriptFC);
                return;
            }

            if (calendarAgendaWidget) {
                calendarAgendaWidget.destroy();
                calendarAgendaWidget = null;
            }

            calendarAgendaWidget = new FullCalendar.Calendar(calendarEl, {
                locale: 'es',
                initialView: 'listWeek',
                headerToolbar: {
                    start: 'prev,next today',
                    center: 'title',
                    end: 'listWeek,listMonth'
                },
                buttonText: {
                    today: 'Hoy',
                    listWeek: 'Semana',
                    listMonth: 'Mes'
                },
                height: 350,
                contentHeight: 330,
                noEventsContent: 'No hay eventos programados para esta área',
                eventTimeFormat: {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                },
                events: function (info, successCallback, failureCallback) {
                    var areaIdVal = $('#select-agenda-area').val();
                    if (!areaIdVal) {
                        areaIdVal = '@areaAgendaInicialId';
                    }

                    $('#agenda-loading-spinner').removeClass('d-none');

                    $.ajax({
                        url: '@Url.Action("ObtenerEventosAgenda", "Home")',
                        type: 'GET',
                        data: { areaId: areaIdVal },
                        success: function (data) {
                            $('#agenda-loading-spinner').addClass('d-none');
                            if (Array.isArray(data)) {
                                successCallback(data);
                            } else {
                                successCallback([]);
                            }
                        },
                        error: function (err) {
                            $('#agenda-loading-spinner').addClass('d-none');
                            console.error('Error al cargar eventos de agenda:', err);
                            failureCallback(err);
                        }
                    });
                },
                eventDidMount: function (info) {
                    var color = info.event.backgroundColor || info.event.borderColor;
                    if (color) {
                        var dotEl = info.el.querySelector('.fc-list-event-dot');
                        if (dotEl) {
                            dotEl.style.borderColor = color;
                            dotEl.style.backgroundColor = color;
                        }
                    }
                    if (info.event.extendedProps && info.event.extendedProps.contexto) {
                        info.el.setAttribute('title', info.event.title + ' - ' + info.event.extendedProps.contexto);
                    }
                },
                eventClick: function (info) {
                    if (window.Swal) {
                        var startStr = info.event.start ? info.event.start.toLocaleString('es-ES', { dateStyle: 'full', timeStyle: 'short' }) : '';
                        var endStr = info.event.end ? info.event.end.toLocaleString('es-ES', { dateStyle: 'full', timeStyle: 'short' }) : '';
                        var horario = info.event.allDay ? 'Todo el día' : (startStr + (endStr ? ' - ' + endStr : ''));
                        var area = (info.event.extendedProps && info.event.extendedProps.areaNombre) ? info.event.extendedProps.areaNombre : 'General';
                        var usuario = (info.event.extendedProps && info.event.extendedProps.usuario) ? info.event.extendedProps.usuario : 'Sistema';
                        var contexto = (info.event.extendedProps && info.event.extendedProps.contexto) ? info.event.extendedProps.contexto : 'Sin notas adicionales';

                        Swal.fire({
                            title: info.event.title,
                            html: '<div class="text-left" style="font-size: 0.88rem; line-height: 1.6;">' +
                                  '<p class="mb-1"><strong><i class="fas fa-layer-group text-primary mr-1"></i> Área:</strong> ' + escapeDashboardHtml(area) + '</p>' +
                                  '<p class="mb-1"><strong><i class="far fa-clock text-info mr-1"></i> Horario:</strong> ' + escapeDashboardHtml(horario) + '</p>' +
                                  '<p class="mb-1"><strong><i class="far fa-user text-secondary mr-1"></i> Creado por:</strong> ' + escapeDashboardHtml(usuario) + '</p>' +
                                  '<hr class="my-2">' +
                                  '<p class="mb-0 text-muted"><strong>Notas:</strong> ' + escapeDashboardHtml(contexto) + '</p>' +
                                  '</div>',
                            icon: 'info',
                            showCancelButton: true,
                            confirmButtonText: '<i class="fas fa-calendar-alt mr-1"></i> Ir al Calendario',
                            cancelButtonText: 'Cerrar',
                            confirmButtonColor: '#0d6efd',
                            cancelButtonColor: '#6c757d'
                        }).then(function (result) {
                            if (result.isConfirmed) {
                                if (window.updateNavbarBreadcrumb) {
                                    window.updateNavbarBreadcrumb(['Inicio', 'Calendario']);
                                }
                                $(document.body).getView({ urlAction: 'calendario/index' });
                            }
                        });
                    }
                }
            });

            calendarAgendaWidget.render();
        }

        // Cambio de área en el select de la agenda
        $(document).on('change', '#select-agenda-area', function () {
            var selectedText = $(this).find('option:selected').text();
            if (selectedText) {
                $('#agenda-area-info-footer').text(selectedText);
            }
            if (calendarAgendaWidget) {
                calendarAgendaWidget.refetchEvents();
            }
        });

        // Botón de recarga manual de la agenda
        $(document).on('click', '#btn-recargar-agenda', function () {
            var $icon = $(this).find('i');
            $icon.addClass('fa-spin');
            if (calendarAgendaWidget) {
                calendarAgendaWidget.refetchEvents();
            }
            setTimeout(function () {
                $icon.removeClass('fa-spin');
            }, 600);
        });

        // Ajustar tamaño de FullCalendar cuando el dashboard se redimensiona o el modal se cierra
        $('#modal-gestionar-dashboard, #modal-gestionar-dashboard-rol').on('hidden.bs.modal', function () {
            if (calendarAgendaWidget) {
                setTimeout(function () {
                    calendarAgendaWidget.updateSize();
                }, 200);
            }
        });

        initGestionAccesosRapidos();
        initAgendaCalendarioWidget();

        sincronizarDashboard();

        var dashboardInterval = setInterval(function () {
            if ($('#kpi-ventas').length > 0) {
                sincronizarDashboard();
            } else {
                clearInterval(dashboardInterval);
            }
        }, 30000);
    });
</script>
