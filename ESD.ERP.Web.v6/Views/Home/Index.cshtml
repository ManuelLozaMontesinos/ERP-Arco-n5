                return;
            }
            var maxItems = limit || currentClientesInactivosLimit || 5;
            var subLista = lista.slice(0, maxItems);
            var html = '';
            for (var i = 0; i < subLista.length; i++) {
                var c = subLista[i];
                var cliente = c.cliente || c.Cliente || 'Sin Nombre';
                var vendedor = c.vendedor || c.Vendedor || 'Sin vendedor';
                var fStr = c.fechaFormateada || c.FechaFormateada || '';
                var encodedCliente = encodeURIComponent(cliente);

                html += '<tr class="dashboard-drilldown-row" role="link" tabindex="0" data-cliente-nombre="' + encodedCliente + '">' +
                    '<td class="py-2"><span class="font-weight-600">' + escapeDashboardHtml(cliente) + '</span></td>';

                if (esAdminTable) {
                    html += '<td class="py-2 text-truncate" style="max-width: 150px;"><span class="text-muted"><i class="fas fa-user-tie text-secondary mr-1"></i>' + escapeDashboardHtml(vendedor) + '</span></td>';
                }

                html += '<td class="text-right py-2" style="white-space: nowrap;">' +
                        '<span class="badge badge-warning text-dark font-weight-bold px-2 py-1">' +
                            '<i class="far fa-calendar-alt mr-1"></i>' + escapeDashboardHtml(fStr) +
                        '</span>' +
                    '</td>' +
                '</tr>';
