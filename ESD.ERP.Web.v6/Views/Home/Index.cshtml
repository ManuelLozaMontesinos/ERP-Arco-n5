                <!-- 2. CONTROL: DIFERENCIA (Central vs. Ilo) -->
                <div class="card card-primary card-outline shadow-sm mb-4" id="area-diferencia-sedes">
                    <div class="card-header border-0 d-flex justify-content-between align-items-center py-2 pl-3 pr-2">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-chart-bar text-primary mr-2"></i>Diferencia
                        </h3>
                        <div class="card-tools d-inline-flex align-items-center ml-auto m-0">
                            <div class="btn-group btn-group-sm mr-2" role="group" aria-label="Filtro de d&iacute;as">
                                <button type="button" class="btn btn-primary active btn-sm px-2" id="btn-dias-6" onclick="setDiferenciaDias(6);">6d</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2" id="btn-dias-8" onclick="setDiferenciaDias(8);">8d</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2" id="btn-dias-10" onclick="setDiferenciaDias(10);">10d</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2" id="btn-dias-12" onclick="setDiferenciaDias(12);">12d</button>
                            </div>
