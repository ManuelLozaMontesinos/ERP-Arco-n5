                                        <small class="text-muted">Tabla con los pedidos de mayor valor de hoy</small>
                                    </div>
                                </div>
                                <div class="custom-control custom-switch custom-switch-lg m-0">
                                    <input type="checkbox" class="custom-control-input chk-dashboard-rol-area" id="chk-rol-area-top-pedidos" data-area="top-pedidos" checked>
                                    <label class="custom-control-label" for="chk-rol-area-top-pedidos"></label>
                                </div>
                            </label>
                        </div>

                        <!-- 9. Clientes Inactivos -->
                        <div class="col-md-6 mb-3">
                            <label class="dashboard-area-card d-flex align-items-center justify-content-between p-3 m-0 rounded bg-white border shadow-sm" for="chk-rol-area-clientes-inactivos" style="cursor: pointer; transition: all 0.2s ease;">
                                <div class="d-flex align-items-center mr-3">
                                    <div class="area-icon-box mr-3 d-flex align-items-center justify-content-center rounded" style="width: 36px; height: 36px; background-color: rgba(220, 53, 69, 0.1); color: #dc3545;">
                                        <i class="fas fa-user-clock"></i>
                                    </div>
                                    <div>
                                        <span class="d-block font-weight-600 text-dark" style="font-size: 0.95rem;">Clientes sin Compras</span>
                                        <small class="text-muted">Seguimiento de clientes inactivos por meses</small>
                                    </div>
                                </div>
                                <div class="custom-control custom-switch custom-switch-lg m-0">
                                    <input type="checkbox" class="custom-control-input chk-dashboard-rol-area" id="chk-rol-area-clientes-inactivos" data-area="clientes-inactivos" checked>
                                    <label class="custom-control-label" for="chk-rol-area-clientes-inactivos"></label>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2 px-4 border-top d-flex justify-content-between">
                    <small class="text-muted">
                        <i class="fas fa-info-circle mr-1"></i>Los cambios se guardan autom&aacute;ticamente al activar o desactivar cada switch.
                    </small>
                    <button type="button" class="btn btn-primary btn-sm px-4 font-weight-600" data-dismiss="modal">
                        <i class="fas fa-check mr-1"></i> Listo
                    </button>
                </div>
            </div>
        </div>
    </div>

<script type="text/javascript">
    $(document).ready(function () {
        var cid = $('#__cid').val() || '@cid';

        // Formato monetario peruano: S/ 310,879.10 o si pasa al millon S/ 3'456,890.00
        function formatMonedaPeruana(valor) {
            if (valor === null || valor === undefined || isNaN(valor)) return 'S/ 0.00';
            var num = Number(valor);
            var isNeg = num < 0;
            num = Math.abs(num);
            var partes = num.toFixed(2).split('.');
            var entero = partes[0];
            var decimales = partes[1];

            if (entero.length > 6) {
                var millones = entero.slice(0, entero.length - 6);
                var miles = entero.slice(entero.length - 6, entero.length - 3);
                var unidades = entero.slice(entero.length - 3);
                var millonesFmt = millones.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                entero = millonesFmt + "'" + miles + "," + unidades;
            } else if (entero.length > 3) {
                entero = entero.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            }

            return (isNeg ? '-' : '') + 'S/ ' + entero + '.' + decimales;
        }

        function getThemeConfig() {
            var isDark = $('body').hasClass('dark-mode') || $('html').hasClass('dark-mode');
            return {
                isDark: isDark,
                textColor: isDark ? '#cbd5e1' : '#64748b',
                gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.05)',
                barCurrent: isDark ? '#3b82f6' : '#007bff',
                barPrevious: isDark ? '#64748b' : '#ced4da',
                pieColors: isDark ? ['#06b6d4', '#10b981', '#f59e0b', '#f43f5e'] : ['#17a2b8', '#28a745', '#ffc107', '#dc3545']
            };
        }

        var salesChartInstance = null;
        var productionChartInstance = null;
        var stackedBarChartInstance = null;
        var vendedorChartInstance = null;

        var allVendedorLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stackedDiasDefault));
        var allVendedorCantidades = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vendedorCantidadesDefault));
        var allVendedorMontos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vendedorMontosDefault));
        var vendedorDiasActuales = 6;
        var vendedorIdActual = @vendedorIdInicial;

        var allStackedLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stackedDiasDefault));
        var allStackedCentral = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dsCentralDefault));
        var allStackedIlo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dsIloDefault));
        var nivelesDias = [6, 8, 10, 12];
        var diasActuales = 6;

        var allSalesMeses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mesesVentasDefault));
        var allSales2025 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventas2025Default));
        var allSales2026 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventas2026Default));

        // Generar series para la comparativa:
        // - Barra Gris (2025): todos los 12 meses (Nov 2025 a Oct 2025)
        // - Barra Azul (2026): Nov y Dic NO tienen barra azul (0). Solo Ene y Feb 2026 tienen barra azul
        // - Linea Verde: nace en la barra gris de Diciembre 2025 y une con Enero y Febrero 2026
        // - Linea Amarilla: conecta todas las barras grises de 2025
        function generarSeriesVentas(n) {
            var slicedMeses = (allSalesMeses || []).slice(-n);
            var slicedBarra2025 = (allSales2025 || []).slice(-n);
            var slicedBarra2026 = (allSales2026 || []).slice(-n);

            var slicedLinea2026 = [];
            for (var i = 0; i < slicedMeses.length; i++) {
                var m = (slicedMeses[i] || '').toLowerCase();
                if (m.indexOf('dic') >= 0 && (!slicedBarra2026[i] || Number(slicedBarra2026[i]) === 0)) {
                    // Nace de la barra gris de diciembre de 2025
                    slicedLinea2026.push(slicedBarra2025[i] || null);
                } else if (slicedBarra2026[i] && Number(slicedBarra2026[i]) > 0) {
                    slicedLinea2026.push(slicedBarra2026[i]);
                } else {
                    slicedLinea2026.push(null);
                }
            }

            return {
                meses: traducirMeses(slicedMeses),
                linea2026: slicedLinea2026,
                linea2025: slicedBarra2025.slice(),
                barra2026: slicedBarra2026,
                barra2025: slicedBarra2025
            };
        }

        var nivelesMesesVentas = [6, 8, 10, 12];
        var mesesVentasActuales = 12;

        function stepVentasMeses(direccion) {
            var curIdx = nivelesMesesVentas.indexOf(mesesVentasActuales);
            if (curIdx === -1) curIdx = 0;
            var newIdx = curIdx + direccion;
            if (newIdx < 0) newIdx = 0;
            if (newIdx >= nivelesMesesVentas.length) newIdx = nivelesMesesVentas.length - 1;
            if (newIdx !== curIdx) {
                setVentasMeses(nivelesMesesVentas[newIdx]);
            }
        }
        window.stepVentasMeses = stepVentasMeses;

        function setVentasMeses(meses) {
            mesesVentasActuales = meses;
            nivelesMesesVentas.forEach(function (m) {
                var $btn = $('#btn-ventas-' + m);
                if (m === meses) {
                    $btn.removeClass('btn-outline-secondary').addClass('btn-primary active');
                } else {
                    $btn.removeClass('btn-primary active').addClass('btn-outline-secondary');
                }
            });

            var $badge = $('#badge-meses-ventas');
            if ($badge.length) {
                if (meses === 12) {
                    $badge.html('<i class="fas fa-calendar-alt mr-1"></i>12 Meses (\u00DAltimos 12 meses)');
                } else {
                    $badge.html('<i class="fas fa-calendar-alt mr-1"></i>\u00DAltimos ' + meses + ' meses');
                }
            }

            actualizarChartVentasMeses();
        }
        window.setVentasMeses = setVentasMeses;

        function actualizarChartVentasMeses() {
            if (!salesChartInstance) return;

            var series = generarSeriesVentas(mesesVentasActuales || 12);
            salesChartInstance.data.labels = series.meses;
            if (salesChartInstance.data.datasets[0]) salesChartInstance.data.datasets[0].data = series.linea2026;
            if (salesChartInstance.data.datasets[1]) salesChartInstance.data.datasets[1].data = series.linea2025;
            if (salesChartInstance.data.datasets[2]) salesChartInstance.data.datasets[2].data = series.barra2026;
            if (salesChartInstance.data.datasets[3]) salesChartInstance.data.datasets[3].data = series.barra2025;
            salesChartInstance.update();
        }

        var lastStackedCentral = (allStackedCentral || []).slice(-6);
        var lastStackedIlo = (allStackedIlo || []).slice(-6);

        var sedesVisibles = { central: true, ilo: true };

        function stepDiferenciaDias(direccion) {
            var curIdx = nivelesDias.indexOf(diasActuales);
            if (curIdx === -1) curIdx = 0;
            var newIdx = curIdx + direccion;
            if (newIdx < 0) newIdx = 0;
            if (newIdx >= nivelesDias.length) newIdx = nivelesDias.length - 1;
            if (newIdx !== curIdx) {
                setDiferenciaDias(nivelesDias[newIdx]);
            }
        }
        window.stepDiferenciaDias = stepDiferenciaDias;

        function setDiferenciaDias(dias) {
            diasActuales = dias;
            nivelesDias.forEach(function (n) {
                var $btn = $('#btn-dias-' + n);
                if (n === dias) {
                    $btn.removeClass('btn-outline-secondary').addClass('btn-primary active');
                } else {
                    $btn.removeClass('btn-primary active').addClass('btn-outline-secondary');
                }
            });

            actualizarBotonesSedesUI();
            actualizarChartDiferenciaDias();
        }
        window.setDiferenciaDias = setDiferenciaDias;

        function actualizarChartDiferenciaDias() {
            if (!stackedBarChartInstance) return;

            var n = diasActuales || 6;
            var slicedLabels = (allStackedLabels || []).slice(-n);
            var slicedCentral = (allStackedCentral || []).slice(-n);
            var slicedIlo = (allStackedIlo || []).slice(-n);

            lastStackedCentral = slicedCentral;
            lastStackedIlo = slicedIlo;

            var slicedTrend = [];
            for (var i = 0; i < slicedCentral.length; i++) {
                var vC = sedesVisibles.central ? (slicedCentral[i] || 0) : 0;
                var vI = sedesVisibles.ilo ? (slicedIlo[i] || 0) : 0;
                slicedTrend.push(Math.round((vC + vI) * 100) / 100);
            }

            stackedBarChartInstance.data.labels = slicedLabels;
            stackedBarChartInstance.data.datasets.forEach(function (ds) {
                if (ds.type === 'line' || (ds.label && ds.label.indexOf('Pico') >= 0)) {
                    ds.data = slicedTrend;
                } else if (ds.label === 'Central' || (ds.label && ds.label.indexOf('Central') >= 0)) {
                    ds.data = slicedCentral;
                    ds.hidden = !sedesVisibles.central;
                } else if (ds.label === 'Ilo' || (ds.label && ds.label.indexOf('Ilo') >= 0)) {
                    ds.data = slicedIlo;
                    ds.hidden = !sedesVisibles.ilo;
                }
            });

            stackedBarChartInstance.update();
        }

        function actualizarBotonesSedesUI() {
            var $btnCentral = $('#btn-filtro-central');
            var $btnIlo = $('#btn-filtro-ilo');
            var $btnVs = $('#btn-filtro-vs');

            if (sedesVisibles.central && sedesVisibles.ilo) {
                $btnCentral.removeClass('inactive').addClass('active').attr('title', 'Ver solo Sede Central');
                $btnIlo.removeClass('inactive').addClass('active').attr('title', 'Ver solo Sede Ilo');
                $btnVs.removeClass('inactive').addClass('active').attr('title', 'Ambas sedes activas (VS)');
            } else if (sedesVisibles.central && !sedesVisibles.ilo) {
                $btnCentral.removeClass('inactive').addClass('active').attr('title', 'Sede Central activa');
                $btnIlo.removeClass('active').addClass('inactive').attr('title', 'Cambiar a Sede Ilo');
                $btnVs.removeClass('active').addClass('inactive').attr('title', 'Clic para comparar ambas sedes (VS)');
            } else {
                $btnCentral.removeClass('active').addClass('inactive').attr('title', 'Cambiar a Sede Central');
                $btnIlo.removeClass('inactive').addClass('active').attr('title', 'Sede Ilo activa');
                $btnVs.removeClass('active').addClass('inactive').attr('title', 'Clic para comparar ambas sedes (VS)');
            }
        }

        function aplicarFiltroSedes() {
            actualizarChartDiferenciaDias();
            actualizarBotonesSedesUI();
        }

        function alternarSede(sede, event) {
            var isCtrl = event && (event.ctrlKey || event.metaKey || event.shiftKey);
            if (isCtrl) {
                if (sede === 'central') {
                    sedesVisibles.central = !sedesVisibles.central;
                    if (!sedesVisibles.central && !sedesVisibles.ilo) sedesVisibles.ilo = true;
                } else {
                    sedesVisibles.ilo = !sedesVisibles.ilo;
                    if (!sedesVisibles.central && !sedesVisibles.ilo) sedesVisibles.central = true;
                }
            } else {
                if (sede === 'central') {
                    if (sedesVisibles.central && sedesVisibles.ilo) {
                        sedesVisibles.central = true;
                        sedesVisibles.ilo = false;
                    } else if (sedesVisibles.central && !sedesVisibles.ilo) {
                        sedesVisibles.central = true;
                        sedesVisibles.ilo = true;
                    } else {
                        sedesVisibles.central = true;
                        sedesVisibles.ilo = false;
                    }
                } else {
                    if (sedesVisibles.central && sedesVisibles.ilo) {
                        sedesVisibles.central = false;
                        sedesVisibles.ilo = true;
                    } else if (!sedesVisibles.central && sedesVisibles.ilo) {
                        sedesVisibles.central = true;
                        sedesVisibles.ilo = true;
                    } else {
                        sedesVisibles.central = false;
                        sedesVisibles.ilo = true;
                    }
                }
            }
            aplicarFiltroSedes();
        }

        $(document).off('click', '#btn-filtro-central').on('click', '#btn-filtro-central', function (e) {
            e.preventDefault();
            alternarSede('central', e);
        });

        $(document).off('click', '#btn-filtro-ilo').on('click', '#btn-filtro-ilo', function (e) {
            e.preventDefault();
            alternarSede('ilo', e);
        });

        $(document).off('click', '#btn-filtro-vs').on('click', '#btn-filtro-vs', function (e) {
            e.preventDefault();
            sedesVisibles.central = true;
            sedesVisibles.ilo = true;
            aplicarFiltroSedes();
        });

        var defaultDashboardData = {
            success: true,
            kpis: {
                facturacionMes: "@Html.Raw(facturacionMes)",
                pedidosActivos: "@Html.Raw(pedidosActivos)",
                cotizacionesActivas: "@Html.Raw(cotizacionesActivas)",
                ordenesProduccionMes: "@Html.Raw(ordenesProduccionMes)",
                ordenesCompraMes: "@Html.Raw(ordenesCompraMes)"
            },
            graficoVentas: {
                meses: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mesesVentasDefault)),
                ventas2025: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventas2025Default)),
                ventas2026: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventas2026Default))
            },
            graficoProduccion: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(prodLabelsDefault)),
                valores: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(prodValoresDefault))
            },
            graficoStackedBar: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stackedDiasDefault)),
                datasets: [
                    {
                        label: 'Ilo',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dsIloDefault))
                    },
                    {
                        label: 'Central',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dsCentralDefault))
                    }
                ]
            }
        };

        var lastDashboardData = defaultDashboardData;

        function traducirMeses(labels) {
            if (!labels || !labels.length) return ["Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre"];
            var mapa = {
                'May': 'Mayo',
                'Jun': 'Junio',
                'Jul': 'Julio',
                'Ago': 'Agosto',
                'Set': 'Septiembre',
                'Sep': 'Septiembre',
                'Sept': 'Septiembre',
                'Oct': 'Octubre',
                'Nov': 'Noviembre',
                'Dic': 'Diciembre',
                'Ene': 'Enero',
                'Feb': 'Febrero',
                'Mar': 'Marzo',
                'Abr': 'Abril'
            };
            return labels.map(function(m) { return mapa[m] || m; });
        }

        var alignLinesWithBarsPlugin = {
            id: 'alignLinesWithBars',
            beforeDraw: function (chart) {
                var meta0 = chart.getDatasetMeta(0);
                var meta1 = chart.getDatasetMeta(1);
                var meta2 = chart.getDatasetMeta(2);
                var meta3 = chart.getDatasetMeta(3);

                if (meta0 && meta0.data) {
                    meta0.data.forEach(function (pt, i) {
                        var valAzul = chart.data.datasets[2] && chart.data.datasets[2].data ? chart.data.datasets[2].data[i] : 0;
                        if ((!valAzul || valAzul === 0) && meta3 && meta3.data && meta3.data[i]) {
                            // En Diciembre de 2025 nace exactamente en la barra gris
                            pt.x = meta3.data[i].x;
                        } else if (meta2 && meta2.data && meta2.data[i]) {
                            pt.x = meta2.data[i].x;
                        }
                    });
                }
                if (meta1 && meta3 && meta1.data && meta3.data) {
                    meta1.data.forEach(function (pt, i) {
                        if (meta3.data[i]) pt.x = meta3.data[i].x;
                    });
                }
            },
            beforeDatasetDraw: function (chart, args) {
                var meta = chart.getDatasetMeta(args.index);
                var meta2 = chart.getDatasetMeta(2);
                var meta3 = chart.getDatasetMeta(3);
                if (args.index === 0 && meta && meta.data) {
                    meta.data.forEach(function (pt, i) {
                        var valAzul = chart.data.datasets[2] && chart.data.datasets[2].data ? chart.data.datasets[2].data[i] : 0;
                        if ((!valAzul || valAzul === 0) && meta3 && meta3.data && meta3.data[i]) {
                            pt.x = meta3.data[i].x;
                        } else if (meta2 && meta2.data && meta2.data[i]) {
                            pt.x = meta2.data[i].x;
                        }
                    });
                } else if (args.index === 1 && meta && meta.data && meta3 && meta3.data) {
                    meta.data.forEach(function (pt, i) {
                        if (meta3.data[i]) pt.x = meta3.data[i].x;
                    });
                }
            }
        };

        function renderSalesChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('salesChart');
            if (!canvas) return;

            if (salesChartInstance) {
                salesChartInstance.destroy();
                salesChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            if (data && data.meses && data.meses.length) allSalesMeses = data.meses;
            if (data && data.ventas2025 && data.ventas2025.length) allSales2025 = data.ventas2025;
            if (data && data.ventas2026 && data.ventas2026.length) allSales2026 = data.ventas2026;

            var series = generarSeriesVentas(mesesVentasActuales || 12);

            salesChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: series.meses,
                    datasets: [
                        {
                            type: 'line',
                            label: 'L\u00EDnea Actual',
                            order: 0,
                            data: series.linea2026,
                            borderColor: '#28a745',
                            backgroundColor: 'rgba(40, 167, 69, 0.08)',
                            borderWidth: 3,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: function(context) {
                                var chart = context.chart;
                                var labels = (chart && chart.data && chart.data.labels) ? chart.data.labels : [];
                                var m = (labels[context.dataIndex] || '').toLowerCase();
                                if (m.indexOf('dic') >= 0) return '#fd7e14';
                                return '#28a745';
                            },
                            pointBorderColor: function(context) {
                                var chart = context.chart;
                                var labels = (chart && chart.data && chart.data.labels) ? chart.data.labels : [];
                                var m = (labels[context.dataIndex] || '').toLowerCase();
                                if (m.indexOf('dic') >= 0) return '#fd7e14';
                                return '#28a745';
                            },
                            segment: {
                                borderColor: function(ctx) {
                                    var chart = ctx.chart;
                                    var labels = (chart && chart.data && chart.data.labels) ? chart.data.labels : [];
                                    var m0 = (labels[ctx.p0DataIndex] || '').toLowerCase();
                                    var m1 = (labels[ctx.p1DataIndex] || '').toLowerCase();
                                    if (m0.indexOf('dic') >= 0 && m1.indexOf('ene') >= 0) {
                                        return '#fd7e14'; // Puente Diciembre 2025 -> Enero 2026 en naranja
                                    }
                                    return '#28a745';
                                }
                            },
                            tension: 0.25,
                            fill: false,
                            spanGaps: false
                        },
                        {
                            type: 'line',
                            label: 'L\u00EDnea Anterior (2025)',
                            order: 1,
                            data: series.linea2025,
                            borderColor: '#ffc107',
                            backgroundColor: 'rgba(255, 193, 7, 0.08)',
                            borderWidth: 3,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#ffc107',
                            pointBorderColor: '#ffc107',
                            segment: {
                                borderColor: function(ctx) {
                                    var chart = ctx.chart;
                                    var labels = (chart && chart.data && chart.data.labels) ? chart.data.labels : [];
                                    var m0 = (labels[ctx.p0DataIndex] || '').toLowerCase();
                                    var m1 = (labels[ctx.p1DataIndex] || '').toLowerCase();
                                    if (m0.indexOf('dic') >= 0 && m1.indexOf('ene') >= 0) {
                                        return 'transparent'; // Quita la union Diciembre 2025 a Enero 2025
                                    }
                                    return '#ffc107';
                                }
                            },
                            tension: 0.25,
                            fill: false
                        },
                        {
                            type: 'bar',
                            label: 'Barra Actual (2026)',
                            order: 2,
                            backgroundColor: theme.barCurrent,
                            borderColor: theme.barCurrent,
                            data: series.barra2026,
                            borderRadius: 4
                        },
                        {
                            type: 'bar',
                            label: 'Barra Anterior (2025)',
                            order: 3,
                            backgroundColor: theme.barPrevious,
                            borderColor: theme.barPrevious,
                            data: series.barra2025,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            filter: function(tooltipItem) {
                                if (tooltipItem.parsed.y === null || tooltipItem.parsed.y === undefined || isNaN(tooltipItem.parsed.y)) return false;
                                if (tooltipItem.datasetIndex === 0) {
                                    var lbl = (tooltipItem.label || '').toLowerCase();
                                    if (lbl.indexOf('dic') >= 0 || lbl.indexOf('nov') >= 0) return false;
                                }
                                return tooltipItem.datasetIndex === 0 || tooltipItem.datasetIndex === 1;
                            },
                            callbacks: {
                                label: function(context) {
                                    if (context.parsed.y === null || context.parsed.y === undefined) return '';
                                    var anio = (context.datasetIndex === 0 || context.datasetIndex === 2) ? 'A\u00F1o Actual (2026)' : 'A\u00F1o 2025';
                                    var montoEnSoles = (Number(context.parsed.y) || 0) * 1000;
                                    return anio + ': ' + formatMonedaPeruana(montoEnSoles);
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: theme.textColor },
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: theme.textColor,
                                callback: function(value) { return 'S/ ' + value + 'k'; }
                            },
                            grid: { color: theme.gridColor }
                        }
                    }
                },
                plugins: [alignLinesWithBarsPlugin]
            });
        }

        function renderProductionChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('productionChart');
            if (!canvas) return;

            if (productionChartInstance) {
                productionChartInstance.destroy();
                productionChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            var rawData = data.valores || [];
            var total = 0;
            for (var i = 0; i < rawData.length; i++) {
                total += (Number(rawData[i]) || 0);
            }

            var $empty = $('#productionChartEmpty');
            if (total === 0) {
                if ($empty.length) $empty.removeClass('d-none');
            } else {
                if ($empty.length) $empty.addClass('d-none');
            }

            productionChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: data.labels,
                    datasets: [{
                        data: rawData,
                        backgroundColor: theme.pieColors,
                        borderWidth: theme.isDark ? 2 : 1,
                        borderColor: theme.isDark ? '#343a40' : '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: theme.textColor,
                                boxWidth: 14,
                                padding: 12,
                                generateLabels: function (chart) {
                                    var ds = chart.data.datasets[0];
                                    return (chart.data.labels || []).map(function (label, idx) {
                                        var val = (ds && ds.data) ? (ds.data[idx] || 0) : 0;
                                        var fill = (ds && ds.backgroundColor && ds.backgroundColor[idx]) ? ds.backgroundColor[idx] : '#999';
                                        return {
                                            text: label + ' (' + val + ')',
                                            fillStyle: fill,
                                            strokeStyle: theme.isDark ? '#343a40' : '#ffffff',
                                            lineWidth: 1,
                                            hidden: false,
                                            index: idx
                                        };
                                    });
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    var label = context.label || '';
                                    var val = Number(context.raw) || 0;
                                    var pct = total > 0 ? Math.round((val / total) * 100) : 0;
                                    return ' ' + label + ': ' + val + ' orden' + (val === 1 ? '' : 'es') + ' (' + pct + '%)';
                                }
                            }
                        }
                    },
                    cutout: '62%'
                }
            });
        }

        function renderStackedBarChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('stackedBarChart');
            if (!canvas) return;

            if (stackedBarChartInstance) {
                stackedBarChartInstance.destroy();
                stackedBarChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            if (data && data.labels && data.labels.length) allStackedLabels = data.labels;
            if (data && data.datasets && data.datasets.length >= 2) {
                data.datasets.forEach(function (ds) {
                    if (ds.label === 'Central' || (ds.label && ds.label.indexOf('Central') >= 0)) {
                        allStackedCentral = ds.data;
                    } else if (ds.label === 'Ilo' || (ds.label && ds.label.indexOf('Ilo') >= 0)) {
                        allStackedIlo = ds.data;
                    }
                });
            }

            var n = diasActuales || 6;
            var slicedLabels = (allStackedLabels || []).slice(-n);
            var slicedCentral = (allStackedCentral || []).slice(-n);
            var slicedIlo = (allStackedIlo || []).slice(-n);

            var trendData = [];
            for (var i = 0; i < slicedCentral.length; i++) {
                var vC = sedesVisibles.central ? (slicedCentral[i] || 0) : 0;
                var vI = sedesVisibles.ilo ? (slicedIlo[i] || 0) : 0;
                trendData.push(Math.round((vC + vI) * 100) / 100);
            }

            stackedBarChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: slicedLabels,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Pico / Tendencia',
                            data: trendData,
                            borderColor: '#28a745',
                            backgroundColor: 'rgba(40, 167, 69, 0.1)',
                            borderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#28a745',
                            fill: false,
                            tension: 0.25,
                            order: 0
                        },
                        {
                            type: 'bar',
                            label: 'Ilo',
                            backgroundColor: theme.barPrevious,
                            borderColor: theme.barPrevious,
                            borderRadius: 4,
                            data: slicedIlo,
                            hidden: !sedesVisibles.ilo,
                            order: 1
                        },
                        {
                            type: 'bar',
                            label: 'Central',
                            backgroundColor: theme.barCurrent,
                            borderColor: theme.barCurrent,
                            borderRadius: 4,
                            data: slicedCentral,
                            hidden: !sedesVisibles.central,
                            order: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            itemSort: function (a, b) {
                                if (a.dataset.type === 'line') return -1;
                                if (b.dataset.type === 'line') return 1;
                                return (b.raw || 0) - (a.raw || 0);
                            },
                            callbacks: {
                                label: function(context) {
                                    var fmt = formatMonedaPeruana(context.parsed.y);
                                    if (context.dataset.type === 'line') {
                                        return 'Pico M\u00E1ximo: ' + fmt;
                                    }
                                    return context.dataset.label + ': ' + fmt;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: true,
                            ticks: { color: theme.textColor },
                            grid: { display: false }
                        },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            ticks: {
                                color: theme.textColor,
                                callback: function(value) {
                                    if (value >= 1000) {
                                        return 'S/ ' + (value / 1000).toLocaleString() + 'k';
                                    }
                                    return 'S/ ' + Number(value).toLocaleString();
                                }
                            },
                            grid: { color: theme.gridColor }
                        }
                    }
                }
            });
            actualizarBotonesSedesUI();
        }

        function initChartsImmediately() {
            if (typeof Chart !== 'undefined') {
                renderSalesChart(lastDashboardData.graficoVentas);
                renderProductionChart(lastDashboardData.graficoProduccion);
                renderStackedBarChart(lastDashboardData.graficoStackedBar);
                var nVend = vendedorDiasActuales || 6;
                renderVendedorChart(
                    (allVendedorLabels || []).slice(-nVend),
                    (allVendedorCantidades || []).slice(-nVend),
                    (allVendedorMontos || []).slice(-nVend)
                );
            } else {
                setTimeout(initChartsImmediately, 80);
            }
        }
        initChartsImmediately();

        // ========================================================
        // GRAFICO: PEDIDOS POR VENDEDOR (Dia a Dia)
        // ========================================================
        function renderVendedorChart(labels, cantidades, montos, totalPedidos, totalMonto) {
            var theme = getThemeConfig();
            var canvas = document.getElementById('vendedorBarChart');
            if (!canvas) return;

            if (vendedorChartInstance) {
                vendedorChartInstance.destroy();
                vendedorChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            labels = labels || [];
            cantidades = cantidades || [];
            montos = montos || [];

            if (totalPedidos === undefined || totalPedidos === null) {
                totalPedidos = cantidades.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
            }
            if (!totalMonto) {
                var sumMto = montos.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
                totalMonto = formatMonedaPeruana(sumMto);
            }

            $('#vendedor-total-pedidos').text(totalPedidos + ' pedido' + (totalPedidos === 1 ? '' : 's') + ' en el periodo');
            $('#vendedor-total-monto').text('Total: ' + totalMonto);

            vendedorChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Tendencia Pedidos',
                            data: cantidades,
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.12)',
                            borderWidth: 2.5,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#10b981',
                            pointBorderColor: '#ffffff',
                            fill: false,
                            tension: 0.25,
                            order: 0
                        },
                        {
                            type: 'bar',
                            label: 'Cantidad de Pedidos',
                            backgroundColor: theme.barCurrent,
                            borderColor: theme.barCurrent,
                            borderRadius: 4,
                            data: cantidades,
                            order: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            backgroundColor: theme.isDark ? '#0f172a' : '#1e293b',
                            titleColor: '#ffffff',
                            bodyColor: '#e2e8f0',
                            borderColor: theme.isDark ? '#334155' : '#475569',
                            borderWidth: 1,
                            padding: 10,
                            callbacks: {
                                label: function(context) {
                                    if (context.dataset.type === 'line') {
                                        return 'Pico / Tendencia: ' + context.parsed.y + ' pedidos';
                                    }
                                    var nVend = vendedorDiasActuales || 6;
                                    var currentMontos = (allVendedorMontos || []).slice(-nVend);
                                    var idx = context.dataIndex;
                                    var mto = (currentMontos && currentMontos.length > idx) ? currentMontos[idx] : 0;
                                    return [
                                        'Pedidos: ' + context.parsed.y,
                                        'Monto Total: ' + formatMonedaPeruana(mto)
                                    ];
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: theme.textColor },
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                color: theme.textColor,
                                callback: function(value) {
                                    return value + ' ped.';
                                }
                            },
                            grid: { color: theme.gridColor }
                        }
                    }
                }
            });
        }

        var nivelesVendedorDias = [6, 8, 10, 12];

        function stepVendedorDias(direccion) {
            var curIdx = nivelesVendedorDias.indexOf(vendedorDiasActuales);
            if (curIdx === -1) curIdx = 0;
            var newIdx = curIdx + direccion;
            if (newIdx < 0) newIdx = 0;
            if (newIdx >= nivelesVendedorDias.length) newIdx = nivelesVendedorDias.length - 1;
            if (newIdx !== curIdx) {
                setVendedorDias(nivelesVendedorDias[newIdx]);
            }
        }
        window.stepVendedorDias = stepVendedorDias;

        function setVendedorDias(dias) {
            vendedorDiasActuales = dias;
            [6, 8, 10, 12].forEach(function(n) {
                var $btn = $('#btn-vendedor-dias-' + n);
                if (n === dias) {
                    $btn.removeClass('btn-outline-secondary').addClass('btn-primary active');
                } else {
                    $btn.removeClass('btn-primary active').addClass('btn-outline-secondary');
                }
            });

            actualizarChartVendedorDias();
        }
        window.setVendedorDias = setVendedorDias;

        function actualizarChartVendedorDias() {
            if (!vendedorChartInstance) {
                var nVend = vendedorDiasActuales || 6;
                renderVendedorChart(
                    (allVendedorLabels || []).slice(-nVend),
                    (allVendedorCantidades || []).slice(-nVend),
                    (allVendedorMontos || []).slice(-nVend)
                );
                return;
            }

            var n = vendedorDiasActuales || 6;
            var slicedLabels = (allVendedorLabels || []).slice(-n);
            var slicedCantidades = (allVendedorCantidades || []).slice(-n);
            var slicedMontos = (allVendedorMontos || []).slice(-n);

            var totalPedidos = slicedCantidades.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
            var sumMto = slicedMontos.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);

            $('#vendedor-total-pedidos').text(totalPedidos + ' pedido' + (totalPedidos === 1 ? '' : 's') + ' en el periodo');
            $('#vendedor-total-monto').text('Total: ' + formatMonedaPeruana(sumMto));

            vendedorChartInstance.data.labels = slicedLabels;
            if (vendedorChartInstance.data.datasets[0]) {
                vendedorChartInstance.data.datasets[0].data = slicedCantidades;
            }
            if (vendedorChartInstance.data.datasets[1]) {
                vendedorChartInstance.data.datasets[1].data = slicedCantidades;
            }
            vendedorChartInstance.update();
        }

        var currentVendedorAjax = null;
        function cargarDatosVendedor(vendedorId) {
            vendedorIdActual = vendedorId;
            if (currentVendedorAjax && currentVendedorAjax.readyState !== 4) {
                currentVendedorAjax.abort();
            }
            currentVendedorAjax = $.ajax({
                url: '/Home/ObtenerPedidosVendedor',
                type: 'GET',
                data: { vendedorId: vendedorId, dias: 12, cid: cid },
                headers: { 'x-app-cid': cid },
                success: function(res) {
                    if (res && res.success) {
                        allVendedorLabels = res.labels;
                        allVendedorCantidades = res.cantidades;
                        allVendedorMontos = res.montos;
                        actualizarChartVendedorDias();
                    }
                },
                error: function(err) {
                    if (err.statusText !== 'abort') {
                        console.warn('Error obteniendo pedidos del vendedor:', err);
                    }
                }
            });
        }

        $(document).on('change', '#select-vendedor-chart', function() {
            var vid = parseInt($(this).val(), 10);
            if (vid > 0) {
                cargarDatosVendedor(vid);
            }
        });

        // ========================================================
        // GESTION DEL DASHBOARD (Areas Visibles y Filtro por Rol)
        // ========================================================
        var currentUsername = '@usuarioLogonActual';
        var currentRoleCode = '@rolActualCodigo';
        var esUsuarioAdmin = @(esAdmin ? "true" : "false");
        var STORAGE_ROLES_KEY = 'arco_dashboard_roles_config_v1';

        // Clave de almacenamiento aislada por usuario y por rol para evitar que un perfil sobreescriba a otro
        function getStorageAreasKey() {
            var u = (currentUsername || 'default_user').toLowerCase().trim();
            var r = (currentRoleCode || 'default_role').toLowerCase().trim();
            return 'arco_dashboard_user_' + u + '_rol_' + r + '_v2';
        }

        // Limpieza de clave global obsoleta para no heredar configuraciones contaminadas
        try {
            localStorage.removeItem('arco_dashboard_areas_visibles_v1');
        } catch (e) { }

        // Configuracion de las 9 areas del dashboard
        var areasDashboardConfig = {
            'kpis': { selector: '#row-kpis-metricas', visible: true },
            'evolucion-ventas': { selector: '#area-evolucion-ventas', visible: true },
            'diferencia-sedes': { selector: '#area-diferencia-sedes', visible: true },
            'pedidos-vendedor': { selector: '#area-pedidos-vendedor', visible: true },
            'accesos-rapidos': { selector: '#area-accesos-rapidos', visible: true },
            'estado-produccion': { selector: '#area-estado-produccion', visible: true },
            'db-tiempo-real': { selector: '#area-db-tiempo-real', visible: true },
            'top-pedidos': { selector: '#area-top-pedidos', visible: true },
            'clientes-inactivos': { selector: '#area-clientes-inactivos', visible: true }
        };

        // Presets predefinidos por Rol en ERP ARCO
        var defaultRolePresets = {
            // Administradores y TI: Acceso total a las 9 areas
            'S0001': { 'kpis': true, 'evolucion-ventas': true, 'diferencia-sedes': true, 'pedidos-vendedor': true, 'accesos-rapidos': true, 'estado-produccion': true, 'db-tiempo-real': true, 'top-pedidos': true, 'clientes-inactivos': true },
            'S0002': { 'kpis': true, 'evolucion-ventas': true, 'diferencia-sedes': true, 'pedidos-vendedor': true, 'accesos-rapidos': true, 'estado-produccion': true, 'db-tiempo-real': true, 'top-pedidos': true, 'clientes-inactivos': true },
            '00020': { 'kpis': true, 'evolucion-ventas': true, 'diferencia-sedes': true, 'pedidos-vendedor': true, 'accesos-rapidos': true, 'estado-produccion': true, 'db-tiempo-real': true, 'top-pedidos': true, 'clientes-inactivos': true },
            // Ventas Jefatura: Foco comercial, ventas, pedidos por vendedor y clientes
            '00003': { 'kpis': true, 'evolucion-ventas': true, 'diferencia-sedes': true, 'pedidos-vendedor': true, 'accesos-rapidos': true, 'estado-produccion': false, 'db-tiempo-real': false, 'top-pedidos': true, 'clientes-inactivos': true },
            // Ventas Operador
            '00004': { 'kpis': true, 'evolucion-ventas': true, 'diferencia-sedes': true, 'pedidos-vendedor': true, 'accesos-rapidos': true, 'estado-produccion': false, 'db-tiempo-real': false, 'top-pedidos': true, 'clientes-inactivos': false },
            // Produccion Operador / Jefatura
            '00009': { 'kpis': true, 'evolucion-ventas': false, 'diferencia-sedes': false, 'pedidos-vendedor': false, 'accesos-rapidos': true, 'estado-produccion': true, 'db-tiempo-real': false, 'top-pedidos': false, 'clientes-inactivos': false },
            '00010': { 'kpis': true, 'evolucion-ventas': false, 'diferencia-sedes': false, 'pedidos-vendedor': false, 'accesos-rapidos': true, 'estado-produccion': true, 'db-tiempo-real': false, 'top-pedidos': true, 'clientes-inactivos': false },
            // Compras y Logistica
            '00005': { 'kpis': true, 'evolucion-ventas': false, 'diferencia-sedes': false, 'pedidos-vendedor': false, 'accesos-rapidos': true, 'estado-produccion': false, 'db-tiempo-real': false, 'top-pedidos': false, 'clientes-inactivos': false },
            // Por defecto
            'DEFAULT': { 'kpis': true, 'evolucion-ventas': true, 'diferencia-sedes': true, 'pedidos-vendedor': true, 'accesos-rapidos': true, 'estado-produccion': true, 'db-tiempo-real': true, 'top-pedidos': true, 'clientes-inactivos': true }
        };

        function obtenerConfigRolesGuardada() {
            try {
                var raw = localStorage.getItem(STORAGE_ROLES_KEY);
                if (raw) return JSON.parse(raw);
            } catch (e) {
                console.warn('Error leyendo roles config:', e);
            }
            return {};
        }

        function guardarConfigRolesCompleta(rolesObj) {
            try {
                localStorage.setItem(STORAGE_ROLES_KEY, JSON.stringify(rolesObj));
            } catch (e) {
                console.warn('Error guardando roles config:', e);
            }
        }

        function obtenerConfiguracionParaRol(rolCod) {
            var rolesObj = obtenerConfigRolesGuardada();
            if (rolesObj[rolCod]) {
                return $.extend({}, defaultRolePresets['DEFAULT'], rolesObj[rolCod]);
            }
            if (defaultRolePresets[rolCod]) {
                return $.extend({}, defaultRolePresets[rolCod]);
            }
            return $.extend({}, defaultRolePresets['DEFAULT']);
        }

        function cargarConfiguracionAreas() {
            try {
                // 1. Obtener los permisos del Rol activo del usuario (o el que este simulando)
                var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);

                // 2. Preferencias personales guardadas estrictamente para este usuario y rol
                var personalRaw = localStorage.getItem(getStorageAreasKey());
                var personal = personalRaw ? JSON.parse(personalRaw) : null;

                for (var key in areasDashboardConfig) {
                    if (areasDashboardConfig.hasOwnProperty(key)) {
                        var permitidoPorRol = (rolPermisos[key] !== undefined) ? Boolean(rolPermisos[key]) : true;

                        if (!permitidoPorRol) {
                            // Si el admin desactivo esta area para este rol, queda forzadamente inactiva
                            areasDashboardConfig[key].visible = false;
                        } else {
                            // Si esta permitida para el rol, respeta la preferencia personalizada del usuario si existe
                            if (personal && personal.hasOwnProperty(key)) {
                                areasDashboardConfig[key].visible = Boolean(personal[key]);
                            } else {
                                // Por defecto, si el rol la autoriza y el usuario no la desactivo, es visible
                                areasDashboardConfig[key].visible = true;
                            }
                        }
                    }
                }
            } catch (e) {
                console.warn('Error leyendo configuracion de areas en localStorage:', e);
            }
        }

        function guardarConfiguracionAreas() {
            try {
                var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);
                var obj = {};
                for (var key in areasDashboardConfig) {
                    var permitidoPorRol = (rolPermisos[key] !== undefined) ? Boolean(rolPermisos[key]) : true;
                    // Solo guardamos preferencia personal para areas que estan autorizadas por el rol
                    if (permitidoPorRol) {
                        obj[key] = areasDashboardConfig[key].visible;
                    }
                }
                localStorage.setItem(getStorageAreasKey(), JSON.stringify(obj));
            } catch (e) {
                console.warn('Error guardando configuracion de areas en localStorage:', e);
            }
        }

        function aplicarVisibilidadAreas() {
            var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);
            var activasCount = 0;
            var permitidasCount = 0;

            for (var key in areasDashboardConfig) {
                var item = areasDashboardConfig[key];
                var $el = $(item.selector);
                var $chk = $('#chk-area-' + key);
                var $card = $chk.closest('.dashboard-area-card');

                var permitidoPorRol = (rolPermisos[key] !== undefined) ? Boolean(rolPermisos[key]) : true;

                if (!permitidoPorRol) {
                    // DESACTIVADO POR ADMIN PARA ESTE ROL:
                    // 1. Ocultar completamente el control en el Dashboard
                    item.visible = false;
                    $el.addClass('d-none');

                    // 2. Ocultar la opcion en el modal del usuario (debe estar invisible, no disponible como opcion a habilitar)
                    if ($card.length) {
                        $card.addClass('d-none');
                    }
                    if ($chk.length) {
                        $chk.prop('checked', false);
                    }
                } else {
                    // HABILITADO POR ADMIN PARA ESTE ROL:
                    permitidasCount++;

                    // 1. Mostrar como opcion disponible en el modal del usuario
                    if ($card.length) {
                        $card.removeClass('d-none');
                    }

                    // 2. Mostrar u ocultar en el Dashboard segun la preferencia del usuario
                    if (item.visible) {
                        activasCount++;
                        $el.removeClass('d-none');
                        if ($chk.length) $chk.prop('checked', true);
                    } else {
                        $el.addClass('d-none');
                        if ($chk.length) $chk.prop('checked', false);
                    }
                }
            }

            $('#modal-conteo-areas-activas').text(activasCount);
            $('#modal-conteo-areas-permitidas').text(permitidasCount);

            if (permitidasCount === 0) {
                $('#modal-areas-ninguna-permitida').removeClass('d-none');
            } else {
                $('#modal-areas-ninguna-permitida').addClass('d-none');
            }

            // Ajuste responsivo de columnas de la seccion principal (Izquierda: Evolucion, Diferencia, Pedidos Vendedor)
            var leftVisible = areasDashboardConfig['evolucion-ventas'].visible || areasDashboardConfig['diferencia-sedes'].visible || areasDashboardConfig['pedidos-vendedor'].visible;
            var rightVisible = areasDashboardConfig['accesos-rapidos'].visible || areasDashboardConfig['estado-produccion'].visible || areasDashboardConfig['db-tiempo-real'].visible;

            var $colLeft = $('#col-main-left');
            var $colRight = $('#col-main-right');
            var $rowMain = $('#row-main-dashboard');

            if (!leftVisible && !rightVisible) {
                $rowMain.addClass('d-none');
            } else {
                $rowMain.removeClass('d-none');
                if (leftVisible && !rightVisible) {
                    $colLeft.removeClass('d-none col-lg-7').addClass('col-lg-12');
                    $colRight.addClass('d-none');
                } else if (!leftVisible && rightVisible) {
                    $colLeft.addClass('d-none');
                    $colRight.removeClass('d-none col-lg-5').addClass('col-lg-12');
                } else {
                    $colLeft.removeClass('d-none col-lg-12').addClass('col-lg-7');
                    $colRight.removeClass('d-none col-lg-12').addClass('col-lg-5');
                }
            }

            // Ajuste responsivo de la seccion de tablas
            var topPedidosVis = areasDashboardConfig['top-pedidos'].visible;
            var clientesVis = areasDashboardConfig['clientes-inactivos'].visible;
            var $areaTop = $('#area-top-pedidos');
            var $areaCli = $('#area-clientes-inactivos');
            var $rowTablas = $('#row-tablas-detalle');

            if (!topPedidosVis && !clientesVis) {
                $rowTablas.addClass('d-none');
            } else {
                $rowTablas.removeClass('d-none');
                if (topPedidosVis && !clientesVis) {
                    $areaTop.removeClass('d-none col-lg-6').addClass('col-lg-12');
                    $areaCli.addClass('d-none');
                } else if (!topPedidosVis && clientesVis) {
                    $areaTop.addClass('d-none');
                    $areaCli.removeClass('d-none col-lg-6').addClass('col-lg-12');
                } else {
                    $areaTop.removeClass('d-none col-lg-12').addClass('col-lg-6');
                    $areaCli.removeClass('d-none col-lg-12').addClass('col-lg-6');
                }
            }

            // Redimensionar graficos Chart.js si cambiaron de tamano o visibilidad
            setTimeout(function () {
                if (salesChartInstance) salesChartInstance.resize();
                if (stackedBarChartInstance) stackedBarChartInstance.resize();
                if (productionChartInstance) productionChartInstance.resize();
                if (vendedorChartInstance) vendedorChartInstance.resize();
            }, 60);
        }

        // Eventos de switches
        $(document).off('change', '.chk-dashboard-area').on('change', '.chk-dashboard-area', function () {
            var areaKey = $(this).data('area');
            var isChecked = $(this).is(':checked');
            var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);
            var permitidoPorRol = (rolPermisos[areaKey] !== undefined) ? Boolean(rolPermisos[areaKey]) : true;

            if (!permitidoPorRol) {
                // Si el rol no lo permite, no se puede activar
                $(this).prop('checked', false);
                if (areasDashboardConfig[areaKey]) {
                    areasDashboardConfig[areaKey].visible = false;
                }
            } else {
                if (areasDashboardConfig.hasOwnProperty(areaKey)) {
                    areasDashboardConfig[areaKey].visible = isChecked;
                }
            }
            guardarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        // Botones auxiliares del modal
        $('#btn-modal-marcar-todos').on('click', function () {
            var rolPermisos = obtenerConfiguracionParaRol(currentRoleCode);
            for (var k in areasDashboardConfig) {
                var permitidoPorRol = (rolPermisos[k] !== undefined) ? Boolean(rolPermisos[k]) : true;
                if (permitidoPorRol) {
                    areasDashboardConfig[k].visible = true;
                }
            }
            guardarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        $('#btn-modal-desmarcar-todos').on('click', function () {
            for (var k in areasDashboardConfig) {
                areasDashboardConfig[k].visible = false;
            }
            guardarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        $('#btn-modal-restablecer').on('click', function () {
            try {
                localStorage.removeItem(getStorageAreasKey());
            } catch (e) { }
            cargarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        // ========================================================
        // LOGICA DEL MODAL: Gestionar Dashboard por Rol (Admin)
        // ========================================================
        function sincronizarModalRolUI(rolCod) {
            var configRol = obtenerConfiguracionParaRol(rolCod);
            var activasCount = 0;

            $('.chk-dashboard-rol-area').each(function () {
                var areaKey = $(this).data('area');
                var isChecked = (configRol[areaKey] !== undefined) ? Boolean(configRol[areaKey]) : true;
                $(this).prop('checked', isChecked);
                if (isChecked) activasCount++;
            });

            $('#modal-rol-conteo-areas-activas').text(activasCount);
        }

        function guardarConfiguracionRolActualEnModal() {
            var rolCod = $('#select-rol-dashboard').val();
            if (!rolCod) return;

            var rolesObj = obtenerConfigRolesGuardada();
            var rolConfig = {};

            $('.chk-dashboard-rol-area').each(function () {
                var areaKey = $(this).data('area');
                rolConfig[areaKey] = $(this).is(':checked');
            });

            rolesObj[rolCod] = rolConfig;
            guardarConfigRolesCompleta(rolesObj);

            // Si el rol modificado es el rol activo o visualizado actualmente, actualizar inmediatamente
            if (rolCod === currentRoleCode) {
                cargarConfiguracionAreas();
                aplicarVisibilidadAreas();
            }
        }

        // Cambio de rol en el select del modal
        $(document).on('change', '#select-rol-dashboard', function () {
            var rolCod = $(this).val();
            sincronizarModalRolUI(rolCod);
        });

        // Boton para ver el Dashboard como el rol seleccionado en el selector
        $(document).on('click', '#btn-aplicar-vista-rol', function () {
            var selectedRol = $('#select-rol-dashboard').val();
            if (selectedRol) {
                currentRoleCode = selectedRol;
                $('#badge-rol-usuario-indicador').remove();
                $('#btn-gestionar-dashboard-rol').after('<span id="badge-rol-usuario-indicador" class="badge badge-info ml-2 font-weight-600 px-2 py-1 shadow-sm"><i class="fas fa-eye mr-1"></i>Vista Rol: ' + selectedRol + '</span>');
                cargarConfiguracionAreas();
                aplicarVisibilidadAreas();
                $('#modal-gestionar-dashboard-rol').modal('hide');
            }
        });

        // Cambio de switches en el modal por rol
        $(document).on('change', '.chk-dashboard-rol-area', function () {
            guardarConfiguracionRolActualEnModal();
            var count = $('.chk-dashboard-rol-area:checked').length;
            $('#modal-rol-conteo-areas-activas').text(count);
        });

        // Acciones rapidas en modal por rol
        $('#btn-modal-rol-marcar-todos').on('click', function () {
            $('.chk-dashboard-rol-area').prop('checked', true);
            guardarConfiguracionRolActualEnModal();
            $('#modal-rol-conteo-areas-activas').text(9);
        });

        $('#btn-modal-rol-desmarcar-todos').on('click', function () {
            $('.chk-dashboard-rol-area').prop('checked', false);
            guardarConfiguracionRolActualEnModal();
            $('#modal-rol-conteo-areas-activas').text(0);
        });

        $('#btn-modal-rol-restablecer').on('click', function () {
            var rolCod = $('#select-rol-dashboard').val();
            var rolesObj = obtenerConfigRolesGuardada();
            delete rolesObj[rolCod];
            guardarConfigRolesCompleta(rolesObj);
            sincronizarModalRolUI(rolCod);
            if (rolCod === currentRoleCode) {
                cargarConfiguracionAreas();
                aplicarVisibilidadAreas();
            }
        });

        // Inicializar UI de modal por rol si existe
        // Sincronizacion dinamica al abrir los modales
        $('#modal-gestionar-dashboard').on('show.bs.modal', function () {
            cargarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        $('#modal-gestionar-dashboard-rol').on('show.bs.modal', function () {
            var rolCod = $('#select-rol-dashboard').val();
            if (!rolCod) {
                rolCod = currentRoleCode;
                $('#select-rol-dashboard').val(rolCod);
            }
            sincronizarModalRolUI(rolCod);
        });

        // Click en badge de rol simulado para restaurar rol original del administrador
        $(document).on('click', '#badge-rol-usuario-indicador', function () {
            currentRoleCode = '@rolActualCodigo';
            $(this).remove();
            cargarConfiguracionAreas();
            aplicarVisibilidadAreas();
        });

        if ($('#select-rol-dashboard').length) {
            sincronizarModalRolUI($('#select-rol-dashboard').val());
        }

        cargarConfiguracionAreas();
        aplicarVisibilidadAreas();

        // Soporte de rueda del raton sobre el grafico de Evolucion de Ventas (6 a 12 meses progresivo)
        var canvasVentas = document.getElementById('salesChart');
        if (canvasVentas && !canvasVentas.__wheelAttached) {
            canvasVentas.__wheelAttached = true;
            canvasVentas.addEventListener('wheel', function (e) {
                e.preventDefault();
                var delta = e.deltaY || e.detail || (-e.wheelDelta);
                if (delta > 0) {
                    stepVentasMeses(-1);
                } else if (delta < 0) {
                    stepVentasMeses(1);
                }
            }, { passive: false });
        }

        // Soporte de rueda del raton sobre el grafico de Diferencia (6 a 12 dias progresivo)
        var lastDiferenciaWheelTime = 0;
        function handleDiferenciaWheel(e) {
            e.preventDefault();
            var now = Date.now();
            if (now - lastDiferenciaWheelTime < 180) return;
            lastDiferenciaWheelTime = now;

            var delta = e.deltaY || e.detail || (-e.wheelDelta);
            if (delta > 0) {
                stepDiferenciaDias(-1);
            } else if (delta < 0) {
                stepDiferenciaDias(1);
            }
        }

        var canvasDiferencia = document.getElementById('stackedBarChart');
        var containerDiferencia = document.getElementById('diferencia-chart-container') || (canvasDiferencia ? canvasDiferencia.parentElement : null);
        if (canvasDiferencia && !canvasDiferencia.__wheelAttached) {
            canvasDiferencia.__wheelAttached = true;
            canvasDiferencia.addEventListener('wheel', handleDiferenciaWheel, { passive: false });
        }
        if (containerDiferencia && !containerDiferencia.__wheelAttached) {
            containerDiferencia.__wheelAttached = true;
            containerDiferencia.addEventListener('wheel', handleDiferenciaWheel, { passive: false });
        }

        // Soporte de rueda del raton sobre el grafico de Pedidos por Vendedor (6 a 12 dias progresivo)
        var lastVendedorWheelTime = 0;
        function handleVendedorWheel(e) {
            e.preventDefault();
            var now = Date.now();
            if (now - lastVendedorWheelTime < 180) return;
            lastVendedorWheelTime = now;

            var delta = e.deltaY || e.detail || (-e.wheelDelta);
            if (delta > 0) {
                stepVendedorDias(-1);
            } else if (delta < 0) {
                stepVendedorDias(1);
            }
        }

        var canvasVendedor = document.getElementById('vendedorBarChart');
        var containerVendedor = document.getElementById('vendedor-chart-container') || (canvasVendedor ? canvasVendedor.parentElement : null);
        if (canvasVendedor && !canvasVendedor.__wheelAttached) {
            canvasVendedor.__wheelAttached = true;
            canvasVendedor.addEventListener('wheel', handleVendedorWheel, { passive: false });
        }
        if (containerVendedor && !containerVendedor.__wheelAttached) {
            containerVendedor.__wheelAttached = true;
            containerVendedor.addEventListener('wheel', handleVendedorWheel, { passive: false });
        }

        $(document).off('themeChanged.dashboard').on('themeChanged.dashboard', function (e, isDark) {
            if (lastDashboardData) {
                if (lastDashboardData.graficoVentas) {
                    renderSalesChart(lastDashboardData.graficoVentas);
                }
                if (lastDashboardData.graficoProduccion) {
                    renderProductionChart(lastDashboardData.graficoProduccion);
                }
                if (lastDashboardData.graficoStackedBar) {
                    renderStackedBarChart(lastDashboardData.graficoStackedBar);
                }
                if (vendedorChartInstance) {
                    var nVend = vendedorDiasActuales || 6;
                    renderVendedorChart(
                        (allVendedorLabels || []).slice(-nVend),
                        (allVendedorCantidades || []).slice(-nVend),
                        (allVendedorMontos || []).slice(-nVend)
                    );
                }
            }
        });

        // Top Pedidos
        var currentTopPedidosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(topPedidos));
        var currentTopLimit = 5;

        function cambiarTopPedidos(limit) {
            currentTopLimit = limit;
            renderTopPedidos(currentTopPedidosData, currentTopLimit);
            actualizarBotonesTopPedidosUI();
        }
        window.cambiarTopPedidos = cambiarTopPedidos;

        function actualizarBotonesTopPedidosUI() {
            var $btn5 = $('#btn-top-5');
            var $btn10 = $('#btn-top-10');
            var $badge = $('#badge-top-pedidos');
            if (currentTopLimit === 10) {
                $btn5.removeClass('btn-primary active').addClass('btn-outline-secondary');
                $btn10.removeClass('btn-outline-secondary').addClass('btn-primary active');
                if ($badge.length) $badge.html('<i class="fas fa-calendar-day mr-1"></i>Top 10 Hoy');
            } else {
                $btn5.removeClass('btn-outline-secondary').addClass('btn-primary active');
                $btn10.removeClass('btn-primary active').addClass('btn-outline-secondary');
                if ($badge.length) $badge.html('<i class="fas fa-calendar-day mr-1"></i>Top 5 Hoy');
            }
        }

        function renderTopPedidos(lista, limit) {
            var $tbody = $('#tabla-top-pedidos tbody');
            if (!$tbody.length) return;
            if (!lista || !lista.length) {
                $tbody.html('<tr><td colspan="3" class="text-center text-muted py-3"><i class="fas fa-info-circle mr-1"></i> No se registran pedidos en el d\u00EDa de hoy</td></tr>');
                return;
            }
            var maxItems = limit || currentTopLimit || 5;
            var subLista = lista.slice(0, maxItems);
            var html = '';
            for (var i = 0; i < subLista.length; i++) {
                var p = subLista[i];
                var id = p.id !== undefined ? p.id : (p.Id !== undefined ? p.Id : '');
                var codigo = p.codigo || p.Codigo || '';
                var cliente = p.cliente || p.Cliente || 'Sin Cliente';
                var montoVal = p.monto !== undefined ? p.monto : (p.Monto !== undefined ? p.Monto : 0);
                var montoFormateado = p.montoFormateado || p.MontoFormateado || ('S/ ' + Number(montoVal).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                var rank = i + 1;
                var badgeClass = rank === 1 ? 'badge-warning text-dark' : 'badge-light border';

                html += '<tr>' +
                    '<td class="text-center font-weight-bold text-primary py-2" style="white-space: nowrap;">' +
                        '<span class="badge ' + badgeClass + ' mr-1">#' + rank + '</span>' +
                        '<span>' + id + '</span>' +
                        (codigo ? ' <small class="text-muted">(' + codigo + ')</small>' : '') +
                    '</td>' +
                    '<td class="py-2"><span class="font-weight-600">' + cliente + '</span></td>' +
                    '<td class="text-right font-weight-bold text-success py-2" style="white-space: nowrap;">' + montoFormateado + '</td>' +
                '</tr>';
            }
            $tbody.html(html);
        }

        // Clientes Inactivos
        var currentClientesInactivosData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(clientesInactivos));
        var currentClientesInactivosLimit = 5;

        function alternarVerMasClientesInactivos() {
            if (currentClientesInactivosLimit === 5) {
                currentClientesInactivosLimit = 10;
            } else {
                currentClientesInactivosLimit = 5;
            }
            actualizarBotonesVerMasUI();
            var meses = parseInt($('#select-meses-inactivos').val()) || 5;
            renderClientesInactivos(currentClientesInactivosData, meses, currentClientesInactivosLimit);
        }
        window.alternarVerMasClientesInactivos = alternarVerMasClientesInactivos;

        function actualizarBotonesVerMasUI() {
            var $btn = $('#btn-ver-mas-clientes');
            if (!$btn.length) return;
            if (currentClientesInactivosLimit === 10) {
                $btn.html('<i class="fas fa-chevron-up mr-1"></i>Ver menos (5)').removeClass('btn-outline-secondary').addClass('btn-secondary');
            } else {
                $btn.html('<i class="fas fa-chevron-down mr-1"></i>Ver m&aacute;s (10)').removeClass('btn-secondary').addClass('btn-outline-secondary');
            }
        }

        function renderClientesInactivos(lista, meses, limit) {
            var $tbody = $('#tabla-clientes-inactivos tbody');
            if (!$tbody.length) return;
            if (!lista || !lista.length) {
                $tbody.html('<tr><td colspan="3" class="text-center text-muted py-3"><i class="fas fa-check-circle text-success mr-1"></i> No se encontraron clientes con inactividad superior a ' + meses + ' meses</td></tr>');
                return;
            }
            var maxItems = limit || currentClientesInactivosLimit || 5;
            var subLista = lista.slice(0, maxItems);
            var html = '';
            for (var i = 0; i < subLista.length; i++) {
                var c = subLista[i];
                var id = c.id !== undefined ? c.id : (c.Id !== undefined ? c.Id : '');
                var codigo = c.codigo || c.Codigo || '';
                var cliente = c.cliente || c.Cliente || 'Sin Nombre';
                var fStr = c.fechaFormateada || c.FechaFormateada || '';
                var rank = i + 1;

                html += '<tr>' +
                    '<td class="text-center font-weight-bold text-secondary py-2" style="white-space: nowrap;">' +
                        '<span class="badge badge-light border mr-1">#' + rank + '</span>' +
                        '<span>' + id + '</span>' +
                        (codigo ? ' <small class="text-muted">(' + codigo + ')</small>' : '') +
                    '</td>' +
                    '<td class="py-2"><span class="font-weight-600">' + cliente + '</span></td>' +
                    '<td class="text-right py-2" style="white-space: nowrap;">' +
                        '<span class="badge badge-warning text-dark font-weight-bold px-2 py-1">' +
                            '<i class="far fa-calendar-alt mr-1"></i>' + fStr +
                        '</span>' +
                    '</td>' +
                '</tr>';
            }
            $tbody.html(html);
        }

        $(document).off('change', '#select-meses-inactivos').on('change', '#select-meses-inactivos', function () {
            var meses = $(this).val();
            var $badge = $('#badge-clientes-inactivos');
            if ($badge.length) {
                $badge.html('<i class="fas fa-history mr-1"></i>Inactivos (&ge; ' + meses + 'm)');
            }
            var $tbody = $('#tabla-clientes-inactivos tbody');
            $tbody.html('<tr><td colspan="3" class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin mr-1"></i> Consultando clientes...</td></tr>');

            $.ajax({
                url: '@Url.Action("ObtenerClientesInactivos", "Home")',
                type: 'GET',
                data: { meses: meses, cid: cid },
                headers: { 'x-app-cid': cid },
                success: function (res) {
                    if (res && res.success && res.data) {
                        currentClientesInactivosData = res.data;
                        renderClientesInactivos(res.data, meses, currentClientesInactivosLimit);
                    } else {
                        $tbody.html('<tr><td colspan="3" class="text-center text-muted py-3"><i class="fas fa-check-circle text-success mr-1"></i> Sin clientes inactivos para este rango</td></tr>');
                    }
                },
                error: function () {
                    $tbody.html('<tr><td colspan="3" class="text-center text-danger py-3"><i class="fas fa-exclamation-circle mr-1"></i> Error al consultar datos</td></tr>');
                }
            });
        });

        function sincronizarDashboard() {
            var mesesAct = parseInt($('#select-meses-inactivos').val()) || 5;
            $.ajax({
                url: '@Url.Action("ObtenerDatosDashboard", "Home")',
                type: 'GET',
                data: { cid: cid, mesesInactivos: mesesAct },
                headers: { 'x-app-cid': cid },
                success: function (res) {
                    if (res && res.success) {
                        lastDashboardData = res;

                        if (res.kpis) {
                            if (res.kpis.facturacionMes) $('#kpi-ventas').text(res.kpis.facturacionMes);
                            if (res.kpis.pedidosActivos) $('#kpi-pedidos').text(res.kpis.pedidosActivos);
                            if (res.kpis.cotizacionesActivas) $('#kpi-cotizaciones').text(res.kpis.cotizacionesActivas);
                            if (res.kpis.ordenesProduccionMes) $('#kpi-produccion').text(res.kpis.ordenesProduccionMes);
                            if (res.kpis.ordenesCompraMes) $('#kpi-compras').text(res.kpis.ordenesCompraMes);
                        }

                        if (res.graficoVentas) {
                            renderSalesChart(res.graficoVentas);
                        }
                        if (res.graficoProduccion) {
                            renderProductionChart(res.graficoProduccion);
                        }
                        if (res.graficoStackedBar) {
                            renderStackedBarChart(res.graficoStackedBar);
                        }
                        if (res.topPedidos) {
                            currentTopPedidosData = res.topPedidos;
                            renderTopPedidos(res.topPedidos, currentTopLimit);
                        }
                        if (res.clientesInactivos) {
                            currentClientesInactivosData = res.clientesInactivos;
                            renderClientesInactivos(res.clientesInactivos, mesesAct, currentClientesInactivosLimit);
                        }
                    }
                },
                error: function () {
                    if (lastDashboardData) {
                        renderSalesChart(lastDashboardData.graficoVentas);
                        renderProductionChart(lastDashboardData.graficoProduccion);
                        renderStackedBarChart(lastDashboardData.graficoStackedBar);
                    }
                }
            });
        }

        sincronizarDashboard();

        var dashboardInterval = setInterval(function () {
            if ($('#kpi-ventas').length > 0) {
                sincronizarDashboard();
            } else {
                clearInterval(dashboardInterval);
            }
        }, 30000);
    });
</script>
