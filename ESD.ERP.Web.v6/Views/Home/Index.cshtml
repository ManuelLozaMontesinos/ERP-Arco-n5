        function recargarTopMenorStock() {
            var $icon = $('#icon-recargar-menor-stock');
            $icon.addClass('fa-spin');
            $('#btn-recargar-menor-stock').prop('disabled', true);

            var sedeId = $('#filtro-menor-stock-sede').val() || '@sedeSesionId';
            var grupoId = $('#filtro-menor-stock-grupo').val();
            var claseId = $('#filtro-menor-stock-clase').val();
            var familiaId = $('#filtro-menor-stock-familia').val();

            var gText = $('#filtro-menor-stock-grupo option:selected').text();
            var cText = $('#filtro-menor-stock-clase option:selected').text();
            var fText = $('#filtro-menor-stock-familia option:selected').text();

            var infoFiltro = 'Todos los Grupos';
            if (grupoId) {
                infoFiltro = gText;
                if (claseId) {
                    infoFiltro += ' > ' + cText;
                    if (familiaId) {
                        infoFiltro += ' > ' + fText;
                    }
                }
            }
            $('#badge-filtro-menor-stock-info').html('<i class="fas fa-filter mr-1"></i>Filtro: ' + escapeDashboardHtml(infoFiltro));

            $.ajax({
                url: '@Url.Action("ObtenerTopMenorStock", "Home")',
                type: 'GET',
                data: {
                    sedeId: parseInt(sedeId, 10),
                    grupoId: grupoId ? parseInt(grupoId, 10) : null,
                    claseId: claseId ? parseInt(claseId, 10) : null,
                    familiaId: familiaId ? parseInt(familiaId, 10) : null,
                    cid: cid
                },
                success: function (res) {
                    if (res && res.success && res.data) {
                        renderTablaTopMenorStock(res.data);
                    }
                },
                error: function (err) {
                    console.error('Error cargando top menor stock:', err);
                },
                complete: function () {
                    $icon.removeClass('fa-spin');
                    $('#btn-recargar-menor-stock').prop('disabled', false);
                }
            });
        }

        function renderTablaTopMenorStock(items) {
            var $tbody = $('#tbody-top-menor-stock');
            $tbody.empty();

            if (!items || items.length === 0) {
                $tbody.html('<tr><td colspan="5" class="text-center text-muted py-4"><i class="fas fa-info-circle mr-1"></i> No se encontraron productos con menor stock para el filtro seleccionado.</td></tr>');
                return;
            }

            items.forEach(function (prod) {
                var badgeHtml = '';
                if (prod.badgeColor === 'danger') {
                    badgeHtml = '<span class="badge badge-danger px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-times-circle mr-1"></i>' + escapeDashboardHtml(prod.estadoStock) + '</span>';
                } else if (prod.badgeColor === 'warning') {
                    badgeHtml = '<span class="badge badge-warning text-dark px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-exclamation-triangle mr-1"></i>' + escapeDashboardHtml(prod.estadoStock) + '</span>';
                } else {
                    badgeHtml = '<span class="badge badge-info px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-info-circle mr-1"></i>' + escapeDashboardHtml(prod.estadoStock) + '</span>';
                }

                var rankBadgeClass = prod.orden <= 3 ? 'badge-danger' : 'badge-secondary';

                var catText = prod.categoriaCompleta || prod.CategoriaCompleta;
                if (!catText) {
                    var partes = [];
                    if (prod.grupoNombre) partes.push(prod.grupoNombre);
                    if (prod.claseNombre) partes.push(prod.claseNombre);
                    if (prod.familiaNombre) partes.push(prod.familiaNombre);
                    catText = partes.length > 0 ? partes.join(' / ') : '-';
                }

                var tr = '<tr>' +
                    '<td class="text-center font-weight-bold text-muted py-2" style="font-size: 0.85rem;">' +
                        '<span class="badge ' + rankBadgeClass + ' font-weight-bold" style="font-size: 0.8rem; border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center;">' +
                            prod.orden +
                        '</span>' +
                    '</td>' +
                    '<td class="text-center py-2" style="white-space: nowrap;">' +
                        '<span class="badge badge-light border font-weight-bold px-2 py-1 text-dark" style="font-family: monospace; font-size: 0.85rem; letter-spacing: 0.03em;">' +
                            escapeDashboardHtml(prod.codigo) +
                        '</span>' +
                    '</td>' +
                    '<td class="py-2" style="max-width: 350px;">' +
                        '<div class="font-weight-600 text-dark">' + escapeDashboardHtml(prod.nombre) + '</div>' +
                    '</td>' +
                    '<td class="py-2" style="font-size: 0.85rem;">' +
                        '<span class="text-muted font-weight-500">' + escapeDashboardHtml(catText) + '</span>' +
                    '</td>' +
                    '<td class="text-right py-2" style="white-space: nowrap;">' +
                        '<div class="d-inline-flex align-items-center justify-content-end" style="gap: 8px;">' +
                            badgeHtml +
                            '<span class="font-weight-bold text-danger" style="font-size: 1rem;">' +
                                escapeDashboardHtml(prod.cantidadFormateada) + ' <small class="font-weight-bold text-secondary">' + escapeDashboardHtml(prod.unidadMedida) + '</small>' +
                            '</span>' +
                        '</div>' +
                    '</td>' +
                '</tr>';

                $tbody.append(tr);
            });
        }

