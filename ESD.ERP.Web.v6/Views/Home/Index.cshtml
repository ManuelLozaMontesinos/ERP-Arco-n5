        function renderTopPedidos(lista, limit) {
            var $tbody = $('#tabla-top-pedidos tbody');
            if (!$tbody.length) return;
            if (!lista || !lista.length) {
                $tbody.html('<tr><td colspan="3" class="text-center text-muted py-3"><i class="fas fa-info-circle mr-1"></i> No se registran pedidos el ' + escapeDashboardHtml(fechaTopPedidos) + '</td></tr>');
                return;
            }
            // Asegurar siempre orden descendente por monto (Top 1 = mayor monto)
            var listaOrdenada = (lista || []).slice().sort(function(a, b) {
                var mA = Number(a.monto !== undefined ? a.monto : (a.Monto !== undefined ? a.Monto : 0)) || 0;
                var mB = Number(b.monto !== undefined ? b.monto : (b.Monto !== undefined ? b.Monto : 0)) || 0;
                return mB - mA;
            });

            var maxItems = limit || currentTopLimit || 5;
            var subLista = listaOrdenada.slice(0, maxItems);
            var html = '';
            for (var i = 0; i < subLista.length; i++) {
                var p = subLista[i];
                var id = p.id !== undefined ? p.id : (p.Id !== undefined ? p.Id : '');
                var cliente = p.cliente || p.Cliente || 'Sin Cliente';
                var montoVal = p.monto !== undefined ? p.monto : (p.Monto !== undefined ? p.Monto : 0);
                var montoFormateado = p.montoFormateado || p.MontoFormateado || ('S/ ' + Number(montoVal).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                var rank = i + 1;
                var badgeClass = rank === 1 ? 'badge-podium-gold' :
                                 rank === 2 ? 'badge-podium-silver' :
                                 rank === 3 ? 'badge-podium-bronze' : 'badge-podium-default';
                var rankIcon = rank <= 3 ? '<i class="fas fa-medal mr-1"></i>' : '';

                html += '<tr class="dashboard-drilldown-row" role="link" tabindex="0" data-cotizacion-id="' + escapeDashboardHtml(id) + '">' +
                    '<td class="text-center font-weight-bold text-primary py-2" style="white-space: nowrap;">' +
                        '<span class="badge ' + badgeClass + ' mr-1">' + rankIcon + '#' + rank + '</span>' +
                        '<span>' + escapeDashboardHtml(p.codigo || p.Codigo || '&mdash;') + '</span>' +
                    '</td>' +
                    '<td class="py-2"><span class="font-weight-600">' + escapeDashboardHtml(cliente) + '</span></td>' +
                    '<td class="text-right font-weight-bold text-success py-2" style="white-space: nowrap;">' + escapeDashboardHtml(montoFormateado) + '</td>' +
                '</tr>';
            }
            $tbody.html(html);
        }

        // Clientes Inactivos
