                                <input type="checkbox" class="custom-control-input chk-dashboard-rol-area" id="chk-rol-area-clientes-inactivos" data-area="clientes-inactivos" checked>
                                <label class="custom-control-label" for="chk-rol-area-clientes-inactivos"></label>
                            </div>
                        </label>
                    </div>

                    <!-- 10. Stock y Consumo de Insumos -->
                    <div class="col-md-6 mb-3">
                        <label class="dashboard-area-card d-flex align-items-center justify-content-between p-3 m-0 rounded bg-white border shadow-sm h-100" for="chk-rol-area-stock-insumos" style="cursor: pointer; transition: all 0.2s ease;">
                            <div class="d-flex align-items-center mr-3">
                                <div class="area-icon-box mr-3 d-flex align-items-center justify-content-center rounded" style="width: 36px; height: 36px; background-color: rgba(23, 162, 184, 0.1); color: #17a2b8; flex-shrink: 0;">
                                    <i class="fas fa-boxes"></i>
                                </div>
                                <div>
                                    <span class="d-block font-weight-600 text-dark" style="font-size: 0.95rem;">Stock y Consumo de Insumos</span>
                                    <small class="text-muted">Insumos cr&iacute;ticos en tiempo real y consumo</small>
                                </div>
                            </div>
                            <div class="custom-control custom-switch custom-switch-lg m-0" style="flex-shrink: 0;">
                                <input type="checkbox" class="custom-control-input chk-dashboard-rol-area" id="chk-rol-area-stock-insumos" data-area="stock-insumos" checked>
                                <label class="custom-control-label" for="chk-rol-area-stock-insumos"></label>
                            </div>
                        </label>
                    </div>

                    <!-- 11. Top 10 Productos con Menor Stock -->
                    <div class="col-md-6 mb-3">
                        <label class="dashboard-area-card d-flex align-items-center justify-content-between p-3 m-0 rounded bg-white border shadow-sm h-100" for="chk-rol-area-top-menor-stock" style="cursor: pointer; transition: all 0.2s ease;">
                            <div class="d-flex align-items-center mr-3">
                                <div class="area-icon-box mr-3 d-flex align-items-center justify-content-center rounded" style="width: 36px; height: 36px; background-color: rgba(220, 53, 69, 0.1); color: #dc3545; flex-shrink: 0;">
                                    <i class="fas fa-boxes"></i>
                                </div>
                                <div>
                                    <span class="d-block font-weight-600 text-dark" style="font-size: 0.95rem;">Top 10 Menor Stock</span>
                                    <small class="text-muted">Filtros por Grupo, Clase y Familia</small>
                                </div>
                            </div>
                            <div class="custom-control custom-switch custom-switch-lg m-0" style="flex-shrink: 0;">
                                <input type="checkbox" class="custom-control-input chk-dashboard-rol-area" id="chk-rol-area-top-menor-stock" data-area="top-menor-stock" checked>
                                <label class="custom-control-label" for="chk-rol-area-top-menor-stock"></label>
                            </div>
                        </label>
                    </div>

                    <!-- 12. Agenda del Calendario -->
                    <div class="col-md-6 mb-3">
                        <label class="dashboard-area-card d-flex align-items-center justify-content-between p-3 m-0 rounded bg-white border shadow-sm h-100" for="chk-rol-area-agenda-calendario" style="cursor: pointer; transition: all 0.2s ease;">
                            <div class="d-flex align-items-center mr-3">
                                <div class="area-icon-box mr-3 d-flex align-items-center justify-content-center rounded" style="width: 36px; height: 36px; background-color: rgba(13, 110, 253, 0.1); color: #0d6efd; flex-shrink: 0;">
                                    <i class="fas fa-calendar-check"></i>
                                </div>
                                <div>
                                    <span class="d-block font-weight-600 text-dark" style="font-size: 0.95rem;">Agenda de Calendario</span>
                                    <small class="text-muted">Agenda de eventos y reuniones por &aacute;rea</small>
                                </div>
                            </div>
                            <div class="custom-control custom-switch custom-switch-lg m-0" style="flex-shrink: 0;">
                                <input type="checkbox" class="custom-control-input chk-dashboard-rol-area" id="chk-rol-area-agenda-calendario" data-area="agenda-calendario" checked>
                                <label class="custom-control-label" for="chk-rol-area-agenda-calendario"></label>
                            </div>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2 px-4 border-top d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    <i class="fas fa-info-circle mr-1 text-primary"></i>Los cambios se guardan autom&aacute;ticamente al activar o desactivar cada switch.
                </small>
                <button type="button" class="btn btn-secondary btn-sm px-4 font-weight-600" data-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var cid = $('#__cid').val() || '@cid';

        function escapeDashboardHtml(value) {
            return $('<span>').text(value === null || value === undefined ? '' : String(value)).html();
        }

        function abrirComprobantes(urlAction) {
            $(document.body).getView({ urlAction: urlAction });
        }

        function navegarDesdePedido(row) {
            var cotizacionId = parseInt($(row).attr('data-cotizacion-id'), 10);
            if (!cotizacionId) return;
            $(document.body).getView({
                editAction: 'Edit',
                menuBarId: '',
                viewModel: [{ name: 'CotizacionDTO.CotizacionId', value: cotizacionId, type: 'int' }],
                urlAction: '@Url.Action("Editar", "Pedido", new { area = "VT" })'
            });
        }

        function navegarDesdeCliente(row) {
            var cliente = decodeURIComponent($(row).attr('data-cliente-nombre') || '');
            if (!cliente) return;
            abrirComprobantes('comprobante/index?clienteNombre=' + encodeURIComponent(cliente));
        }

        // Formato monetario peruano: S/ 310,879.10 o si pasa al millon S/ 3'456,890.00
        function formatMonedaPeruana(valor) {
            if (valor === null || valor === undefined || isNaN(valor)) return 'S/ 0.00';
            var num = Number(valor);
            var isNeg = num < 0;
            num = Math.abs(num);
            var partes = num.toFixed(2).split('.');
            var entero = partes[0];
            var decimales = partes[1];

            if (entero.length > 6) {
                var millones = entero.slice(0, entero.length - 6);
                var miles = entero.slice(entero.length - 6, entero.length - 3);
                var unidades = entero.slice(entero.length - 3);
                var millonesFmt = millones.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
                entero = millonesFmt + "'" + miles + "," + unidades;
            } else if (entero.length > 3) {
                entero = entero.replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            }

            return (isNeg ? '-' : '') + 'S/ ' + entero + '.' + decimales;
        }

        function getThemeConfig() {
            var isDark = $('body').hasClass('dark-mode') || $('html').hasClass('dark-mode');
            return {
                isDark: isDark,
                textColor: isDark ? '#cbd5e1' : '#64748b',
                gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.05)',
                barCurrent: isDark ? '#3b82f6' : '#007bff',
                barPrevious: isDark ? '#64748b' : '#ced4da',
                pieColors: isDark ? ['#06b6d4', '#10b981', '#f59e0b', '#f43f5e'] : ['#17a2b8', '#28a745', '#ffc107', '#dc3545']
            };
        }

        var salesChartInstance = null;
        var productionChartInstance = null;
        var stackedBarChartInstance = null;
        var vendedorChartInstance = null;

        var allVendedorLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stackedDiasDefault));
        var allVendedorCantidades = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vendedorCantidadesDefault));
        var allVendedorMontos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(vendedorMontosDefault));
        var vendedorDiasActuales = 6;
        var vendedorIdActual = @vendedorIdInicial;

        var allStackedLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stackedDiasDefault));
        var allStackedCentral = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dsCentralDefault));
        var allStackedIlo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dsIloDefault));
        var nivelesDias = [6, 8, 10, 12];
        var diasActuales = 6;

        var allSalesMeses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mesesVentasDefault));
        var allSalesAnterior = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventasAnteriorDefault));
        var allSalesActual = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventasActualDefault));
        var allSalesBarraActual = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventasBarraActualDefault));

        // Generar series para la comparativa del año actual contra el anterior.
        function generarSeriesVentas(n) {
            var slicedMeses = (allSalesMeses || []).slice(-n);
            var slicedActual = (allSalesActual || []).slice(-n);
            var slicedAnterior = (allSalesAnterior || []).slice(-n);
            var slicedBarrasActual = (allSalesBarraActual || []).slice(-n);

            return {
                meses: traducirMeses(slicedMeses),
                lineaActual: slicedActual.slice(),
                lineaAnterior: slicedAnterior.slice(),
                barraActual: slicedBarrasActual,
                barraAnterior: slicedAnterior
            };
        }

        var nivelesMesesVentas = [6, 8, 10, 12];
        var mesesVentasActuales = 12;

        function stepVentasMeses(direccion) {
            var curIdx = nivelesMesesVentas.indexOf(mesesVentasActuales);
            if (curIdx === -1) curIdx = 0;
            var newIdx = curIdx + direccion;
            if (newIdx < 0) newIdx = 0;
            if (newIdx >= nivelesMesesVentas.length) newIdx = nivelesMesesVentas.length - 1;
            if (newIdx !== curIdx) {
                setVentasMeses(nivelesMesesVentas[newIdx]);
            }
        }
        window.stepVentasMeses = stepVentasMeses;

        function setVentasMeses(meses) {
            mesesVentasActuales = meses;
            nivelesMesesVentas.forEach(function (m) {
                var $btn = $('#btn-ventas-' + m);
                if (m === meses) {
                    $btn.removeClass('btn-outline-secondary').addClass('btn-primary active');
                } else {
                    $btn.removeClass('btn-primary active').addClass('btn-outline-secondary');
                }
            });

            var $badge = $('#badge-meses-ventas');
            if ($badge.length) {
                var anioSel = parseInt($('#header-select-periodo').val()) || @anioSesion;
                var eneroIndex = (allSalesMeses || []).findIndex(function (l) { return (l || '').toLowerCase().indexOf('ene') === 0; });
                if (meses === 12) {
                    if (eneroIndex === 0) {
                        $badge.html('<i class="fas fa-calendar-alt mr-1"></i>12 Meses (A\u00F1o ' + anioSel + ')');
                    } else {
                        $badge.html('<i class="fas fa-calendar-alt mr-1"></i>12 Meses (\u00DAltimos 12 meses)');
                    }
                } else {
                    $badge.html('<i class="fas fa-calendar-alt mr-1"></i>\u00DAltimos ' + meses + ' meses');
                }
            }

            actualizarChartVentasMeses();
        }
        window.setVentasMeses = setVentasMeses;

        function actualizarChartVentasMeses() {
            if (!salesChartInstance) return;

            var series = generarSeriesVentas(mesesVentasActuales || 12);
            var eneIdx = (allSalesMeses || []).findIndex(function (l) { return (l || '').toLowerCase().indexOf('ene') === 0; });
            if (eneIdx > 0) { $('#legend-puente-dic-ene').show(); } else { $('#legend-puente-dic-ene').hide(); }
            salesChartInstance.data.labels = series.meses;
            if (salesChartInstance.data.datasets[0]) salesChartInstance.data.datasets[0].data = series.lineaActual;
            if (salesChartInstance.data.datasets[1]) salesChartInstance.data.datasets[1].data = series.lineaAnterior;
            if (salesChartInstance.data.datasets[2]) salesChartInstance.data.datasets[2].data = series.barraActual;
            if (salesChartInstance.data.datasets[3]) salesChartInstance.data.datasets[3].data = series.barraAnterior;
            salesChartInstance.update();
        }

        var lastStackedCentral = (allStackedCentral || []).slice(-6);
        var lastStackedIlo = (allStackedIlo || []).slice(-6);

        var sedesVisibles = { central: true, ilo: true };

        function stepDiferenciaDias(direccion) {
            var curIdx = nivelesDias.indexOf(diasActuales);
            if (curIdx === -1) curIdx = 0;
            var newIdx = curIdx + direccion;
            if (newIdx < 0) newIdx = 0;
            if (newIdx >= nivelesDias.length) newIdx = nivelesDias.length - 1;
            if (newIdx !== curIdx) {
                setDiferenciaDias(nivelesDias[newIdx]);
            }
        }
        window.stepDiferenciaDias = stepDiferenciaDias;

        function setDiferenciaDias(dias) {
            diasActuales = dias;
            nivelesDias.forEach(function (n) {
                var $btn = $('#btn-dias-' + n);
                if (n === dias) {
                    $btn.removeClass('btn-outline-secondary').addClass('btn-primary active');
                } else {
                    $btn.removeClass('btn-primary active').addClass('btn-outline-secondary');
                }
            });

            actualizarBotonesSedesUI();
            actualizarChartDiferenciaDias();
        }
        window.setDiferenciaDias = setDiferenciaDias;

        function actualizarChartDiferenciaDias() {
            if (!stackedBarChartInstance) return;

            var n = diasActuales || 6;
            var slicedLabels = (allStackedLabels || []).slice(-n);
            var slicedCentral = (allStackedCentral || []).slice(-n);
            var slicedIlo = (allStackedIlo || []).slice(-n);

            lastStackedCentral = slicedCentral;
            lastStackedIlo = slicedIlo;

            var slicedTrend = [];
            for (var i = 0; i < slicedCentral.length; i++) {
                var vC = sedesVisibles.central ? (slicedCentral[i] || 0) : 0;
                var vI = sedesVisibles.ilo ? (slicedIlo[i] || 0) : 0;
                slicedTrend.push(Math.round((vC + vI) * 100) / 100);
            }

            stackedBarChartInstance.data.labels = slicedLabels;
            stackedBarChartInstance.data.datasets.forEach(function (ds) {
                if (ds.type === 'line' || (ds.label && ds.label.indexOf('Pico') >= 0)) {
                    ds.data = slicedTrend;
                } else if (ds.label === 'Central' || (ds.label && ds.label.indexOf('Central') >= 0)) {
                    ds.data = slicedCentral;
                    ds.hidden = !sedesVisibles.central;
                } else if (ds.label === 'Ilo' || (ds.label && ds.label.indexOf('Ilo') >= 0)) {
                    ds.data = slicedIlo;
                    ds.hidden = !sedesVisibles.ilo;
                }
            });

            stackedBarChartInstance.update();
        }

        function actualizarBotonesSedesUI() {
            var $btnCentral = $('#btn-filtro-central');
            var $btnIlo = $('#btn-filtro-ilo');
            var $btnVs = $('#btn-filtro-vs');

            if (sedesVisibles.central && sedesVisibles.ilo) {
                $btnCentral.removeClass('inactive').addClass('active').attr('title', 'Ver solo Sede Central');
                $btnIlo.removeClass('inactive').addClass('active').attr('title', 'Ver solo Sede Ilo');
                $btnVs.removeClass('inactive').addClass('active').attr('title', 'Ambas sedes activas (VS)');
            } else if (sedesVisibles.central && !sedesVisibles.ilo) {
                $btnCentral.removeClass('inactive').addClass('active').attr('title', 'Sede Central activa');
                $btnIlo.removeClass('active').addClass('inactive').attr('title', 'Cambiar a Sede Ilo');
                $btnVs.removeClass('active').addClass('inactive').attr('title', 'Clic para comparar ambas sedes (VS)');
            } else {
                $btnCentral.removeClass('active').addClass('inactive').attr('title', 'Cambiar a Sede Central');
                $btnIlo.removeClass('inactive').addClass('active').attr('title', 'Sede Ilo activa');
                $btnVs.removeClass('active').addClass('inactive').attr('title', 'Clic para comparar ambas sedes (VS)');
            }
        }

        function aplicarFiltroSedes() {
            actualizarChartDiferenciaDias();
            actualizarBotonesSedesUI();
        }

        function alternarSede(sede, event) {
            var isCtrl = event && (event.ctrlKey || event.metaKey || event.shiftKey);
            if (isCtrl) {
                if (sede === 'central') {
                    sedesVisibles.central = !sedesVisibles.central;
                    if (!sedesVisibles.central && !sedesVisibles.ilo) sedesVisibles.ilo = true;
                } else {
                    sedesVisibles.ilo = !sedesVisibles.ilo;
                    if (!sedesVisibles.central && !sedesVisibles.ilo) sedesVisibles.central = true;
                }
            } else {
                if (sede === 'central') {
                    if (sedesVisibles.central && sedesVisibles.ilo) {
                        sedesVisibles.central = true;
                        sedesVisibles.ilo = false;
                    } else if (sedesVisibles.central && !sedesVisibles.ilo) {
                        sedesVisibles.central = true;
                        sedesVisibles.ilo = true;
                    } else {
                        sedesVisibles.central = true;
                        sedesVisibles.ilo = false;
                    }
                } else {
                    if (sedesVisibles.central && sedesVisibles.ilo) {
                        sedesVisibles.central = false;
                        sedesVisibles.ilo = true;
                    } else if (!sedesVisibles.central && sedesVisibles.ilo) {
                        sedesVisibles.central = true;
                        sedesVisibles.ilo = true;
                    } else {
                        sedesVisibles.central = false;
                        sedesVisibles.ilo = true;
                    }
                }
            }
            aplicarFiltroSedes();
        }

        $(document).off('click', '#btn-filtro-central').on('click', '#btn-filtro-central', function (e) {
            e.preventDefault();
            alternarSede('central', e);
        });

        $(document).off('click', '#btn-filtro-ilo').on('click', '#btn-filtro-ilo', function (e) {
            e.preventDefault();
            alternarSede('ilo', e);
        });

        $(document).off('click', '#btn-filtro-vs').on('click', '#btn-filtro-vs', function (e) {
            e.preventDefault();
            sedesVisibles.central = true;
            sedesVisibles.ilo = true;
            aplicarFiltroSedes();
        });

        var defaultDashboardData = {
            success: true,
            kpis: {
                facturacionMes: "@Html.Raw(facturacionMes)",
                pedidosActivos: "@Html.Raw(pedidosActivos)",
                cotizacionesActivas: "@Html.Raw(cotizacionesActivas)",
                ordenesProduccionMes: "@Html.Raw(ordenesProduccionMes)",
                ordenesCompraMes: "@Html.Raw(ordenesCompraMes)"
            },
            graficoVentas: {
                meses: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mesesVentasDefault)),
                ventasAnterior: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventasAnteriorDefault)),
                ventasActual: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventasActualDefault)),
                ventasBarraActual: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ventasBarraActualDefault))
            },
            graficoProduccion: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(prodLabelsDefault)),
                valores: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(prodValoresDefault))
            },
            graficoStackedBar: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stackedDiasDefault)),
                datasets: [
                    {
                        label: 'Ilo',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dsIloDefault))
                    },
                    {
                        label: 'Central',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dsCentralDefault))
                    }
                ]
            }
        };

        var lastDashboardData = defaultDashboardData;

        function traducirMeses(labels) {
            if (!labels || !labels.length) return ["Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre"];
            var mapa = {
                'May': 'Mayo',
                'Jun': 'Junio',
                'Jul': 'Julio',
                'Ago': 'Agosto',
                'Set': 'Septiembre',
                'Sep': 'Septiembre',
                'Sept': 'Septiembre',
                'Oct': 'Octubre',
                'Nov': 'Noviembre',
                'Dic': 'Diciembre',
                'Ene': 'Enero',
                'Feb': 'Febrero',
                'Mar': 'Marzo',
                'Abr': 'Abril'
            };
            return labels.map(function(m) { return mapa[m] || m; });
        }

        var alignLinesWithBarsPlugin = {
            id: 'alignLinesWithBars',
            beforeDraw: function (chart) {
                var meta0 = chart.getDatasetMeta(0);
                var meta1 = chart.getDatasetMeta(1);
                var meta2 = chart.getDatasetMeta(2);
                var meta3 = chart.getDatasetMeta(3);

                if (meta0 && meta0.data) {
                    meta0.data.forEach(function (pt, i) {
                        var valAzul = chart.data.datasets[2] && chart.data.datasets[2].data ? chart.data.datasets[2].data[i] : 0;
                        if ((!valAzul || valAzul === 0) && meta3 && meta3.data && meta3.data[i]) {
                            // En Diciembre de 2025 nace exactamente en la barra gris
                            pt.x = meta3.data[i].x;
                        } else if (meta2 && meta2.data && meta2.data[i]) {
                            pt.x = meta2.data[i].x;
                        }
                    });
                }
                if (meta1 && meta3 && meta1.data && meta3.data) {
                    meta1.data.forEach(function (pt, i) {
                        if (meta3.data[i]) pt.x = meta3.data[i].x;
                    });
                }
            },
            beforeDatasetDraw: function (chart, args) {
                var meta = chart.getDatasetMeta(args.index);
                var meta2 = chart.getDatasetMeta(2);
                var meta3 = chart.getDatasetMeta(3);
                if (args.index === 0 && meta && meta.data) {
                    meta.data.forEach(function (pt, i) {
                        var valAzul = chart.data.datasets[2] && chart.data.datasets[2].data ? chart.data.datasets[2].data[i] : 0;
                        if ((!valAzul || valAzul === 0) && meta3 && meta3.data && meta3.data[i]) {
                            pt.x = meta3.data[i].x;
                        } else if (meta2 && meta2.data && meta2.data[i]) {
                            pt.x = meta2.data[i].x;
                        }
                    });
                } else if (args.index === 1 && meta && meta.data && meta3 && meta3.data) {
                    meta.data.forEach(function (pt, i) {
                        if (meta3.data[i]) pt.x = meta3.data[i].x;
                    });
                }
            }
        };

        function renderSalesChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('salesChart');
            if (!canvas) return;

            if (salesChartInstance) {
                salesChartInstance.destroy();
                salesChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            if (data && data.meses && data.meses.length) allSalesMeses = data.meses;
            if (data && data.ventasAnterior && data.ventasAnterior.length) allSalesAnterior = data.ventasAnterior;
            if (data && data.ventasActual && data.ventasActual.length) allSalesActual = data.ventasActual;
            if (data && data.ventasBarraActual && data.ventasBarraActual.length) allSalesBarraActual = data.ventasBarraActual;

            var series = generarSeriesVentas(mesesVentasActuales || 12);

            salesChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: series.meses,
                    datasets: [
                        {
                            type: 'line',
                            label: 'L\u00EDnea Actual',
                            order: 0,
                            data: series.lineaActual,
                            borderColor: '#28a745',
                            backgroundColor: 'rgba(40, 167, 69, 0.08)',
                            borderWidth: 3,
                            pointRadius: 5,
                            pointHoverRadius: 7,
                            pointBackgroundColor: function(context) {
                                var labels = context.chart.data.labels || [];
                                var eneroIndex = labels.findIndex(function(label) {
                                    return (label || '').toLowerCase().indexOf('ene') === 0;
                                });
                                return eneroIndex > 0 && context.dataIndex < eneroIndex ? '#ffc107' : '#28a745';
                            },
                            pointBorderColor: function(context) {
                                var labels = context.chart.data.labels || [];
                                var eneroIndex = labels.findIndex(function(label) {
                                    return (label || '').toLowerCase().indexOf('ene') === 0;
                                });
                                return eneroIndex > 0 && context.dataIndex < eneroIndex ? '#ffc107' : '#28a745';
                            },
                            segment: {
                                borderColor: function(ctx) {
                                    var labels = ctx.chart.data.labels || [];
                                    var mesInicio = (labels[ctx.p0DataIndex] || '').toLowerCase();
                                    var mesFin = (labels[ctx.p1DataIndex] || '').toLowerCase();
                                    var eneroIndex = labels.findIndex(function(label) {
                                        return (label || '').toLowerCase().indexOf('ene') === 0;
                                    });
                                    if (mesInicio.indexOf('dic') === 0 && mesFin.indexOf('ene') === 0) return '#fd7e14';
                                    if (eneroIndex > 0 && ctx.p1DataIndex < eneroIndex) return '#ffc107';
                                    return '#28a745';
                                }
                            },
                            tension: 0.25,
                            fill: false,
                            spanGaps: false
                        },
                        {
                            type: 'line',
                            label: 'L\u00EDnea Anterior',
                            order: 1,
                            data: series.lineaAnterior,
                            borderColor: '#ffc107',
                            backgroundColor: 'rgba(255, 193, 7, 0.08)',
                            borderWidth: 3,
                            pointRadius: function(context) {
                                var labels = context.chart.data.labels || [];
                                var eneroIndex = labels.findIndex(function(l) { return (l || '').toLowerCase().indexOf('ene') === 0; });
                                if (eneroIndex > 0 && context.dataIndex < eneroIndex) return 0;
                                return 4;
                            },
                            pointHoverRadius: function(context) {
                                var labels = context.chart.data.labels || [];
                                var eneroIndex = labels.findIndex(function(l) { return (l || '').toLowerCase().indexOf('ene') === 0; });
                                if (eneroIndex > 0 && context.dataIndex < eneroIndex) return 0;
                                return 6;
                            },
                            pointBackgroundColor: '#ffc107',
                            pointBorderColor: '#ffc107',
                            segment: {
                                borderColor: function(ctx) {
                                    var labels = ctx.chart.data.labels || [];
                                    var mesInicio = (labels[ctx.p0DataIndex] || '').toLowerCase();
                                    var mesFin = (labels[ctx.p1DataIndex] || '').toLowerCase();
                                    var eneroIndex = labels.findIndex(function(l) { return (l || '').toLowerCase().indexOf('ene') === 0; });
                                    if (eneroIndex > 0 && ctx.p1DataIndex <= eneroIndex) return 'transparent';
                                    return '#ffc107';
                                }
                            },
                            tension: 0.25,
                            fill: false
                        },
                        {
                            type: 'bar',
                            label: 'Barra Actual',
                            order: 2,
                            backgroundColor: theme.barCurrent,
                            borderColor: theme.barCurrent,
                            data: series.barraActual,
                            borderRadius: 4
                        },
                        {
                            type: 'bar',
                            label: 'Barra Anterior',
                            order: 3,
                            backgroundColor: theme.barPrevious,
                            borderColor: theme.barPrevious,
                            data: series.barraAnterior,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            filter: function(tooltipItem) {
                                if (tooltipItem.parsed.y === null || tooltipItem.parsed.y === undefined || isNaN(tooltipItem.parsed.y)) return false;
                                if (tooltipItem.datasetIndex === 0) {
                                    var lbl = (tooltipItem.label || '').toLowerCase();
                                    var labels = tooltipItem.chart.data.labels || [];
                                    var eneroIndex = labels.findIndex(function(l) { return (l || '').toLowerCase().indexOf('ene') === 0; });
                                    if (eneroIndex > 0 && tooltipItem.dataIndex < eneroIndex) return false;
                                }
                                return tooltipItem.datasetIndex === 0 || tooltipItem.datasetIndex === 1;
                            },
                            callbacks: {
                                label: function(context) {
                                    if (context.parsed.y === null || context.parsed.y === undefined) return '';
                                    var anioSel = parseInt($('#header-select-periodo').val()) || @anioSesion;
                                    var anio = (context.datasetIndex === 0 || context.datasetIndex === 2) ? ('A\u00F1o ' + anioSel) : ('A\u00F1o ' + (anioSel - 1));
                                    var montoEnSoles = (Number(context.parsed.y) || 0) * 1000;
                                    return anio + ': ' + formatMonedaPeruana(montoEnSoles);
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: theme.textColor },
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: theme.textColor,
                                callback: function(value) { return 'S/ ' + value + 'k'; }
                            },
                            grid: { color: theme.gridColor }
                        }
                    }
                },
                plugins: [alignLinesWithBarsPlugin]
            });
        }

        function renderProductionChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('productionChart');
            if (!canvas) return;

            if (productionChartInstance) {
                productionChartInstance.destroy();
                productionChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            var rawData = data.valores || [];
            var total = 0;
            for (var i = 0; i < rawData.length; i++) {
                total += (Number(rawData[i]) || 0);
            }

            var $empty = $('#productionChartEmpty');
            if (total === 0) {
                if ($empty.length) $empty.removeClass('d-none');
            } else {
                if ($empty.length) $empty.addClass('d-none');
            }

            productionChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: data.labels,
                    datasets: [{
                        data: rawData,
                        backgroundColor: theme.pieColors,
                        borderWidth: theme.isDark ? 2 : 1,
                        borderColor: theme.isDark ? '#343a40' : '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: theme.textColor,
                                boxWidth: 14,
                                padding: 12,
                                generateLabels: function (chart) {
                                    var ds = chart.data.datasets[0];
                                    return (chart.data.labels || []).map(function (label, idx) {
                                        var val = (ds && ds.data) ? (ds.data[idx] || 0) : 0;
                                        var fill = (ds && ds.backgroundColor && ds.backgroundColor[idx]) ? ds.backgroundColor[idx] : '#999';
                                        return {
                                            text: label + ' (' + val + ')',
                                            fillStyle: fill,
                                            strokeStyle: theme.isDark ? '#343a40' : '#ffffff',
                                            lineWidth: 1,
                                            hidden: false,
                                            index: idx
                                        };
                                    });
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    var label = context.label || '';
                                    var val = Number(context.raw) || 0;
                                    var pct = total > 0 ? Math.round((val / total) * 100) : 0;
                                    return ' ' + label + ': ' + val + ' orden' + (val === 1 ? '' : 'es') + ' (' + pct + '%)';
                                }
                            }
                        }
                    },
                    cutout: '62%'
                }
            });
        }

        function renderStackedBarChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('stackedBarChart');
            if (!canvas) return;

            if (stackedBarChartInstance) {
                stackedBarChartInstance.destroy();
                stackedBarChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            if (data && data.labels && data.labels.length) allStackedLabels = data.labels;
            if (data && data.datasets && data.datasets.length >= 2) {
                data.datasets.forEach(function (ds) {
                    if (ds.label === 'Central' || (ds.label && ds.label.indexOf('Central') >= 0)) {
                        allStackedCentral = ds.data;
                    } else if (ds.label === 'Ilo' || (ds.label && ds.label.indexOf('Ilo') >= 0)) {
                        allStackedIlo = ds.data;
                    }
                });
            }

            var n = diasActuales || 6;
            var slicedLabels = (allStackedLabels || []).slice(-n);
            var slicedCentral = (allStackedCentral || []).slice(-n);
            var slicedIlo = (allStackedIlo || []).slice(-n);

            var trendData = [];
            for (var i = 0; i < slicedCentral.length; i++) {
                var vC = sedesVisibles.central ? (slicedCentral[i] || 0) : 0;
                var vI = sedesVisibles.ilo ? (slicedIlo[i] || 0) : 0;
                trendData.push(Math.round((vC + vI) * 100) / 100);
            }

            stackedBarChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: slicedLabels,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Pico / Tendencia',
                            data: trendData,
                            borderColor: '#28a745',
                            backgroundColor: 'rgba(40, 167, 69, 0.1)',
                            borderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#28a745',
                            fill: false,
                            tension: 0.25,
                            order: 0
                        },
                        {
                            type: 'bar',
                            label: 'Ilo',
                            backgroundColor: theme.barPrevious,
                            borderColor: theme.barPrevious,
                            borderRadius: 4,
                            data: slicedIlo,
                            hidden: !sedesVisibles.ilo,
                            order: 1
                        },
                        {
                            type: 'bar',
                            label: 'Central',
                            backgroundColor: theme.barCurrent,
                            borderColor: theme.barCurrent,
                            borderRadius: 4,
                            data: slicedCentral,
                            hidden: !sedesVisibles.central,
                            order: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            itemSort: function (a, b) {
                                if (a.dataset.type === 'line') return -1;
                                if (b.dataset.type === 'line') return 1;
                                return (b.raw || 0) - (a.raw || 0);
                            },
                            callbacks: {
                                label: function(context) {
                                    var fmt = formatMonedaPeruana(context.parsed.y);
                                    if (context.dataset.type === 'line') {
                                        return 'Pico M\u00E1ximo: ' + fmt;
                                    }
                                    return context.dataset.label + ': ' + fmt;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: true,
                            ticks: { color: theme.textColor },
                            grid: { display: false }
                        },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            ticks: {
                                color: theme.textColor,
                                callback: function(value) {
                                    if (value >= 1000) {
                                        return 'S/ ' + (value / 1000).toLocaleString() + 'k';
                                    }
                                    return 'S/ ' + Number(value).toLocaleString();
                                }
                            },
                            grid: { color: theme.gridColor }
                        }
                    }
                }
            });
            actualizarBotonesSedesUI();
        }

        function initChartsImmediately() {
            if (typeof Chart !== 'undefined') {
                renderSalesChart(lastDashboardData.graficoVentas);
                renderProductionChart(lastDashboardData.graficoProduccion);
                renderStackedBarChart(lastDashboardData.graficoStackedBar);
                var nVend = vendedorDiasActuales || 6;
                renderVendedorChart(
                    (allVendedorLabels || []).slice(-nVend),
                    (allVendedorCantidades || []).slice(-nVend),
                    (allVendedorMontos || []).slice(-nVend)
                );
            } else {
                setTimeout(initChartsImmediately, 80);
            }
        }
        initChartsImmediately();

        // ========================================================
        // GRAFICO: PEDIDOS POR VENDEDOR (Dia a Dia)
        // ========================================================
        function renderVendedorChart(labels, cantidades, montos, totalPedidos, totalMonto) {
            var theme = getThemeConfig();
            var canvas = document.getElementById('vendedorBarChart');
            if (!canvas) return;

            if (vendedorChartInstance) {
                vendedorChartInstance.destroy();
                vendedorChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            labels = labels || [];
            cantidades = cantidades || [];
            montos = montos || [];

            if (totalPedidos === undefined || totalPedidos === null) {
                totalPedidos = cantidades.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
            }
            if (!totalMonto) {
                var sumMto = montos.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
                totalMonto = formatMonedaPeruana(sumMto);
            }

            $('#vendedor-total-pedidos').text(totalPedidos + ' pedido' + (totalPedidos === 1 ? '' : 's') + ' en el periodo');
            $('#vendedor-total-monto').text('Total: ' + totalMonto);

            vendedorChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Tendencia Pedidos',
                            data: cantidades,
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.12)',
                            borderWidth: 2.5,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#10b981',
                            pointBorderColor: '#ffffff',
                            fill: false,
                            tension: 0.25,
                            order: 0
                        },
                        {
                            type: 'bar',
                            label: 'Cantidad de Pedidos',
                            backgroundColor: theme.barCurrent,
                            borderColor: theme.barCurrent,
                            borderRadius: 4,
                            data: cantidades,
                            order: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                            backgroundColor: theme.isDark ? '#0f172a' : '#1e293b',
                            titleColor: '#ffffff',
                            bodyColor: '#e2e8f0',
                            borderColor: theme.isDark ? '#334155' : '#475569',
                            borderWidth: 1,
                            padding: 10,
                            callbacks: {
                                label: function(context) {
                                    if (context.dataset.type === 'line') {
                                        return 'Pico / Tendencia: ' + context.parsed.y + ' pedidos';
                                    }
                                    var nVend = vendedorDiasActuales || 6;
                                    var currentMontos = (allVendedorMontos || []).slice(-nVend);
                                    var idx = context.dataIndex;
                                    var mto = (currentMontos && currentMontos.length > idx) ? currentMontos[idx] : 0;
                                    return [
                                        'Pedidos: ' + context.parsed.y,
                                        'Monto Total: ' + formatMonedaPeruana(mto)
                                    ];
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: theme.textColor },
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                color: theme.textColor,
                                callback: function(value) {
                                    return value + ' ped.';
                                }
                            },
                            grid: { color: theme.gridColor }
                        }
                    }
                }
            });
        }

        var nivelesVendedorDias = [6, 8, 10, 12];

        function stepVendedorDias(direccion) {
            var curIdx = nivelesVendedorDias.indexOf(vendedorDiasActuales);
            if (curIdx === -1) curIdx = 0;
            var newIdx = curIdx + direccion;
            if (newIdx < 0) newIdx = 0;
            if (newIdx >= nivelesVendedorDias.length) newIdx = nivelesVendedorDias.length - 1;
            if (newIdx !== curIdx) {
                setVendedorDias(nivelesVendedorDias[newIdx]);
            }
        }
        window.stepVendedorDias = stepVendedorDias;

        function setVendedorDias(dias) {
            vendedorDiasActuales = dias;
            [6, 8, 10, 12].forEach(function(n) {
                var $btn = $('#btn-vendedor-dias-' + n);
                if (n === dias) {
                    $btn.removeClass('btn-outline-secondary').addClass('btn-primary active');
                } else {
                    $btn.removeClass('btn-primary active').addClass('btn-outline-secondary');
                }
            });

            actualizarChartVendedorDias();
        }
        window.setVendedorDias = setVendedorDias;

        function actualizarChartVendedorDias() {
            if (!vendedorChartInstance) {
                var nVend = vendedorDiasActuales || 6;
                renderVendedorChart(
                    (allVendedorLabels || []).slice(-nVend),
                    (allVendedorCantidades || []).slice(-nVend),
                    (allVendedorMontos || []).slice(-nVend)
                );
                return;
            }

            var n = vendedorDiasActuales || 6;
            var slicedLabels = (allVendedorLabels || []).slice(-n);
            var slicedCantidades = (allVendedorCantidades || []).slice(-n);
            var slicedMontos = (allVendedorMontos || []).slice(-n);

            var totalPedidos = slicedCantidades.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);
            var sumMto = slicedMontos.reduce(function(a, b) { return a + (Number(b) || 0); }, 0);

            $('#vendedor-total-pedidos').text(totalPedidos + ' pedido' + (totalPedidos === 1 ? '' : 's') + ' en el periodo');
            $('#vendedor-total-monto').text('Total: ' + formatMonedaPeruana(sumMto));

            vendedorChartInstance.data.labels = slicedLabels;
            if (vendedorChartInstance.data.datasets[0]) {
                vendedorChartInstance.data.datasets[0].data = slicedCantidades;
            }
            if (vendedorChartInstance.data.datasets[1]) {
                vendedorChartInstance.data.datasets[1].data = slicedCantidades;
            }
            vendedorChartInstance.update();
        }

        var currentVendedorAjax = null;
        function cargarDatosVendedor(vendedorId) {
            vendedorIdActual = vendedorId;
            if (currentVendedorAjax && currentVendedorAjax.readyState !== 4) {
                currentVendedorAjax.abort();
            }
            var anioSel = parseInt($('#header-select-periodo').val()) || @anioSesion;
            currentVendedorAjax = $.ajax({
                url: '/Home/ObtenerPedidosVendedor',
                type: 'GET',
                data: { vendedorId: vendedorId, dias: 12, cid: cid, anio: anioSel },
                headers: { 'x-app-cid': cid },
                success: function(res) {
                    if (res && res.success) {
                        allVendedorLabels = res.labels;
                        allVendedorCantidades = res.cantidades;
                        allVendedorMontos = res.montos;
                        actualizarChartVendedorDias();
                    }
                },
                error: function(err) {
                    if (err.statusText !== 'abort') {
                        console.warn('Error obteniendo pedidos del vendedor:', err);
                    }
                }
            });
        }

        var puedeFiltrarVendedorClientesJs = @(puedeFiltrarVendedorClientes ? "true" : "false");

        $(document).on('change', '#select-vendedor-chart', function() {
            if (!puedeFiltrarVendedorClientesJs) return;
            var vid = parseInt($(this).val(), 10);
            if (vid > 0) {
                cargarDatosVendedor(vid);
            }
        });

