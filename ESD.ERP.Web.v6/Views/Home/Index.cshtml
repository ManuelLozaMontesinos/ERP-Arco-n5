                    </div>
                    <div class="card-body pt-1">
                        <div class="position-relative mb-3" id="vendedor-chart-container" style="height: 250px;" title="Usa la rueda del rat&oacute;n para cambiar el rango de d&iacute;as (6d, 8d, 10d, 12d)">
                            <canvas id="vendedorBarChart" height="240"></canvas>
                        </div>
                        <div class="d-flex flex-row justify-content-between align-items-center px-1 text-xs text-muted flex-wrap" style="gap: 6px;">
                            <div class="d-flex align-items-center" style="gap: 8px;">
                                <span><i class="fas fa-chart-line text-success mr-1"></i>Pico / Tendencia diaria</span>
                                <span id="vendedor-total-monto" class="badge badge-light border text-dark font-weight-600 px-2 py-1">Total: S/ 0.00</span>
                            </div>
                            <div>
                                <span id="vendedor-total-pedidos" class="badge badge-primary font-weight-600 px-2 py-1">0 pedidos en el periodo</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Columna Derecha (5 columnas) -->
            <div class="col-lg-5" id="col-main-right">

                <!-- 3. Accesos Rápidos del ERP -->
                <div class="card card-success card-outline shadow-sm mb-4" id="area-accesos-rapidos">
                    <div class="card-header border-0 d-flex justify-content-between align-items-center py-2 pl-3 pr-2">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-bolt text-success mr-2"></i>Accesos Rápidos
                        </h3>
                        <div class="card-tools d-inline-flex align-items-center ml-auto m-0">
                            <button type="button" class="btn btn-tool mr-1" id="btn-gestionar-accesos-rapidos" data-toggle="modal" data-target="#modal-gestionar-accesos-rapidos" title="Personalizar Accesos Rápidos" style="font-size: 0.85rem;"><i class="fas fa-sliders-h text-success"></i></button>
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Minimizar">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        <div id="contenedor-accesos-rapidos" class="d-flex flex-wrap justify-content-center align-items-center" style="gap: 10px;">
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'cotizacion/index' });">
                                <i class="fas fa-file-signature text-success"></i> Cotizaciones
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'pedido/index' });">
                                <i class="fas fa-dolly text-primary"></i> Pedidos
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'comprobante/index' });">
                                <i class="fas fa-receipt text-info"></i> Facturar
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'ordenProdu/index' });">
                                <i class="fas fa-industry text-warning"></i> Producción
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'ordenCompra/index' });">
                                <i class="fas fa-truck-loading text-danger"></i> Compras
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'producto/index' });">
                                <i class="fas fa-tags text-secondary"></i> Productos
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 4. Gráfico de Producción en Planta -->
                <div class="card card-warning card-outline shadow-sm mb-4" id="area-estado-produccion">
                    <div class="card-header border-0 d-flex justify-content-between align-items-center py-2 pl-3 pr-2">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-chart-pie text-warning mr-2"></i>Estado de Producción
                            <span class="badge badge-light border text-warning ml-2 font-weight-bold" style="font-size: 0.75rem;"><i class="fas fa-filter mr-1"></i>@sedeSesionNombre (@anioSesion)</span>
                        </h3>
                        <div class="card-tools d-inline-flex align-items-center ml-auto m-0">
                            <span class="badge badge-warning px-2 py-1 mr-2" id="badge-prod-mes"><i class="fas fa-calendar-alt mr-1"></i>Mes Actual</span>
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Minimizar">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-1 pb-3" style="position: relative; height: 260px;">
                        <canvas id="productionChart" height="210"></canvas>
                        <div id="productionChartEmpty" class="d-none text-center text-muted" style="position: absolute; top: 45%; left: 0; right: 0; transform: translateY(-50%);">
                            <i class="fas fa-industry fa-2x mb-2 text-secondary" style="opacity: 0.5;"></i>
                            <div class="font-weight-500">Sin &oacute;rdenes de producci&oacute;n registradas</div>
                            <small class="text-muted">en el mes actual</small>
                        </div>
                    </div>
                </div>

                <!-- 4. Widget: Agenda del Calendario -->
                <div class="card card-primary card-outline shadow-sm mb-4" id="area-agenda-calendario" style="border-radius: 8px;">
                    <div class="card-header border-0 d-flex flex-wrap justify-content-between align-items-center py-2 pl-3 pr-2" style="gap: 8px;">
                        <div class="d-flex align-items-center flex-wrap" style="gap: 8px;">
                            <h3 class="card-title font-weight-bold m-0" style="font-size: 1rem;">
                                <i class="fas fa-calendar-check text-primary mr-1"></i> Agenda de Eventos
                            </h3>
                            @if (!esAdminAgenda && !tieneMultiplesAreasAgenda)
                            {
                                <span class="badge badge-primary px-2 py-1 font-weight-600 shadow-none" id="badge-agenda-area-fija" title="Área asignada">
                                    <i class="fas fa-layer-group mr-1"></i>@areaAgendaInicialNombre
                                </span>
                                <input type="hidden" id="select-agenda-area" value="@areaAgendaInicialId" />
                            }
                        </div>
                        <div class="card-tools d-inline-flex flex-wrap align-items-center ml-auto m-0" style="gap: 6px;">
                            @if (esAdminAgenda || tieneMultiplesAreasAgenda)
                            {
                                <div class="d-inline-flex align-items-center">
                                    <label for="select-agenda-area" class="text-xs text-muted mb-0 mr-1 d-none d-sm-inline font-weight-normal">&Aacute;rea:</label>
                                    <select id="select-agenda-area" class="form-control form-control-sm font-weight-600 shadow-none border-primary text-primary" style="width: auto; min-width: 145px; height: 30px; font-size: 0.82rem; padding: 2px 8px;" title="Seleccionar &Aacute;rea">
                                        @foreach (var area in areasAgenda)
                                        {
                                            if (area.AreaId == areaAgendaInicialId)
                                            {
                                                <option value="@area.AreaId" selected="selected">@area.Nombre</option>
                                            }
                                            else
                                            {
                                                <option value="@area.AreaId">@area.Nombre</option>
                                            }
                                        }
                                    </select>
                                </div>
                            }
                            <a href="javascript:void(0);" onclick="if (window.updateNavbarBreadcrumb) { window.updateNavbarBreadcrumb(['Inicio', 'Calendario']); } $(this).getView({ urlAction: 'calendario/index' });" class="btn btn-xs btn-outline-primary px-2 py-1 font-weight-600" title="Abrir Calendario completo" style="height: 28px; display: inline-flex; align-items: center;">
                                <i class="fas fa-calendar-alt mr-1"></i> Ir al Calendario
                            </a>
                            <button type="button" class="btn btn-tool" id="btn-recargar-agenda" title="Actualizar Agenda" style="height: 28px; width: 28px; display: inline-flex; align-items: center; justify-content: center;">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Minimizar">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-2" style="position: relative;">
                        <!-- Contenedor FullCalendar de Agenda -->
                        <div id="calendar-agenda-widget" style="min-height: 260px; max-height: 380px; overflow-y: auto;"></div>
                        <div id="agenda-loading-spinner" class="d-none text-center py-4 text-muted">
                            <i class="fas fa-circle-notch fa-spin fa-2x text-primary mb-2"></i>
                            <div class="font-weight-500 text-sm">Cargando agenda...</div>
                        </div>
                    </div>
                    <div class="card-footer py-1 px-3 bg-light border-top-0 d-flex justify-content-between align-items-center" style="font-size: 0.75rem;">
                        <span class="text-muted"><i class="fas fa-info-circle text-info mr-1"></i> Vista de agenda semanal continua</span>
                        <span class="text-muted font-weight-bold" id="agenda-area-info-footer">@areaAgendaInicialNombre</span>
                    </div>
                </div>

                <!-- 5. Tarjeta informativa de Base de Datos en Tiempo Real -->
                <div class="card card-outline card-success shadow-sm mb-4" id="area-db-tiempo-real" style="border-radius: 8px;">
                    <div class="card-header border-0 d-flex justify-content-between align-items-center py-2 pl-3 pr-2">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-database text-success mr-2"></i>Base de Datos en Tiempo Real
                        </h3>
                        <div class="card-tools d-inline-flex align-items-center ml-auto m-0">
                            <span class="badge badge-success px-2 py-1 mr-2"><i class="fas fa-check-circle mr-1"></i>Sincronizado</span>
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Minimizar">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-0 pb-3">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <span class="text-muted font-weight-normal text-sm">
                                Cat&aacute;logo: <code>esderp_v6</code> &bull; Polling activo cada 30s
                            </span>
                        </div>
                        <div class="progress my-2" style="height: 4px; border-radius: 2px;">
                            <div class="progress-bar bg-success" style="width: 100%"></div>
                        </div>
                        <span class="text-muted text-xs d-block">
                            <i class="fas fa-bolt text-success mr-1"></i> Totales y m&eacute;tricas calculados directamente desde BD
                        </span>
                    </div>
                </div>

            </div>

        </div>

        <!-- 3. SECCION: TOP 5/10 PEDIDOS DEL DIA Y CLIENTES INACTIVOS -->
        <div class="row" id="row-tablas-detalle">
            <!-- 3.1. Top 5 / Top 10 Pedidos del Día (Izquierda) -->
            <div class="col-lg-6 mb-4" id="area-top-pedidos">
                <div class="card card-primary card-outline shadow-sm mb-4">
                    <div class="card-header border-0 d-flex justify-content-between align-items-center py-2 pl-3 pr-2">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-crown text-warning mr-2"></i>Top Pedidos del D&iacute;a
                            <span class="badge badge-light border text-primary ml-2 font-weight-bold" style="font-size: 0.75rem;"><i class="fas fa-filter mr-1"></i>@sedeSesionNombre (@anioSesion)</span>
                        </h3>
                        <div class="card-tools d-inline-flex align-items-center ml-auto m-0">
                            <div class="btn-group btn-group-sm mr-2" role="group" aria-label="Cantidad pedidos">
                                <button type="button" class="btn btn-primary active btn-sm px-2" id="btn-top-5" onclick="cambiarTopPedidos(5);">Top 5</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm px-2" id="btn-top-10" onclick="cambiarTopPedidos(10);">Top 10</button>
                            </div>
                            <span class="badge badge-primary px-2 py-1 mr-2" id="badge-top-pedidos"><i class="fas fa-calendar-day mr-1"></i>Top 5 · @topPedidosFecha</span>
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Minimizar">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-striped table-hover table-sm table-valign-middle mb-0" id="tabla-top-pedidos">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 24%; text-align: center;">ID del Pedido</th>
                                    <th>Cliente</th>
                                    <th style="width: 28%; text-align: right;">Monto / Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (topPedidos != null && topPedidos.Count > 0)
                                {
                                    int ranking = 1;
                                    foreach (var p in topPedidos.OrderByDescending(x => x.Monto).Take(5))
                                    {
                                        string badgeClass = ranking == 1 ? "badge-podium-gold" :
                                                            ranking == 2 ? "badge-podium-silver" :
                                                            ranking == 3 ? "badge-podium-bronze" : "badge-podium-default";
                                        string rankIcon = ranking <= 3 ? "<i class=\"fas fa-medal mr-1\"></i>" : "";
                                        <tr class="dashboard-drilldown-row" role="link" tabindex="0" data-cotizacion-id="@p.Id">
                                            <td class="text-center font-weight-bold text-primary py-2" style="white-space: nowrap;">
                                                <span class="badge @badgeClass mr-1">@Html.Raw(rankIcon)#@ranking</span>
                                                <span>@p.Codigo</span>
                                            </td>
                                            <td class="py-2">
                                                <span class="font-weight-600">@p.Cliente</span>
                                            </td>
                                            <td class="text-right font-weight-bold text-success py-2" style="white-space: nowrap;">
                                                @p.MontoFormateado
                                            </td>
                                        </tr>
                                        ranking++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-3">
                                            <i class="fas fa-info-circle mr-1"></i> No se registran pedidos el @topPedidosFecha
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer clearfix border-top-0 py-2">
                        <small class="text-muted"><i class="fas fa-info-circle mr-1"></i>Pedidos m&aacute;s grandes registrados el @topPedidosFecha</small>
                        <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'pedido/index' });" class="btn btn-xs btn-outline-primary float-right">
                            <i class="fas fa-list mr-1"></i>Ver Todos los Pedidos
                        </a>
                    </div>
                </div>
            </div>

            <!-- 3.2. Clientes sin Compras (+5 Meses) (Derecha) -->
            <div class="col-lg-6 mb-4" id="area-clientes-inactivos">
                <div class="card card-warning card-outline shadow-sm mb-4">
                    <div class="card-header border-0 d-flex justify-content-between align-items-center py-2 pl-3 pr-2">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-user-clock text-warning mr-2"></i>Clientes sin Compras (<span id="label-meses-inactivos">&ge; 5 Meses</span>)
                            <span class="badge badge-light border text-warning ml-2 font-weight-bold" style="font-size: 0.75rem;"><i class="fas fa-filter mr-1"></i>@sedeSesionNombre</span>
                        </h3>
                        <div class="card-tools d-inline-flex flex-wrap align-items-center ml-auto m-0" style="gap: 5px;">
                            <div class="d-inline-flex align-items-center mr-2">
                                <select id="select-meses-inactivos" class="form-control form-control-sm" style="width: auto; height: 28px; padding: 2px 8px; font-size: 0.8rem;">
                                    <option value="3">&ge; 3 Meses</option>
                                    <option value="4">&ge; 4 Meses</option>
                                    <option value="5" selected>&ge; 5 Meses</option>
                                    <option value="6">&ge; 6 Meses</option>
                                </select>
                            </div>
                            @if (puedeFiltrarVendedorClientes)
                            {
                                <select id="select-vendedor-inactivos" class="form-control form-control-sm" aria-label="Filtrar clientes por vendedor" style="width: 165px; height: 28px; padding: 2px 8px; font-size: 0.8rem;">
                                    <option value="" selected>Todos los Vendedores</option>
                                    @foreach (var vendedor in listaVendedores.OrderBy(v => v.nombre))
                                    {
                                        <option value="@vendedor.id">@vendedor.nombre</option>
                                    }
                                </select>
                            }
                            <button type="button" class="btn btn-outline-secondary btn-sm mr-2" id="btn-ver-mas-clientes" onclick="alternarVerMasClientesInactivos();" style="height: 28px; padding: 2px 8px; font-size: 0.8rem;">
                                <i class="fas fa-chevron-down mr-1"></i>Ver m&aacute;s (10)
                            </button>
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Minimizar">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-striped table-hover table-sm table-valign-middle mb-0" id="tabla-clientes-inactivos">
                            <thead class="thead-light">
                                <tr>
                                    @if (esAdmin)
                                    {
                                        <th style="width: 44%;">Cliente</th>
                                        <th style="width: 32%;">Vendedor</th>
                                        <th style="width: 24%; text-align: right;">&Uacute;ltima Compra</th>
                                    }
                                    else
                                    {
                                        <th style="width: 68%;">Cliente</th>
                                        <th style="width: 32%; text-align: right;">&Uacute;ltima Compra</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (clientesInactivos != null && clientesInactivos.Count > 0)
                                {
                                    foreach (var c in clientesInactivos.Take(5))
                                    {
                                        <tr class="dashboard-drilldown-row" role="link" tabindex="0" data-cliente-nombre="@System.Uri.EscapeDataString(c.Cliente ?? string.Empty)">
                                            <td class="py-2">
                                                <span class="font-weight-600">@c.Cliente</span>
                                            </td>
                                            @if (esAdmin)
                                            {
                                                <td class="py-2 text-truncate" style="max-width: 150px;">
                                                    <span class="text-muted"><i class="fas fa-user-tie text-secondary mr-1"></i>@(string.IsNullOrWhiteSpace(c.Vendedor) ? "Sin vendedor" : c.Vendedor)</span>
                                                </td>
                                            }
                                            <td class="text-right py-2" style="white-space: nowrap;">
                                                <span class="badge badge-warning text-dark font-weight-bold px-2 py-1">
                                                    <i class="far fa-calendar-alt mr-1"></i>@c.FechaFormateada
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="@(esAdmin ? 3 : 2)" class="text-center text-muted py-3">
                                            <i class="fas fa-check-circle text-success mr-1"></i> No se encontraron clientes con inactividad superior a 5 meses
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer clearfix border-top-0 py-2">
                        <small class="text-muted"><i class="fas fa-exclamation-triangle text-warning mr-1"></i>Listado ordenado por mayor tiempo de inactividad</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. SECCION: STOCK Y CONSUMO DE INSUMOS CRITICOS EN TIEMPO REAL -->
        <div class="row" id="row-stock-insumos">
            <div class="col-12 mb-4">
                <div class="card card-info card-outline shadow-sm mb-4">
                    <div class="card-header border-0 d-flex flex-wrap justify-content-between align-items-center py-2 pl-3 pr-2">
                        <div class="d-flex align-items-center flex-wrap">
                            <h3 class="card-title font-weight-bold m-0" style="font-size: 1.05rem;">
                                <i class="fas fa-boxes text-info mr-2"></i>Stock y Consumo de Insumos Cr&iacute;ticos
                                <span class="badge badge-light border text-info ml-2 font-weight-bold" style="font-size: 0.75rem;"><i class="fas fa-filter mr-1"></i>@sedeSesionNombre</span>
                            </h3>
                            <span class="badge badge-info px-2 py-1 ml-2 font-weight-600 shadow-none" id="badge-stock-insumos" style="font-size: 0.75rem;">
                                <i class="fas fa-satellite-dish mr-1"></i>En Vivo
                            </span>
                        </div>
                        <div class="card-tools d-inline-flex flex-wrap align-items-center ml-auto m-0" style="gap: 8px;">
                            <!-- Buscador rapido -->
                            <div class="input-group input-group-sm" style="width: 220px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-light border-right-0 py-0"><i class="fas fa-search text-muted" style="font-size: 0.85rem;"></i></span>
                                </div>
                                <input type="text" id="filtro-stock-insumos" class="form-control form-control-sm border-left-0" placeholder="Filtrar por c&oacute;digo/nombre..." title="Filtrar insumos en tiempo real" style="height: 31px;">
                            </div>

                            <!-- Selector de Almacen -->
                            <div class="d-inline-flex align-items-center">
                                <select id="select-almacen-stock" class="form-control form-control-sm font-weight-600 shadow-sm" style="width: auto; min-width: 220px; height: 31px; font-size: 0.825rem;">
                                    <option value="0" selected>Todos los Almacenes (Consolidado)</option>
                                    @if (listaAlmacenesStock != null)
                                    {
                                        foreach (var alm in listaAlmacenesStock)
                                        {
                                            <option value="@alm.AlmacenId">@alm.Nombre</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- Boton Recargar -->
                            <button type="button" class="btn btn-outline-info btn-sm shadow-none px-2" id="btn-recargar-stock-insumos" title="Actualizar Stock en tiempo real" style="height: 31px;">
                                <i class="fas fa-sync-alt" id="icon-recargar-stock"></i>
                            </button>

                            <!-- Minimizar -->
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Minimizar">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-striped table-hover table-sm table-valign-middle mb-0" id="tabla-stock-insumos">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 5%; text-align: center;">#</th>
                                    <th style="width: 15%; text-align: center;">C&oacute;digo</th>
                                    <th style="width: 32%;">Descripci&oacute;n del Producto</th>
                                    <th style="width: 18%; text-align: right;">Consumo Mes</th>
                                    <th style="width: 30%; text-align: right;">Stock / Saldo Actual</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-stock-insumos">
                                @if (listaStockInsumos != null && listaStockInsumos.Count > 0)
                                {
                                    foreach (var prod in listaStockInsumos)
                                    {
                                        <tr class="fila-producto-stock" data-codigo="@prod.Codigo" data-desc="@prod.Descripcion.ToLowerInvariant()">
                                            <td class="text-center font-weight-bold text-muted py-2" style="font-size: 0.85rem;">
                                                @prod.Orden
                                            </td>
                                            <td class="text-center py-2" style="white-space: nowrap;">
                                                <span class="badge badge-secondary font-weight-bold px-2 py-1" style="font-family: monospace; font-size: 0.85rem; letter-spacing: 0.03em;">
                                                    @prod.Codigo
                                                </span>
                                            </td>
                                            <td class="py-2" style="max-width: 380px;">
                                                <span class="font-weight-600">@prod.Descripcion</span>
                                            </td>
                                            <td class="text-right py-2 font-weight-bold" style="white-space: nowrap; font-size: 0.95rem;">
                                                @prod.ConsumoMesFormateado <small class="font-weight-normal text-muted">@prod.UnidadMedida</small>
                                            </td>
                                            <td class="text-right py-2" style="white-space: nowrap;">
                                                <div class="d-inline-flex align-items-center justify-content-end" style="gap: 8px;">
                                                    @if (prod.BadgeColor == "success")
                                                    {
                                                        <span class="badge badge-success px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-check-circle mr-1"></i>@prod.EstadoStock</span>
                                                    }
                                                    else if (prod.BadgeColor == "warning")
                                                    {
                                                        <span class="badge badge-warning text-dark px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-exclamation-triangle mr-1"></i>@prod.EstadoStock</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-danger px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-times-circle mr-1"></i>@prod.EstadoStock</span>
                                                    }
                                                    <span class="font-weight-bold @(prod.StockActual <= 0 ? "text-danger" : "text-primary")" style="font-size: 0.95rem;">
                                                        @prod.StockActualFormateado <small class="font-weight-normal text-muted">@prod.UnidadMedida</small>
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            <i class="fas fa-info-circle mr-1"></i> No se encontraron registros de stock para los insumos.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer clearfix border-top-0 py-2 d-flex flex-wrap justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="fas fa-info-circle text-info mr-1"></i>Saldo en tiempo real de <code>mov_alm_saldo</code> y consumo acumulado en el mes actual (<span id="span-mes-stock-insumos">@mesActualStock</span>).
                        </small>
                        <span class="badge badge-light border text-muted px-2 py-1 font-weight-600" id="badge-stock-insumos-total">
                            <i class="fas fa-clipboard-list mr-1"></i><span id="span-cant-insumos-monitoreados">@(listaStockInsumos != null ? listaStockInsumos.Count : 0)</span> Insumos Monitoreados
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. SECCION: TOP 10 PRODUCTOS CON MENOR STOCK -->
        <div class="row" id="row-top-menor-stock">
            <div class="col-12 mb-4">
                <div class="card card-danger card-outline shadow-sm mb-4">
                    <div class="card-header border-0 d-flex flex-wrap justify-content-between align-items-center py-2 pl-3 pr-2">
                        <div class="d-flex align-items-center flex-wrap">
                            <h3 class="card-title font-weight-bold m-0" style="font-size: 1.05rem;">
                                <i class="fas fa-boxes text-danger mr-2"></i>Top 10 Productos con Menor Stock
                                <span id="badge-menor-stock-sede" class="badge badge-light border text-danger ml-2 font-weight-bold" style="font-size: 0.75rem;"><i class="fas fa-filter mr-1"></i>@sedeSesionNombre</span>
                            </h3>
                            <span class="badge badge-danger px-2 py-1 ml-2 font-weight-600 shadow-none" style="font-size: 0.75rem;">
                                <i class="fas fa-exclamation-triangle mr-1"></i>Inventario Cr&iacute;tico
                            </span>
                        </div>
                        <div class="card-tools d-inline-flex flex-wrap align-items-center ml-auto m-0" style="gap: 8px;">
                            <!-- Filtro Sede -->
                            <div class="d-inline-flex align-items-center">
                                <select id="filtro-menor-stock-sede" class="form-control form-control-sm font-weight-600 shadow-sm" style="width: auto; min-width: 135px; height: 31px; font-size: 0.825rem;" title="Filtrar por Sede">
                                    @if (sedeSesionId == 2)
                                    {
                                        <option value="1">Sede Central</option>
                                        <option value="2" selected="selected">Sede Ilo</option>
                                    }
                                    else
                                    {
                                        <option value="1" selected="selected">Sede Central</option>
                                        <option value="2">Sede Ilo</option>
                                    }
                                </select>
                            </div>

                            <!-- Filtro Grupo -->
                            <div class="d-inline-flex align-items-center">
                                <select id="filtro-menor-stock-grupo" class="form-control form-control-sm font-weight-600 shadow-sm" style="width: auto; min-width: 170px; height: 31px; font-size: 0.825rem;" title="Filtrar por Grupo">
                                    <option value="">-- Todos los Grupos --</option>
                                    @if (listaGruposProducto != null)
                                    {
                                        foreach (var grp in listaGruposProducto)
                                        {
                                            <option value="@grp.Id">@grp.Nombre</option>
                                        }
                                    }
                                </select>
                            </div>

                            <!-- Filtro Clase -->
                            <div class="d-inline-flex align-items-center">
                                <select id="filtro-menor-stock-clase" class="form-control form-control-sm font-weight-600 shadow-sm" style="width: auto; min-width: 170px; height: 31px; font-size: 0.825rem;" title="Filtrar por Clase">
                                    <option value="">-- Todas las Clases --</option>
                                </select>
                            </div>

                            <!-- Filtro Familia -->
                            <div class="d-inline-flex align-items-center">
                                <select id="filtro-menor-stock-familia" class="form-control form-control-sm font-weight-600 shadow-sm" style="width: auto; min-width: 170px; height: 31px; font-size: 0.825rem;" title="Filtrar por Familia">
                                    <option value="">-- Todas las Familias --</option>
                                </select>
                            </div>

                            <!-- Boton Limpiar Filtros -->
                            <button type="button" class="btn btn-outline-secondary btn-sm shadow-none px-2" id="btn-limpiar-filtro-menor-stock" title="Limpiar todos los filtros" style="height: 31px;">
                                <i class="fas fa-undo"></i>
                            </button>

                            <!-- Boton Recargar -->
                            <button type="button" class="btn btn-outline-danger btn-sm shadow-none px-2" id="btn-recargar-menor-stock" title="Actualizar en tiempo real" style="height: 31px;">
                                <i class="fas fa-sync-alt" id="icon-recargar-menor-stock"></i>
                            </button>

                            <!-- Minimizar -->
                            <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Minimizar">
                                <i class="fas fa-minus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-striped table-hover table-sm table-valign-middle mb-0" id="tabla-top-menor-stock">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 5%; text-align: center;">#</th>
                                    <th style="width: 14%; text-align: center;">C&oacute;digo</th>
                                    <th style="width: 33%;">Nombre del Producto</th>
                                    <th style="width: 28%;">Categor&iacute;a</th>
                                    <th style="width: 20%; text-align: right;">Cantidad (Stock)</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-top-menor-stock">
                                @if (listaTopMenorStock != null && listaTopMenorStock.Count > 0)
                                {
                                    foreach (var prod in listaTopMenorStock)
                                    {
                                        <tr>
                                            <td class="text-center font-weight-bold text-muted py-2" style="font-size: 0.85rem;">
                                                <span class="badge @(prod.Orden <= 3 ? "badge-danger" : "badge-secondary") font-weight-bold" style="font-size: 0.8rem; border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center;">
                                                    @prod.Orden
                                                </span>
                                            </td>
                                            <td class="text-center py-2" style="white-space: nowrap;">
                                                <span class="badge badge-light border font-weight-bold px-2 py-1 text-dark" style="font-family: monospace; font-size: 0.85rem; letter-spacing: 0.03em;">
                                                    @prod.Codigo
                                                </span>
                                            </td>
                                            <td class="py-2" style="max-width: 350px;">
                                                <div class="font-weight-600 text-dark">@prod.Nombre</div>
                                            </td>
                                            <td class="py-2" style="font-size: 0.85rem;">
                                                <span class="text-muted font-weight-500">@prod.CategoriaCompleta</span>
                                            </td>
                                            <td class="text-right py-2" style="white-space: nowrap;">
                                                <div class="d-inline-flex align-items-center justify-content-end" style="gap: 8px;">
                                                    @if (prod.BadgeColor == "danger")
                                                    {
                                                        <span class="badge badge-danger px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-times-circle mr-1"></i>@prod.EstadoStock</span>
                                                    }
                                                    else if (prod.BadgeColor == "warning")
                                                    {
                                                        <span class="badge badge-warning text-dark px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-exclamation-triangle mr-1"></i>@prod.EstadoStock</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-info px-2 py-1 font-weight-600" style="font-size: 0.75rem;"><i class="fas fa-info-circle mr-1"></i>@prod.EstadoStock</span>
                                                    }
                                                    <span class="font-weight-bold text-danger" style="font-size: 1rem;">
                                                        @prod.CantidadFormateada <small class="font-weight-bold text-secondary">@prod.UnidadMedida</small>
                                                    </span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            <i class="fas fa-info-circle mr-1"></i> No se encontraron productos con menor stock para el filtro seleccionado.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer clearfix border-top-0 py-2 d-flex flex-wrap justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="fas fa-info-circle text-danger mr-1"></i>Top 10 productos con menor stock vinculados al m&oacute;dulo Volumen de Existencias en tiempo real.
                        </small>
                        <span class="badge badge-light border text-muted px-2 py-1 font-weight-600" id="badge-filtro-menor-stock-info">
                            <i class="fas fa-filter mr-1"></i>Filtro: Todos los Grupos
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================== -->
<!-- MODAL: GESTIONAR DASHBOARD (Areas Visibles)              -->
<!-- ======================================================== -->
<div class="modal fade" id="modal-gestionar-dashboard" tabindex="-1" role="dialog" aria-labelledby="modalGestionarDashboardLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content shadow-lg border-0" style="border-radius: 12px; overflow: hidden;">
            <div class="modal-header bg-light py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="modal-header-icon mr-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 8px; background-color: rgba(0, 123, 255, 0.12); color: #007bff; flex-shrink: 0;">
                        <i class="fas fa-sliders-h fa-lg"></i>
                    </div>
                    <div>
                        <h5 class="modal-title font-weight-bold mb-0 text-dark" id="modalGestionarDashboardLabel" style="font-size: 1.15rem;">
                            Gestionar Dashboard
                        </h5>
                        <small class="text-muted">Activa o desactiva las &aacute;reas que deseas visualizar en tu pantalla de inicio</small>
                    </div>
                </div>
                <div class="d-flex align-items-center">
                    <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm font-weight-600 mr-2" data-dismiss="modal" id="btn-modal-aceptar-header">
                        <i class="fas fa-check mr-1"></i> Aceptar
                    </button>
                    <button type="button" class="close text-secondary" data-dismiss="modal" aria-label="Cerrar" style="font-size: 1.5rem; opacity: 0.6; outline: none;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </div>
            <div class="modal-body p-4" style="background-color: #f8fafc; max-height: 70vh; overflow-y: auto;">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <span class="text-xs font-weight-600 text-uppercase text-muted" style="letter-spacing: 0.05em;">
                        &Aacute;reas del Dashboard (<span id="modal-conteo-areas-activas" class="font-weight-bold text-primary">12</span> de <span id="modal-conteo-areas-permitidas" class="font-weight-bold text-dark">12</span> disponibles)
                    </span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-primary btn-xs px-2" id="btn-modal-marcar-todos" title="Mostrar todas las áreas">
                            <i class="fas fa-check-double mr-1"></i>Marcar Todos
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-xs px-2" id="btn-modal-desmarcar-todos" title="Ocultar todas las áreas">
                            <i class="fas fa-times mr-1"></i>Desmarcar Todos
                        </button>
                        <button type="button" class="btn btn-outline-info btn-xs px-2" id="btn-modal-restablecer" title="Restablecer vista por defecto">
                            <i class="fas fa-undo mr-1"></i>Restablecer
                        </button>
                    </div>
                </div>

                <div id="modal-areas-ninguna-permitida" class="alert alert-warning text-center py-3 d-none mb-3" style="border-radius: 8px;">
                    <i class="fas fa-lock mr-2"></i>El administrador ha desactivado todos los controles para este rol.
                </div>

                <div class="d-flex flex-column" style="gap: 10px;">
                    <!-- 1. Tarjetas de Métricas -->
                    <label class="dashboard-area-card d-flex align-items-center justify-content-between p-3 m-0 rounded bg-white border shadow-sm" for="chk-area-kpis" style="cursor: pointer; transition: all 0.2s ease;">
                        <div class="d-flex align-items-center mr-3">
                            <div class="icon-box-area mr-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; border-radius: 8px; background-color: rgba(23, 162, 184, 0.12); color: #17a2b8; flex-shrink: 0;">
                                <i class="fas fa-th-large fa-lg"></i>
                            </div>
                            <div>
                                <div class="font-weight-600 text-dark mb-0" style="font-size: 0.95rem;">Tarjetas de M&eacute;tricas (KPIs)</div>
                                <small class="text-muted">Facturaci&oacute;n del Mes, Pedidos Activos, Cotizaciones, &Oacute;rdenes de Producción y Compras</small>
                            </div>
                        </div>
                        <div class="custom-control custom-switch custom-switch-md" style="flex-shrink: 0;">
                            <input type="checkbox" class="custom-control-input chk-dashboard-area" id="chk-area-kpis" data-area="kpis" checked>
                            <label class="custom-control-label" for="chk-area-kpis"></label>
                        </div>
                    </label>

                    <!-- Sub-controles de Tarjetas Individuales de KPIs (Desplegable) -->
                    <div id="sub-kpis-container" class="ml-3 pl-3 pr-2 py-3 border-left" style="border-left: 3px solid #17a2b8 !important; display: none; background: rgba(248, 249, 250, 0.85); border-radius: 0 8px 8px 0;">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <small class="font-weight-700 text-uppercase text-secondary" style="letter-spacing: 0.05em; font-size: 0.72rem;">
                                <i class="fas fa-layer-group text-info mr-1"></i> Controles de Tarjetas Individuales:
                            </small>
                            <span class="badge badge-light border text-muted px-2 py-0" style="font-size: 0.7rem;" id="badge-conteo-kpis-activos">9 activas</span>
                        </div>
                        <div class="sub-kpis-grid-2">
                            <div class="sub-kpi-card d-flex align-items-center justify-content-between px-3 py-2 rounded bg-white border" data-kpi="kpi-facturacion" style="transition: all 0.2s ease;">
                                <div class="d-flex align-items-center text-truncate mr-2">
                                    <span class="badge mr-2 px-2 py-1" style="background-color: rgba(23, 162, 184, 0.15); color: #17a2b8;"><i class="fas fa-shopping-cart"></i></span>
                                    <span class="font-weight-600 text-dark text-truncate" style="font-size: 0.88rem;">Facturaci&oacute;n del Mes</span>
                                </div>
                                <div class="custom-control custom-switch custom-switch-sm m-0" style="flex-shrink: 0;">
                                    <input type="checkbox" class="custom-control-input chk-sub-kpi" id="chk-sub-kpi-facturacion" data-kpi="kpi-facturacion" checked>
                                    <label class="custom-control-label" for="chk-sub-kpi-facturacion"></label>
                                </div>
                            </div>
                            <div class="sub-kpi-card d-flex align-items-center justify-content-between px-3 py-2 rounded bg-white border" data-kpi="kpi-pedidos-activos" style="transition: all 0.2s ease;">
                                <div class="d-flex align-items-center text-truncate mr-2">
                                    <span class="badge mr-2 px-2 py-1" style="background-color: rgba(0, 123, 255, 0.15); color: #007bff;"><i class="fas fa-dolly"></i></span>
                                    <span class="font-weight-600 text-dark text-truncate" style="font-size: 0.88rem;">Pedidos Activos</span>
                                </div>
                                <div class="custom-control custom-switch custom-switch-sm m-0" style="flex-shrink: 0;">
                                    <input type="checkbox" class="custom-control-input chk-sub-kpi" id="chk-sub-kpi-pedidos-activos" data-kpi="kpi-pedidos-activos" checked>
                                    <label class="custom-control-label" for="chk-sub-kpi-pedidos-activos"></label>
                                </div>
                            </div>
                            <div class="sub-kpi-card d-flex align-items-center justify-content-between px-3 py-2 rounded bg-white border" data-kpi="kpi-cotizaciones" style="transition: all 0.2s ease;">
                                <div class="d-flex align-items-center text-truncate mr-2">
                                    <span class="badge mr-2 px-2 py-1" style="background-color: rgba(40, 167, 69, 0.15); color: #28a745;"><i class="fas fa-file-invoice-dollar"></i></span>
                                    <span class="font-weight-600 text-dark text-truncate" style="font-size: 0.88rem;">Cotizaciones Activas</span>
                                </div>
                                <div class="custom-control custom-switch custom-switch-sm m-0" style="flex-shrink: 0;">
                                    <input type="checkbox" class="custom-control-input chk-sub-kpi" id="chk-sub-kpi-cotizaciones" data-kpi="kpi-cotizaciones" checked>
                                    <label class="custom-control-label" for="chk-sub-kpi-cotizaciones"></label>
                                </div>
                            </div>
                            <div class="sub-kpi-card d-flex align-items-center justify-content-between px-3 py-2 rounded bg-white border" data-kpi="kpi-produccion" style="transition: all 0.2s ease;">
                                <div class="d-flex align-items-center text-truncate mr-2">
                                    <span class="badge mr-2 px-2 py-1" style="background-color: rgba(255, 193, 7, 0.18); color: #d39e00;"><i class="fas fa-industry"></i></span>
                                    <span class="font-weight-600 text-dark text-truncate" style="font-size: 0.88rem;">Producción del Mes</span>
                                </div>
                                <div class="custom-control custom-switch custom-switch-sm m-0" style="flex-shrink: 0;">
                                    <input type="checkbox" class="custom-control-input chk-sub-kpi" id="chk-sub-kpi-produccion" data-kpi="kpi-produccion" checked>
                                    <label class="custom-control-label" for="chk-sub-kpi-produccion"></label>
                                </div>
                            </div>
                            <div class="sub-kpi-card d-flex align-items-center justify-content-between px-3 py-2 rounded bg-white border" data-kpi="kpi-compras" style="transition: all 0.2s ease;">
                                <div class="d-flex align-items-center text-truncate mr-2">
                                    <span class="badge mr-2 px-2 py-1" style="background-color: rgba(220, 53, 69, 0.15); color: #dc3545;"><i class="fas fa-truck-loading"></i></span>
                                    <span class="font-weight-600 text-dark text-truncate" style="font-size: 0.88rem;">Compras del Mes</span>
                                </div>
                                <div class="custom-control custom-switch custom-switch-sm m-0" style="flex-shrink: 0;">
                                    <input type="checkbox" class="custom-control-input chk-sub-kpi" id="chk-sub-kpi-compras" data-kpi="kpi-compras" checked>
                                    <label class="custom-control-label" for="chk-sub-kpi-compras"></label>
                                </div>
                            </div>
                            <div class="sub-kpi-card d-flex align-items-center justify-content-between px-3 py-2 rounded bg-white border" data-kpi="kpi-pedidos-mes" style="transition: all 0.2s ease;">
                                <div class="d-flex align-items-center text-truncate mr-2">
                                    <span class="badge mr-2 px-2 py-1" style="background-color: rgba(37, 99, 235, 0.15); color: #2563eb;"><i class="fas fa-clipboard-check"></i></span>
                                    <span class="font-weight-600 text-dark text-truncate" style="font-size: 0.88rem;">Pedidos del Mes</span>
                                </div>
                                <div class="custom-control custom-switch custom-switch-sm m-0" style="flex-shrink: 0;">
                                    <input type="checkbox" class="custom-control-input chk-sub-kpi" id="chk-sub-kpi-pedidos-mes" data-kpi="kpi-pedidos-mes" checked>
                                    <label class="custom-control-label" for="chk-sub-kpi-pedidos-mes"></label>
                                </div>
                            </div>
                            <div class="sub-kpi-card d-flex align-items-center justify-content-between px-3 py-2 rounded bg-white border" data-kpi="kpi-consumo-interno" style="transition: all 0.2s ease;">
                                <div class="d-flex align-items-center text-truncate mr-2">
                                    <span class="badge mr-2 px-2 py-1" style="background-color: rgba(13, 148, 136, 0.15); color: #0d9488;"><i class="fas fa-dolly-flatbed"></i></span>
                                    <span class="font-weight-600 text-dark text-truncate" style="font-size: 0.88rem;">Consumo Interno</span>
