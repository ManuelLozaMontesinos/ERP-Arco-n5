                    /* Estilos para Gestionar Dashboard */
                    #btn-gestionar-dashboard {
                        transition: all 0.2s ease;
                        border-radius: 6px;
                    }
                    #btn-gestionar-dashboard:hover {
                        transform: translateY(-1px);
