@{
    ViewData["Title"] = "Tablero Principal";
    string cid = ViewBag.cid;
    string facturacionMes = ViewBag.FacturacionMes ?? "S/ 1,506,785.22";
    string pedidosActivos = ViewBag.PedidosActivos ?? "169";
    string cotizacionesActivas = ViewBag.CotizacionesActivas ?? "7,637";
    string ordenesProduccionMes = ViewBag.OrdenesProduccionMes ?? "1,510";
    string ordenesCompraMes = ViewBag.OrdenesCompraMes ?? "18";
}
<script type="text/javascript">
    if (window.resetNavbarBreadcrumb) {
        window.resetNavbarBreadcrumb();
    }
</script>

<!-- Content Header (Page header) -->
<div class="content-header pb-2">
    <div class="container-fluid">
        <div class="row align-items-center mb-1">
            <div class="col-sm-12">
                <h1 class="m-0 text-dark font-weight-bold" style="font-size: 1.45rem; letter-spacing: -0.02em;">
                    <i class="fas fa-tachometer-alt text-primary mr-2"></i>Tablero de Control
                </h1>
                <small class="text-muted" style="font-size: 0.825rem;">SIGANET ERP &mdash; Métricas en Tiempo Real (Sincronizado con BD <code>esderp_v6</code>)</small>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">

        <!-- 1. FILA DE TARJETAS KPI (4 por fila, la 5ta cae a la 2da fila) -->
        <div class="row">
            <!-- 1. Facturación del mes -->
            <div class="col-xl-3 col-lg-3 col-md-6 col-12 mb-3">
                <div class="small-box bg-info shadow-sm h-100 mb-0" style="transition: transform 0.2s ease, box-shadow 0.2s ease; border-radius: 8px;">
                    <div class="inner">
                        <h3 id="kpi-ventas">@facturacionMes</h3>
                        <p class="font-weight-500">Facturación del Mes</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'comprobante/index' });" class="small-box-footer font-weight-500">
                        Ver Comprobantes <i class="fas fa-arrow-circle-right ml-1"></i>
                    </a>
                </div>
            </div>

            <!-- 2. Pedidos Activos -->
            <div class="col-xl-3 col-lg-3 col-md-6 col-12 mb-3">
                <div class="small-box bg-primary shadow-sm h-100 mb-0" style="transition: transform 0.2s ease, box-shadow 0.2s ease; border-radius: 8px;">
                    <div class="inner">
                        <h3 id="kpi-pedidos">@pedidosActivos</h3>
                        <p class="font-weight-500">Pedidos Activos</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-dolly"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'pedido/index' });" class="small-box-footer font-weight-500">
                        Ver Pedidos <i class="fas fa-arrow-circle-right ml-1"></i>
                    </a>
                </div>
            </div>

            <!-- 3. Cotizaciones Activas -->
            <div class="col-xl-3 col-lg-3 col-md-6 col-12 mb-3">
                <div class="small-box bg-success shadow-sm h-100 mb-0" style="transition: transform 0.2s ease, box-shadow 0.2s ease; border-radius: 8px;">
                    <div class="inner">
                        <h3 id="kpi-cotizaciones">@cotizacionesActivas</h3>
                        <p class="font-weight-500">Cotizaciones Activas</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-file-invoice-dollar"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'cotizacion/index' });" class="small-box-footer font-weight-500">
                        Ver Cotizaciones <i class="fas fa-arrow-circle-right ml-1"></i>
                    </a>
                </div>
            </div>

            <!-- 4. Órdenes de Producción del mes -->
            <div class="col-xl-3 col-lg-3 col-md-6 col-12 mb-3">
                <div class="small-box bg-warning shadow-sm h-100 mb-0" style="transition: transform 0.2s ease, box-shadow 0.2s ease; border-radius: 8px;">
                    <div class="inner">
                        <h3 id="kpi-produccion" style="color: #ffffff !important;">@ordenesProduccionMes</h3>
                        <p style="color: #ffffff !important;" class="font-weight-500">&Oacute;rdenes de Producci&oacute;n del Mes</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-industry" style="color: rgba(255, 255, 255, 0.25) !important;"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'ordenProdu/index' });" class="small-box-footer font-weight-500" style="color: #ffffff !important;">
                        Ver Planta / O.P. <i class="fas fa-arrow-circle-right ml-1"></i>
                    </a>
                </div>
            </div>

            <!-- 5. Órdenes de Compra del mes (Cae a la 2da fila) -->
            <div class="col-xl-3 col-lg-3 col-md-6 col-12 mb-3">
                <div class="small-box bg-danger shadow-sm h-100 mb-0" style="transition: transform 0.2s ease, box-shadow 0.2s ease; border-radius: 8px;">
                    <div class="inner">
                        <h3 id="kpi-compras">@ordenesCompraMes</h3>
                        <p class="font-weight-500">&Oacute;rdenes de Compra del Mes</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-truck-loading"></i>
                    </div>
                    <a href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'ordenCompra/index' });" class="small-box-footer font-weight-500">
                        Ver &Oacute;rdenes de Compra <i class="fas fa-arrow-circle-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 2. SECCIÓN PRINCIPAL (Gráficos y Accesos Rápidos) -->
        <div class="row">

            <!-- Columna Izquierda (7 columnas) -->
            <div class="col-lg-7">

                <!-- Gráfico de Ventas -->
                <div class="card card-primary card-outline shadow-sm mb-4">
                    <div class="card-header border-0 d-flex align-items-center justify-content-between">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-chart-line text-primary mr-2"></i>Evolución de Ventas (Miles de Soles)
                        </h3>
                        <span class="badge badge-success px-2 py-1"><i class="fas fa-sync-alt mr-1"></i>Sincronizado BD</span>
                    </div>
                    <div class="card-body pt-1">
                        <div class="position-relative mb-3" style="height: 250px;">
                            <canvas id="salesChart" height="240"></canvas>
                        </div>
                        <div class="d-flex flex-row justify-content-end align-items-center text-sm">
                            <span class="mr-3 font-weight-500 text-muted">
                                <i class="fas fa-square text-primary mr-1"></i> Año Actual (2026)
                            </span>
                            <span class="font-weight-500 text-muted">
                                <i class="fas fa-square mr-1" style="color: #94a3b8;"></i> Año Anterior (2025)
                            </span>
                        </div>
                    </div>
                </div>

                <!-- STACKED BAR CHART (AdminLTE 3 Card Success) -->
                <div class="card card-success shadow-sm mb-4">
                    <div class="card-header">
                        <h3 class="card-title font-weight-bold">Stacked Bar Chart</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                                <i class="fas fa-minus"></i>
                            </button>
                            <button type="button" class="btn btn-tool" data-card-widget="remove">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="chart position-relative" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;">
                            <canvas id="stackedBarChart" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Columna Derecha (5 columnas) -->
            <div class="col-lg-5">

                <!-- Accesos Rápidos -->
                <div class="card card-success card-outline shadow-sm mb-4">
                    <div class="card-header border-0">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-bolt text-success mr-2"></i>Accesos Rápidos
                        </h3>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex flex-wrap justify-content-center align-items-center" style="gap: 10px;">
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'cotizacion/index' });">
                                <i class="fas fa-file-signature text-success"></i> Cotizaciones
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'pedido/index' });">
                                <i class="fas fa-dolly text-primary"></i> Pedidos
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'comprobante/index' });">
                                <i class="fas fa-receipt text-info"></i> Facturar
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'ordenProdu/index' });">
                                <i class="fas fa-industry text-warning"></i> Producción
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'ordenCompra/index' });">
                                <i class="fas fa-truck-loading text-danger"></i> Compras
                            </a>
                            <a class="btn btn-app m-0" href="javascript:void(0);" onclick="$(this).getView({ urlAction: 'producto/index' });">
                                <i class="fas fa-tags text-secondary"></i> Productos
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Gráfico de Producción en Planta -->
                <div class="card card-warning card-outline shadow-sm mb-4">
                    <div class="card-header border-0">
                        <h3 class="card-title font-weight-bold m-0">
                            <i class="fas fa-chart-pie text-warning mr-2"></i>Estado de Producción
                        </h3>
                    </div>
                    <div class="card-body pt-1 pb-3" style="position: relative; height: 260px;">
                        <canvas id="productionChart" height="210"></canvas>
                    </div>
                </div>

                <!-- Tarjeta informativa de Entorno -->
                <div class="info-box bg-light shadow-sm mb-4" style="border-radius: 10px;">
                    <span class="info-box-icon bg-success elevation-1" style="border-radius: 8px;"><i class="fas fa-database"></i></span>
                    <div class="info-box-content">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="info-box-text font-weight-bold m-0">Base de Datos en Tiempo Real</span>
                            <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i>Sincronizado</span>
                        </div>
                        <span class="info-box-number text-muted font-weight-normal text-sm mt-1">
                            Catálogo: <code>esderp_v6</code> &bull; Polling activo cada 30s
                        </span>
                        <div class="progress my-2" style="height: 4px; border-radius: 2px;">
                            <div class="progress-bar bg-success" style="width: 100%"></div>
                        </div>
                        <span class="progress-description text-muted text-xs">
                            <i class="fas fa-bolt text-success mr-1"></i> Totales y métricas calculados directamente desde BD
                        </span>
                    </div>
                </div>

            </div>

        </div>

    </div>
</section>

<script type="text/javascript">
    $(document).ready(function () {
        var cid = $('#__cid').val() || '@cid';

        // Helpers para soporte dinámico Claro / Oscuro en Chart.js
        function getThemeConfig() {
            var isDark = $('body').hasClass('dark-mode') || $('html').hasClass('dark-mode');
            return {
                isDark: isDark,
                textColor: isDark ? '#cbd5e1' : '#64748b',
                gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.05)',
                barCurrent: isDark ? '#3b82f6' : '#007bff',
                barPrevious: isDark ? '#64748b' : '#ced4da',
                pieColors: isDark ? ['#06b6d4', '#10b981', '#f59e0b', '#f43f5e'] : ['#17a2b8', '#28a745', '#ffc107', '#dc3545']
            };
        }

        var salesChartInstance = null;
        var productionChartInstance = null;
        var stackedBarChartInstance = null;

        var defaultDashboardData = {
            success: true,
            kpis: {
                facturacionMes: "@Html.Raw(facturacionMes)",
                pedidosActivos: "@Html.Raw(pedidosActivos)",
                cotizacionesActivas: "@Html.Raw(cotizacionesActivas)",
                ordenesProduccionMes: "@Html.Raw(ordenesProduccionMes)",
                ordenesCompraMes: "@Html.Raw(ordenesCompraMes)"
            },
            graficoVentas: {
                meses: ["May", "Jun", "Jul", "Ago", "Set", "Oct"],
                ventas2025: [2759.3, 2545.2, 2644.6, 2979.2, 2872.9, 3071.1],
                ventas2026: [3015.2, 2931.8, 2901.6, 3090.7, 1506.8, 0]
            },
            graficoProduccion: {
                labels: ["En Proceso", "Culminadas", "Pendientes", "Anuladas"],
                valores: [42, 118, 26, 4]
            },
            graficoStackedBar: {
                labels: ['January', 'February', 'March', 'April', 'May', 'June', 'July'],
                datasets: [
                    {
                        label: 'Electronics',
                        data: [65, 59, 80, 81, 56, 55, 40]
                    },
                    {
                        label: 'Digital Goods',
                        data: [28, 48, 40, 19, 86, 27, 90]
                    }
                ]
            }
        };

        var lastDashboardData = defaultDashboardData;

        function renderSalesChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('salesChart');
            if (!canvas) return;

            if (salesChartInstance) {
                salesChartInstance.destroy();
                salesChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            salesChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: data.meses,
                    datasets: [
                        {
                            label: 'Año Actual (2026)',
                            backgroundColor: theme.barCurrent,
                            borderColor: theme.barCurrent,
                            data: data.ventas2026,
                            borderRadius: 4
                        },
                        {
                            label: 'Año Anterior (2025)',
                            backgroundColor: theme.barPrevious,
                            borderColor: theme.barPrevious,
                            data: data.ventas2025,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': S/ ' + context.parsed.y + 'k';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            ticks: { color: theme.textColor },
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: theme.textColor,
                                callback: function(value) { return 'S/ ' + value + 'k'; }
                            },
                            grid: { color: theme.gridColor }
                        }
                    }
                }
            });
        }

        function renderProductionChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('productionChart');
            if (!canvas) return;

            if (productionChartInstance) {
                productionChartInstance.destroy();
                productionChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            productionChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: data.labels,
                    datasets: [{
                        data: data.valores,
                        backgroundColor: theme.pieColors,
                        borderWidth: theme.isDark ? 2 : 1,
                        borderColor: theme.isDark ? '#343a40' : '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: theme.textColor,
                                boxWidth: 14,
                                padding: 12
                            }
                        }
                    },
                    cutout: '62%'
                }
            });
        }

        function renderStackedBarChart(data) {
            if (!data) return;
            var theme = getThemeConfig();
            var canvas = document.getElementById('stackedBarChart');
            if (!canvas) return;

            if (stackedBarChartInstance) {
                stackedBarChartInstance.destroy();
                stackedBarChartInstance = null;
            }

            if (typeof Chart === 'undefined') return;

            var labels = data.labels || ['January', 'February', 'March', 'April', 'May', 'June', 'July'];
            var dElectronics = [65, 59, 80, 81, 56, 55, 40];
            var dDigital = [28, 48, 40, 19, 86, 27, 90];
            var lElectronics = 'Electronics';
            var lDigital = 'Digital Goods';

            if (data.datasets && data.datasets.length >= 2) {
                lElectronics = data.datasets[0].label || lElectronics;
                dElectronics = data.datasets[0].data || dElectronics;
                lDigital = data.datasets[1].label || lDigital;
                dDigital = data.datasets[1].data || dDigital;
            }

            stackedBarChartInstance = new Chart(canvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: lElectronics,
                            backgroundColor: theme.isDark ? '#94a3b8' : 'rgba(210, 214, 222, 1)',
                            borderColor: theme.isDark ? '#64748b' : '#c1c7d1',
                            borderWidth: 1,
                            data: dElectronics
                        },
                        {
                            label: lDigital,
                            backgroundColor: theme.isDark ? '#3b82f6' : 'rgba(60, 141, 188, 0.9)',
                            borderColor: theme.isDark ? '#2563eb' : 'rgba(60, 141, 188, 1)',
                            borderWidth: 1,
                            data: dDigital
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top',
                            labels: {
                                color: theme.textColor,
                                boxWidth: 20,
                                padding: 15,
                                font: {
                                    size: 12
                                }
                            }
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false
                        }
                    },
                    scales: {
                        x: {
                            stacked: true,
                            ticks: {
                                color: theme.textColor
                            },
                            grid: {
                                color: theme.gridColor,
                                display: true
                            }
                        },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            suggestedMax: 160,
                            ticks: {
                                color: theme.textColor,
                                stepSize: 20
                            },
                            grid: {
                                color: theme.gridColor,
                                display: true
                            }
                        }
                    }
                }
            });
        }

        // Renderizado inicial inmediato con fallback para que los gráficos NUNCA aparezcan vacíos
        function initChartsImmediately() {
            if (typeof Chart !== 'undefined') {
                renderSalesChart(lastDashboardData.graficoVentas);
                renderProductionChart(lastDashboardData.graficoProduccion);
                renderStackedBarChart(lastDashboardData.graficoStackedBar);
            } else {
                setTimeout(initChartsImmediately, 80);
            }
        }
        initChartsImmediately();

        // Listener para actualización en tiempo real cuando se cambia de tema Claro <-> Oscuro
        $(document).off('themeChanged.dashboard').on('themeChanged.dashboard', function (e, isDark) {
            if (lastDashboardData) {
                if (lastDashboardData.graficoVentas) {
                    renderSalesChart(lastDashboardData.graficoVentas);
                }
                if (lastDashboardData.graficoProduccion) {
                    renderProductionChart(lastDashboardData.graficoProduccion);
                }
                if (lastDashboardData.graficoStackedBar) {
                    renderStackedBarChart(lastDashboardData.graficoStackedBar);
                }
            }
        });

        // Función para cargar/sincronizar datos dinámicos en tiempo real
        function sincronizarDashboard() {
            $.ajax({
                url: '@Url.Action("ObtenerDatosDashboard", "Home")',
                type: 'GET',
                data: { cid: cid },
                headers: { 'x-app-cid': cid },
                success: function (res) {
                    if (res && res.success) {
                        lastDashboardData = res;

                        // Actualizar los 5 KPIs en tiempo real
                        if (res.kpis) {
                            if (res.kpis.facturacionMes) $('#kpi-ventas').text(res.kpis.facturacionMes);
                            if (res.kpis.pedidosActivos) $('#kpi-pedidos').text(res.kpis.pedidosActivos);
                            if (res.kpis.cotizacionesActivas) $('#kpi-cotizaciones').text(res.kpis.cotizacionesActivas);
                            if (res.kpis.ordenesProduccionMes) $('#kpi-produccion').text(res.kpis.ordenesProduccionMes);
                            if (res.kpis.ordenesCompraMes) $('#kpi-compras').text(res.kpis.ordenesCompraMes);
                        }

                        // Actualizar Gráficos con datos frescos de la BD
                        if (res.graficoVentas) {
                            renderSalesChart(res.graficoVentas);
                        }
                        if (res.graficoProduccion) {
                            renderProductionChart(res.graficoProduccion);
                        }
                        if (res.graficoStackedBar) {
                            renderStackedBarChart(res.graficoStackedBar);
                        }
                    }
                },
                error: function () {
                    // Mantener datos locales en caso de desconexión
                    if (lastDashboardData) {
                        renderSalesChart(lastDashboardData.graficoVentas);
                        renderProductionChart(lastDashboardData.graficoProduccion);
                        renderStackedBarChart(lastDashboardData.graficoStackedBar);
                    }
                }
            });
        }

        // Carga inicial vía AJAX
        sincronizarDashboard();

        // Polling en segundo plano cada 30 segundos para actualización en tiempo real
        var dashboardInterval = setInterval(function () {
            // Verificar si el tablero aún sigue en el DOM antes de consultar
            if ($('#kpi-ventas').length > 0) {
                sincronizarDashboard();
            } else {
                clearInterval(dashboardInterval);
            }
        }, 30000);
    });
</script>