                            </label>
                            <label class="color-pill" style="background:#dc3545;" title="Rojo (Lanzamiento / CrÃ­tico)">
                                <input type="radio" name="evento-color" value="#dc3545" />
                                <i class="fas fa-check"></i>
                            </label>
                            <label class="color-pill" style="background:#6f42c1;" title="Morado (General / All-hands)">
                                <input type="radio" name="evento-color" value="#6f42c1" />
                                <i class="fas fa-check"></i>
