                        </div>
                    </div>

                    <!-- Meta info (cuando se edita un evento existente) -->
                    <div id="evento-info-meta" class="alert alert-light border small text-muted mb-0" style="display: none;">
                        <div class="d-flex justify-content-between">
                            <span><i class="far fa-user mr-1"></i> Registrado por: <strong id="evento-meta-usuario">-</strong></span>
                            <span><i class="far fa-clock mr-1"></i> <span id="evento-meta-fecha">-</span></span>
