                        <label class="font-weight-bold text-muted small mb-1">
                            <i class="far fa-calendar-alt mr-1 text-primary"></i> Fecha Seleccionada <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control" id="evento-fecha-inicio" required />
                    </div>

                    <!-- TÃ­tulo del Evento -->
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-muted small mb-1">
                            <i class="fas fa-heading mr-1 text-primary"></i> TÃ­tulo del Evento <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="evento-titulo" placeholder="Ej. ReuniÃ³n de equipo / RevisiÃ³n de avance" maxlength="150" required />
                        <small class="form-text text-muted">Escribe un tÃ­tulo descriptivo para la actividad.</small>
                    </div>

                    <!-- Contexto de lo que harÃ­an -->
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-muted small mb-1">
                            <i class="fas fa-align-left mr-1 text-primary"></i> Contexto / DescripciÃ³n de lo que se harÃ¡
                        </label>
                        <textarea class="form-control" id="evento-contexto" rows="4" placeholder="Escribe el contexto detallado, temas a tratar, objetivos o lo que se realizarÃ¡ en este dÃ­a..."></textarea>
                        <small class="form-text text-muted">Detalla las actividades o contexto necesario.</small>
                    </div>

                    <!-- Selector de Color / CategorÃ­a -->
                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-muted small mb-2 d-block">
                            <i class="fas fa-palette mr-1 text-primary"></i> Color / CategorÃ­a
                        </label>
                        <div class="d-flex align-items-center" id="color-palette-group" style="gap: 12px;">
                            <label class="color-pill" style="background:#0d6efd;" title="Azul (ReuniÃ³n)">
                                <input type="radio" name="evento-color" value="#0d6efd" checked />
                                <i class="fas fa-check"></i>
                            </label>
                            <label class="color-pill" style="background:#198754;" title="Verde (Cliente)">
                                <input type="radio" name="evento-color" value="#198754" />
                                <i class="fas fa-check"></i>
                            </label>
                            <label class="color-pill" style="background:#ffc107;" title="Amarillo (RevisiÃ³n)">
                                <input type="radio" name="evento-color" value="#ffc107" />
                                <i class="fas fa-check" style="color: #212529;"></i>
                            </label>
                            <label class="color-pill" style="background:#0dcaf0;" title="Celeste (1 a 1)">
                                <input type="radio" name="evento-color" value="#0dcaf0" />
