                        <i class="fas fa-trash-alt mr-1"></i> Eliminar Evento
                    </button>
                    <div class="ml-auto">
                        <button type="button" class="btn btn-secondary btn-sm mr-2" data-dismiss="modal" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-primary btn-sm font-weight-bold px-3 shadow-sm" id="btn-guardar-evento">
                            <i class="fas fa-save mr-1"></i> Guardar Evento
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="text/javascript">
(function() {
    function initFullCalendarModule() {
        var calendarEl = document.getElementById('calendar');
        var externalEl = document.getElementById('external-events');
        var removeAfterDrop = document.getElementById('remove-after-drop');

        if (!calendarEl) return;

        // Initialize Draggable External Events
        if (externalEl && window.FullCalendar && FullCalendar.Draggable) {
            new FullCalendar.Draggable(externalEl, {
                itemSelector: '.draggable-event',
                eventData: function(eventEl) {
                    return {
                        title: eventEl.textContent.trim(),
                        backgroundColor: eventEl.dataset.color || '#0d6efd',
                        borderColor: eventEl.dataset.color || '#0d6efd'
                    };
                }
            });
        }

        // Initialize Calendar
        var calendar = new FullCalendar.Calendar(calendarEl, {
            locale: 'es',
            initialView: 'dayGridMonth',
            headerToolbar: {
                start: 'prev,next today',
                center: 'title',
                end: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
            },
            buttonText: {
                today: 'Hoy',
                month: 'Mes',
                week: 'Semana',
                day: 'DÃ­a',
                list: 'Agenda'
            },
            height: 'auto',
            editable: true,
            droppable: true,
            dayMaxEvents: 3,
            events: '@Url.Action("ObtenerEventos", "Calendario")',

            // Drop from external draggable badges
            drop: function(info) {
                var title = info.draggedEl.textContent.trim();
                var color = info.draggedEl.dataset.color || '#0d6efd';

                if (removeAfterDrop && removeAfterDrop.checked) {
                    info.draggedEl.remove();
                }

                // Persist new event in DB
                $.ajax({
                    url: '@Url.Action("GuardarEvento", "Calendario")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        id: 0,
                        titulo: title,
                        contexto: 'Registrado desde eventos arrastrables',
                        fechaInicio: info.dateStr,
                        todoElDia: true,
                        color: color
                    }),
                    success: function(res) {
                        if (res.success) {
                            calendar.refetchEvents();
                            if (window.alertify) alertify.success('Evento programado exitosamente');
                        } else {
                            if (window.alertify) alertify.error(res.message);
                        }
                    },
                    error: function() {
                        if (window.alertify) alertify.error('Error al guardar el evento arrastrado');
                    }
                });
            },

            // Click on day cell -> Open Registration Modal
            dateClick: function(info) {
                abrirModalNuevoEvento(info.dateStr);
            },

            // Click on existing event -> Open Edit/Delete Modal
            eventClick: function(info) {
                abrirModalEditarEvento(info.event);
            },

            // Event dragged to another day
            eventDrop: function(info) {
                actualizarFechaEvento(info.event);
            },

            // Event resized
            eventResize: function(info) {
                actualizarFechaEvento(info.event);
            }
        });

        calendar.render();
        window._activeCalendarInstance = calendar;

        // Modal Helpers
        function abrirModalNuevoEvento(fechaStr) {
            $('#evento-id').value = '0';
            $('#evento-id').val(0);
            $('#evento-fecha-inicio').val(fechaStr || new Date().toISOString().slice(0, 10));
            $('#evento-titulo').val('');
            $('#evento-contexto').val('');
            
            // Default color azul
            $('input[name="evento-color"][value="#0d6efd"]').prop('checked', true);
            actualizarEstiloColorPills('#0d6efd');

            $('#modalEventoLabel #modal-icon').attr('class', 'far fa-calendar-plus mr-2');
            $('#modalEventoLabel #modal-title-text').text('Registrar Evento');
            $('#btn-eliminar-evento').hide();
            $('#evento-info-meta').hide();

            $('#modal-evento-calendario').modal('show');
            setTimeout(function() { $('#evento-titulo').focus(); }, 400);
        }

        function abrirModalEditarEvento(event) {
            $('#evento-id').val(event.id);
            var fInicio = event.startStr ? event.startStr.slice(0, 10) : '';
            $('#evento-fecha-inicio').val(fInicio);
            $('#evento-titulo').val(event.title);
            
            var ext = event.extendedProps || {};
            $('#evento-contexto').val(ext.contexto || '');

            var color = event.backgroundColor || '#0d6efd';
            var $radio = $('input[name="evento-color"][value="' + color + '"]');
            if ($radio.length > 0) {
                $radio.prop('checked', true);
                actualizarEstiloColorPills(color);
            } else {
                $('input[name="evento-color"][value="#0d6efd"]').prop('checked', true);
                actualizarEstiloColorPills('#0d6efd');
            }

            $('#modalEventoLabel #modal-icon').attr('class', 'fas fa-edit mr-2');
            $('#modalEventoLabel #modal-title-text').text('Editar Evento');

            if (ext.usuario) {
                $('#evento-meta-usuario').text(ext.usuario);
                $('#evento-meta-fecha').text(ext.fechaCreacion || '');
                $('#evento-info-meta').show();
            } else {
                $('#evento-info-meta').hide();
            }

            $('#btn-eliminar-evento').show();
            $('#modal-evento-calendario').modal('show');
        }

        function actualizarEstiloColorPills(colorSeleccionado) {
            $('.color-pill').each(function() {
                var $radio = $(this).find('input[type="radio"]');
                if ($radio.val() === colorSeleccionado) {
                    $(this).addClass('active');
                } else {
                    $(this).removeClass('active');
                }
            });
        }

        $('input[name="evento-color"]').on('change', function() {
            actualizarEstiloColorPills($(this).val());
        });

        // Click on manual "Registrar Nuevo Evento" button
        $('#btn-crear-evento-manual').off('click').on('click', function() {
            abrirModalNuevoEvento(new Date().toISOString().slice(0, 10));
        });

        // Save Event (Create or Update)
        $('#btn-guardar-evento').off('click').on('click', function() {
            var id = parseInt($('#evento-id').val()) || 0;
            var titulo = $('#evento-titulo').val().trim();
            var contexto = $('#evento-contexto').val().trim();
            var fechaInicio = $('#evento-fecha-inicio').val();
            var color = $('input[name="evento-color"]:checked').val() || '#0d6efd';

            if (!titulo) {
                if (window.alertify) alertify.warning('Por favor ingresa el tÃ­tulo del evento.');
                $('#evento-titulo').focus();
                return;
            }

            if (!fechaInicio) {
                if (window.alertify) alertify.warning('Por favor selecciona una fecha vÃ¡lida.');
                $('#evento-fecha-inicio').focus();
                return;
            }

            var payload = {
                id: id,
                titulo: titulo,
                contexto: contexto,
                fechaInicio: fechaInicio,
                todoElDia: true,
                color: color
            };

            var $btn = $(this);
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');

            $.ajax({
                url: '@Url.Action("GuardarEvento", "Calendario")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    $btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Guardar Evento');
                    if (res.success) {
                        $('#modal-evento-calendario').modal('hide');
                        calendar.refetchEvents();
                        if (window.alertify) alertify.success(res.message || 'Evento guardado exitosamente');
                    } else {
                        if (window.alertify) alertify.error(res.message || 'Error al guardar el evento');
                    }
                },
                error: function(xhr) {
                    $btn.prop('disabled', false).html('<i class="fas fa-save mr-1"></i> Guardar Evento');
                    if (window.alertify) alertify.error('Error al comunicarse con el servidor.');
                }
            });
        });

        // Delete Event
        $('#btn-eliminar-evento').off('click').on('click', function() {
            var id = parseInt($('#evento-id').val()) || 0;
            if (id <= 0) return;

            if (confirm('Â¿EstÃ¡s seguro de que deseas eliminar este evento?')) {
                var $btn = $(this);
                $btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("EliminarEvento", "Calendario")',
                    type: 'POST',
                    data: { id: id },
                    success: function(res) {
                        $btn.prop('disabled', false);
                        if (res.success) {
                            $('#modal-evento-calendario').modal('hide');
                            calendar.refetchEvents();
                            if (window.alertify) alertify.success('Evento eliminado correctamente');
                        } else {
                            if (window.alertify) alertify.error(res.message || 'Error al eliminar el evento');
                        }
                    },
                    error: function() {
                        $btn.prop('disabled', false);
                        if (window.alertify) alertify.error('Error al comunicarse con el servidor.');
                    }
                });
            }
        });

        // Update Event Date on Drag/Resize
        function actualizarFechaEvento(event) {
            var payload = {
                id: parseInt(event.id),
                titulo: event.title,
                contexto: event.extendedProps ? (event.extendedProps.contexto || '') : '',
                fechaInicio: event.startStr,
                fechaFin: event.endStr || null,
                todoElDia: event.allDay,
                color: event.backgroundColor || '#0d6efd'
            };

            $.ajax({
                url: '@Url.Action("GuardarEvento", "Calendario")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    if (res.success) {
                        if (window.alertify) alertify.success('Fecha actualizada');
                    } else {
                        if (window.alertify) alertify.error(res.message);
                        calendar.refetchEvents();
                    }
                },
                error: function() {
                    if (window.alertify) alertify.error('Error al actualizar fecha del evento');
                    calendar.refetchEvents();
                }
            });
        }
    }

    // Ensure FullCalendar is loaded before initializing
    if (window.FullCalendar) {
        initFullCalendarModule();
    } else {
        var scriptIndex = document.createElement('script');
        scriptIndex.src = '@Url.Content("~/plugins/fullcalendar/index.global.min.js")';
        scriptIndex.onload = function() {
            var scriptEs = document.createElement('script');
            scriptEs.src = '@Url.Content("~/plugins/fullcalendar/es.global.min.js")';
            scriptEs.onload = function() {
                initFullCalendarModule();
            };
            document.head.appendChild(scriptEs);
        };
        document.head.appendChild(scriptIndex);
    }
})();
</script>