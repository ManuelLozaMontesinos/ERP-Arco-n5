<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>True</OverwriteDataSources>
    <TargetServerVersion>SSRS2008R2</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>ESDERPv6</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DebugLocal' ">
    <FullPath>DebugLocal</FullPath>
    <OutputPath>bin\DebugLocal</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>ESD.ERP.Report.v6</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>ESDERPv6</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSource Include="esdDataSource.rds" />
  </ItemGroup>
  <ItemGroup>
    <Report Include="CM_OrdenCompra.rdl" />
    <Report Include="CM_PedidoCompra.rdl" />
    <Report Include="CM_Valorizacion.rdl" />
    <Report Include="IV_GuiaRemision.rdl" />
    <Report Include="IV_GuiaRemisionE.rdl" />
    <Report Include="IV_GuiaRemOtroE.rdl" />
    <Report Include="IV_MovimientoAlmacen.rdl" />
    <Report Include="IV_Reclasificacion.rdl" />
    <Report Include="LG_KardexConsolidado.rdl" />
    <Report Include="LG_KardexUnidadFecha.rdl" />
    <Report Include="LG_KardexUnidadMensual.rdl" />
    <Report Include="LG_SaldoConsoAlmacen.rdl" />
    <Report Include="LG_SaldoConsolidado.rdl" />
    <Report Include="LG_SaldoUnidad.rdl" />
    <Report Include="LG_SaldoUnidadConsolidado.rdl" />
    <Report Include="PD_OrdenProduccion.rdl" />
    <Report Include="RH_Boleta.rdl" />
    <Report Include="RH_ResumenPlanilla.rdl" />
    <Report Include="VT_Canje.rdl" />
    <Report Include="VT_ComprobanteE.rdl" />
    <Report Include="VT_CotizacionPedido.rdl" />
    <Report Include="VT_CotizacionPedidoPeso.rdl" />
    <Report Include="VT_DocSaldoReservado.rdl" />
    <Report Include="VT_DocSaldoResPorTipo.rdl" />
    <Report Include="VT_DocumentoTemporal.rdl" />
    <Report Include="VT_InternoE.rdl" />
    <Report Include="VT_InvoiceWithDetraction.rdl" />
    <Report Include="VT_MargenUnitario.rdl" />
    <Report Include="VT_NotaCreditoE.rdl" />
    <Report Include="VT_ReciboAnticipo.rdl" />
    <Report Include="VT_RegistroVentaGeneral.rdl" />
    <Report Include="VT_RegistroVentaOficial.rdl" />
    <Report Include="VT_RegistroVentaProducto.rdl" />
    <Report Include="VT_VendedorVentaAnual.rdl" />
    <Report Include="VT_VendedorVentaMes.rdl" />
    <Report Include="VT_VentaClienteConsolidado.rdl" />
    <Report Include="VT_VentaClientePorProducto.rdl" />
    <Report Include="VT_VentaClienteRegistro.rdl" />
    <Report Include="VT_VentaPorProducto.rdl" />
    <Report Include="VT_VentaXVendedor.rdl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets" />
</Project>