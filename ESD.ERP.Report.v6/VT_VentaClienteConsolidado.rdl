  <Code>Public Function ObtenerSubTitulo(mesNombre As String, fechaDesde As String, fechaHasta As String) As String

If Not String.IsNullOrEmpty(mesNombre) Then
	Return "MES DE " &amp; mesNombre
Else
	Return "DEL " &amp; DateTime.ParseExact(fechaDesde,"yyyyMMdd",System.Globalization.CultureInfo.InvariantCulture) _
	&amp; " AL " &amp; DateTime.ParseExact(fechaHasta,"yyyyMMdd",System.Globalization.CultureInfo.InvariantCulture)
End If
End Function</Code>
